PORTAL_DOMAIN=lontsihomes.example.com
API_DOMAIN=api.lontsihomes.example.com

PUBLIC_SITE_NAME=Lontsi Homes
PUBLIC_SITE_LEGAL_ENTITY_NAME=Lontsi Homes
PUBLIC_SITE_SUPPORT_EMAIL=support@example.com
PUBLIC_SITE_REFUND_EMAIL=refunds@example.com
PUBLIC_SITE_SUPPORT_PHONE=
PUBLIC_SITE_SUPPORT_WHATSAPP=
PUBLIC_SITE_COMPANY_ADDRESS=

SQL_DATABASE=RentHubDb
SQL_SA_PASSWORD=

JWT_ISSUER=RentHub
JWT_AUDIENCE=RentHub.Clients
JWT_EXPIRY_MINUTES=480
JWT_SIGNING_KEY=

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorage;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=renthub

INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=
INFOBIP_WHATSAPP_SENDER=
INFOBIP_WEBHOOK_SECRET=
# SMS main-phone onboarding is paused until the SMS sender is approved.
REQUIRE_MAIN_PHONE_VERIFICATION=false
# Dynamic suffixes only; fill after checking the exact approved button URL.
# Supported tokens: {verificationCode} for landlord receipt; {tenancyId} for others.
WHATSAPP_BUTTON_LANDLORD_RECEIPT=
WHATSAPP_BUTTON_RENT_DUE_SOON=
WHATSAPP_BUTTON_RENT_DUE_TODAY=
WHATSAPP_BUTTON_RENT_OVERDUE=
WHATSAPP_BUTTON_TENANCY_ENDING=

EMAIL_SMTP_HOST=smtp.gmail.com
GOOGLE_GEOCODING_API_KEY=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_SMTP_FROM_NAME=Lontsi Homes
EMAIL_SMTP_USE_SSL=true

NOTIFICATIONS_KYC_ADMIN_EMAIL=
ADMIN_NOTIFICATIONS_KYC_EMAIL=

NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_API_KEY=
NOTCHPAY_WEBHOOK_SECRET=

CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_KEY=

SUBSCRIPTIONS_USD_TO_XAF_RATE=600
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_CURRENCY=usd
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=true
STRIPE_CONNECT_REQUIRE_PAYOUT_SETUP=true
STRIPE_CONNECT_DEFAULT_COUNTRY=CA
STRIPE_CONNECT_BUSINESS_PROFILE_URL=https://lontsihomes.com

# Enable temporarily for initial administrator creation, then disable and remove the password.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULL_NAME=System Administrator
ADMIN_SEED_COUNTRY_CODE=+237

REMINDER_DAYS_BEFORE_DUE=10
REMINDER_DAYS_AFTER_UNPAID=3
