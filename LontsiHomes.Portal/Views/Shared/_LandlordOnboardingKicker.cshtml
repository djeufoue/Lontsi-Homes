@model LandlordOnboardingProgressVm
@inject Microsoft.Extensions.Configuration.IConfiguration OnboardingConfiguration
@{
    Model.RequireMainPhoneVerification = OnboardingConfiguration.GetValue("Onboarding:RequireMainPhoneVerification", true);
}

<span class="rh-auth-kicker"
      data-onboarding-kicker
      data-current-step="@Model.CurrentStep">@Model.KickerText</span>
