@model string

<span class="rh-brand-logo @Model" role="img" aria-label="Lontsi Homes">
    <img class="rh-brand-logo__image rh-brand-logo__full rh-brand-logo__light"
         src="~/assets/branding/logo-light.png"
         alt="Lontsi Homes"
         width="1600"
         height="339" />
    <img class="rh-brand-logo__image rh-brand-logo__full rh-brand-logo__dark"
         src="~/assets/branding/logo-dark.png"
         alt=""
         width="1600"
         height="339"
         aria-hidden="true" />
    <img class="rh-brand-logo__image rh-brand-logo__icon rh-brand-logo__light"
         src="~/assets/branding/logo-icon-light.png"
         alt=""
         width="984"
         height="977"
         aria-hidden="true" />
    <img class="rh-brand-logo__image rh-brand-logo__icon rh-brand-logo__dark"
         src="~/assets/branding/logo-icon-dark.png"
         alt=""
         width="984"
         height="977"
         aria-hidden="true" />
</span>
