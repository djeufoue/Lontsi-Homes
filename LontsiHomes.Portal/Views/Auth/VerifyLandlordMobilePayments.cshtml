@model LontsiHomes.Portal.ViewModels.Auth.VerifyLandlordMobilePaymentsVm
@{
    ViewData["Title"] = "Verify Mobile Payments";
    Layout = "_AuthLayout";
    var status = Model.Status;
    var needsSubscriptionOtp = status == null || !status.IsSubscriptionPaymentPhoneVerified;
    var needsPayoutOtp = status == null || !status.IsPayoutPhoneVerified;
    var whatsAppNumber = status?.PendingWhatsAppPhoneNumber ?? status?.WhatsAppPhoneNumber;
    var needsWhatsAppOtp = !string.IsNullOrWhiteSpace(whatsAppNumber) && status?.IsWhatsAppPhoneVerified != true;
    var isAccountUpdate = User.Identity?.IsAuthenticated == true;
    var progress = new LandlordOnboardingProgressVm
    {
        CurrentStep = LandlordOnboardingSteps.MobilePaymentVerification,
        CountryCode = status?.CountryCode ?? "+237",
        CountryIsoCode = status?.CountryIsoCode
    };
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell">
        <aside class="rh-auth-hero">
            @if (isAccountUpdate)
            {
                <span class="rh-auth-kicker">Payment verification</span>
            }
            else
            {
                <partial name="_LandlordOnboardingKicker" model="progress" />
            }
            <h1>@(isAccountUpdate ? "Verify updated numbers." : "Verify payment numbers.")</h1>
            <p>@(isAccountUpdate ? "Enter the OTP codes for changed numbers before they become usable for checkout or future payouts." : "Only the numbers that still need confirmation require an OTP. If the same number was already validated, the system reuses that validation.")</p>
            <ul class="rh-auth-points">
                <li>No duplicate OTP for the same verified number</li>
                <li>Subscription payments use your selected subscription number</li>
                <li>Rent payout number is stored for future tenant payment flows</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            @if (!isAccountUpdate)
            {
                <partial name="_LandlordOnboardingStepper" model="progress" />
            }

            <div class="rh-auth-card-header">
                <h2>OTP confirmation</h2>
                <p>@(isAccountUpdate ? "Confirm the changed payment numbers." : "Enter the OTP codes received for pending numbers.")</p>
            </div>

            @if (ViewBag.AuthInfo is string authInfo)
            {
                <div class="alert alert-info py-2">@authInfo</div>
            }

            @if (ViewBag.AuthError is string authError)
            {
                <div class="alert alert-danger py-2">@authError</div>
            }

            <form asp-action="VerifyLandlordMobilePayments" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                @if (status != null)
                {
                    <div class="rh-verification-list mb-3">
                        <div>
                            <span>Subscription payment</span>
                            <strong>@(string.IsNullOrWhiteSpace(status.SubscriptionPaymentPhoneNumber) ? "Configured number" : status.SubscriptionPaymentPhoneNumber)</strong>
                            <small>@(status.IsSubscriptionPaymentPhoneVerified ? "Verified" : "Pending OTP")</small>
                        </div>
                        <div>
                            <span>Rent payout</span>
                            <strong>@(string.IsNullOrWhiteSpace(status.PayoutPhoneNumber) ? "Configured number" : status.PayoutPhoneNumber)</strong>
                            <small>@(status.IsPayoutPhoneVerified ? "Verified" : "Pending OTP")</small>
                        </div>
                        <div>
                            <span>WhatsApp alerts</span>
                            <strong>@(string.IsNullOrWhiteSpace(whatsAppNumber) ? "Optional number" : whatsAppNumber)</strong>
                            <small>@(status.IsWhatsAppPhoneVerified ? "Verified" : "Pending if configured")</small>
                        </div>
                    </div>
                }

                @if (needsSubscriptionOtp)
                {
                    <div class="mb-3">
                        <label asp-for="SubscriptionPaymentOtp" class="form-label rh-auth-label"></label>
                        <input asp-for="SubscriptionPaymentOtp" class="form-control rh-auth-input" autocomplete="one-time-code" inputmode="numeric" placeholder="Code sent to subscription number" required data-required-when-visible="true" />
                        <span asp-validation-for="SubscriptionPaymentOtp" class="text-danger small"></span>
                    </div>
                }

                @if (needsPayoutOtp)
                {
                    <div class="mb-3">
                        <label asp-for="PayoutOtp" class="form-label rh-auth-label"></label>
                        <input asp-for="PayoutOtp" class="form-control rh-auth-input" autocomplete="one-time-code" inputmode="numeric" placeholder="Code sent to rent payout number" required data-required-when-visible="true" />
                        <span asp-validation-for="PayoutOtp" class="text-danger small"></span>
                    </div>
                }

                @if (needsWhatsAppOtp)
                {
                    <div class="mb-3">
                        <label asp-for="WhatsAppOtp" class="form-label rh-auth-label"></label>
                        <input asp-for="WhatsAppOtp" class="form-control rh-auth-input" autocomplete="one-time-code" inputmode="numeric" placeholder="Code from WhatsApp" required data-required-when-visible="true" />
                        <span asp-validation-for="WhatsAppOtp" class="text-danger small"></span>
                    </div>
                }

                <button type="submit" class="btn rh-btn-primary w-100">@(isAccountUpdate ? "Verify updated numbers" : "Complete registration")</button>
            </form>

            <p class="rh-auth-footnote mb-0 mt-3">
                Need to change a number?
                <a asp-action="LandlordMobilePayments" asp-route-email="@Model.Email" asp-route-returnUrl="@Model.ReturnUrl">Go back</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
