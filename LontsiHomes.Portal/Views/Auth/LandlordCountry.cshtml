@model LontsiHomes.Portal.ViewModels.Auth.LandlordCountryVm
@{
    ViewData["Title"] = "Choose Country";
    Layout = "_AuthLayout";
    var selectedCountryCode = string.IsNullOrWhiteSpace(Model.CountryCode) ? "+1" : Model.CountryCode;
    var selectedCountryIsoCode = string.IsNullOrWhiteSpace(Model.CountryIsoCode) ? "CA" : Model.CountryIsoCode.Trim().ToUpperInvariant();
    var progress = new LandlordOnboardingProgressVm
    {
        CurrentStep = LandlordOnboardingSteps.Country,
        CountryCode = selectedCountryCode,
        CountryIsoCode = selectedCountryIsoCode
    };
    var countries = new[]
    {
        new { Iso = "CA", Code = "+1", Label = "Canada (+1)" },
        new { Iso = "US", Code = "+1", Label = "United States (+1)" },
        new { Iso = "CM", Code = "+237", Label = "Cameroon (+237)" },
        new { Iso = "GB", Code = "+44", Label = "United Kingdom (+44)" },
        new { Iso = "FR", Code = "+33", Label = "France (+33)" },
        new { Iso = "BE", Code = "+32", Label = "Belgium (+32)" },
        new { Iso = "DE", Code = "+49", Label = "Germany (+49)" },
        new { Iso = "NG", Code = "+234", Label = "Nigeria (+234)" },
        new { Iso = "CI", Code = "+225", Label = "Cote d'Ivoire (+225)" },
        new { Iso = "GH", Code = "+233", Label = "Ghana (+233)" },
        new { Iso = "ZA", Code = "+27", Label = "South Africa (+27)" },
        new { Iso = "KE", Code = "+254", Label = "Kenya (+254)" },
        new { Iso = "AE", Code = "+971", Label = "United Arab Emirates (+971)" }
    };
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell">
        <aside class="rh-auth-hero">
            <partial name="_LandlordOnboardingKicker" model="progress" />
            <h1>Choose your country.</h1>
            <p>This controls which payment setup steps apply to your landlord account.</p>
            <ul class="rh-auth-points">
                <li>Country rules are saved for your landlord account</li>
                <li>Your main phone number is confirmed by SMS OTP</li>
                <li>You can continue after confirming the number</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            <partial name="_LandlordOnboardingStepper" model="progress" />

            <div class="rh-auth-card-header">
                <h2>Country</h2>
                <p>Select where this landlord account is registered.</p>
            </div>

            @if (ViewBag.AuthInfo is string authInfo)
            {
                <div class="alert alert-info py-2">@authInfo</div>
            }

            @if (ViewBag.AuthError is string authError)
            {
                <div class="alert alert-danger py-2">@authError</div>
            }

            <form asp-action="LandlordCountry" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <input asp-for="Email" type="hidden" />
                <input asp-for="CountryCode" type="hidden" value="@selectedCountryCode" data-country-code-output />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="CountryIsoCode" class="form-label rh-auth-label"></label>
                    <select asp-for="CountryIsoCode" class="form-select rh-auth-input" autocomplete="country" data-country-selector>
                        <option value="">Choose a country</option>
                        @foreach (var country in countries)
                        {
                            <option value="@country.Iso" data-country-code="@country.Code">@country.Label</option>
                        }
                    </select>
                    <span asp-validation-for="CountryIsoCode" class="text-danger small"></span>
                    <span asp-validation-for="CountryCode" class="text-danger small"></span>
                </div>

                <div class="rh-inline-hint mb-3">
                    If you choose Cameroon, Mobile Money setup appears later. Other countries use card payments.
                </div>

                <button type="submit" class="btn rh-btn-primary w-100">Continue</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const select = document.querySelector("[data-country-selector]");
            const countryCodeOutput = document.querySelector("[data-country-code-output]");
            const stepper = document.querySelector("[data-onboarding-stepper]");
            const kicker = document.querySelector("[data-onboarding-kicker]");
            if (!select || !countryCodeOutput || !stepper || !kicker) {
                return;
            }

            const currentStep = "country";
            const baseSteps = ["account", "email", "country", "phone", "kyc", "contract"];
            const cameroonSteps = ["account", "email", "country", "phone", "mobile-payments", "mobile-payment-verification", "kyc", "contract"];

            const render = () => {
                const selectedOption = select.options[select.selectedIndex];
                countryCodeOutput.value = selectedOption?.dataset?.countryCode || "";
                const steps = (select.value === "CM" ? cameroonSteps : baseSteps)
                    .filter(step => step !== "phone" || stepper.dataset.requireMainPhone !== "false");
                const activeIndex = steps.indexOf(currentStep);
                stepper.style.setProperty("--rh-auth-step-count", steps.length.toString());
                stepper.classList.toggle("rh-auth-stepper-wide", steps.length > 6);
                kicker.textContent = `Step ${activeIndex + 1} of ${steps.length}`;
                stepper.replaceChildren(...steps.map((_, index) => {
                    const item = document.createElement("span");
                    item.textContent = (index + 1).toString();
                    if (index === activeIndex) {
                        item.className = "active";
                    } else if (index < activeIndex) {
                        item.className = "done";
                    }
                    return item;
                }));
            };

            select.addEventListener("change", render);
            render();
        })();
    </script>
}
