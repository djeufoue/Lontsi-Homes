@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">Lontsi Homes Security</span>
            <h1>Check your inbox.</h1>
            <p>Password recovery links are delivered only to the email address registered on the account.</p>
        </aside>

        <section class="rh-auth-card">
            <div class="rh-auth-card-header">
                <h2>Reset link requested</h2>
                <p>If an account exists for that email, we sent a password reset link.</p>
            </div>

            <div class="alert alert-info">
                Check your inbox and spam folder. The link can only be used once and will expire.
            </div>

            <a asp-action="Login" class="btn rh-btn-primary w-100">Return to login</a>
            <p class="rh-auth-footnote mb-0">
                Didn’t receive it?
                <a asp-action="ForgotPassword">Try again</a>
            </p>
        </section>
    </div>
</div>
