@model LontsiHomes.Portal.ViewModels.Auth.ForgotPasswordVm
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">Lontsi Homes Security</span>
            <h1>Get back to managing your rentals.</h1>
            <p>We’ll send a secure, one-time password reset link to your account email.</p>
            <ul class="rh-auth-points">
                <li>Your current password remains unchanged until you finish</li>
                <li>The recovery link expires and can only be used once</li>
                <li>Only the account owner’s email receives the link</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            <div class="rh-auth-card-header">
                <h2>Reset your password</h2>
                <p>Enter the email address you use to sign in.</p>
            </div>

            <form asp-action="ForgotPassword" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label rh-auth-label"></label>
                    <input asp-for="Email" class="form-control rh-auth-input" autocomplete="email" autofocus placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn rh-btn-primary w-100" data-pending-text="Sending link">Send reset link</button>
            </form>

            <p class="rh-auth-footnote mb-0">
                Remembered your password?
                <a asp-action="Login" asp-route-email="@Model.Email">Back to login</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
