@model LontsiHomes.Portal.ViewModels.Auth.ResetPasswordVm
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">Lontsi Homes Security</span>
            <h1>Choose a new password.</h1>
            <p>Use at least eight characters and choose a password you don’t use elsewhere.</p>
            <ul class="rh-auth-points">
                <li>Your reset link will stop working after this change</li>
                <li>Your password is never included in email</li>
                <li>You’ll return to login when the reset is complete</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            <div class="rh-auth-card-header">
                <h2>Create a new password</h2>
                <p>Enter and confirm your new password.</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label rh-auth-label"></label>
                    <input asp-for="NewPassword" class="form-control rh-auth-input" autocomplete="new-password" autofocus />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label rh-auth-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control rh-auth-input" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn rh-btn-primary w-100" data-pending-text="Resetting password">Reset password</button>
            </form>

            <p class="rh-auth-footnote mb-0">
                Need another link?
                <a asp-action="ForgotPassword" asp-route-email="@Model.Email">Request a new one</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
