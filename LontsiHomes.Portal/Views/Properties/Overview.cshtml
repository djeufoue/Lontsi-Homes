@model LontsiHomes.Portal.ViewModels.Properties.PropertyOverviewVm
@using Common.Enums
@using System
@using System.Globalization
@using System.Linq
@using LontsiHomes.Portal.Helpers
@{
    ViewData["Title"] = T["Property Overview"];

    var property = Model.Property;
    var totalPages = Model.UnitsPageSize <= 0 ? 1 : (int)Math.Ceiling((double)Model.TotalUnits / Model.UnitsPageSize);
    var nextUnitsPage = Model.UnitsPage + 1;
    var allUnits = property.Apartments?.ToList() ?? new List<Common.CommunicationModels.ApartmentDto>();
    var activeStatuses = new[] { "occupied", "rented", "active" };
    var occupiedUnits = allUnits.Count(unit => activeStatuses.Contains((unit.Status ?? string.Empty).Trim().ToLowerInvariant()));
    var availableUnits = Math.Max(0, Model.TotalUnits - occupiedUnits);
    var averageRent = allUnits.Any() ? allUnits.Average(unit => unit.Price) : 0m;
    var propertyImages = Model.Documents
        .Where(doc => doc.DocumentType == DocumentTypeEnum.PropertyImage)
        .OrderByDescending(doc => doc.UploadedAt)
        .ToList();
    var propertyImage = propertyImages.FirstOrDefault();
    var propertyImageUrl = propertyImage != null ? Url.Action("DocumentContent", "Properties", new { id = propertyImage.Id }) : null;
    var propertyDocuments = Model.Documents
        .Where(doc => doc.DocumentType != DocumentTypeEnum.PropertyImage)
        .OrderByDescending(doc => doc.UploadedAt)
        .ToList();
    var landlordName = string.IsNullOrWhiteSpace(property.LandlordName) ? T["Landlord"].Value : property.LandlordName;
    var landlordInitial = landlordName.Trim()[0].ToString().ToUpperInvariant();
    var members = Model.FilteredManagers ?? new List<Common.CommunicationModels.PropertyManagerDto>();
    var canOpenUserOverview = User.IsInRole("Admin") || User.IsInRole("Landlord") || User.IsInRole("Manager");
    var selectedCountryIsoCode = string.IsNullOrWhiteSpace(property.CountryIsoCode) ? string.Empty : property.CountryIsoCode.Trim().ToUpperInvariant();
    var countries = new[]
    {
        new { Iso = "CA", Code = "+1", Label = T["Canada"].Value + " (+1)" },
        new { Iso = "US", Code = "+1", Label = T["United States"].Value + " (+1)" },
        new { Iso = "CM", Code = "+237", Label = T["Cameroon"].Value + " (+237)" },
        new { Iso = "GB", Code = "+44", Label = T["United Kingdom"].Value + " (+44)" },
        new { Iso = "FR", Code = "+33", Label = T["France"].Value + " (+33)" },
        new { Iso = "BE", Code = "+32", Label = T["Belgium"].Value + " (+32)" },
        new { Iso = "DE", Code = "+49", Label = T["Germany"].Value + " (+49)" },
        new { Iso = "NG", Code = "+234", Label = T["Nigeria"].Value + " (+234)" },
        new { Iso = "CI", Code = "+225", Label = T["Cote d'Ivoire"].Value + " (+225)" },
        new { Iso = "GH", Code = "+233", Label = T["Ghana"].Value + " (+233)" },
        new { Iso = "ZA", Code = "+27", Label = T["South Africa"].Value + " (+27)" },
        new { Iso = "KE", Code = "+254", Label = T["Kenya"].Value + " (+254)" },
        new { Iso = "AE", Code = "+971", Label = T["United Arab Emirates"].Value + " (+971)" }
    };
    var selectedCountry = countries.FirstOrDefault(country => string.Equals(country.Iso, selectedCountryIsoCode, StringComparison.OrdinalIgnoreCase));
    var propertyCountryLabel = selectedCountry?.Label ?? (string.IsNullOrWhiteSpace(selectedCountryIsoCode) ? T["Country not set"].Value : selectedCountryIsoCode);
}

<section class="rh-overview-shell"
         data-property-overview-root="true"
         data-property-id="@property.Id"
         data-overview-content-url="@Url.Action("OverviewContent", "Properties", new { id = property.Id })"
         data-show-close-button="true"
         data-auto-close-enabled="@(Model.SuccessDialogAutoCloseEnabled.ToString().ToLowerInvariant())"
         data-auto-close-seconds="@Model.SuccessDialogAutoCloseSeconds"
         data-show-success-messages="@(Model.SuccessDialogShowSuccessMessages.ToString().ToLowerInvariant())"
         data-dialog-position="@Model.SuccessDialogPosition">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-action="Index">&#8592; @T["Back to properties"]</a>
            <p class="rh-kicker">@T["Property Command Center"]</p>
            <h1 class="rh-heading-title">@property.Name</h1>
            <p class="rh-heading-subtitle">@property.Address, @property.City@(!string.IsNullOrWhiteSpace(selectedCountryIsoCode) ? $", {selectedCountryIsoCode}" : string.Empty)</p>

            <div class="rh-overview-badges">
                <span class="rh-chip rh-chip-primary">@T["{0} apartments", Model.TotalUnits]</span>
                <span class="rh-chip rh-chip-info">@propertyCountryLabel</span>
                <span class="rh-chip rh-chip-info">@T["{0} documents", propertyDocuments.Count]</span>
                <span class="rh-chip @(Model.CanWrite ? "rh-chip-primary" : "rh-chip-warning")">@(Model.CanWrite ? T["Write access"] : T["Read access"])</span>
            </div>
        </div>

        <div class="rh-overview-hero-actions">
            @if (Model.CanWrite)
            {
                <a class="btn rh-btn-subtle" asp-action="Settings" asp-route-id="@property.Id">@T["Property Settings"]</a>
            }
            @if (property.MapEnabled)
            {
                <a class="btn rh-btn-subtle" asp-action="Map" asp-route-id="@property.Id">@T["Open Map"]</a>
            }
        </div>
    </section>

    <section class="rh-overview-mastgrid">
        <article class="rh-overview-spotlight rh-panel rh-panel-elevated">
            <div class="rh-overview-panel-head">
                <div>
                    <h2 class="rh-dashboard-panel-title">@T["Operations overview"]</h2>
                    <p class="rh-dashboard-panel-copy">@T["A refined workspace for apartments, members, location, and documents."]</p>
                </div>

                <div class="rh-dashboard-range-chip">@T["Updated today"]</div>
            </div>

            <div class="rh-overview-spotlight-grid">
                <div class="rh-overview-bigstat">
                    <span>@T["Occupied"]</span>
                    <strong>@occupiedUnits</strong>
                    <small>@T["Actively assigned apartments"]</small>
                </div>
                <div class="rh-overview-bigstat alt">
                    <span>@T["Average rent"]</span>
                    <strong>@averageRent.ToString("N0")</strong>
                    <small>@T["Snapshot across apartments"]</small>
                </div>
            </div>

            <div class="rh-overview-profile-strip">
                <div class="rh-overview-profile-pill">
                    <span class="rh-avatar">@landlordInitial</span>
                    <div>
                        <strong>@landlordName</strong>
                        <small>@T["Landlord"]</small>
                    </div>
                </div>
            </div>
        </article>

        <article class="rh-overview-sidebarcard rh-panel rh-panel-elevated">
            <div class="rh-overview-sidebarstat">
                <span>@T["Total apartments"]</span>
                <strong>@Model.TotalUnits</strong>
                <small>@T["Inventory inside this property"]</small>
            </div>
            <div class="rh-overview-sidebarstat">
                <span>@T["Available now"]</span>
                <strong>@availableUnits</strong>
                <small>@T["Ready for the next tenant"]</small>
            </div>
            <div class="rh-overview-sidebarstat">
                <span>@T["Members"]</span>
                <strong>@(Model.Managers.Count + 1)</strong>
                <small>@T["Landlord plus property team"]</small>
            </div>
        </article>
    </section>

    <section class="rh-overview-workgrid rh-overview-workgrid-rebalanced">
        <div class="rh-overview-maincolumn">
            <article class="rh-overview-image-card rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Property image"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Landscape cover for this property. Max 2 MB."]</p>
                    </div>

                    @if (Model.CanUploadDocuments)
                    {
                        <form id="propertyImageForm" method="post" asp-action="UploadPropertyDocument" enctype="multipart/form-data" class="rh-property-image-form" data-live-submit="property-overview">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="propertyId" value="@property.Id" />
                            <input type="hidden" name="type" value="@DocumentTypeEnum.PropertyImage" />
                            <input class="rh-hidden-input" id="propertyImageFile" type="file" name="file" accept="image/*" />
                            <button type="button" class="rh-icon-btn rh-image-edit-trigger" data-image-trigger="propertyImageFile" title="@T["Replace property image"]" aria-label="@T["Replace property image"]">
                                <span class="rh-icon-pencil"></span>
                            </button>
                            <p class="rh-inline-validation" id="propertyImageValidation" aria-live="polite"></p>
                        </form>
                    }
                </div>

                <div class="rh-property-image-frame">
                    @if (propertyImage != null && !string.IsNullOrWhiteSpace(propertyImageUrl))
                    {
                        <button type="button" class="rh-property-image-button" data-bs-toggle="modal" data-bs-target="#propertyImageLightbox" aria-label="@T["Open property image"]">
                            <img src="@propertyImageUrl" alt="@T["{0} property image", property.Name ?? T["Property"].Value]" class="rh-property-image" />
                        </button>
                    }
                    else
                    {
                        <div class="rh-property-image-placeholder">
                            <strong>@T["No property image yet"]</strong>
                            <span>@T["Upload a landscape image so this overview feels complete."]</span>
                        </div>
                    }
                </div>
            </article>

            @if (property.MapEnabled)
            {
            <article class="rh-overview-map-preview rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Property map"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Your saved latitude and longitude now pin the property on the map."]</p>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        @if (Model.CanWrite)
                        {
                            <form method="post" asp-action="RefreshMapLocation">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="propertyId" value="@property.Id" />
                                <button class="btn rh-btn-subtle btn-sm" type="submit">@T["Refresh from address"]</button>
                            </form>
                        }
                        <a class="btn rh-btn-subtle btn-sm" asp-action="Map" asp-route-id="@property.Id">@T["Open full map"]</a>
                    </div>
                </div>

                @{
                    var previewLatitude = property.Latitude ?? 4.048300;
                    var previewLongitude = property.Longitude ?? 9.704400;
                    var previewLatText = previewLatitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);
                    var previewLonText = previewLongitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);
                    var previewBbox = string.Format(
                        System.Globalization.CultureInfo.InvariantCulture,
                        "{0},{1},{2},{3}",
                        previewLongitude - 0.006,
                        previewLatitude - 0.006,
                        previewLongitude + 0.006,
                        previewLatitude + 0.006);
                    var previewMarker = string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0},{1}", previewLatitude, previewLongitude);
                    var previewEmbedUrl = $"https://www.openstreetmap.org/export/embed.html?bbox={Uri.EscapeDataString(previewBbox)}&layer=mapnik&marker={Uri.EscapeDataString(previewMarker)}";
                }

                <div class="rh-map-preview-stage rh-map-preview-stage-real">
                    <iframe
                        class="rh-map-iframe"
                        src="@previewEmbedUrl"
                        title="@T["{0} location preview", property.Name ?? T["Property"].Value]"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                    <div class="rh-map-preview-card">
                        <small>@property.City</small>
                        <strong>@property.Name</strong>
                        <span>@property.Address</span>
                        <em class="rh-map-preview-coordinates">@previewLatText, @previewLonText</em>
                    </div>
                </div>
            </article>
            }

            <article class="rh-overview-docs-card rh-panel rh-panel-elevated rh-overview-docs-compact">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Property documents"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Rules, guides, and reference files linked to this property."]</p>
                    </div>

                    @if (Model.CanUploadDocuments)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addPropertyDocumentModal">@T["Add+"]</button>
                    }
                </div>
                @if (!propertyDocuments.Any())
                {
                    <div class="rh-empty">@T["No property documents uploaded yet."]</div>
                }
                else
                {
                    <div class="rh-document-list rh-document-list-compact">
                        @foreach (var doc in propertyDocuments.Take(5))
                        {
                            <article class="rh-document-item rh-document-item-previewable rh-card-spotlight">
                                <div class="rh-document-item-copy">
                                    <a asp-action="DocumentPreview" asp-route-id="@doc.Id" class="rh-document-title-link">@doc.FileName</a>
                                    <small>@T[doc.DocumentType.ToString()] • @doc.UploadedAt.LocalDateTime.ToString("d", CultureInfo.CurrentCulture)</small>
                                </div>

                                <div class="rh-document-actions">
                                    <a class="btn btn-sm rh-btn-subtle" asp-action="DocumentPreview" asp-route-id="@doc.Id">@T["Preview"]</a>
                                    @if (Model.CanDeleteDocuments)
                                    {
                                        <form method="post" asp-action="DeleteDocument" class="d-inline" data-live-submit="property-overview" data-confirm-modal="true" data-confirm-title="@T["Delete document?"]" data-confirm-message="@T["This document will be removed from this property."]" data-confirm-proceed="@T["Delete document"]">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="propertyId" value="@property.Id" />
                                            <input type="hidden" name="documentId" value="@doc.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">@T["Delete"]</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </div>

        <div class="rh-overview-sidecolumn rh-overview-sidecolumn-priority">
            <article class="rh-overview-units-card rh-panel rh-panel-elevated" data-property-section="apartments">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Apartments"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Manage the apartments in this property."]</p>
                    </div>

                    <div class="rh-overview-inline-actions">
                        <div class="rh-overview-inline-stats">
                            <span>@T["{0} total", Model.TotalUnits]</span>
                            <span>@T["{0} available", availableUnits]</span>
                        </div>
                        @if (Model.CanAddApartment)
                        {
                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentModal">@T["Add+"]</button>
                        }
                    </div>
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="apartments">
                    <input type="hidden" name="id" value="@property.Id" />
                    <input type="hidden" name="memberSearch" value="@Model.MemberSearch" />
                    <input type="hidden" name="unitsPage" value="1" />
                    <input type="hidden" name="unitsPageSize" value="@Model.UnitsPageSize" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input js-auto-submit" type="text" name="apartmentSearch" value="@Model.ApartmentSearch" placeholder="@T["Search apartments by name, type, or status"]" autocomplete="off" />
                    </div>
                </form>

                @if (!Model.Units.Any())
                {
                    <div class="rh-empty">@T["No apartments found for this property."]</div>
                }
                else
                {
                    <div class="rh-unit-card-grid rh-unit-card-grid-compact">
                        @foreach (var unit in Model.Units)
                        {
                            <a class="rh-unit-card rh-unit-card-link rh-card-spotlight" asp-controller="Apartments" asp-action="Overview" asp-route-id="@unit.Id">
                                <div class="rh-unit-card-head">
                                    <div>
                                        <h3>@unit.Name</h3>
                                        <small>@T[ApartmentTypeDisplayHelper.ResourceKey(unit.Type.ToString())]</small>
                                    </div>
                                    <span class="rh-chip @(((unit.Status ?? string.Empty).Contains("available", StringComparison.OrdinalIgnoreCase)) ? "rh-chip-primary" : "rh-chip-info")">@T[unit.Status ?? string.Empty]</span>
                                </div>

                                <div class="rh-unit-card-meta">
                                    <span>@T["Area"] <strong>@unit.Area.ToString("N0", CultureInfo.CurrentCulture) @T["sqm"]</strong></span>
                                    <span>@T["Floor"] <strong>@(unit.FloorNumber == 0 ? T["Ground floor"] : T["Floor {0}", unit.FloorNumber])</strong></span>
                                    <span>@T["Rent"] <strong>@unit.Price.ToString("N0", CultureInfo.CurrentCulture)</strong></span>
                                </div>
                            </a>
                        }
                    </div>
                }

                <div class="rh-overview-footerline">
                    <small class="text-muted">@T["Page {0} / {1}", Model.UnitsPage, totalPages]</small>
                    @if (nextUnitsPage <= totalPages)
                    {
                        <a class="btn btn-sm rh-btn-subtle" asp-action="Overview" asp-route-id="@property.Id" asp-route-apartmentSearch="@Model.ApartmentSearch" asp-route-memberSearch="@Model.MemberSearch" asp-route-unitsPage="@nextUnitsPage" asp-route-unitsPageSize="@Model.UnitsPageSize">@T["See More"]</a>
                    }
                </div>
            </article>

            <article class="rh-overview-members-card rh-panel rh-panel-elevated" data-property-section="members">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Property members"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Landlord and managers assigned to this property."]</p>
                    </div>

                    @if (Model.CanManageManagers)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addMemberModal">@T["Add+"]</button>
                    }
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="members">
                    <input type="hidden" name="id" value="@property.Id" />
                    <input type="hidden" name="apartmentSearch" value="@Model.ApartmentSearch" />
                    <input type="hidden" name="unitsPage" value="@Model.UnitsPage" />
                    <input type="hidden" name="unitsPageSize" value="@Model.UnitsPageSize" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input js-auto-submit" type="text" name="memberSearch" value="@Model.MemberSearch" placeholder="@T["Search members by name or access"]" autocomplete="off" />
                    </div>
                </form>

                <div class="rh-member-stack">
                    <article class="rh-member-card rh-card-spotlight is-landlord">
                        <div class="rh-member-card-copy">
                            <strong>@landlordName</strong>
                            <small>@T["Landlord"]</small>
                            <small>@property.LandlordEmail</small>
                        </div>
                        <div class="rh-member-card-actions">
                            <span class="rh-chip rh-chip-primary">@T["ReadWrite"]</span>
                            @if (canOpenUserOverview && !string.IsNullOrWhiteSpace(property.LandlordId))
                            {
                                <a class="btn btn-sm rh-btn-subtle" asp-controller="AdminUsers" asp-action="Overview" asp-route-userId="@property.LandlordId">@T["User overview"]</a>
                            }
                            @if (Model.CanEditLandlordEmail)
                            {
                                <button type="button" class="btn btn-sm rh-btn-subtle" data-bs-toggle="modal" data-bs-target="#editMemberEmailModal" data-member-id="@property.LandlordId" data-member-name="@landlordName" data-member-email="@property.LandlordEmail">@T["Edit email"]</button>
                            }
                        </div>
                    </article>
                    @if (!members.Any())
                    {
                        <div class="rh-empty">@T["No additional members assigned yet."]</div>
                    }
                    else
                    {
                        @foreach (var manager in members.OrderByDescending(manager => manager.AssignedAt))
                        {
                            <article class="rh-member-card rh-card-spotlight">
                                <div class="rh-member-card-copy">
                                    <strong>@manager.ManagerName</strong>
                                    <small>@T["Manager"] • @manager.AssignedAt.LocalDateTime.ToString("d", CultureInfo.CurrentCulture)</small>
                                    <small>@manager.ManagerEmail</small>
                                </div>

                                @if (canOpenUserOverview)
                                {
                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="AdminUsers" asp-action="Overview" asp-route-userId="@manager.ManagerId">@T["User overview"]</a>
                                }

                                @if (Model.CanEditMemberEmails)
                                {
                                    <button type="button" class="btn btn-sm rh-btn-subtle" data-bs-toggle="modal" data-bs-target="#editMemberEmailModal" data-member-id="@manager.ManagerId" data-member-name="@manager.ManagerName" data-member-email="@manager.ManagerEmail">@T["Edit email"]</button>
                                }

                                @if (Model.CanManageManagers)
                                {
                                    <div class="rh-member-card-actions">
                                        <a class="btn btn-sm rh-btn-primary"
                                           asp-action="ManagerPermissions"
                                           asp-route-propertyId="@property.Id"
                                           asp-route-assignmentId="@manager.Id">@T["Permissions / Access"]</a>

                                        <form method="post" asp-action="RemoveManager" data-live-submit="property-overview" data-confirm-modal="true" data-confirm-title="@T["Remove property member?"]" data-confirm-message="@T["This member will lose access to this property."]" data-confirm-proceed="@T["Remove member"]">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="propertyId" value="@property.Id" />
                                            <input type="hidden" name="assignmentId" value="@manager.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">@T["Remove"]</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="rh-chip rh-chip-info">@T["Manager access"]</span>
                                }
                            </article>
                        }
                    }
                </div>
            </article>
        </div>
    </section>

</section>
@if (Model.CanAddApartment || Model.CanManageManagers || Model.CanUploadDocuments || Model.CanEditMemberEmails || Model.CanEditLandlordEmail)
{
    @if (Model.CanAddApartment)
    {
    <div class="modal fade" id="addApartmentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="CreateApartment" data-live-submit="property-overview" data-live-close-modal="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@property.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@T["Add Apartment"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">@T["Apartment name"]</label>
                            <input class="form-control rh-input" name="Name" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">@T["Type"]</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="Type">
                                    @foreach (var type in Enum.GetValues<ApartmentTypeEnum>())
                                    {
                                        <option value="@((int)type)">@T[ApartmentTypeDisplayHelper.ResourceKey(type)]</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">@T["Area (sqm)"]</label>
                            <input class="form-control rh-input" name="Area" type="number" min="0" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">@T["Monthly rent"]</label>
                            <input class="form-control rh-input" name="Price" type="text" inputmode="decimal" required data-localized-decimal />
                        </div>

                        <div class="col-12">
                            <label class="form-label">@T["Floor"]</label>
                            <input class="form-control rh-input" name="FloorNumber" type="number" min="0" value="0" required aria-describedby="newApartmentFloorHint" />
                            <div class="rh-field-meaning-hint" id="newApartmentFloorHint">
                                <span aria-hidden="true">&#9432;</span>
                                <strong>@T["0 means ground floor."]</strong>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-primary">@T["Add Apartment"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    }

    @if (Model.CanManageManagers)
    {
    <div class="modal fade" id="addMemberModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="AddMember" data-live-submit="property-overview" data-live-close-modal="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="propertyId" value="@property.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@T["Add Property Member"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>

                    <div class="modal-body row g-2">
                        <div class="col-12">
                            <label class="form-label">@T["Role"]</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="role">
                                    <option value="Manager">@T["Manager"]</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">@T["Email"]</label>
                            <input class="form-control rh-input" name="Email" type="email" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">@T["Full Name"]</label>
                            <input class="form-control rh-input" name="FullName" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">@T["Country Code"]</label>
                            <input class="form-control rh-input" name="CountryCode" inputmode="numeric" placeholder="@T["e.g. +237"]" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">@T["Phone Number"]</label>
                            <input class="form-control rh-input" name="PhoneNumber" inputmode="numeric" placeholder="@T["e.g. 600000001"]" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">@T["WhatsApp number (optional)"]</label>
                            <input class="form-control rh-input" name="WhatsAppPhoneNumber" inputmode="numeric" placeholder="@T["e.g. +237 600000001"]" />
                        </div>

                        <div class="col-12">
                            <small class="text-muted">@T["This number is only proposed. The manager must sign in, consent, and verify it before receiving WhatsApp notifications."]</small>
                        </div>

                        <div class="col-12">
                            <small class="text-muted">@T["New managers can edit apartments by default. The landlord can remove this permission from Permissions / Access."]</small>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-primary">@T["Add+"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    }

    @if (Model.CanEditMemberEmails || Model.CanEditLandlordEmail)
    {
    <div class="modal fade" id="editMemberEmailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="UpdateMemberEmail">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="propertyId" value="@property.Id" />
                    <input type="hidden" name="memberId" id="editMemberEmailUserId" />
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@T["Edit email address"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted" id="editMemberEmailName"></p>
                        <label class="form-label" for="editMemberEmailValue">@T["New email address"]</label>
                        <input class="form-control rh-input" id="editMemberEmailValue" name="email" type="email" maxlength="256" autocomplete="email" required />
                        <small class="text-muted">@T["This will sign the user out and require all account verifications again. No welcome message will be sent."]</small>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-primary">@T["Save email"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    }

    @if (Model.CanUploadDocuments)
    {
    <div class="modal fade" id="addPropertyDocumentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="UploadPropertyDocument" enctype="multipart/form-data" data-live-submit="property-overview" data-live-close-modal="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="propertyId" value="@property.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@T["Add Property Document"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">@T["Document file"]</label>
                            <input class="form-control rh-input" type="file" name="file" accept=".pdf,application/pdf" required />
                            <small class="text-muted">@T["Only PDF files are allowed in this section."]</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label">@T["Document type"]</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="type">
                                    @foreach (var type in Enum.GetValues<DocumentTypeEnum>().Where(type => type != DocumentTypeEnum.PropertyImage && type != DocumentTypeEnum.ApartmentImage))
                                    {
                                        <option value="@type">@T[type.ToString()]</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-primary">@T["Upload document"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
    (() => {
        const modal = document.getElementById("editMemberEmailModal");
        if (!modal || modal.dataset.bound === "true") return;
        modal.dataset.bound = "true";
        modal.addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            document.getElementById("editMemberEmailUserId").value = button?.dataset.memberId ?? "";
            document.getElementById("editMemberEmailValue").value = button?.dataset.memberEmail ?? "";
            document.getElementById("editMemberEmailName").textContent = button?.dataset.memberName ?? "";
        });
    })();
</script>

@if (propertyImage != null && !string.IsNullOrWhiteSpace(propertyImageUrl))
{
    <div class="modal fade" id="propertyImageLightbox" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content rh-image-lightbox-modal">
                <div class="modal-header border-0">
                    <h5 class="modal-title">@T["{0} image", property.Name ?? T["Property"].Value]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                </div>
                <div class="modal-body pt-0">
                    <div class="rh-image-lightbox-stage">
                        @if (propertyImages.Count > 1)
                        {
                            <button type="button" class="rh-gallery-nav rh-lightbox-nav prev" data-property-lightbox-nav="prev" aria-label="@T["Previous property image"]">&#8592;</button>
                            <button type="button" class="rh-gallery-nav rh-lightbox-nav next" data-property-lightbox-nav="next" aria-label="@T["Next property image"]">&#8594;</button>
                        }
                        <img src="@propertyImageUrl" alt="@T["{0} property image", property.Name ?? T["Property"].Value]" class="rh-image-lightbox-preview" id="propertyImageLightboxPreview" />
                    </div>
                    <div class="d-none" data-property-lightbox-items>
                        @foreach (var image in propertyImages)
                        {
                            <span data-property-lightbox-image
                                  data-image-url="@Url.Action("DocumentContent", "Properties", new { id = image.Id })"
                                  data-image-name="@image.FileName"></span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
}







