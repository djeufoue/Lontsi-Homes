@model LontsiHomes.Portal.ViewModels.Properties.ManagerPermissionsVm
@using Common.Enums
@{
    ViewData["Title"] = T["Manager Permissions"];
    var sections = new (string Name, (string Label, ManagerPermission Permission)[] Items)[]
    {
        ("Property Overview", new[]
        {
            ("View property", ManagerPermission.ViewProperty),
            ("View property overview", ManagerPermission.ViewPropertyOverview),
            ("Add property", ManagerPermission.AddProperty),
            ("Edit property", ManagerPermission.EditProperty),
            ("Delete property", ManagerPermission.DeleteProperty),
            ("View financial information", ManagerPermission.ViewPropertyFinancialInformation),
            ("Edit financial information", ManagerPermission.EditPropertyFinancialInformation),
            ("View dashboard", ManagerPermission.ViewDashboard)
        }),
        ("Members", new[]
        {
            ("View members", ManagerPermission.ViewMembers),
            ("Add member", ManagerPermission.AddMember),
            ("Edit member", ManagerPermission.EditMember),
            ("Remove member", ManagerPermission.RemoveMember),
            ("Manage member roles", ManagerPermission.ManageMemberRoles),
            ("View managers", ManagerPermission.ViewManagers)
        }),
        ("Apartments / Units", new[]
        {
            ("View apartments", ManagerPermission.ViewApartments),
            ("Add Apartment", ManagerPermission.AddApartment),
            ("Edit apartment", ManagerPermission.EditApartment),
            ("Delete apartment", ManagerPermission.DeleteApartment),
            ("View apartment details", ManagerPermission.ViewApartmentDetails),
            ("View apartment financial information", ManagerPermission.ViewApartmentFinancialInformation),
            ("Manage apartment members", ManagerPermission.ManageApartmentMembers),
            ("Manage apartment documents", ManagerPermission.ManageApartmentDocuments)
        }),
        ("Tenancies", new[]
        {
            ("View tenancies", ManagerPermission.ViewTenancies),
            ("Add tenancy", ManagerPermission.AddTenancy),
            ("Edit tenancy", ManagerPermission.EditTenancy),
            ("Delete tenancy", ManagerPermission.DeleteTenancy),
            ("Terminate tenancy", ManagerPermission.TerminateTenancy),
            ("Renew tenancy", ManagerPermission.RenewTenancy),
            ("View tenancy details", ManagerPermission.ViewTenancyDetails),
            ("View tenancy members", ManagerPermission.ViewTenancyMembers),
            ("Add tenancy member", ManagerPermission.AddTenancyMember),
            ("Edit tenancy member", ManagerPermission.EditTenancyMember),
            ("Remove tenancy member", ManagerPermission.RemoveTenancyMember),
            ("View lease documents", ManagerPermission.ViewLeaseDocuments),
            ("Upload lease documents", ManagerPermission.UploadLeaseDocuments),
            ("Delete lease documents", ManagerPermission.DeleteLeaseDocuments)
        }),
        ("Rent & Payments", new[]
        {
            ("View rent information", ManagerPermission.ViewRentInformation),
            ("View payment history", ManagerPermission.ViewRentPaymentHistory),
            ("Mark rent as paid", ManagerPermission.MarkRentAsPaid),
            ("Mark rent as unpaid", ManagerPermission.MarkRentAsUnpaid),
            ("Add manual payment", ManagerPermission.AddManualPayment),
            ("Edit payment", ManagerPermission.EditPayment),
            ("Delete or cancel payment", ManagerPermission.DeletePayment),
            ("View outstanding rent", ManagerPermission.ViewOutstandingRent),
            ("Send rent reminder", ManagerPermission.SendRentReminder),
            ("Manage rent reminder settings", ManagerPermission.ManageRentReminderSettings)
        }),
        ("Documents & Communication", new[]
        {
            ("View documents", ManagerPermission.ViewDocuments),
            ("Upload documents", ManagerPermission.UploadDocuments),
            ("Delete documents", ManagerPermission.DeleteDocuments),
            ("View messages", ManagerPermission.ViewMessages),
            ("Send messages", ManagerPermission.SendMessages)
        })
    };
    var readOnlyFlags = (long)ManagerPermissionDefaults.ReadOnly;
    var allFlags = (long)ManagerPermissionDefaults.All;
}

<section class="rh-page-shell rh-manager-permissions-page">
    <header class="rh-heading-card rh-panel rh-panel-elevated">
        <div>
            <a class="rh-back-link" asp-action="Overview" asp-route-id="@Model.PropertyId">← @T["Back to property overview"]</a>
            <span class="rh-kicker">@T["MANAGER ACCESS"]</span>
            <h1>@T["Manager Permissions"]</h1>
            <p>@Model.ManagerName · @Model.ManagerEmail<br />@Model.PropertyName</p>
        </div>
        <span class="rh-chip rh-chip-warning">@T["Landlord only"]</span>
    </header>

    <form method="post" asp-action="ManagerPermissions" class="rh-permissions-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PropertyId" />
        <input type="hidden" asp-for="AssignmentId" />
        <input type="hidden" asp-for="PropertyName" />
        <input type="hidden" asp-for="ManagerName" />
        <input type="hidden" asp-for="ManagerEmail" />

        <article class="rh-panel rh-panel-elevated rh-permission-intro">
            <div>
                <h2>@T["Default access"]</h2>
                <p>@T["New managers can edit apartment information by default. You can remove that permission here; managers can never manage other managers' access."]</p>
            </div>
            <div class="rh-permission-presets">
                <button type="button" class="btn rh-btn-subtle" data-permission-preset="readonly" data-readonly-flags="@readOnlyFlags">@T["Read Only"]</button>
                <button type="button" class="btn rh-btn-subtle" data-permission-preset="full" data-all-flags="@allFlags">@T["Full Access"]</button>
                <button type="button" class="btn rh-btn-subtle" data-permission-preset="none">@T["Clear"]</button>
            </div>
        </article>

        @foreach (var section in sections)
        {
            <article class="rh-panel rh-panel-elevated rh-permission-section" data-permission-section>
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2>@T[section.Name]</h2>
                        <p class="text-muted">@T["Choose the actions this Manager may perform."]</p>
                    </div>
                    <div class="rh-permission-presets">
                        <button type="button" class="btn btn-sm rh-btn-subtle" data-section-readonly>@T["Read Only"]</button>
                        <button type="button" class="btn btn-sm rh-btn-subtle" data-section-all>@T["Select All"]</button>
                        <button type="button" class="btn btn-sm rh-btn-subtle" data-section-none>@T["Clear"]</button>
                    </div>
                </div>
                <div class="rh-permission-grid">
                    @foreach (var item in section.Items)
                    {
                        var value = (long)item.Permission;
                        <label class="rh-permission-option">
                            <input type="checkbox" name="SelectedPermissions" value="@value" checked="@(Model.SelectedPermissions.Contains(value) ? "checked" : null)" data-readonly="@(((readOnlyFlags & value) != 0).ToString().ToLowerInvariant())" />
                            <span>@T[item.Label]</span>
                        </label>
                    }
                </div>
            </article>
        }

        <article class="rh-panel rh-panel-elevated rh-permission-section">
            <div class="rh-overview-panel-head align-start">
                <div>
                    <h2>@T["Apartment access and overrides"]</h2>
                    <p class="text-muted">@T["Tenancy access automatically follows the apartment scope. Each apartment can override the global permissions."]</p>
                </div>
                <label class="rh-switch-line">
                    <input type="checkbox" asp-for="AccessAllApartments" value="true" />
                    <input type="hidden" name="AccessAllApartments" value="false" />
                    <span>@T["Access to all Apartments / Units"]</span>
                </label>
            </div>

            <div class="rh-apartment-permission-list">
                @for (var index = 0; index < Model.Apartments.Count; index++)
                {
                    <details class="rh-apartment-permission-card">
                        <summary>
                            <strong>@Model.Apartments[index].ApartmentName</strong>
                            <span>@T["Configure exception"]</span>
                        </summary>
                        <input type="hidden" asp-for="Apartments[index].ApartmentId" />
                        <input type="hidden" asp-for="Apartments[index].ApartmentName" />
                        <label class="rh-switch-line">
                            <input type="checkbox" name="Apartments[@index].HasAccess" value="true" checked="@(Model.Apartments[index].HasAccess ? "checked" : null)" />
                            <input type="hidden" name="Apartments[@index].HasAccess" value="false" />
                            <span>@T["Can access this apartment"]</span>
                        </label>
                        <div class="rh-permission-grid rh-permission-grid-compact">
                            @foreach (var section in sections.Where(section => section.Name is "Apartments / Units" or "Tenancies" or "Rent & Payments" or "Documents & Communication"))
                            {
                                @foreach (var item in section.Items)
                                {
                                    var value = (long)item.Permission;
                                    <label class="rh-permission-option">
                                        <input type="checkbox" name="Apartments[@index].SelectedPermissions" value="@value" checked="@(Model.Apartments[index].SelectedPermissions.Contains(value) ? "checked" : null)" data-readonly="@(((readOnlyFlags & value) != 0).ToString().ToLowerInvariant())" />
                                        <span>@T[item.Label]</span>
                                    </label>
                                }
                            }
                        </div>
                    </details>
                }
            </div>
        </article>

        <div class="rh-form-actions sticky-actions">
            <a class="btn rh-btn-subtle" asp-action="Overview" asp-route-id="@Model.PropertyId">@T["Cancel"]</a>
            <button class="btn rh-btn-primary" type="submit">@T["Save permissions"]</button>
        </div>
    </form>
</section>

<style>
    .rh-permissions-form { display: grid; gap: 1rem; }
    .rh-permission-intro, .rh-overview-panel-head { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
    .rh-permission-presets { display: flex; flex-wrap: wrap; gap: .5rem; }
    .rh-permission-section { padding: 1.25rem; }
    .rh-permission-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: .65rem; }
    .rh-permission-option, .rh-switch-line { display: flex; gap: .65rem; align-items: center; padding: .75rem; border: 1px solid var(--rh-border); border-radius: .75rem; cursor: pointer; }
    .rh-permission-option input, .rh-switch-line input[type=checkbox] { width: 1.1rem; height: 1.1rem; accent-color: var(--rh-accent); }
    .rh-apartment-permission-list { display: grid; gap: .75rem; margin-top: 1rem; }
    .rh-apartment-permission-card { border: 1px solid var(--rh-border); border-radius: .8rem; padding: 1rem; }
    .rh-apartment-permission-card summary { display: flex; justify-content: space-between; cursor: pointer; }
    .rh-apartment-permission-card[open] summary { margin-bottom: 1rem; }
    .rh-permission-grid-compact { margin-top: .75rem; }
    .sticky-actions { position: sticky; bottom: 0; background: var(--rh-shell-bg); padding: 1rem; z-index: 5; }
    @@media (max-width: 720px) { .rh-permission-intro, .rh-overview-panel-head { align-items: stretch; flex-direction: column; } }
</style>

<script>
    (() => {
        const setChecks = (root, predicate) => root.querySelectorAll('input[type="checkbox"][name$="SelectedPermissions"], input[type="checkbox"][name="SelectedPermissions"]')
            .forEach(input => input.checked = predicate(input));
        document.querySelector('[data-permission-preset="readonly"]')?.addEventListener('click', () =>
            setChecks(document, input => input.dataset.readonly === 'true'));
        document.querySelector('[data-permission-preset="full"]')?.addEventListener('click', () => setChecks(document, () => true));
        document.querySelector('[data-permission-preset="none"]')?.addEventListener('click', () => setChecks(document, () => false));
        document.querySelectorAll('[data-permission-section]').forEach(section => {
            section.querySelector('[data-section-readonly]')?.addEventListener('click', () => setChecks(section, input => input.dataset.readonly === 'true'));
            section.querySelector('[data-section-all]')?.addEventListener('click', () => setChecks(section, () => true));
            section.querySelector('[data-section-none]')?.addEventListener('click', () => setChecks(section, () => false));
        });
    })();
</script>
