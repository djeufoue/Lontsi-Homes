@model LontsiHomes.Portal.ViewModels.Properties.PropertyOverviewVm
@using System
@{
    ViewData["Title"] = "Property Settings";

    var property = Model.Property;
    var selectedCountryIsoCode = string.IsNullOrWhiteSpace(property.CountryIsoCode) ? string.Empty : property.CountryIsoCode.Trim().ToUpperInvariant();
    var selectedCountryCode = string.IsNullOrWhiteSpace(property.CountryCode) ? string.Empty : property.CountryCode.Trim();
    var countries = new[]
    {
        new { Iso = "CA", Code = "+1", Label = "Canada (+1)" },
        new { Iso = "US", Code = "+1", Label = "United States (+1)" },
        new { Iso = "CM", Code = "+237", Label = "Cameroon (+237)" },
        new { Iso = "GB", Code = "+44", Label = "United Kingdom (+44)" },
        new { Iso = "FR", Code = "+33", Label = "France (+33)" },
        new { Iso = "BE", Code = "+32", Label = "Belgium (+32)" },
        new { Iso = "DE", Code = "+49", Label = "Germany (+49)" },
        new { Iso = "NG", Code = "+234", Label = "Nigeria (+234)" },
        new { Iso = "CI", Code = "+225", Label = "Cote d'Ivoire (+225)" },
        new { Iso = "GH", Code = "+233", Label = "Ghana (+233)" },
        new { Iso = "ZA", Code = "+27", Label = "South Africa (+27)" },
        new { Iso = "KE", Code = "+254", Label = "Kenya (+254)" },
        new { Iso = "AE", Code = "+971", Label = "United Arab Emirates (+971)" }
    };
    var dialogPositions = new[]
    {
        new { Value = "top-start", Label = T["Top left"].Value },
        new { Value = "top-center", Label = T["Top center"].Value },
        new { Value = "top-end", Label = T["Top right"].Value },
        new { Value = "center-start", Label = T["Center left"].Value },
        new { Value = "center", Label = T["Center"].Value },
        new { Value = "center-end", Label = T["Center right"].Value },
        new { Value = "bottom-start", Label = T["Bottom left"].Value },
        new { Value = "bottom-center", Label = T["Bottom center"].Value },
        new { Value = "bottom-end", Label = T["Bottom right"].Value }
    };
}

<section class="rh-overview-shell rh-property-settings-page"
         data-property-settings-root="true"
         data-property-id="@property.Id"
         data-show-close-button="true"
         data-auto-close-enabled="@(Model.SuccessDialogAutoCloseEnabled.ToString().ToLowerInvariant())"
         data-auto-close-seconds="@Model.SuccessDialogAutoCloseSeconds"
         data-show-success-messages="@(Model.SuccessDialogShowSuccessMessages.ToString().ToLowerInvariant())"
         data-dialog-position="@Model.SuccessDialogPosition">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-action="Overview" asp-route-id="@property.Id">&#8592; Back to property overview</a>
            <p class="rh-kicker">Property Configuration</p>
            <h1 class="rh-heading-title">Property Settings</h1>
            <p class="rh-heading-subtitle">Manage settings that apply specifically to @property.Name.</p>
            <div class="rh-overview-badges">
                <span class="rh-chip rh-chip-primary">@property.Name</span>
                <span class="rh-chip @(Model.CanWrite ? "rh-chip-primary" : "rh-chip-warning")">@(Model.CanWrite ? "Write access" : "Read access")</span>
            </div>
        </div>

        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-primary" asp-action="Overview" asp-route-id="@property.Id">Property Overview</a>
        </div>
    </section>

    <section class="rh-overview-bottomgrid rh-property-settings-grid">
        <article class="rh-overview-settings-card rh-panel rh-panel-elevated">
            <div class="rh-overview-panel-head compact">
                <div>
                    <h2 class="rh-dashboard-panel-title">Property information</h2>
                    <p class="rh-dashboard-panel-copy">Keep the core information current and accurate.</p>
                </div>
                @if (Model.CanWrite)
                {
                    <button type="button" class="rh-icon-btn" id="propertySettingsEditToggle" title="Edit property settings" aria-label="Edit property settings">
                        <span class="rh-icon-pencil"></span>
                    </button>
                }
            </div>

            <form method="post" asp-action="UpdateSettings" class="row g-3 rh-inline-editor-form" id="propertySettingsForm" data-inline-editor="locked">
                @Html.AntiForgeryToken()
                <input type="hidden" name="propertyId" value="@property.Id" />

                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <input class="form-control rh-input" name="Name" value="@property.Name" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-md-6">
                    <label class="form-label">City</label>
                    <input class="form-control rh-input" name="City" value="@property.City" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Country</label>
                    <input type="hidden" name="CountryCode" value="@selectedCountryCode" data-country-code-output />
                    <div class="rh-select-wrap">
                        <select class="form-select rh-input rh-select" name="CountryIsoCode" autocomplete="country" required data-country-selector @(Model.CanWrite ? null : "disabled")>
                            <option value="">Choose a country</option>
                            @foreach (var country in countries)
                            {
                                <option value="@country.Iso" data-country-code="@country.Code" selected="@(string.Equals(country.Iso, selectedCountryIsoCode, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@country.Label</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Latitude</label>
                    <input class="form-control rh-input" name="Latitude" type="number" step="0.000001" min="-90" max="90" value="@(property.Latitude?.ToString("F6") ?? string.Empty)" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Longitude</label>
                    <input class="form-control rh-input" name="Longitude" type="number" step="0.000001" min="-180" max="180" value="@(property.Longitude?.ToString("F6") ?? string.Empty)" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-12">
                    <label class="form-label">Address</label>
                    <input class="form-control rh-input" name="Address" value="@property.Address" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea class="form-control rh-input" name="Description" rows="5" @(Model.CanWrite ? "readonly" : "disabled")>@property.Description</textarea>
                </div>

                @if (Model.CanWrite)
                {
                    <div class="col-12 rh-inline-editor-actions" hidden>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button class="btn rh-btn-subtle" type="button" id="propertySettingsCancel">Cancel</button>
                            <button class="btn rh-btn-primary" type="submit">Save Settings</button>
                        </div>
                    </div>
                }
            </form>
        </article>

        @if (Model.CanManageMapVisibility)
        {
            <article class="rh-overview-settings-card rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head compact">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Map settings"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Control whether the property map is available throughout the workspace."]</p>
                    </div>
                </div>

                <form method="post" asp-action="UpdateMapSettings" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="propertyId" value="@property.Id" />

                    <div class="col-12">
                        <div class="rh-form-switch-row">
                            <div class="form-check form-switch rh-form-switch">
                                <input class="form-check-input" type="checkbox" id="mapEnabled" name="mapEnabled" value="true" @(property.MapEnabled ? "checked" : null) />
                                <label class="form-check-label" for="mapEnabled">@T["Enable property map"]</label>
                            </div>
                        </div>
                        <small class="text-muted">@T["When disabled, the map button, preview section, and full map page are hidden for every user."]</small>
                    </div>

                    <div class="col-12 d-grid">
                        <button class="btn rh-btn-primary" type="submit">@T["Save Map Settings"]</button>
                    </div>
                </form>
            </article>
        }

        <article class="rh-overview-settings-card rh-panel rh-panel-elevated">
            <div class="rh-overview-panel-head compact">
                <div>
                    <h2 class="rh-dashboard-panel-title">@T["Dialog settings"]</h2>
                    <p class="rh-dashboard-panel-copy">@T["Control the visibility, timing, and position of feedback dialogs for this property."]</p>
                </div>
            </div>

            <form method="post" asp-action="UpdateSuccessDialogSettings" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="propertyId" value="@property.Id" />

                <div class="col-12">
                    <div class="rh-form-switch-row">
                        <div class="form-check form-switch rh-form-switch">
                            <input class="form-check-input" type="checkbox" id="showSuccessMessages" name="showSuccessMessages" value="true" @(Model.SuccessDialogShowSuccessMessages ? "checked" : null) />
                            <label class="form-check-label" for="showSuccessMessages">@T["Show success messages"]</label>
                        </div>
                    </div>
                    <small class="text-muted">@T["When disabled, successful actions continue normally without displaying a confirmation dialog. Error messages remain visible."]</small>
                </div>

                <div class="col-12">
                    <label class="form-label" for="dialogPosition">@T["Dialog position"]</label>
                    <div class="rh-select-wrap">
                        <select class="form-select rh-input rh-select" id="dialogPosition" name="dialogPosition">
                            @foreach (var position in dialogPositions)
                            {
                                <option value="@position.Value" selected="@(string.Equals(Model.SuccessDialogPosition, position.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@position.Label</option>
                            }
                        </select>
                    </div>
                    <small class="text-muted">@T["Bottom center is the default position."]</small>
                </div>

                <div class="col-12">
                    <div class="rh-form-switch-row">
                        <div class="form-check form-switch rh-form-switch">
                            <input class="form-check-input" type="checkbox" id="autoCloseEnabled" name="autoCloseEnabled" value="true" @(Model.SuccessDialogAutoCloseEnabled ? "checked" : null) />
                            <label class="form-check-label" for="autoCloseEnabled">@T["Auto-hide success and error dialogs"]</label>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">@T["Auto close after (seconds)"]</label>
                    <input class="form-control rh-input" type="number" min="2" max="30" name="autoCloseSeconds" id="autoCloseSeconds" value="@Model.SuccessDialogAutoCloseSeconds" @(Model.SuccessDialogAutoCloseEnabled ? null : "readonly") />
                    <small class="text-muted">@T["Applies only to success and error dialogs, never to add/edit modal forms."]</small>
                </div>

                <div class="col-12 d-grid">
                    <button class="btn rh-btn-primary" type="submit">@T["Save Dialog Preferences"]</button>
                </div>
            </form>
        </article>
    </section>
</section>
