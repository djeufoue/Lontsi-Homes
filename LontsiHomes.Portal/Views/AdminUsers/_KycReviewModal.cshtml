@{
    var approveUrl = Url.Action("ApproveKyc", "AdminUsers") ?? string.Empty;
    var rejectUrl = Url.Action("RejectKyc", "AdminUsers") ?? string.Empty;
}

<div class="modal fade" id="kycReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" class="modal-content rh-modal-content rh-kyc-review-modal" data-kyc-review-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" data-kyc-review-user-id />
            <input type="hidden" name="search" data-kyc-review-search />
            <input type="hidden" name="returnTo" data-kyc-review-return-to />

            <div class="modal-header border-0">
                <div>
                    <p class="rh-kicker mb-1">KYC Review</p>
                    <h5 class="modal-title">Confirm landlord identity decision</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-0">
                <div class="rh-review-warning mb-3">
                    <strong>Review carefully before confirming.</strong>
                    This decision controls whether the landlord can unlock subscription payments and property creation.
                </div>

                <p class="rh-card-meta mb-3">
                    Selected landlord: <strong data-kyc-review-subject>this landlord</strong>
                </p>

                <div class="rh-review-choice-list" role="radiogroup" aria-label="KYC review decision">
                    <label class="rh-review-choice">
                        <input type="radio"
                               name="kycDecision"
                               value="approve"
                               data-kyc-review-decision
                               data-action-url="@approveUrl" />
                        <span>
                            <strong>Approve KYC</strong>
                            <small>The landlord can proceed to subscription payment after the contract is complete.</small>
                        </span>
                    </label>

                    <label class="rh-review-choice">
                        <input type="radio"
                               name="kycDecision"
                               value="reject"
                               data-kyc-review-decision
                               data-action-url="@rejectUrl" />
                        <span>
                            <strong>Reject KYC</strong>
                            <small>The landlord must submit corrected identity files before continuing.</small>
                        </span>
                    </label>
                </div>

                <div class="mt-3 d-none" data-kyc-review-note-wrap>
                    <label class="form-label rh-auth-label" for="kycReviewNote">Reason message</label>
                    <textarea id="kycReviewNote"
                              class="form-control rh-input"
                              name="note"
                              rows="3"
                              maxlength="500"
                              placeholder="Example: Document photo is blurred or does not match the submitted face photo."
                              data-kyc-review-note
                              disabled></textarea>
                    <div class="form-text">This reason is emailed to the landlord.</div>
                </div>

                <div class="mt-3 d-none" data-kyc-rejected-files-wrap>
                    <p class="rh-card-meta mb-2">Select which file(s) must be uploaded again.</p>
                    <label class="rh-review-file-choice">
                        <input type="checkbox" name="rejectAllFiles" value="true" data-kyc-reject-all disabled />
                        <span>Reject all submitted files</span>
                    </label>
                    <div class="rh-review-file-grid mt-2">
                        <label class="rh-review-file-choice">
                            <input type="checkbox" name="rejectFaceFront" value="true" data-kyc-reject-file disabled />
                            <span>Front selfie</span>
                        </label>
                        <label class="rh-review-file-choice">
                            <input type="checkbox" name="rejectFaceRight" value="true" data-kyc-reject-file disabled />
                            <span>Right selfie</span>
                        </label>
                        <label class="rh-review-file-choice">
                            <input type="checkbox" name="rejectFaceLeft" value="true" data-kyc-reject-file disabled />
                            <span>Left selfie</span>
                        </label>
                        <label class="rh-review-file-choice">
                            <input type="checkbox" name="rejectDocumentFront" value="true" data-kyc-reject-file disabled />
                            <span>Document front</span>
                        </label>
                        <label class="rh-review-file-choice" data-kyc-review-document-back-choice>
                            <input type="checkbox" name="rejectDocumentBack" value="true" data-kyc-reject-file data-kyc-review-document-back disabled />
                            <span>Document back</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn rh-btn-primary" disabled data-kyc-review-confirm>
                    <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true" data-kyc-review-spinner></span>
                    <span data-kyc-review-confirm-label>Confirm decision</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    (() => {
        if (window.__lontsiHomesKycReviewModalInitialized) {
            return;
        }

        window.__lontsiHomesKycReviewModalInitialized = true;

        const modalEl = document.getElementById("kycReviewModal");
        const form = modalEl?.querySelector("[data-kyc-review-form]");
        const modal = modalEl ? new bootstrap.Modal(modalEl) : null;
        const confirmButton = form?.querySelector("[data-kyc-review-confirm]");
        const confirmLabel = form?.querySelector("[data-kyc-review-confirm-label]");
        const spinner = form?.querySelector("[data-kyc-review-spinner]");
        const noteWrap = form?.querySelector("[data-kyc-review-note-wrap]");
        const note = form?.querySelector("[data-kyc-review-note]");
        const rejectedFilesWrap = form?.querySelector("[data-kyc-rejected-files-wrap]");
        const rejectAll = form?.querySelector("[data-kyc-reject-all]");
        const rejectedFileChecks = Array.from(form?.querySelectorAll("[data-kyc-reject-file]") || []);
        const documentBackChoice = form?.querySelector("[data-kyc-review-document-back-choice]");
        const documentBackCheck = form?.querySelector("[data-kyc-review-document-back]");
        const subject = form?.querySelector("[data-kyc-review-subject]");
        const userIdInput = form?.querySelector("[data-kyc-review-user-id]");
        const searchInput = form?.querySelector("[data-kyc-review-search]");
        const returnToInput = form?.querySelector("[data-kyc-review-return-to]");
        const decisions = Array.from(form?.querySelectorAll("[data-kyc-review-decision]") || []);
        let documentBackRequired = true;

        const selectedDecision = () => decisions.find(input => input.checked);
        const hasRejectedFileSelection = () => {
            return rejectAll?.checked || rejectedFileChecks.some(input => !input.closest("[hidden]") && input.checked);
        };

        const syncDecision = () => {
            const selected = selectedDecision();
            const isReject = selected?.value === "reject";

            if (noteWrap && note) {
                noteWrap.classList.toggle("d-none", !isReject);
                note.disabled = !isReject;
                if (!isReject) {
                    note.value = "";
                }
            }

            if (rejectedFilesWrap) {
                rejectedFilesWrap.classList.toggle("d-none", !isReject);
            }
            if (rejectAll) {
                rejectAll.disabled = !isReject;
            }
            rejectedFileChecks.forEach(input => {
                input.disabled = !isReject || rejectAll?.checked === true;
            });
            if (documentBackChoice && documentBackCheck) {
                documentBackChoice.hidden = !documentBackRequired;
                if (!documentBackRequired) {
                    documentBackCheck.checked = false;
                }
            }

            if (confirmButton && confirmLabel) {
                const rejectReady = !isReject ||
                    ((note?.value || "").trim().length > 0 && hasRejectedFileSelection());
                confirmButton.disabled = !selected || !rejectReady;
                confirmButton.classList.toggle("rh-btn-outline-danger", isReject);
                confirmButton.classList.toggle("rh-btn-primary", !isReject);
                confirmLabel.textContent = selected
                    ? (isReject ? "Confirm rejection" : "Confirm approval")
                    : "Confirm decision";
            }
        };

        const resetForm = () => {
            form?.removeAttribute("action");
            form?.removeAttribute("data-pending-review");
            decisions.forEach(input => {
                input.checked = false;
                input.disabled = false;
            });
            if (note) {
                note.value = "";
                note.disabled = true;
            }
            if (rejectAll) {
                rejectAll.checked = false;
                rejectAll.disabled = true;
            }
            rejectedFileChecks.forEach(input => {
                input.checked = false;
                input.disabled = true;
            });
            documentBackRequired = true;
            if (spinner) {
                spinner.classList.add("d-none");
            }
            if (confirmButton) {
                confirmButton.disabled = true;
            }
            syncDecision();
        };

        decisions.forEach(input => {
            input.addEventListener("change", syncDecision);
        });
        note?.addEventListener("input", syncDecision);
        rejectAll?.addEventListener("change", syncDecision);
        rejectedFileChecks.forEach(input => {
            input.addEventListener("change", syncDecision);
        });

        document.addEventListener("click", event => {
            const trigger = event.target.closest("[data-kyc-review-trigger]");
            if (!trigger || !form || !modal) {
                return;
            }

            resetForm();

            if (userIdInput) {
                userIdInput.value = trigger.dataset.userId || "";
            }
            if (searchInput) {
                searchInput.value = trigger.dataset.search || "";
            }
            if (returnToInput) {
                returnToInput.value = trigger.dataset.returnTo || "";
            }
            if (subject) {
                subject.textContent = trigger.dataset.userLabel || "this landlord";
            }
            documentBackRequired = trigger.dataset.documentBackRequired !== "false";

            const initialDecision = trigger.dataset.initialDecision;
            const selected = decisions.find(input => input.value === initialDecision);
            if (selected) {
                selected.checked = true;
            }

            syncDecision();
            modal.show();
        });

        form?.addEventListener("submit", event => {
            const selected = selectedDecision();
            if (!selected || form.dataset.pendingReview === "true") {
                event.preventDefault();
                return;
            }

            form.action = selected.dataset.actionUrl || "";
            form.dataset.pendingReview = "true";
            decisions.forEach(input => input.disabled = true);
            if (note && selected.value !== "reject") {
                note.disabled = true;
            }
            if (confirmButton && confirmLabel) {
                confirmButton.disabled = true;
                confirmLabel.textContent = selected.value === "reject" ? "Rejecting" : "Approving";
            }
            spinner?.classList.remove("d-none");
        });

        modalEl?.addEventListener("hidden.bs.modal", resetForm);
    })();
</script>
