@model Common.CommunicationModels.RentReceiptVerificationDto
@using Common.Enums
@using System.Globalization
@{
    Layout = null;

    var culture = CultureInfo.CurrentCulture;
    var accessAuthorized = ViewData["ReceiptAccessAuthorized"] as bool? ?? true;
    string DateLabel(DateTimeOffset? value) => value.HasValue
        ? value.Value.LocalDateTime.ToString("dd MMM yyyy", culture)
        : T["Unavailable"].Value;
    string PeriodLabel() => Model.PeriodStart.HasValue && Model.PeriodEnd.HasValue
        ? $"{Model.PeriodStart.Value.ToString("dd MMM yyyy", culture)} - {Model.PeriodEnd.Value.ToString("dd MMM yyyy", culture)}"
        : Model.PeriodLabel;
    string MethodLabel() => Model.Method switch
    {
        PaymentMethodEnum.Cash => T["Cash / off-platform"].Value,
        PaymentMethodEnum.Momo => "MTN Mobile Money",
        PaymentMethodEnum.OrangeMoney => "Orange Money",
        PaymentMethodEnum.Card => T["Card"].Value,
        _ => Model.PaymentMethod
    };
}
<!doctype html>
<html lang="@culture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T["Invoice verification"]</title>
    <partial name="_BrandHead" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <style>
        :root {
            color-scheme: dark;
            --ink: #f4f1ed;
            --muted: #aaa5a0;
            --line: rgba(255, 255, 255, .09);
            --bg: radial-gradient(circle at 20% 0%, rgba(124, 95, 111, .14), transparent 34%), #181719;
            --surface: #302f33;
            --shadow: rgba(0, 0, 0, .32);
            --status-bg: @(Model.IsValid ? "rgba(167, 201, 155, .14)" : "rgba(239, 140, 150, .14)");
            --status-ink: @(Model.IsValid ? "#c4ddb9" : "#f1a0a8");
        }

        :root[data-bs-theme="light"] {
            color-scheme: light;
            --ink: #29272a;
            --muted: #6f6965;
            --line: rgba(41, 39, 42, .12);
            --bg: #ebe8e2;
            --surface: #f8f5ef;
            --shadow: rgba(56, 48, 42, .13);
            --status-bg: @(Model.IsValid ? "#e4eee0" : "#f7e3e5");
            --status-ink: @(Model.IsValid ? "#42653a" : "#8f3944");
        }

        body {
            margin: 0;
            min-height: 100dvh;
            display: grid;
            place-items: center;
            background: var(--bg);
            color: var(--ink);
            font-family: "Segoe UI", sans-serif;
            padding: 24px;
        }

        main {
            width: min(720px, 100%);
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 26px;
            box-shadow: 0 18px 40px var(--shadow);
            padding: 32px;
        }

        .brand-logo {
            display: block;
            width: min(100%, 260px);
            margin: 0 auto 1.5rem;
        }

        .brand-logo img {
            display: block;
            width: 100%;
            height: auto;
        }

        .brand-logo .dark {
            display: none;
        }

        html[data-bs-theme="dark"] .brand-logo .light {
            display: none;
        }

        html[data-bs-theme="dark"] .brand-logo .dark {
            display: block;
        }

        .status {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 8px 12px;
            font-weight: 700;
            background: var(--status-bg);
            color: var(--status-ink);
        }

        h1 {
            margin: 18px 0 8px;
            font-size: clamp(2rem, 6vw, 3rem);
            letter-spacing: 0;
        }

        p {
            color: var(--muted);
            margin: 0 0 24px;
        }

        dl {
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: 12px 18px;
            margin: 0;
            border-top: 1px solid var(--line);
            padding-top: 24px;
        }

        dt {
            color: var(--muted);
            font-weight: 700;
        }

        dd {
            margin: 0;
            font-weight: 600;
        }

        @@media (max-width: 560px) {
            dl {
                grid-template-columns: 1fr;
                gap: 6px;
            }
        }
    </style>
</head>
<body>
    <main>
        <a class="brand-logo" asp-controller="Home" asp-action="Index" aria-label="Lontsi Homes home">
            <img class="light" src="~/assets/branding/logo-light.png" alt="Lontsi Homes" width="1600" height="339" />
            <img class="dark" src="~/assets/branding/logo-dark.png" alt="" width="1600" height="339" aria-hidden="true" />
        </a>
        @if (!accessAuthorized)
        {
            <span class="status">@T["Access denied"]</span>
            <h1>@T["Invoice access denied"]</h1>
            <p>@T["You are not authorized to view this invoice. Sign in with the tenant, landlord, or property manager account linked to it."]</p>
        }
        else if (Model.IsCorrected)
        {
            <span class="status">@T[Model.ReplacementPaymentId.HasValue ? "Cancelled and replaced invoice" : "Cancelled invoice"]</span>
            <h1>@Model.ReceiptNumber</h1>
            <p>@T["This receipt is kept for history only and is no longer proof of payment."]</p>
            <p>@T["Reason for correction"]: @Model.CorrectionReason</p>
            <p>@DateLabel(Model.CorrectedAt)</p>
            @if (Model.ReplacementPaymentId.HasValue)
            {
                <a asp-controller="Receipts" asp-action="Payment" asp-route-paymentId="@Model.ReplacementPaymentId">@T["Replacement invoice"]: @Model.ReplacementReceiptNumber</a>
            }
        }
        else if (Model.IsValid)
        {
            <span class="status">@T["Valid system invoice"]</span>
            <h1>@Model.ReceiptNumber</h1>
            <p>@T["This invoice was generated by Lontsi Homes and matches a successful rent payment."]</p>
            <dl>
                <dt>@T["Issued"]</dt>
                <dd>@DateLabel(Model.IssuedAt)</dd>
                <dt>@T["Payment date"]</dt>
                <dd>@DateLabel(Model.PaymentDate)</dd>
                <dt>@T["Amount"]</dt>
                <dd>@Model.Amount.ToString("N0", culture) @Model.Currency</dd>
                <dt>@T["Method"]</dt>
                <dd>@MethodLabel()</dd>
                <dt>@T["Tenant"]</dt>
                <dd>@Model.TenantName</dd>
                <dt>@T["Landlord"]</dt>
                <dd>@Model.LandlordName</dd>
                <dt>@T["Rental unit"]</dt>
                <dd>@Model.PropertyName - @Model.ApartmentName</dd>
                <dt>@T["Rent period"]</dt>
                <dd>@PeriodLabel()</dd>
            </dl>
            @if (Model.Lines.Any())
            {
                <h2 style="margin-top:24px;font-size:1rem;">@T["Receipt lines"]</h2>
                <div style="overflow-x:auto;">
                    <table style="width:100%;border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th style="padding:8px;text-align:left;">@T["Period"]</th>
                                <th style="padding:8px;text-align:right;">@T["Period amount"]</th>
                                <th style="padding:8px;text-align:right;">@T["Amount paid"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines.OrderBy(item => item.PeriodStart))
                            {
                                <tr>
                                    <td style="padding:8px;border-top:1px solid rgba(128,128,128,.25);">@DateLabel(line.PeriodStart) - @DateLabel(line.PeriodEnd)</td>
                                    <td style="padding:8px;border-top:1px solid rgba(128,128,128,.25);text-align:right;">@line.PeriodAmount.ToString("N0", culture) @Model.Currency</td>
                                    <td style="padding:8px;border-top:1px solid rgba(128,128,128,.25);text-align:right;"><strong>@line.PaidAmount.ToString("N0", culture) @Model.Currency</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <span class="status">@T["Invalid invoice"]</span>
            <h1>@T["Invoice not found"]</h1>
            <p>@T["The scanned code does not match a valid system-generated rent invoice."]</p>
        }
    </main>
</body>
</html>
