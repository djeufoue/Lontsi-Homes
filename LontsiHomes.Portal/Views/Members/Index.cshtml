@model Common.CommunicationModels.WorkspaceDirectoryResponseDto<Common.CommunicationModels.WorkspaceMemberDto>
@{
    ViewData["Title"] = T["Members"].Value;
}

<div class="rh-properties-page">
    <section class="rh-properties-hero">
        <div class="rh-properties-overview-head"><div><p class="rh-kicker rh-kicker-ghost">@T["Workspace directory"]</p><h1 class="rh-heading-title rh-properties-overview-title">@T["Members"]</h1><p class="rh-card-meta mb-0">@T["See people and access assignments across your portfolio."]</p></div></div>
        <div class="rh-properties-overview-grid">
            <article class="rh-properties-stat-card"><span>@T["Assignments"]</span><strong>@Model.ScopeTotalCount</strong><small>@T["Total accessible assignments"]</small></article>
            <article class="rh-properties-stat-card"><span>@T["Matching"]</span><strong>@Model.TotalCount</strong><small>@T["Results after filters"]</small></article>
            <article class="rh-properties-stat-card"><span>@T["Current page"]</span><strong>@Model.Page / @Model.TotalPages</strong><small>@T["{0} rows per page", Model.PageSize]</small></article>
        </div>
    </section>
    <section class="rh-properties-filter-shell">
        <div class="rh-properties-filter-head"><div><p class="rh-kicker rh-kicker-ghost mb-1">@T["Essential filters"]</p><h2 class="rh-section-title mb-0">@T["Find a member"]</h2></div><small>@T["Search by name, email, role, or assigned workspace."]</small></div>
        <form method="get" class="rh-properties-filter-grid rh-collapsible-filter">
            <div class="rh-properties-filter-field rh-properties-filter-field-wide"><label class="form-label mb-1">@T["Search"]</label><input class="form-control rh-input" name="search" value="@Model.Search" placeholder="@T["Name, email, role, property, or apartment"]" /></div>
            <div class="rh-properties-filter-field"><label class="form-label mb-1">@T["Property"]</label><select class="form-select rh-input rh-select" name="propertyId"><option value="">@T["All properties"]</option>@foreach (var option in Model.Properties) { <option value="@option.Id" selected="@(Model.PropertyId == option.Id ? "selected" : null)">@option.Label</option> }</select></div>
            <div class="rh-properties-filter-field"><label class="form-label mb-1">@T["Role"]</label><select class="form-select rh-input rh-select" name="role"><option value="">@T["All roles"]</option>@foreach (var option in Model.Roles) { <option value="@option" selected="@(Model.Role == option ? "selected" : null)">@T[option]</option> }</select></div>
            <input type="hidden" name="page" value="1" /><div class="rh-properties-filter-actions"><button class="btn rh-btn-primary" type="submit">@T["Apply filters"]</button><a asp-action="Index" class="btn rh-btn-subtle">@T["Clear"]</a></div>
        </form>
    </section>
    <section class="rh-properties-scope-shell">
        <div class="rh-properties-filter-head"><div><p class="rh-kicker rh-kicker-ghost mb-1">@T["Member register"]</p><h2 class="rh-section-title mb-0">@T["Accessible assignments"]</h2></div><small>@T["{0} results", Model.TotalCount]</small></div>
        @if (!Model.Items.Any()) { <div class="rh-empty">@T["No members match these filters."]</div> }
        else
        {
            <div class="table-responsive rh-responsive-table-wrap"><table class="table align-middle mb-0 rh-table rh-responsive-data-table"><thead><tr><th>@T["Member"]</th><th>@T["Role"]</th><th>@T["Level"]</th><th>@T["Property"]</th><th>@T["Assigned area"]</th><th>@T["Landlord"]</th><th>@T["Permission"]</th><th>@T["Status"]</th><th class="text-end">@T["Action"]</th></tr></thead><tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="rh-mobile-card-title" data-label="@T["Member"]"><strong>@item.FullName</strong><small class="d-block text-muted">@item.Email</small></td>
                    <td data-label="@T["Role"]">@T[item.Role]</td>
                    <td data-label="@T["Level"]">@T[item.Level]</td>
                    <td data-label="@T["Property"]"><a class="rh-table-property-link" asp-controller="Properties" asp-action="Overview" asp-route-id="@item.PropertyId">@item.PropertyName</a></td>
                    <td data-label="@T["Assigned area"]">@if (item.ApartmentId.HasValue) { <a class="rh-table-property-link" asp-controller="Apartments" asp-action="Overview" asp-route-id="@item.ApartmentId.Value">@item.ApartmentName</a> } else { <a class="rh-table-property-link" asp-controller="Properties" asp-action="Overview" asp-route-id="@item.PropertyId">@item.PropertyName</a> }</td>
                    <td data-label="@T["Landlord"]">@item.LandlordName</td>
                    <td data-label="@T["Permission"]"><span class="rh-chip rh-chip-info">@T[item.Permission]</span></td>
                    <td data-label="@T["Status"]">@T[item.Status]</td>
                    <td data-label="@T["Action"]" class="text-end"><a class="btn btn-sm rh-btn-subtle" asp-controller="AdminUsers" asp-action="Overview" asp-route-userId="@item.UserId">@T["User overview"]</a></td>
                </tr>
            }
            </tbody></table></div>
        }
        <div class="rh-table-footer"><a class="btn btn-sm rh-btn-subtle @(Model.Page <= 1 ? "disabled" : null)" asp-route-search="@Model.Search" asp-route-propertyId="@Model.PropertyId" asp-route-role="@Model.Role" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">@T["Previous"]</a><div class="rh-table-page-size"><label class="form-label mb-0" for="memberPageSize">@T["Rows"]</label><select id="memberPageSize" class="form-select rh-input rh-select" data-auto-page-size>@foreach (var size in new[] { 6, 12, 24 }) { <option value="@size" selected="@(Model.PageSize == size ? "selected" : null)">@size</option> }</select><small class="text-muted">@T["Page {0} of {1}", Model.Page, Model.TotalPages]</small></div><a class="btn btn-sm rh-btn-subtle rh-table-footer-next @(Model.Page >= Model.TotalPages ? "disabled" : null)" asp-route-search="@Model.Search" asp-route-propertyId="@Model.PropertyId" asp-route-role="@Model.Role" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">@T["Next"]</a></div>
    </section>
</div>
