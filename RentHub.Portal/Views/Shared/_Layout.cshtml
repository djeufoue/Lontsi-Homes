@using System
@using System.Linq
@using System.Globalization
@using System.Text.Json
@using RentHub.Portal.Helpers
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var suppressSuccessFeedback = string.Equals(currentController, "Conversations", StringComparison.OrdinalIgnoreCase);
    var rawSuccessMessage = TempData["Success"] as string;
    var rawInfoMessage = TempData["Info"] as string;
    var rawErrorMessage = TempData["Error"] as string;
    var successDialog = SuccessDialogHelper.GetActive(Context.Session);
    var successMessage = suppressSuccessFeedback || !successDialog.ShowSuccessMessages || string.IsNullOrWhiteSpace(rawSuccessMessage)
        ? null
        : T[rawSuccessMessage].Value;
    var infoMessage = string.IsNullOrWhiteSpace(rawInfoMessage) ? null : T[rawInfoMessage].Value;
    var errorMessage = string.IsNullOrWhiteSpace(rawErrorMessage) ? null : T[rawErrorMessage].Value;

    var isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
    var isMarketingPage = isHome;
    var isProperties = string.Equals(currentController, "Properties", StringComparison.OrdinalIgnoreCase);
    var isApartments = string.Equals(currentController, "Apartments", StringComparison.OrdinalIgnoreCase);
    var isTenancies = string.Equals(currentController, "Tenancies", StringComparison.OrdinalIgnoreCase);
    var isTenancyRequests = string.Equals(currentController, "TenancyRequests", StringComparison.OrdinalIgnoreCase);
    var isMembers = string.Equals(currentController, "Members", StringComparison.OrdinalIgnoreCase);
    var isMessages = string.Equals(currentController, "Conversations", StringComparison.OrdinalIgnoreCase);
    var isAdminSubscriptionsController = string.Equals(currentController, "AdminSubscriptions", StringComparison.OrdinalIgnoreCase);
    var isSubscriptionsAdmin = isAdminSubscriptionsController && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isAdminPaymentAccounts = isAdminSubscriptionsController && string.Equals(currentAction, "PaymentAccounts", StringComparison.OrdinalIgnoreCase);
    var isAdminPaymentActivity = isAdminSubscriptionsController && string.Equals(currentAction, "PaymentActivity", StringComparison.OrdinalIgnoreCase);
    var isUsersAdmin = string.Equals(currentController, "AdminUsers", StringComparison.OrdinalIgnoreCase);
    var isLandlordValidation = isUsersAdmin && string.Equals(currentAction, "Landlords", StringComparison.OrdinalIgnoreCase);
    var isKycApprovals = isUsersAdmin && string.Equals(currentAction, "LandlordApprovals", StringComparison.OrdinalIgnoreCase);
    var isProfile = string.Equals(currentController, "Profile", StringComparison.OrdinalIgnoreCase);
    var isProfileHome = isProfile && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isProfilePayments = isProfile && string.Equals(currentAction, "Payments", StringComparison.OrdinalIgnoreCase);

    var userPrincipal = User;
    var isAuthenticated = userPrincipal?.Identity?.IsAuthenticated == true;
    var isTenantWorkspace = userPrincipal?.IsInRole("Tenant") == true &&
                            userPrincipal?.IsInRole("Admin") != true &&
                            userPrincipal?.IsInRole("Landlord") != true;
    var canSeeProperties = userPrincipal?.IsInRole("Landlord") == true || userPrincipal?.IsInRole("Manager") == true || userPrincipal?.IsInRole("Admin") == true || userPrincipal?.IsInRole("Tenant") == true;
    var canSeeMembersDirectory = !isTenantWorkspace &&
                                 (userPrincipal?.IsInRole("Landlord") == true || userPrincipal?.IsInRole("Manager") == true || userPrincipal?.IsInRole("Admin") == true);
    var canSeeMessages = userPrincipal?.IsInRole("Tenant") == true ||
                         userPrincipal?.IsInRole("Visitor") == true ||
                         userPrincipal?.IsInRole("Landlord") == true ||
                         userPrincipal?.IsInRole("Manager") == true;
    var showSidebar = isAuthenticated && !isMarketingPage;
    var canSeeProfile = isAuthenticated && userPrincipal?.IsInRole("Visitor") != true;
    var hasSubscriptionExemption = string.Equals(
        userPrincipal?.FindFirst("subscription_exempt")?.Value,
        "true",
        StringComparison.OrdinalIgnoreCase);
    var canSeePaymentCenter = canSeeProfile
        && userPrincipal?.IsInRole("Landlord") == true
        && !hasSubscriptionExemption;

    var userName = User?.Identity?.Name;
    var userInitial = !string.IsNullOrWhiteSpace(userName) ? userName.Trim()[0].ToString().ToUpperInvariant() : "U";
    var userRoleName =
        userPrincipal?.IsInRole("Admin") == true ? T["Administrator"].Value :
        userPrincipal?.IsInRole("Landlord") == true ? T["Landlord"].Value :
        userPrincipal?.IsInRole("Tenant") == true ? T["Tenant"].Value :
        userPrincipal?.IsInRole("Manager") == true ? T["Manager"].Value :
        userPrincipal?.IsInRole("Visitor") == true ? T["Visitor"].Value :
        T["Account"].Value;
    var userRoleLabel =
        userPrincipal?.IsInRole("Admin") == true ? T["Administrator workspace"].Value :
        userPrincipal?.IsInRole("Landlord") == true ? T["Landlord workspace"].Value :
        userPrincipal?.IsInRole("Tenant") == true ? T["Tenant workspace"].Value :
        userPrincipal?.IsInRole("Manager") == true ? T["Manager workspace"].Value :
        userPrincipal?.IsInRole("Visitor") == true ? T["Visitor workspace"].Value :
        T["Workspace profile"].Value;
    var clientTranslations = new Dictionary<string, string>
    {
        ["Action completed"] = T["Action completed"].Value,
        ["Action Completed"] = T["Action Completed"].Value,
        ["Action Failed"] = T["Action Failed"].Value,
        ["Close"] = T["Close"].Value,
        ["Choose date"] = T["Choose date"].Value,
        ["Previous month"] = T["Previous month"].Value,
        ["Next month"] = T["Next month"].Value,
        ["Select date"] = T["Select date"].Value,
        ["Unable to refresh this section right now."] = T["Unable to refresh this section right now."].Value,
        ["Please choose an image file."] = T["Please choose an image file."].Value,
        ["Please choose a landscape image."] = T["Please choose a landscape image."].Value,
        ["This image could not be validated."] = T["This image could not be validated."].Value,
        ["Property image"] = T["Property image"].Value,
        ["Unable to refresh the property workspace right now."] = T["Unable to refresh the property workspace right now."].Value,
        ["Property workspace content was not returned."] = T["Property workspace content was not returned."].Value,
        ["Requested property section could not be refreshed."] = T["Requested property section could not be refreshed."].Value,
        ["Unable to refresh the apartment workspace right now."] = T["Unable to refresh the apartment workspace right now."].Value,
        ["Apartment workspace content was not returned."] = T["Apartment workspace content was not returned."].Value,
        ["Requested apartment section could not be refreshed."] = T["Requested apartment section could not be refreshed."].Value,
        ["Unable to complete this action right now."] = T["Unable to complete this action right now."].Value,
        ["Action completed successfully."] = T["Action completed successfully."].Value,
        ["Current apartment image"] = T["Current apartment image"].Value,
        ["Apartment image"] = T["Apartment image"].Value,
        ["Apartment image preview"] = T["Apartment image preview"].Value,
        ["Choose rent periods"] = T["Choose rent periods"].Value,
        ["Select the oldest period first. Each selected period unlocks the next one."] = T["Select the oldest period first. Each selected period unlocks the next one."].Value,
        ["selected period"] = T["selected period"].Value,
        ["Rent periods are selected in order. Unselecting one period clears every period after it."] = T["Rent periods are selected in order. Unselecting one period clears every period after it."].Value,
        ["Please confirm"] = T["Please confirm"].Value,
        ["Are you sure you want to continue?"] = T["Are you sure you want to continue?"].Value,
        ["Proceed"] = T["Proceed"].Value,
        ["Dark"] = T["Dark"].Value,
        ["Light"] = T["Light"].Value,
        ["Device"] = T["Device"].Value,
        ["Pay {0} period through {1}"] = T["Pay {0} period through {1}"].Value,
        ["Pay {0} periods through {1}"] = T["Pay {0} periods through {1}"].Value,
        ["{0} request(s) awaiting a decision"] = T["{0} request(s) awaiting a decision"].Value,
        ["Requests awaiting a decision"] = T["Requests awaiting a decision"].Value,
        ["New decision on your tenancy request"] = T["New decision on your tenancy request"].Value,
        ["{0} new request decision(s)"] = T["{0} new request decision(s)"].Value
    };
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" class="rh-app-document">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lontsi Homes</title>
    <partial name="_BrandHead" />

    <script>window.rhI18n = @Html.Raw(JsonSerializer.Serialize(clientTranslations));</script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RentHub.Portal.styles.css" asp-append-version="true" />
</head>
<body class="rh-body @(isMarketingPage ? "rh-body-public" : null)">
    <svg class="rh-icon-sprite" aria-hidden="true" focusable="false">
        <symbol id="rh-icon-properties" viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="1.5" /><path d="M8 7h2m4 0h2M8 11h2m4 0h2M8 15h2m4 0h2m-6 6v-3h4v3" /></symbol>
        <symbol id="rh-icon-apartments" viewBox="0 0 24 24"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 11h2m2 0h2M9 15h2m2 0h2m-4 6v-3h2v3" /></symbol>
        <symbol id="rh-icon-tenancies" viewBox="0 0 24 24"><path d="M5 3h10l4 4v14H5V3Zm9 0v5h5M8 12h8m-8 4h6" /></symbol>
        <symbol id="rh-icon-inbox" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></symbol>
        <symbol id="rh-icon-external" viewBox="0 0 24 24"><path d="M15 3h6v6m0-6L10 14m8-1v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></symbol>
        <symbol id="rh-icon-dashboard" viewBox="0 0 24 24"><path d="M4 5h16v14H4V5Zm3 3h4v3H7V8Zm6 0h4v8h-4V8Zm-6 5h4v3H7v-3Z" /></symbol>
        <symbol id="rh-icon-settings" viewBox="0 0 24 24"><path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm8 3.5-2.1-1.1.2-2.4-2.6-1.5-2 1.3L11.4 7 9 8.3 7 7 4.4 8.5l.2 2.4L2.5 12l2.1 1.1-.2 2.4L7 17l2-1.3 2.4 1.3 2.1-1.3 2 1.3 2.6-1.5-.2-2.4L20 12Z" /></symbol>
        <symbol id="rh-icon-wallet" viewBox="0 0 24 24"><path d="M4 6h14a2 2 0 0 1 2 2v10H4V6Zm0 0 11-2v2m1 5h4v4h-4a2 2 0 1 1 0-4Z" /></symbol>
        <symbol id="rh-icon-payment" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h4" /></symbol>
        <symbol id="rh-icon-profile" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" /></symbol>
        <symbol id="rh-icon-users" viewBox="0 0 24 24"><path d="M9 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm-6 8a6 6 0 0 1 12 0H3Zm13-9a3 3 0 1 0 0-6m0 8a5 5 0 0 1 5 5" /></symbol>
        <symbol id="rh-icon-shield" viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.8 8 7 10 4.2-2 7-5.4 7-10V6l-7-3Zm-3 9 2 2 4-4" /></symbol>
        <symbol id="rh-icon-logout" viewBox="0 0 24 24"><path d="M10 5H5v14h5m4-3 4-4-4-4m4 4H9" /></symbol>
        <symbol id="rh-icon-appearance" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></symbol>
        <symbol id="rh-icon-device" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" /></symbol>
        <symbol id="rh-icon-dark" viewBox="0 0 24 24"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z" /></symbol>
        <symbol id="rh-icon-light" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></symbol>
        <symbol id="rh-icon-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></symbol>
        <symbol id="rh-icon-arrow-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6m-6 6h10" /></symbol>
        <symbol id="rh-icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
    </svg>
    <div class="rh-shell @(showSidebar ? "has-sidebar" : "has-public-nav")">
        @if (showSidebar)
        {
            <aside class="rh-sidebar" id="rhSidebar">
                <div class="rh-sidebar-brand">
                    <a class="rh-sidebar-brand-link" asp-controller="Home" asp-action="Index">
                        <partial name="_BrandLogo" model="@("rh-brand-logo--sidebar")" />
                    </a>
                    <button type="button" class="rh-sidebar-close" id="rhSidebarClose" aria-label="@T["Close menu"]">
                        &times;
                    </button>
                </div>

                @if (canSeeProfile)
                {
                    <a class="rh-sidebar-user rh-sidebar-user-link" asp-controller="Profile" asp-action="Index">
                        <div class="rh-avatar">@userInitial</div>
                        <div>
                            <p class="rh-sidebar-user-name">@(userName ?? T["User"].Value)</p>
                            <p class="rh-sidebar-user-role">@userRoleLabel</p>
                        </div>
                    </a>
                }

                <div class="rh-sidebar-section">
                    <p class="rh-sidebar-section-label">@T["Workspace"]</p>
                    <nav class="rh-nav">
                        @if (canSeeProperties)
                        {
                            <a class="rh-nav-link @(isProperties ? "active" : null)" asp-controller="Properties" asp-action="Index" aria-current="@(isProperties ? "page" : null)">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-properties"></use></svg>
                                <span>@T["Properties"]</span>
                            </a>
                            <a class="rh-nav-link @(isApartments ? "active" : null)" asp-controller="Apartments" asp-action="Index" aria-current="@(isApartments ? "page" : null)">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-apartments"></use></svg>
                                <span>@T["Apartments"]</span>
                            </a>
                            <a class="rh-nav-link @(isTenancies ? "active" : null)" asp-controller="Tenancies" asp-action="Index" aria-current="@(isTenancies ? "page" : null)">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-tenancies"></use></svg>
                                <span>@T["Tenancies"]</span>
                            </a>
                            <a class="rh-nav-link @(isTenancyRequests ? "active" : null)" asp-controller="TenancyRequests" asp-action="Index" aria-current="@(isTenancyRequests ? "page" : null)">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-inbox"></use></svg>
                                <span>@T["Tenancy requests"]</span>
                                @await Component.InvokeAsync("TenancyRequestPendingCount")
                            </a>
                            @if (canSeeMembersDirectory)
                            {
                                <a class="rh-nav-link @(isMembers ? "active" : null)" asp-controller="Members" asp-action="Index" aria-current="@(isMembers ? "page" : null)">
                                    <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-users"></use></svg>
                                    <span>@T["Members"]</span>
                                </a>
                            }
                        }

                        @if (canSeeMessages)
                        {
                             <a class="rh-nav-link @(isMessages ? "active" : null)" asp-controller="Conversations" asp-action="Index" aria-current="@(isMessages ? "page" : null)">
                                 <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-inbox"></use></svg>
                                 <span>@T["Conversations"]</span>
                                 @await Component.InvokeAsync("ConversationUnreadCount")
                             </a>
                        }

                        <a class="rh-nav-link @(isHome ? "active" : null)" asp-controller="Home" asp-action="Index" aria-current="@(isHome ? "page" : null)">
                            <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-external"></use></svg>
                            <span>@T["Public Site"]</span>
                        </a>

                        @if (canSeePaymentCenter)
                        {
                            <a class="rh-nav-link @(isProfilePayments ? "active" : null)" asp-controller="Profile" asp-action="Payments">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-payment"></use></svg>
                                <span>@T["Payments"]</span>
                            </a>
                        }

                    </nav>
                </div>

                @if (userPrincipal?.IsInRole("Admin") == true)
                {
                    <div class="rh-sidebar-section">
                        <p class="rh-sidebar-section-label">@T["Administration"]</p>
                        <nav class="rh-nav">
                            <a class="rh-nav-link @(isMessages ? "active" : null)" asp-controller="Conversations" asp-action="Index" asp-route-kind="subscription">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-inbox"></use></svg>
                                <span>@T["Conversations"]</span>
                                @await Component.InvokeAsync("ConversationUnreadCount")
                            </a>
                            <a class="rh-nav-link @(isSubscriptionsAdmin ? "active" : null)" asp-controller="AdminSubscriptions" asp-action="Index">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-settings"></use></svg>
                                <span>@T["Subscriptions"]</span>
                            </a>
                            <a class="rh-nav-link @(isAdminPaymentAccounts ? "active" : null)" asp-controller="AdminSubscriptions" asp-action="PaymentAccounts">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-wallet"></use></svg>
                                <span>@T["Payment Accounts"]</span>
                            </a>
                            <a class="rh-nav-link @(isAdminPaymentActivity ? "active" : null)" asp-controller="AdminSubscriptions" asp-action="PaymentActivity">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-payment"></use></svg>
                                <span>@T["Payment Activity"]</span>
                            </a>
                            <a class="rh-nav-link @(isUsersAdmin && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-controller="AdminUsers" asp-action="Index">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-profile"></use></svg>
                                <span>@T["User Validation"]</span>
                            </a>
                            <a class="rh-nav-link @(isLandlordValidation ? "active" : null)" asp-controller="AdminUsers" asp-action="Landlords">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-users"></use></svg>
                                <span>@T["Landlord Validation"]</span>
                            </a>
                            <a class="rh-nav-link @(isKycApprovals ? "active" : null)" asp-controller="AdminUsers" asp-action="LandlordApprovals">
                                <svg class="rh-nav-icon" aria-hidden="true"><use href="#rh-icon-shield"></use></svg>
                                <span>@T["KYC Approvals"]</span>
                            </a>
                        </nav>
                    </div>
                }

            </aside>
        }

        @if (showSidebar)
        {
            <button type="button" class="rh-sidebar-scrim" id="rhSidebarScrim" aria-label="@T["Close menu"]"></button>
        }

        <div class="rh-main @(showSidebar ? null : "is-public")">
            <header class="rh-topbar @(isMarketingPage ? "is-public" : null)">
                <div class="rh-topbar-left">
                    @if (isMarketingPage)
                    {
                        <a class="rh-public-brand" asp-controller="Home" asp-action="Index" aria-label="Lontsi Homes home">
                            <partial name="_BrandLogo" model="@("rh-brand-logo--public rh-brand-logo--responsive")" />
                        </a>
                    }
                    else
                    {
                        @if (showSidebar)
                        {
                            <button type="button" class="btn rh-btn-subtle rh-sidebar-toggle" id="rhSidebarToggle" aria-controls="rhSidebar" aria-expanded="false">
                                @T["Menu"]
                            </button>
                        }
                        <div class="rh-topbar-context">
                            <p class="rh-topbar-title">@(ViewData["Title"] ?? "Lontsi Homes")</p>
                            <small class="rh-topbar-caption">@T["Operational workspace"]</small>
                        </div>
                    }
                </div>

                <div class="rh-topbar-right">
                    @if (isAuthenticated)
                    {
                        @if (isMarketingPage)
                        {
                            <nav class="rh-public-workspace-nav" aria-label="@T["Workspace"]">
                                @if (canSeeProperties)
                                {
                                    <a class="rh-public-workspace-link" asp-controller="Properties" asp-action="Index" aria-label="@T["My Properties"]" title="@T["My Properties"]">
                                        <svg aria-hidden="true"><use href="#rh-icon-properties"></use></svg>
                                        <span>@T["My Properties"]</span>
                                    </a>
                                    <a class="rh-public-workspace-link" asp-controller="Apartments" asp-action="Index" aria-label="@T["Apartments"]" title="@T["Apartments"]">
                                        <svg aria-hidden="true"><use href="#rh-icon-apartments"></use></svg>
                                        <span>@T["Apartments"]</span>
                                    </a>
                                    <a class="rh-public-workspace-link" asp-controller="Tenancies" asp-action="Index" aria-label="@T["Tenancies"]" title="@T["Tenancies"]">
                                        <svg aria-hidden="true"><use href="#rh-icon-tenancies"></use></svg>
                                        <span>@T["Tenancies"]</span>
                                    </a>
                                    @if (canSeeMembersDirectory)
                                    {
                                        <a class="rh-public-workspace-link" asp-controller="Members" asp-action="Index" aria-label="@T["Members"]" title="@T["Members"]">
                                            <svg aria-hidden="true"><use href="#rh-icon-users"></use></svg>
                                            <span>@T["Members"]</span>
                                        </a>
                                    }
                                }
                                @if (canSeeMessages)
                                {
                                    <a class="rh-public-workspace-link" asp-controller="Conversations" asp-action="Index" aria-label="@T["Messages"]" title="@T["Messages"]">
                                        <svg aria-hidden="true"><use href="#rh-icon-inbox"></use></svg>
                                        <span>@T["Messages"]</span>
                                    </a>
                                }
                                @if (canSeeProfile)
                                {
                                    <a class="rh-public-workspace-link" asp-controller="Profile" asp-action="Index" aria-label="@T["View Profile"]" title="@T["View Profile"]">
                                        <svg aria-hidden="true"><use href="#rh-icon-profile"></use></svg>
                                        <span>@T["View Profile"]</span>
                                    </a>
                                }
                            </nav>
                        }
                        <div class="dropdown rh-account-menu">
                            <button class="rh-account-trigger" id="rhAccountMenuButton" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="@T["Open account menu for {0}", userName ?? T["current user"].Value]">
                                <span class="rh-account-avatar">@userInitial</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end rh-account-dropdown" data-account-dropdown aria-labelledby="rhAccountMenuButton">
                                <div data-account-menu-panel>
                                    <div class="rh-account-summary">
                                        <span class="rh-account-avatar rh-account-avatar-large">@userInitial</span>
                                        <span class="rh-account-summary-copy">
                                            <strong>@(userName ?? T["Signed-in user"].Value)</strong>
                                            <small>@userRoleName</small>
                                        </span>
                                    </div>

                                    @if (canSeeProfile || canSeePaymentCenter || canSeeProperties || canSeeMessages)
                                    {
                                        <div class="rh-account-menu-section">
                                            @if (canSeeProfile)
                                            {
                                                <a class="dropdown-item rh-account-menu-item" asp-controller="Profile" asp-action="Index">
                                                    <svg aria-hidden="true"><use href="#rh-icon-profile"></use></svg>
                                                    <span>@T["View Profile"]</span>
                                                </a>
                                            }
                                            @if (canSeePaymentCenter)
                                            {
                                                <a class="dropdown-item rh-account-menu-item" asp-controller="Profile" asp-action="Payments">
                                                    <svg aria-hidden="true"><use href="#rh-icon-payment"></use></svg>
                                                    <span>@T["Payments"]</span>
                                                </a>
                                            }
                                            @if (canSeeProperties)
                                            {
                                                <a class="dropdown-item rh-account-menu-item" asp-controller="Properties" asp-action="Index">
                                                    <svg aria-hidden="true"><use href="#rh-icon-properties"></use></svg>
                                                    <span>@T["My Properties"]</span>
                                                </a>
                                            }
                                            @if (canSeeMessages)
                                            {
                                                <a class="dropdown-item rh-account-menu-item" asp-controller="Conversations" asp-action="Index">
                                                    <svg aria-hidden="true"><use href="#rh-icon-inbox"></use></svg>
                                                    <span>@T["Messages"]</span>
                                                </a>
                                            }
                                        </div>
                                    }

                                    <div class="rh-account-menu-section">
                                        <button class="dropdown-item rh-account-menu-item rh-account-menu-choice" type="button" data-appearance-open aria-haspopup="menu" aria-expanded="false">
                                            <svg aria-hidden="true"><use href="#rh-icon-appearance"></use></svg>
                                            <span class="rh-account-menu-item-copy">
                                                <span>@T["Appearance"]</span>
                                                <small data-theme-current-label>@T["Dark"]</small>
                                            </span>
                                            <svg class="rh-account-menu-chevron" aria-hidden="true"><use href="#rh-icon-chevron-right"></use></svg>
                                        </button>
                                    </div>

                                    <div class="rh-account-menu-section">
                                        <form asp-controller="Auth"
                                              asp-action="Logout"
                                              method="post"
                                              class="rh-account-action-form"
                                              data-confirm-modal="true"
                                              data-confirm-title="@T["Log out?"]"
                                              data-confirm-message="@T["Are you sure you want to end your current session?"]"
                                              data-confirm-proceed="@T["Log out"]"
                                              data-confirm-style="danger">
                                            @Html.AntiForgeryToken()
                                            <button class="dropdown-item rh-account-menu-item rh-account-menu-item-danger" type="submit">
                                                <svg aria-hidden="true"><use href="#rh-icon-logout"></use></svg>
                                                <span>@T["Log out"]</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="rh-appearance-panel" data-appearance-menu-panel hidden>
                                    <div class="rh-appearance-header">
                                        <button class="rh-appearance-back" type="button" data-appearance-back aria-label="@T["Back to account menu"]">
                                            <svg aria-hidden="true"><use href="#rh-icon-arrow-left"></use></svg>
                                            <span>@T["Appearance"]</span>
                                        </button>
                                    </div>
                                    <div class="rh-appearance-options" role="radiogroup" aria-label="@T["Theme preference"]">
                                        <button class="dropdown-item rh-theme-option" type="button" role="radio" aria-checked="false" data-theme-option="system">
                                            <svg aria-hidden="true"><use href="#rh-icon-device"></use></svg>
                                            <span>@T["Use device theme"]</span>
                                            <svg class="rh-theme-check" data-theme-check aria-hidden="true" hidden><use href="#rh-icon-check"></use></svg>
                                        </button>
                                        <button class="dropdown-item rh-theme-option" type="button" role="radio" aria-checked="false" data-theme-option="dark">
                                            <svg aria-hidden="true"><use href="#rh-icon-dark"></use></svg>
                                            <span>@T["Dark theme"]</span>
                                            <svg class="rh-theme-check" data-theme-check aria-hidden="true" hidden><use href="#rh-icon-check"></use></svg>
                                        </button>
                                        <button class="dropdown-item rh-theme-option" type="button" role="radio" aria-checked="false" data-theme-option="light">
                                            <svg aria-hidden="true"><use href="#rh-icon-light"></use></svg>
                                            <span>@T["Light theme"]</span>
                                            <svg class="rh-theme-check" data-theme-check aria-hidden="true" hidden><use href="#rh-icon-check"></use></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown rh-public-theme-menu">
                            <button class="rh-public-theme-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@T["Appearance"]">
                                <svg aria-hidden="true"><use href="#rh-icon-appearance"></use></svg>
                                <span class="visually-hidden">@T["Appearance"]</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end rh-public-theme-dropdown">
                                <p class="rh-public-theme-heading">@T["Appearance"]</p>
                                <div class="rh-appearance-options" role="radiogroup" aria-label="@T["Theme preference"]">
                                    <button class="dropdown-item rh-theme-option" type="button" role="radio" aria-checked="false" data-theme-option="system">
                                        <svg aria-hidden="true"><use href="#rh-icon-device"></use></svg>
                                        <span>@T["Use device theme"]</span>
                                        <svg class="rh-theme-check" data-theme-check aria-hidden="true" hidden><use href="#rh-icon-check"></use></svg>
                                    </button>
                                    <button class="dropdown-item rh-theme-option" type="button" role="radio" aria-checked="false" data-theme-option="dark">
                                        <svg aria-hidden="true"><use href="#rh-icon-dark"></use></svg>
                                        <span>@T["Dark theme"]</span>
                                        <svg class="rh-theme-check" data-theme-check aria-hidden="true" hidden><use href="#rh-icon-check"></use></svg>
                                    </button>
                                    <button class="dropdown-item rh-theme-option" type="button" role="radio" aria-checked="false" data-theme-option="light">
                                        <svg aria-hidden="true"><use href="#rh-icon-light"></use></svg>
                                        <span>@T["Light theme"]</span>
                                        <svg class="rh-theme-check" data-theme-check aria-hidden="true" hidden><use href="#rh-icon-check"></use></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <a class="btn rh-btn-subtle btn-sm me-2" asp-controller="Auth" asp-action="Login">@T["Login"]</a>
                        <a class="btn rh-btn-primary btn-sm" asp-controller="Auth" asp-action="Register">@T["Become a Landlord"]</a>
                    }
                </div>
            </header>

            <div class="rh-main-scroll @(isMessages ? "rh-main-scroll-conversations" : null)">
                <main role="main" class="rh-page @(isMarketingPage ? "rh-page-public" : null) @(isMessages ? "rh-page-conversations" : null)">
                    @RenderBody()
                </main>

                <footer class="rh-footer @(isMarketingPage ? "is-public" : null)">
                    <div>&copy; 2026 - Lontsi Homes</div>
                    <div class="rh-footer-links">
                        <a asp-controller="Home" asp-action="Terms">@T["Terms"]</a>
                        <a asp-controller="Home" asp-action="Privacy">@T["Privacy"]</a>
                        <a asp-controller="Home" asp-action="RefundPolicy">@T["Refund Policy"]</a>
                        <a asp-controller="Home" asp-action="Contact">@T["Contact"]</a>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="modal fade" id="successDialogModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog rh-feedback-dialog rh-feedback-position-@successDialog.Position">
                <div class="modal-content rh-success-modal">
                    <div class="modal-header border-0">
                        <h5 class="modal-title">@T["Action Completed"]</h5>
                        @if (successDialog.ShowCloseButton)
                        {
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                        }
                    </div>
                    <div class="modal-body pt-0">
                        <p class="mb-0">@successMessage</p>
                    </div>
                    @if (successDialog.ShowCloseButton)
                    {
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Close"]</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="modal fade" id="errorDialogModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog rh-feedback-dialog rh-feedback-position-@successDialog.Position">
                <div class="modal-content rh-error-modal">
                    <div class="modal-header border-0">
                        <h5 class="modal-title">@T["Action Failed"]</h5>
                        @if (successDialog.ShowCloseButton)
                        {
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                        }
                    </div>
                    <div class="modal-body pt-0">
                        <p class="mb-0">@errorMessage</p>
                    </div>
                    @if (successDialog.ShowCloseButton)
                    {
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-outline-danger" data-bs-dismiss="modal">@T["Close"]</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(infoMessage))
    {
        <div class="modal fade" id="infoDialogModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog rh-feedback-dialog rh-feedback-position-@successDialog.Position">
                <div class="modal-content rh-success-modal">
                    <div class="modal-header border-0">
                        <h5 class="modal-title">@T["Action Needed"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>
                    <div class="modal-body pt-0">
                        <p class="mb-0">@infoMessage</p>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Close"]</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="confirmationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered rh-action-modal-dialog">
            <div class="modal-content rh-confirm-modal">
            <div class="modal-header border-0 rh-confirm-modal-header">
                    <div class="rh-confirm-heading flex-grow-1">
                        <div class="rh-confirm-warning d-none" id="confirmationModalWarning" role="alert" aria-hidden="true">
                            <span class="rh-confirm-warning-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" focusable="false">
                                    <path d="M10.3 3.7 2.2 17.8A2 2 0 0 0 3.9 21h16.2a2 2 0 0 0 1.7-3.2L13.7 3.7a2 2 0 0 0-3.4 0Z" />
                                    <path d="M12 8v5.5M12 17.25v.05" />
                                </svg>
                            </span>
                            <div>
                                <strong class="d-block">@T["Attention"]</strong>
                                <span>@T["Confirm that the payment was actually received before continuing. This action changes the rent balance and creates a receipt."]</span>
                            </div>
                        </div>
                        <h5 class="modal-title" id="confirmationModalTitle">@T["Please confirm"]</h5>
                    </div>
                    <button type="button" class="btn-close rh-confirm-modal-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                </div>
            <div class="modal-body rh-confirm-modal-body">
                <p class="mb-0 rh-confirm-modal-message" id="confirmationModalMessage">@T["Are you sure you want to continue?"]</p>
                    <div class="mt-4 d-none" id="confirmationModalDuration">
                        <label class="form-label fw-semibold" for="confirmationDurationMonths">@T["Subscription duration"]</label>
                        <select class="form-select" id="confirmationDurationMonths">
                            @for (var months = 6; months <= 36; months++)
                            {
                                <option value="@months" selected="@(months == 12 ? "selected" : null)">@T["{0} months", months]</option>
                            }
                        </select>
                        <small class="text-muted d-block mt-2">@T["Choose between 6 months and 36 months (3 years)."]</small>
                    </div>
                </div>
            <div class="modal-footer border-0 rh-confirm-modal-footer">
                    <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                    <button type="button" class="btn rh-btn-outline-danger" id="confirmationModalProceed">@T["Proceed"]</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (isAuthenticated)
    {
        <script>
            window.rhSession = {
                keepAliveUrl: '@Url.Action("KeepAlive", "Auth")'
            };
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (!string.IsNullOrWhiteSpace(successMessage) || !string.IsNullOrWhiteSpace(infoMessage) || !string.IsNullOrWhiteSpace(errorMessage))
    {
        <script>
            (() => {
                const allowManualClose = @(successDialog.ShowCloseButton ? "true" : "false");
                const autoCloseEnabled = @(successDialog.AutoCloseEnabled ? "true" : "false");
                const autoCloseMs = @(successDialog.AutoCloseSeconds * 1000);

                const queue = [];
                const errorEl = document.getElementById("errorDialogModal");
                const infoEl = document.getElementById("infoDialogModal");
                const successEl = document.getElementById("successDialogModal");

                if (errorEl) queue.push(errorEl);
                if (infoEl) queue.push(infoEl);
                if (successEl) queue.push(successEl);

                if (!queue.length) return;

                const showAt = (index) => {
                    if (index >= queue.length) return;

                    const modalEl = queue[index];
                    const modal = new bootstrap.Modal(modalEl, {
                        backdrop: allowManualClose ? true : "static",
                        keyboard: allowManualClose
                    });

                    modalEl.addEventListener("hidden.bs.modal", () => showAt(index + 1), { once: true });
                    modal.show();

                    if (autoCloseEnabled && autoCloseMs > 0) {
                        setTimeout(() => modal.hide(), autoCloseMs);
                    }
                };

                showAt(0);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


