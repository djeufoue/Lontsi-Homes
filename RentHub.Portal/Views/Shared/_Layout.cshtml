@using System
@using System.Linq
@using RentHub.Portal.Helpers
@{
    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;
    var successDialog = SuccessDialogHelper.GetActive(Context.Session);

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
    var isMarketingPage = isHome;
    var isProperties = string.Equals(currentController, "Properties", StringComparison.OrdinalIgnoreCase);
    var isMessages = string.Equals(currentController, "Conversations", StringComparison.OrdinalIgnoreCase);
    var isSubscriptionsAdmin = string.Equals(currentController, "AdminSubscriptions", StringComparison.OrdinalIgnoreCase);
    var isProfile = string.Equals(currentController, "Profile", StringComparison.OrdinalIgnoreCase);

    var userPrincipal = User;
    var isAuthenticated = userPrincipal?.Identity?.IsAuthenticated == true;
    var canSeeProperties = userPrincipal?.IsInRole("Landlord") == true || userPrincipal?.IsInRole("Manager") == true || userPrincipal?.IsInRole("Admin") == true;
    var canSeeMessages = userPrincipal?.IsInRole("Visitor") == true || userPrincipal?.IsInRole("Landlord") == true;
    var showSidebar = isAuthenticated && !isMarketingPage;

    var userName = User?.Identity?.Name;
    var userInitial = !string.IsNullOrWhiteSpace(userName) ? userName.Trim()[0].ToString().ToUpperInvariant() : "U";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentHub</title>

    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RentHub.Portal.styles.css" asp-append-version="true" />
</head>
<body class="rh-body @(isMarketingPage ? "rh-body-public" : null)">
    <div class="rh-shell @(showSidebar ? "has-sidebar" : "has-public-nav")">
        @if (showSidebar)
        {
            <aside class="rh-sidebar" id="rhSidebar">
                <div class="rh-sidebar-brand">
                    <a asp-controller="Home" asp-action="Index">RentHub</a>
                    <small>Workspace</small>
                </div>

                @if (userPrincipal?.IsInRole("Visitor") != true)
                {
                    <a class="rh-sidebar-user rh-sidebar-user-link @(isProfile ? "active" : null)" asp-controller="Profile" asp-action="Index">
                        <div class="rh-avatar">@userInitial</div>
                        <div>
                            <p class="rh-sidebar-user-name">@(userName ?? "User")</p>
                            <p class="rh-sidebar-user-role">Workspace profile</p>
                        </div>
                    </a>
                }

                <nav class="rh-nav">
                    <a class="rh-nav-link @(isHome ? "active" : null)" asp-controller="Home" asp-action="Index">
                        <span class="rh-nav-icon">&#9635;</span>
                        <span>Public Home</span>
                    </a>

                    @if (canSeeProperties)
                    {
                        <a class="rh-nav-link @(isProperties ? "active" : null)" asp-controller="Properties" asp-action="Index">
                            <span class="rh-nav-icon">&#9638;</span>
                            <span>My Properties</span>
                        </a>
                    }

                    @if (canSeeMessages)
                    {
                        <a class="rh-nav-link @(isMessages ? "active" : null)" asp-controller="Conversations" asp-action="Index">
                            <span class="rh-nav-icon">&#9993;</span>
                            <span>Messages</span>
                        </a>
                    }

                    @if (userPrincipal?.IsInRole("Admin") == true)
                    {
                        <a class="rh-nav-link @(isSubscriptionsAdmin ? "active" : null)" asp-controller="AdminSubscriptions" asp-action="Index">
                            <span class="rh-nav-icon">&#9881;</span>
                            <span>Subscriptions</span>
                        </a>
                    }
                </nav>

                <div class="rh-sidebar-footer">
                    <p>RentHub</p>
                    <small>Public listings and landlord operations</small>
                </div>
            </aside>
        }

        <div class="rh-main @(showSidebar ? null : "is-public")">
            <header class="rh-topbar @(isMarketingPage ? "is-public" : null)">
                <div class="rh-topbar-left">
                    @if (showSidebar)
                    {
                        <button type="button" class="btn rh-btn-subtle rh-sidebar-toggle" id="rhSidebarToggle">
                            Menu
                        </button>
                    }
                    <div class="rh-topbar-context">
                        <p class="rh-topbar-title">@(isMarketingPage ? "RentHub" : (ViewData["Title"] ?? "RentHub"))</p>
                        <small class="rh-topbar-caption">@(isMarketingPage ? "Public apartment showcase and landlord services" : "Operational workspace")</small>
                    </div>
                </div>

                <div class="rh-topbar-right">
                    <a class="btn rh-btn-subtle btn-sm me-2" asp-controller="Home" asp-action="Index">Home</a>

                    @if (isAuthenticated)
                    {
                        if (canSeeProperties)
                        {
                            <a class="btn rh-btn-subtle btn-sm me-2" asp-controller="Properties" asp-action="Index">My Properties</a>
                        }

                        if (canSeeMessages)
                        {
                            <a class="btn rh-btn-subtle btn-sm me-2" asp-controller="Conversations" asp-action="Index">Messages</a>
                        }

                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn rh-btn-outline-danger btn-sm" type="submit">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn rh-btn-subtle btn-sm me-2" asp-controller="Auth" asp-action="Login">Login</a>
                        <a class="btn rh-btn-primary btn-sm" asp-controller="Auth" asp-action="Register">Become a Landlord</a>
                    }
                </div>
            </header>

            <main role="main" class="rh-page @(isMarketingPage ? "rh-page-public" : null)">
                @RenderBody()
            </main>

            <footer class="rh-footer @(isMarketingPage ? "is-public" : null)">
                <div>&copy; 2026 - RentHub</div>
                <div>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="modal fade" id="successDialogModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rh-success-modal">
                    <div class="modal-header border-0">
                        <h5 class="modal-title">Action Completed</h5>
                        @if (successDialog.ShowCloseButton)
                        {
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        }
                    </div>
                    <div class="modal-body pt-0">
                        <p class="mb-0">@successMessage</p>
                    </div>
                    @if (successDialog.ShowCloseButton)
                    {
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Close</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="modal fade" id="errorDialogModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rh-error-modal">
                    <div class="modal-header border-0">
                        <h5 class="modal-title">Action Failed</h5>
                        @if (successDialog.ShowCloseButton)
                        {
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        }
                    </div>
                    <div class="modal-body pt-0">
                        <p class="mb-0">@errorMessage</p>
                    </div>
                    @if (successDialog.ShowCloseButton)
                    {
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-outline-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="confirmationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content rh-confirm-modal">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="confirmationModalTitle">Please confirm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0">
                    <p class="mb-0" id="confirmationModalMessage">Are you sure you want to continue?</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn rh-btn-outline-danger" id="confirmationModalProceed">Proceed</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (isAuthenticated)
    {
        <script>
            window.rhSession = {
                keepAliveUrl: '@Url.Action("KeepAlive", "Auth")'
            };
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (!string.IsNullOrWhiteSpace(successMessage) || !string.IsNullOrWhiteSpace(errorMessage))
    {
        <script>
            (() => {
                const allowManualClose = @(successDialog.ShowCloseButton ? "true" : "false");
                const autoCloseEnabled = @(successDialog.AutoCloseEnabled ? "true" : "false");
                const autoCloseMs = @(successDialog.AutoCloseSeconds * 1000);

                const queue = [];
                const errorEl = document.getElementById("errorDialogModal");
                const successEl = document.getElementById("successDialogModal");

                if (errorEl) queue.push(errorEl);
                if (successEl) queue.push(successEl);

                if (!queue.length) return;

                const showAt = (index) => {
                    if (index >= queue.length) return;

                    const modalEl = queue[index];
                    const modal = new bootstrap.Modal(modalEl, {
                        backdrop: allowManualClose ? true : "static",
                        keyboard: allowManualClose
                    });

                    modalEl.addEventListener("hidden.bs.modal", () => showAt(index + 1), { once: true });
                    modal.show();

                    if (autoCloseEnabled && autoCloseMs > 0) {
                        setTimeout(() => modal.hide(), autoCloseMs);
                    }
                };

                showAt(0);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


