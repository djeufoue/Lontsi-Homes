@model Common.CommunicationModels.WorkspaceDirectoryResponseDto<Common.CommunicationModels.WorkspaceApartmentDto>
@{
    ViewData["Title"] = T["Apartments"].Value;
}

<div class="rh-properties-page">
    <section class="rh-properties-hero">
        <div class="rh-properties-overview-head">
            <div>
                <p class="rh-kicker rh-kicker-ghost">@T["Workspace directory"]</p>
                <h1 class="rh-heading-title rh-properties-overview-title">@T["Apartments"]</h1>
                <p class="rh-card-meta mb-0">@T["Review units across every property available to you."]</p>
            </div>
        </div>
        <div class="rh-properties-overview-grid">
            <article class="rh-properties-stat-card"><span>@T["In scope"]</span><strong>@Model.ScopeTotalCount</strong><small>@T["Total accessible apartments"]</small></article>
            <article class="rh-properties-stat-card"><span>@T["Matching"]</span><strong>@Model.TotalCount</strong><small>@T["Results after filters"]</small></article>
            <article class="rh-properties-stat-card"><span>@T["Current page"]</span><strong>@Model.Page / @Model.TotalPages</strong><small>@T["{0} rows per page", Model.PageSize]</small></article>
        </div>
    </section>

    <section class="rh-properties-filter-shell">
        <div class="rh-properties-filter-head">
            <div><p class="rh-kicker rh-kicker-ghost mb-1">@T["Essential filters"]</p><h2 class="rh-section-title mb-0">@T["Find an apartment"]</h2></div>
            <small>@T["Search by apartment, property, landlord, or type."]</small>
        </div>
        <form method="get" class="rh-properties-filter-grid rh-collapsible-filter">
            <div class="rh-properties-filter-field rh-properties-filter-field-wide">
                <label class="form-label mb-1">@T["Search"]</label>
                <input class="form-control rh-input" name="search" value="@Model.Search" placeholder="@T["Apartment, property, landlord, or type"]" />
            </div>
            <div class="rh-properties-filter-field">
                <label class="form-label mb-1">@T["Property"]</label>
                <select class="form-select rh-input rh-select" name="propertyId">
                    <option value="">@T["All properties"]</option>
                    @foreach (var option in Model.Properties) { <option value="@option.Id" selected="@(Model.PropertyId == option.Id ? "selected" : null)">@option.Label</option> }
                </select>
            </div>
            <div class="rh-properties-filter-field">
                <label class="form-label mb-1">@T["Status"]</label>
                <select class="form-select rh-input rh-select" name="status">
                    <option value="">@T["All statuses"]</option>
                    @foreach (var option in Model.Statuses) { <option value="@option" selected="@(Model.Status == option ? "selected" : null)">@T[option]</option> }
                </select>
            </div>
            <input type="hidden" name="page" value="1" />
            <div class="rh-properties-filter-actions"><button class="btn rh-btn-primary" type="submit">@T["Apply filters"]</button><a asp-action="Index" class="btn rh-btn-subtle">@T["Clear"]</a></div>
        </form>
    </section>

    <section class="rh-properties-scope-shell">
        <div class="rh-properties-filter-head"><div><p class="rh-kicker rh-kicker-ghost mb-1">@T["Apartment register"]</p><h2 class="rh-section-title mb-0">@T["Accessible apartments"]</h2></div><small>@T["{0} results", Model.TotalCount]</small></div>
        @if (!Model.Items.Any())
        {
            <div class="rh-empty">@T["No apartments match these filters."]</div>
        }
        else
        {
            <div class="table-responsive rh-responsive-table-wrap"><table class="table align-middle mb-0 rh-table rh-responsive-data-table"><thead><tr><th>@T["Apartment"]</th><th>@T["Property"]</th><th>@T["Landlord"]</th><th>@T["Status"]</th><th>@T["Rent"]</th><th>@T["Tenancies"]</th><th>@T["Members"]</th><th class="text-end">@T["Action"]</th></tr></thead><tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="rh-mobile-card-title" data-label="@T["Apartment"]"><a class="rh-table-property-link" asp-action="Overview" asp-route-id="@item.Id">@item.Name</a><small class="d-block text-muted">@T[item.Type] · @T["{0:N0} m²", item.Area]</small></td>
                    <td data-label="@T["Property"]"><a class="rh-table-property-link" asp-controller="Properties" asp-action="Overview" asp-route-id="@item.PropertyId">@item.PropertyName</a></td>
                    <td data-label="@T["Landlord"]">@item.LandlordName</td>
                    <td data-label="@T["Status"]"><span class="rh-chip rh-chip-info">@T[item.Status]</span></td>
                    <td data-label="@T["Rent"]">@item.Rent.ToString("N0")</td>
                    <td data-label="@T["Tenancies"]">@T["{0} active", item.ActiveTenancies]</td>
                    <td data-label="@T["Members"]">@item.MemberCount</td>
                    <td data-label="@T["Action"]" class="text-end"><a class="btn btn-sm rh-btn-primary" asp-action="Overview" asp-route-id="@item.Id">@T["Open"]</a></td>
                </tr>
            }
            </tbody></table></div>
        }
        <div class="rh-table-footer">
            <a class="btn btn-sm rh-btn-subtle @(Model.Page <= 1 ? "disabled" : null)" asp-route-search="@Model.Search" asp-route-propertyId="@Model.PropertyId" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">@T["Previous"]</a>
            <div class="rh-table-page-size"><label class="form-label mb-0" for="apartmentPageSize">@T["Rows"]</label><select id="apartmentPageSize" class="form-select rh-input rh-select" data-auto-page-size>@foreach (var size in new[] { 6, 12, 24 }) { <option value="@size" selected="@(Model.PageSize == size ? "selected" : null)">@size</option> }</select><small class="text-muted">@T["Page {0} of {1}", Model.Page, Model.TotalPages]</small></div>
            <a class="btn btn-sm rh-btn-subtle rh-table-footer-next @(Model.Page >= Model.TotalPages ? "disabled" : null)" asp-route-search="@Model.Search" asp-route-propertyId="@Model.PropertyId" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">@T["Next"]</a>
        </div>
    </section>
</div>
