@model RentHub.Portal.ViewModels.Apartments.ApartmentOverviewVm
@using Common.Enums
@using System
@using System.Globalization
@using System.Linq
@{
    ViewData["Title"] = T["Apartment Overview"];
    var canOpenUserOverview = User.IsInRole("Admin") || User.IsInRole("Landlord") || User.IsInRole("Manager");

    var apartment = Model.Apartment;
    var documents = Model.Documents?.OrderByDescending(doc => doc.UploadedAt).ToList() ?? new List<Common.CommunicationModels.DocumentDto>();
    var apartmentImages = documents.Where(doc => doc.DocumentType == DocumentTypeEnum.ApartmentImage).ToList();
    var apartmentDocuments = documents.Where(doc => doc.DocumentType != DocumentTypeEnum.ApartmentImage).ToList();
    var owners = Model.Owners ?? new List<Common.CommunicationModels.ApartmentOwnerDto>();
    var tenancies = Model.Tenancies ?? new List<Common.CommunicationModels.TenancyDto>();
    var reminderRules = apartment.RentReminderRules.OrderBy(rule => rule.SortOrder).ToList();
    var today = DateTimeOffset.UtcNow.Date;

    string GetTenancyState(Common.CommunicationModels.TenancyDto tenancy)
    {
        if (!string.IsNullOrWhiteSpace(tenancy.Status))
        {
            return tenancy.Status;
        }

        if (tenancy.StartDate.Date > today)
        {
            return "Upcoming";
        }

        if (tenancy.EndDate.HasValue && tenancy.EndDate.Value.Date < today)
        {
            return "Closed";
        }

        return "Active";
    }

    string GetTenancyStateClass(string state) => state switch
    {
        "Active" => "rh-chip-primary",
        "Month-to-month" => "rh-chip-primary",
        "Upcoming" => "rh-chip-info",
        _ => "rh-chip-warning"
    };

    int GetTenancySortRank(Common.CommunicationModels.TenancyDto tenancy) => GetTenancyState(tenancy) switch
    {
        "Active" => 0,
        "Upcoming" => 1,
        _ => 2
    };

    var sortedTenancies = tenancies
        .OrderBy(GetTenancySortRank)
        .ThenBy(tenancy => GetTenancyState(tenancy) == "Upcoming" ? tenancy.StartDate : DateTimeOffset.MaxValue)
        .ThenByDescending(tenancy => tenancy.StartDate)
        .ToList();

    var activeTenancies = tenancies.Count(tenancy => GetTenancyState(tenancy) == "Active");
    var memberCount = owners.Count;
    var currentApartmentImage = apartmentImages.FirstOrDefault();
    var averageRent = tenancies.Any() ? tenancies.Average(tenancy => tenancy.MonthlyRent) : apartment.Price;
}

<section class="rh-overview-shell rh-apartment-shell"
         data-apartment-overview-root="true"
         data-overview-content-url="@Url.Action("OverviewContent", "Apartments", new { id = apartment.Id })">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-controller="Properties" asp-action="Overview" asp-route-id="@apartment.PropertyId">&#8592; @T["Back to property overview"]</a>
            <p class="rh-kicker">@T["Apartment Workspace"]</p>
            <h1 class="rh-heading-title">@apartment.Name</h1>
            <p class="rh-heading-subtitle">@apartment.PropertyName - @T[apartment.Type.ToString()] - @T[apartment.Status ?? string.Empty]</p>

            <div class="rh-overview-badges">
                @if (Model.CanViewFinancialInformation)
                {
                <span class="rh-chip rh-chip-primary">@T["{0} rent", apartment.Price.ToString("N0", CultureInfo.CurrentCulture)]</span>
                }
                <span class="rh-chip rh-chip-info">@T["{0} sqm", apartment.Area?.ToString("N0", CultureInfo.CurrentCulture) ?? "0"]</span>
                <span class="rh-chip @(Model.CanWrite ? "rh-chip-primary" : "rh-chip-warning")">@(Model.CanWrite ? T["Write access"] : T["Read access"])</span>
            </div>
        </div>

        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-subtle" asp-controller="Properties" asp-action="Map" asp-route-id="@apartment.PropertyId">@T["Property Map"]</a>
            <a class="btn rh-btn-primary" asp-controller="Properties" asp-action="Overview" asp-route-id="@apartment.PropertyId">@T["Property Workspace"]</a>
        </div>
    </section>

    <section class="rh-apartment-commanddeck rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head">
            <div>
                <h2 class="rh-dashboard-panel-title">@T["Apartment overview"]</h2>
                <p class="rh-dashboard-panel-copy">@T["Live tenancy, member, reminder, and occupancy signals in one apartment board."]</p>
            </div>
            <div class="rh-dashboard-range-chip">@T["Live apartment view"]</div>
        </div>

        <div class="rh-apartment-commanddeck-grid">
            <div class="rh-overview-bigstat">
                <span>@T["Active tenancies"]</span>
                <strong>@activeTenancies</strong>
                <small>@T["Current apartment occupancy records"]</small>
            </div>
            @if (Model.CanViewFinancialInformation)
            {
            <div class="rh-overview-bigstat alt">
                <span>@T["Average tenancy rent"]</span>
                <strong>@averageRent.ToString("N0", CultureInfo.CurrentCulture)</strong>
                <small>@T["Latest tenancy billing snapshot"]</small>
            </div>
            }
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Members"]</span>
                <strong>@memberCount</strong>
                <small>@T["Owners and apartment collaborators"]</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Status"]</span>
                <strong>@T[apartment.Status ?? string.Empty]</strong>
                <small>@T["Operational apartment state"]</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Automatic rent reminders"]</span>
                <strong>@reminderRules.Count(rule => rule.IsEnabled)</strong>
                <small>@T["Active rules for unpaid rent"]</small>
            </div>
        </div>
    </section>

    <section class="rh-overview-workgrid rh-apartment-workgrid">
        <div class="rh-overview-maincolumn">
            <article class="rh-overview-image-card rh-panel rh-panel-elevated" data-apartment-section="images">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Apartment images"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Keep the gallery close at hand and manage the image currently in view."]</p>
                    </div>

                    @if (Model.CanManageDocuments)
                    {
                        <div class="rh-overview-inline-actions">
                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentImagesModal">@T["Add+"]</button>
                            <button type="button" class="rh-icon-btn" data-bs-toggle="modal" data-bs-target="#manageApartmentImageModal" data-apartment-image-manage-open="true" title="Manage current apartment image" aria-label="Manage current apartment image">
                                <span class="rh-icon-pencil"></span>
                            </button>
                        </div>
                    }
                </div>

                @if (!apartmentImages.Any())
                {
                    <div class="rh-property-image-placeholder rh-apartment-image-placeholder">
                        <strong>@T["No apartment images yet"]</strong>
                        <span>@T["Add one or more landscape images so this apartment has a proper visual gallery."]</span>
                        @if (Model.CanManageDocuments)
                        {
                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentImagesModal">@T["Add images"]</button>
                        }
                    </div>
                }
                else
                {
                    <div class="rh-apartment-gallery" data-apartment-gallery="true">
                        <div class="rh-apartment-gallery-stage">
                            @for (var index = 0; index < apartmentImages.Count; index++)
                            {
                                var image = apartmentImages[index];
                                <div class="rh-apartment-gallery-slide @(index == 0 ? "is-active" : string.Empty)"
                                     data-gallery-slide
                                     data-document-id="@image.Id"
                                     data-image-url="@image.BlobUrl"
                                     data-image-name="@image.FileName">
                                    <button type="button" class="rh-property-image-button" data-bs-toggle="modal" data-bs-target="#apartmentImageLightbox" data-image-lightbox-trigger="true" data-image-url="@image.BlobUrl" data-image-name="@image.FileName" aria-label="Open apartment image">
                                        <img src="@image.BlobUrl" alt="@image.FileName" class="rh-property-image" loading="lazy" />
                                    </button>
                                </div>
                            }

                            @if (apartmentImages.Count > 1)
                            {
                                <button type="button" class="rh-gallery-nav prev" data-gallery-nav="prev" aria-label="@T["Previous image"]">&#8592;</button>
                                <button type="button" class="rh-gallery-nav next" data-gallery-nav="next" aria-label="@T["Next image"]">&#8594;</button>
                            }
                        </div>

                        <div class="rh-apartment-gallery-footer">
                            <div>
                                <strong data-gallery-current-name>@currentApartmentImage?.FileName</strong>
                                <small><span data-gallery-current-index>1</span> / @T["{0} image(s)", apartmentImages.Count]</small>
                            </div>
                        </div>
                    </div>
                }
            </article>

            <article class="rh-overview-members-card rh-panel rh-panel-elevated" data-apartment-section="reminders">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Apartment reminder settings"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Choose when automatic reminders are sent and how many immediate manual follow-ups are allowed."]</p>
                    </div>
                    @if (Model.CanManageRentReminderSettings)
                    {
                        <button type="button" class="rh-icon-btn" id="apartmentReminderEditToggle" title="@T["Edit apartment reminder settings"]" aria-label="@T["Edit apartment reminder settings"]">
                            <span class="rh-icon-pencil"></span>
                        </button>
                    }
                </div>

                <form method="post" asp-action="UpdateReminderSettings" class="rh-inline-settings-grid rh-inline-editor-form" id="apartmentReminderForm" data-inline-editor="locked">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="apartmentId" value="@apartment.Id" />
                    <input type="hidden" name="RentReminderDaysBeforeDue" value="@apartment.RentReminderDaysBeforeDue" />

                    <div class="col-12 rh-reminder-rules-field">
                        <div class="rh-overview-panel-head align-start mb-2">
                            <div>
                                <label class="form-label mb-1">@T["Automatic rent reminders"]</label>
                                <small class="text-muted d-block">@T["Each active rule is sent once per rent period. A future period is shown for information but is not included in the amount due."]</small>
                            </div>
                            @if (Model.CanManageRentReminderSettings)
                            {
                                <button type="button" class="btn btn-sm rh-btn-subtle" data-reminder-rule-add hidden>@T["Add a rule"]</button>
                            }
                        </div>

                        <div class="d-grid gap-2" data-reminder-rules>
                            @for (var ruleIndex = 0; ruleIndex < reminderRules.Count; ruleIndex++)
                            {
                                var rule = reminderRules[ruleIndex];
                                <div class="rh-card-spotlight p-3" data-reminder-rule-row>
                                    <input type="hidden" data-reminder-field="Id" name="RentReminderRules[@ruleIndex].Id" value="@rule.Id" />
                                    <input type="hidden" data-reminder-field="SmsEnabled" name="RentReminderRules[@ruleIndex].SmsEnabled" value="false" />
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-4">
                                            <label class="form-label">@T["When"]</label>
                                            <select class="form-select rh-input" data-reminder-editable data-reminder-timing data-reminder-field="Timing" name="RentReminderRules[@ruleIndex].Timing">
                                                <option value="0" selected="@(rule.Timing == RentReminderTimingEnum.BeforeDue)">@T["Before the due date"]</option>
                                                <option value="1" selected="@(rule.Timing == RentReminderTimingEnum.OnDueDate)">@T["On the due date"]</option>
                                                <option value="2" selected="@(rule.Timing == RentReminderTimingEnum.AfterDue)">@T["After the due date"]</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">@T["Number of days"]</label>
                                            <input class="form-control rh-input" data-reminder-editable data-reminder-days data-reminder-field="Days" type="number" min="0" max="365" name="RentReminderRules[@ruleIndex].Days" value="@rule.Days" required />
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" data-reminder-editable data-reminder-field="IsEnabled" type="checkbox" name="RentReminderRules[@ruleIndex].IsEnabled" value="true" checked="@rule.IsEnabled" />
                                                <label class="form-check-label">@T["Active"]</label>
                                            </div>
                                            <input type="hidden" data-reminder-field="IsEnabled" name="RentReminderRules[@ruleIndex].IsEnabled" value="false" />
                                            <div class="form-check">
                                                <input class="form-check-input" data-reminder-editable data-reminder-field="EmailEnabled" type="checkbox" name="RentReminderRules[@ruleIndex].EmailEnabled" value="true" checked="@rule.EmailEnabled" />
                                                <label class="form-check-label">@T["Email"]</label>
                                            </div>
                                            <input type="hidden" data-reminder-field="EmailEnabled" name="RentReminderRules[@ruleIndex].EmailEnabled" value="false" />
                                        </div>
                                        <div class="col-md-2 text-md-end">
                                            <button type="button" class="btn btn-sm rh-btn-outline-danger" data-reminder-editable data-reminder-rule-remove>@T["Remove"]</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="form-label">@T["Lease termination lead days"]</label>
                        <input class="form-control rh-input" data-reminder-editable type="number" min="0" max="365" name="LeaseTerminationReminderDaysBeforeEnd" value="@apartment.LeaseTerminationReminderDaysBeforeEnd" required />
                        <small class="text-muted">@T["If the tenancy has an end date, the tenant will be notified this many days before the lease ends."]</small>
                    </div>

                    <div>
                        <label class="form-label">@T["Immediate manual follow-ups allowed"]</label>
                        <input class="form-control rh-input" data-reminder-editable type="number" min="0" max="20" name="ManualRentReminderLimit" value="@apartment.ManualRentReminderLimit" required />
                        <small class="text-muted">@T["This limit applies to the oldest unpaid period and resets when that period is paid."]</small>
                    </div>

                    <div>
                        <label class="form-label">@T["Hours between manual follow-ups"]</label>
                        <input class="form-control rh-input" data-reminder-editable type="number" min="0" max="168" name="ManualRentReminderCooldownHours" value="@apartment.ManualRentReminderCooldownHours" required />
                        <small class="text-muted">@T["Use 0 only if authorized users may send follow-ups without a waiting period."]</small>
                    </div>

                    <div class="rh-inline-settings-note">
                        @T["Payment reminders use each tenancy rent amount, not the apartment reference price. If a tenant pays several periods ahead, the reminder schedule waits until that advance coverage is nearly exhausted."]
                    </div>

                    @if (Model.CanManageRentReminderSettings)
                    {
                        <div class="col-12 rh-inline-editor-actions" hidden>
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button class="btn rh-btn-subtle" type="button" id="apartmentReminderCancel">@T["Cancel"]</button>
                                <button class="btn rh-btn-primary" type="submit">@T["Save reminder settings"]</button>
                            </div>
                        </div>
                    }
                </form>

                <template id="apartmentReminderRuleTemplate">
                    <div class="rh-card-spotlight p-3" data-reminder-rule-row>
                        <input type="hidden" data-reminder-field="SmsEnabled" value="false" />
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label">@T["When"]</label>
                                <select class="form-select rh-input" data-reminder-editable data-reminder-timing data-reminder-field="Timing">
                                    <option value="0">@T["Before the due date"]</option>
                                    <option value="1">@T["On the due date"]</option>
                                    <option value="2" selected>@T["After the due date"]</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@T["Number of days"]</label>
                                <input class="form-control rh-input" data-reminder-editable data-reminder-days data-reminder-field="Days" type="number" min="0" max="365" value="5" required />
                            </div>
                            <div class="col-md-3">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" data-reminder-editable data-reminder-field="IsEnabled" type="checkbox" value="true" checked />
                                    <label class="form-check-label">@T["Active"]</label>
                                </div>
                                <input type="hidden" data-reminder-field="IsEnabled" value="false" />
                                <div class="form-check">
                                    <input class="form-check-input" data-reminder-editable data-reminder-field="EmailEnabled" type="checkbox" value="true" checked />
                                    <label class="form-check-label">@T["Email"]</label>
                                </div>
                                <input type="hidden" data-reminder-field="EmailEnabled" value="false" />
                            </div>
                            <div class="col-md-2 text-md-end">
                                <button type="button" class="btn btn-sm rh-btn-outline-danger" data-reminder-editable data-reminder-rule-remove>@T["Remove"]</button>
                            </div>
                        </div>
                    </div>
                </template>
            </article>
        </div>

        <div class="rh-overview-sidecolumn rh-overview-sidecolumn-priority">
            <article class="rh-overview-members-card rh-panel rh-panel-elevated" data-apartment-section="members">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Apartment members"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Owners and collaborators with apartment-level access."]</p>
                    </div>

                    @if (Model.CanManageMembers)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentMemberModal">@T["Add+"]</button>
                    }
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="members">
                    <input type="hidden" name="id" value="@apartment.Id" />
                    <input type="hidden" name="tenancySearch" value="@Model.TenancySearch" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input js-auto-submit" type="text" name="memberSearch" value="@Model.MemberSearch" placeholder="@T["Search apartment members"]" autocomplete="off" />
                    </div>
                </form>
                @if (!owners.Any())
                {
                    <div class="rh-empty">@T["No apartment members assigned yet."]</div>
                }
                else
                {
                    <div class="rh-member-stack">
                        @foreach (var owner in owners.OrderBy(item => item.Role == ApartmentMemberRoleEnum.Owner ? 0 : 1).ThenByDescending(item => item.AssignedAt))
                        {
                            <article class="rh-member-card rh-card-spotlight">
                                <div class="rh-member-card-copy">
                                    <strong>@owner.OwnerName</strong>
                                    <small>@T[owner.Role.ToString()] • @T["Assigned {0}", owner.AssignedAt.LocalDateTime.ToString("d", CultureInfo.CurrentCulture)]</small>
                                </div>

                                <div class="rh-member-card-actions">
                                    <span class="rh-chip rh-chip-info">@T[owner.Role.ToString()]</span>
                                    <span class="rh-chip @(owner.Permission == PermissionLevelEnum.ReadWrite ? "rh-chip-primary" : "rh-chip-warning")">@T[owner.Permission.ToString()]</span>
                                    @if (canOpenUserOverview)
                                    {
                                        <a class="btn btn-sm rh-btn-subtle" asp-controller="AdminUsers" asp-action="Overview" asp-route-userId="@owner.OwnerId">@T["User overview"]</a>
                                    }
                                    @if (Model.CanManageMembers)
                                    {
                                        <button type="button" class="btn btn-sm rh-btn-subtle" data-bs-toggle="modal" data-bs-target="#editApartmentMemberModal-@owner.Id">@T["Edit"]</button>
                                        <form method="post" asp-action="RemoveOwner" data-confirm-modal="true" data-confirm-title="@T["Remove apartment member?"]" data-confirm-message="@T["This member will lose apartment access."]" data-confirm-proceed="@T["Remove member"]">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="apartmentId" value="@apartment.Id" />
                                            <input type="hidden" name="assignmentId" value="@owner.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">@T["Remove"]</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>

            <article class="rh-overview-units-card rh-panel rh-panel-elevated" data-apartment-section="tenancies">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Tenancies"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Track tenancy records linked to this apartment."]</p>
                    </div>

                    @if (Model.CanAddTenancy)
                    {
                        <a class="btn btn-sm rh-btn-primary" asp-controller="Tenancies" asp-action="Create" asp-route-apartmentId="@apartment.Id">@T["Add+"]</a>
                    }
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="tenancies">
                    <input type="hidden" name="id" value="@apartment.Id" />
                    <input type="hidden" name="memberSearch" value="@Model.MemberSearch" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input js-auto-submit" type="text" name="tenancySearch" value="@Model.TenancySearch" placeholder="@T["Search tenancy records"]" autocomplete="off" />
                    </div>
                </form>

                @if (!sortedTenancies.Any())
                {
                    <div class="rh-empty">@T["No tenancy records linked to this apartment yet."]</div>
                }
                else
                {
                    <div class="rh-unit-card-grid rh-unit-card-grid-compact rh-tenancy-card-grid">
                        @foreach (var tenancy in sortedTenancies)
                        {
                            var tenancyState = GetTenancyState(tenancy);
                            var tenancyStateClass = GetTenancyStateClass(tenancyState);
                            var startDateLabel = tenancy.StartDate.LocalDateTime.ToString("d", CultureInfo.CurrentCulture);
                            var endDateLabel = tenancy.EndDate?.LocalDateTime.ToString("d", CultureInfo.CurrentCulture) ?? T["Open term"].Value;
                            <article class="rh-unit-card rh-card-spotlight rh-tenancy-card-shell">
                                <div class="rh-unit-card-head rh-tenancy-card-head">
                                    <div>
                                        <h3>@T["Tenancy #{0}", tenancy.Id]</h3>
                                        <small>@tenancy.ApartmentName</small>
                                    </div>
                                    <div class="rh-tenancy-card-head-actions">
                                        <span class="rh-chip @tenancyStateClass">@T[tenancyState]</span>
                                        <a class="btn btn-sm rh-btn-subtle" asp-controller="Tenancies" asp-action="Overview" asp-route-id="@tenancy.Id">@T["Open"]</a>
                                        @if (Model.CanEditTenancy)
                                        {
                                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#editTenancyModal-@tenancy.Id">@T["Edit"]</button>
                                        }
                                    </div>
                                </div>

                                <div class="rh-tenancy-dateband">
                                    <div class="rh-tenancy-datepill start">
                                        <span>@T["Start date"]</span>
                                        <strong>@startDateLabel</strong>
                                    </div>
                                    <div class="rh-tenancy-datepill end">
                                        <span>@T["End date"]</span>
                                        <strong>@endDateLabel</strong>
                                    </div>
                                </div>

                                <div class="rh-unit-card-meta rh-tenancy-card-meta">
                                    @if (Model.CanViewFinancialInformation)
                                    {
                                    <span>@T["Monthly rent"] <strong>@tenancy.MonthlyRent.ToString("N0", CultureInfo.CurrentCulture) XAF</strong></span>
                                    }
                                    <span>@T["Apartment"] <strong>@tenancy.ApartmentName</strong></span>
                                    <span>@T["Max members"] <strong>@tenancy.MaxMembers</strong></span>
                                </div>

                                @if (Model.CanViewFinancialInformation)
                                {
                                <div class="rh-unit-card-schedule">
                                    <span>
                                        @T["Last paid month"]
                                        <strong>@(tenancy.LastPaidPeriodStart?.LocalDateTime.ToString("MMMM yyyy", CultureInfo.CurrentCulture) ?? T["No paid month yet"].Value)</strong>
                                        @if (tenancy.LastPaidAt.HasValue)
                                        {
                                            <small>@T["Paid on {0}", tenancy.LastPaidAt.Value.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)]</small>
                                        }
                                    </span>
                                    <span>@T["Due now"] <strong>@(tenancy.DueNowPeriodCount > 0 ? $"{tenancy.DueNowAmount.ToString("N0", CultureInfo.CurrentCulture)} XAF" : T["Nothing due"].Value)</strong></span>
                                    <span>
                                        @T["Next rent"]
                                        <strong>@(tenancy.NextUpcomingPeriodStart?.LocalDateTime.ToString("d", CultureInfo.CurrentCulture) ?? T["Not scheduled"].Value)</strong>
                                        @if (tenancy.NextUpcomingAmount.HasValue)
                                        {
                                            <small>@tenancy.NextUpcomingAmount.Value.ToString("N0", CultureInfo.CurrentCulture) XAF</small>
                                        }
                                    </span>
                                    <span>@T["Last reminder sent"] <strong>@(tenancy.LastReminderSentAt?.LocalDateTime.ToString("g", CultureInfo.CurrentCulture) ?? T["No reminder sent"].Value)</strong></span>
                                    <span>@T["Lease alert"] <strong>@(tenancy.LeaseTerminationReminderDate?.LocalDateTime.ToString("d", CultureInfo.CurrentCulture) ?? T["No lease end"].Value)</strong></span>
                                </div>
                                }

                                @if (tenancy.IsPaidInAdvance)
                                {
                                    <div class="rh-inline-hint">@T["Tenant is currently covered in advance. Upcoming rent reminders will wait until the paid coverage window is almost finished."]</div>
                                }
                            </article>
                        }
                    </div>
                }
            </article>

            <article class="rh-overview-docs-card rh-panel rh-panel-elevated rh-overview-docs-compact" data-apartment-section="documents">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Apartment documents"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Reference files and operational records for this apartment."]</p>
                    </div>

                    @if (Model.CanManageDocuments)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentDocumentModal">@T["Add+"]</button>
                    }
                </div>

                @if (!apartmentDocuments.Any())
                {
                    <div class="rh-empty">@T["No apartment documents uploaded yet."]</div>
                }
                else
                {
                    <div class="rh-document-list rh-document-list-compact">
                        @foreach (var document in apartmentDocuments)
                        {
                            <article class="rh-document-item rh-document-item-previewable rh-card-spotlight">
                                <div class="rh-document-item-copy">
                                    <a asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@document.Id" class="rh-document-title-link">@document.FileName</a>
                                    <small>@T[document.DocumentType.ToString()] - @document.UploadedAt.LocalDateTime.ToString("d", CultureInfo.CurrentCulture)</small>
                                </div>
                                <div class="rh-document-actions">
                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@document.Id">@T["Preview"]</a>
                                    @if (Model.CanManageDocuments)
                                    {
                                        <form method="post" asp-action="DeleteDocument" data-confirm-modal="true" data-confirm-title="@T["Delete apartment document?"]" data-confirm-message="@T["This document will be removed from the apartment."]" data-confirm-proceed="@T["Delete document"]">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="apartmentId" value="@apartment.Id" />
                                            <input type="hidden" name="documentId" value="@document.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">@T["Delete"]</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </div>
    </section>
</section>

@if (Model.CanEditTenancy || Model.CanManageMembers || Model.CanManageDocuments)
{
    @foreach (var tenancy in sortedTenancies)
    {
        <div class="modal fade" id="editTenancyModal-@tenancy.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rh-modal-content">
                    <form method="post" asp-action="UpdateTenancy">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ApartmentId" value="@apartment.Id" />
                        <input type="hidden" name="TenancyId" value="@tenancy.Id" />

                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title">@T["Edit Tenancy #{0}", tenancy.Id]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                        </div>

                        <div class="modal-body row g-3">
                            <div class="col-md-6">
                                <label class="form-label">@T["Start date"]</label>
                                <input class="form-control rh-input" type="date" name="StartDate" value="@tenancy.StartDate.ToString("yyyy-MM-dd")" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">@T["End date"]</label>
                                <input class="form-control rh-input" type="date" name="EndDate" value="@(tenancy.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                            </div>

                            @if (Model.CanViewFinancialInformation)
                            {
                                <div class="col-md-6">
                                    <label class="form-label">@T["Monthly rent"]</label>
                                    <input class="form-control rh-input" type="number" name="MonthlyRent" min="0" step="0.01" value="@tenancy.MonthlyRent" disabled="@(!Model.CanEditFinancialInformation)" required />
                                </div>
                            }

                            <div class="col-md-6">
                                <label class="form-label">@T["Max members"]</label>
                                <input class="form-control rh-input" type="number" name="MaxMembers" min="1" value="@tenancy.MaxMembers" required />
                                <small class="text-muted">@T["The selected dates must not overlap another tenancy for this apartment."]</small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">@T["Rent due day"]</label>
                                <input class="form-control rh-input" type="number" name="RentDueDay" min="1" max="31" value="@tenancy.RentDueDay" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">@T["After end date"]</label>
                                <div class="rh-select-wrap">
                                    <select class="form-select rh-input rh-select" name="EndBehavior">
                                        <option value="ExpireAutomatically" selected="@(tenancy.EndBehavior == TenancyEndBehaviorEnum.ExpireAutomatically ? "selected" : null)">@T["Expire automatically"]</option>
                                        <option value="ContinueMonthToMonth" selected="@(tenancy.EndBehavior == TenancyEndBehaviorEnum.ContinueMonthToMonth ? "selected" : null)">@T["Continue month-to-month"]</option>
                                        <option value="NoEndDate" selected="@(tenancy.EndBehavior == TenancyEndBehaviorEnum.NoEndDate ? "selected" : null)">@T["No end date"]</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                            <button type="submit" class="btn rh-btn-primary">@T["Save tenancy"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @foreach (var owner in owners)
    {
        <div class="modal fade" id="editApartmentMemberModal-@owner.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rh-modal-content">
                    <form method="post" asp-action="UpdateOwnerPermission">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="apartmentId" value="@apartment.Id" />
                        <input type="hidden" name="assignmentId" value="@owner.Id" />

                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title">@T["Edit Apartment Member"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                        </div>

                        <div class="modal-body row g-3">
                            <div class="col-12">
                                <div class="rh-inline-settings-note">
                                    <strong>@owner.OwnerName</strong>
                                    <div class="mt-2">@T["Adjust the apartment role and permission for this member."]</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@T["Role"]</label>
                                <div class="rh-select-wrap">
                                    <select class="form-select rh-input rh-select" name="Role">
                                        <option value="Owner" selected="@(owner.Role == ApartmentMemberRoleEnum.Owner ? "selected" : null)">@T["Owner"]</option>
                                        <option value="Manager" selected="@(owner.Role == ApartmentMemberRoleEnum.Manager ? "selected" : null)">@T["Manager"]</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@T["Permission"]</label>
                                <div class="rh-select-wrap">
                                    <select class="form-select rh-input rh-select" name="Permission">
                                        <option value="ReadOnly" selected="@(owner.Permission == PermissionLevelEnum.ReadOnly ? "selected" : null)">@T["ReadOnly"]</option>
                                        <option value="ReadWrite" selected="@(owner.Permission == PermissionLevelEnum.ReadWrite ? "selected" : null)">@T["ReadWrite"]</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                            <button type="submit" class="btn rh-btn-primary">@T["Save member"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="addApartmentMemberModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="AssignOwner">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="apartmentId" value="@apartment.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@T["Add Apartment Member"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">@T["Email"]</label>
                            <input class="form-control rh-input" name="Email" type="email" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@T["Full name"]</label>
                            <input class="form-control rh-input" name="FullName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T["Country code"]</label>
                            <input class="form-control rh-input" name="CountryCode" inputmode="numeric" placeholder="@T["e.g. +237"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T["Phone number"]</label>
                            <input class="form-control rh-input" name="PhoneNumber" inputmode="numeric" placeholder="@T["e.g. REMOVED_PRIVATE_VALUE"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T["Role"]</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="Role">
                                    <option value="Owner">@T["Owner"]</option>
                                    <option value="Manager">@T["Manager"]</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T["Permission"]</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="Permission">
                                    <option value="ReadOnly">@T["ReadOnly"]</option>
                                    <option value="ReadWrite">@T["ReadWrite"]</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-primary">@T["Add member"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addApartmentDocumentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="UploadApartmentDocument" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="apartmentId" value="@apartment.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@T["Add Apartment Document"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">@T["Document file"]</label>
                            <input class="form-control rh-input" type="file" name="file" accept=".pdf,application/pdf" required />
                            <small class="text-muted">@T["Only PDF files are allowed in this section."]</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@T["Document type"]</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="documentType">
                                    @foreach (var type in Enum.GetValues<DocumentTypeEnum>().Where(type => type != DocumentTypeEnum.PropertyImage && type != DocumentTypeEnum.ApartmentImage))
                                    {
                                        <option value="@type">@T[type.ToString()]</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-primary">@T["Upload document"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addApartmentImagesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="UploadApartmentImages" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="apartmentId" value="@apartment.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@T["Add Apartment Images"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">@T["Select image files"]</label>
                            <input class="form-control rh-input" type="file" name="files" accept="image/*" multiple required />
                            <small class="text-muted">@T["You can choose multiple images at once. Landscape images work best for the apartment gallery."]</small>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-primary">@T["Upload images"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="manageApartmentImageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title">@T["Manage Apartment Image"]</h5>
                        <p class="text-muted mb-0">@T["Replace or remove the image currently shown in the gallery."]</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                </div>

                <div class="modal-body row g-3">
                    <div class="col-12">
                        <div class="rh-inline-settings-note">
                            <strong data-current-image-name>@(currentApartmentImage?.FileName ?? T["No image selected yet"].Value)</strong>
                            <div class="mt-2">@T["Use a landscape image under 2 MB for the best result."]</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <form method="post" asp-action="UploadApartmentImage" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="apartmentId" value="@apartment.Id" />
                            <input type="hidden" name="currentDocumentId" value="@(currentApartmentImage?.Id)" />

                            <label class="form-label">@T["Replace current image"]</label>
                            <input class="form-control rh-input" type="file" name="file" accept="image/*" required />
                            <small class="text-muted d-block mt-2">@T["Uploading here replaces only the image currently displayed in the gallery."]</small>

                            <div class="modal-footer border-0 px-0 pt-3 pb-0">
                                <button type="submit" class="btn rh-btn-primary">@T["Save current image"]</button>
                            </div>
                        </form>
                    </div>

                    @if (currentApartmentImage != null)
                    {
                        <div class="col-12">
                            <form method="post" asp-action="DeleteApartmentImage" data-confirm-modal="true" data-confirm-title="@T["Delete apartment image?"]" data-confirm-message="@T["This will remove the image currently shown in the gallery."]" data-confirm-proceed="@T["Delete image"]">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="apartmentId" value="@apartment.Id" />
                                <input type="hidden" name="documentId" value="@currentApartmentImage.Id" />

                                <div class="modal-footer border-0 px-0 pt-0 pb-0 justify-content-start">
                                    <button type="submit" class="btn rh-btn-outline-danger">@T["Delete current image"]</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="apartmentImageLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rh-image-lightbox-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title">@T["Apartment image"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body pt-0">
                <div class="rh-image-lightbox-stage">
                    @if (apartmentImages.Count > 1)
                    {
                        <button type="button" class="rh-gallery-nav rh-lightbox-nav prev" data-lightbox-nav="prev" aria-label="@T["Previous image"]">&#8592;</button>
                        <button type="button" class="rh-gallery-nav rh-lightbox-nav next" data-lightbox-nav="next" aria-label="@T["Next image"]">&#8594;</button>
                    }
                    <img src="@(currentApartmentImage?.BlobUrl ?? string.Empty)"
                         alt="@T["Apartment image preview"]"
                         class="rh-image-lightbox-preview"
                         id="apartmentImageLightboxPreview" />
                </div>
            </div>
        </div>
    </div>
</div>


