@model RentHub.Portal.ViewModels.Apartments.ApartmentOverviewVm
@using Common.Enums
@using System
@using System.Globalization
@using System.Linq
@using RentHub.Portal.Helpers
@{
    ViewData["Title"] = T["Apartment Overview"];
    var canOpenUserOverview = User.IsInRole("Admin") || User.IsInRole("Landlord") || User.IsInRole("Manager");
    var isTenantWorkspace = User.IsInRole("Tenant") && !User.IsInRole("Admin") && !User.IsInRole("Landlord");

    var apartment = Model.Apartment;
    var documents = Model.Documents?.OrderByDescending(doc => doc.UploadedAt).ToList() ?? new List<Common.CommunicationModels.DocumentDto>();
    var apartmentImages = documents.Where(doc => doc.DocumentType == DocumentTypeEnum.ApartmentImage).ToList();
    var apartmentDocuments = documents.Where(doc => doc.DocumentType != DocumentTypeEnum.ApartmentImage).ToList();
    var owners = Model.Owners ?? new List<Common.CommunicationModels.ApartmentOwnerDto>();
    var tenancies = Model.Tenancies ?? new List<Common.CommunicationModels.TenancyDto>();
    var latestTenancy = Model.LatestTenancy;
    var latestTenancyMembers = Model.LatestTenancyMembers ?? new List<Common.CommunicationModels.TenancyMemberDto>();
    var reminderRules = apartment.RentReminderRules.OrderBy(rule => rule.SortOrder).ToList();
    var today = DateTimeOffset.UtcNow.Date;
    var localToday = DateTime.Today;

    string MemberRoleLabel(string role) =>
        string.Equals(role, TenancyMemberRoleEnum.MainTenant.ToString(), StringComparison.OrdinalIgnoreCase)
            ? T["Main Tenant"].Value
            : T[role].Value;

    string GetRelativeDateLabel(DateTimeOffset value)
    {
        var date = value.LocalDateTime.Date;
        var dayDifference = (date - localToday).Days;

        if (dayDifference == 0)
        {
            return T["Today"].Value;
        }

        if (dayDifference == 1)
        {
            return T["Tomorrow"].Value;
        }

        if (dayDifference == -1)
        {
            return T["Yesterday"].Value;
        }

        var isFuture = dayDifference > 0;
        var earlierDate = isFuture ? localToday : date;
        var laterDate = isFuture ? date : localToday;
        var months = ((laterDate.Year - earlierDate.Year) * 12) + laterDate.Month - earlierDate.Month;

        if (earlierDate.AddMonths(months) > laterDate)
        {
            months--;
        }

        var days = (laterDate - earlierDate.AddMonths(months)).Days;
        var monthLabel = months switch
        {
            0 => string.Empty,
            1 => T["1 month"].Value,
            _ => T["{0} months", months].Value
        };
        var dayLabel = days switch
        {
            0 => string.Empty,
            1 => T["1 day"].Value,
            _ => T["{0} days", days].Value
        };
        var durationLabel = !string.IsNullOrWhiteSpace(monthLabel) && !string.IsNullOrWhiteSpace(dayLabel)
            ? T["{0} and {1}", monthLabel, dayLabel].Value
            : monthLabel + dayLabel;

        return isFuture
            ? T["In {0}", durationLabel].Value
            : T["{0} ago", durationLabel].Value;
    }

    string GetTenancyState(Common.CommunicationModels.TenancyDto tenancy)
    {
        if (!string.IsNullOrWhiteSpace(tenancy.Status))
        {
            return tenancy.Status;
        }

        if (tenancy.StartDate.Date > today)
        {
            return "Upcoming";
        }

        if (tenancy.EndDate.HasValue && tenancy.EndDate.Value.Date < today)
        {
            return "Closed";
        }

        return "Active";
    }

    string GetTenancyStateClass(string state) => state switch
    {
        "Active" => "rh-chip-primary",
        "Month-to-month" => "rh-chip-primary",
        "Upcoming" => "rh-chip-info",
        _ => "rh-chip-warning"
    };

    int GetTenancySortRank(Common.CommunicationModels.TenancyDto tenancy) => GetTenancyState(tenancy) switch
    {
        "Active" => 0,
        "Upcoming" => 1,
        _ => 2
    };

    var sortedTenancies = tenancies
        .OrderBy(GetTenancySortRank)
        .ThenBy(tenancy => GetTenancyState(tenancy) == "Upcoming" ? tenancy.StartDate : DateTimeOffset.MaxValue)
        .ThenByDescending(tenancy => tenancy.StartDate)
        .ToList();

    var activeTenancies = tenancies.Count(tenancy => GetTenancyState(tenancy) == "Active");
    var memberCount = Model.LatestTenancyMemberCount;
    var currentApartmentImage = apartmentImages.FirstOrDefault();
    var averageRent = tenancies.Any() ? tenancies.Average(tenancy => tenancy.MonthlyRent) : apartment.Price;
}

<section class="rh-overview-shell rh-apartment-shell"
         data-apartment-overview-root="true"
         data-overview-content-url="@Url.Action("OverviewContent", "Apartments", new { id = apartment.Id })">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-controller="Properties" asp-action="Overview" asp-route-id="@apartment.PropertyId">&#8592; @T["Back to property overview"]</a>
            <p class="rh-kicker">@T["Apartment Workspace"]</p>
            <h1 class="rh-heading-title">@apartment.Name</h1>
            <p class="rh-heading-subtitle">@apartment.PropertyName - @T[ApartmentTypeDisplayHelper.ResourceKey(apartment.Type)] - @T[apartment.Status ?? string.Empty]</p>

            <div class="rh-overview-badges">
                @if (Model.CanViewFinancialInformation)
                {
                <span class="rh-chip rh-chip-primary">@T["{0} rent", apartment.Price.ToString("N0", CultureInfo.CurrentCulture)]</span>
                }
                <span class="rh-chip rh-chip-info">@T["{0} sqm", apartment.Area?.ToString("N0", CultureInfo.CurrentCulture) ?? "0"]</span>
                <span class="rh-chip rh-chip-info">@(apartment.FloorNumber == 0 ? T["Ground floor"] : T["Floor {0}", apartment.FloorNumber])</span>
                <span class="rh-chip @(Model.CanWrite ? "rh-chip-primary" : "rh-chip-warning")">@(Model.CanWrite ? T["Write access"] : T["Read access"])</span>
            </div>
        </div>

        @if (apartment.PropertyMapEnabled || Model.CanWrite || !isTenantWorkspace)
        {
            <div class="rh-overview-hero-actions">
                @if (!isTenantWorkspace)
                {
                    <a class="btn rh-btn-subtle" asp-action="ReminderSettings" asp-route-id="@apartment.Id">@T["Apartment reminder settings"]</a>
                }
                @if (Model.CanWrite)
                {
                    <button type="button" class="btn rh-btn-primary" data-bs-toggle="modal" data-bs-target="#editApartmentModal">@T["Edit apartment"]</button>
                }
                @if (apartment.PropertyMapEnabled)
                {
                    <a class="btn rh-btn-subtle" asp-controller="Properties" asp-action="Map" asp-route-id="@apartment.PropertyId">@T["Property Map"]</a>
                }
            </div>
        }
    </section>

    <section class="rh-apartment-commanddeck rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head">
            <div>
                <h2 class="rh-dashboard-panel-title">@T["Apartment overview"]</h2>
                <p class="rh-dashboard-panel-copy">@T["Live tenancy, member, reminder, and occupancy signals in one apartment board."]</p>
            </div>
            <div class="rh-dashboard-range-chip">@T["Live apartment view"]</div>
        </div>

        <div class="rh-apartment-commanddeck-grid">
            <div class="rh-overview-bigstat">
                <span>@T["Active tenancies"]</span>
                <strong>@activeTenancies</strong>
                <small>@T["Current apartment occupancy records"]</small>
            </div>
            @if (Model.CanViewFinancialInformation)
            {
            <div class="rh-overview-bigstat alt">
                <span>@T["Average tenancy rent"]</span>
                <strong>@averageRent.ToString("N0", CultureInfo.CurrentCulture)</strong>
                <small>@T["Latest tenancy billing snapshot"]</small>
            </div>
            }
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Members"]</span>
                <strong>@memberCount</strong>
                <small>@T["Owners and apartment collaborators"]</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Status"]</span>
                <strong>@T[apartment.Status ?? string.Empty]</strong>
                <small>@T["Operational apartment state"]</small>
            </div>
            @if (!isTenantWorkspace)
            {
                <div class="rh-apartment-stat-card rh-card-spotlight">
                    <span>@T["Automatic rent reminders"]</span>
                    <strong>@reminderRules.Count(rule => rule.IsEnabled)</strong>
                    <small>@T["Active rules for unpaid rent"]</small>
                </div>
            }
        </div>
    </section>

    <section class="rh-overview-workgrid rh-apartment-workgrid">
        <div class="rh-overview-maincolumn">
            <article class="rh-overview-image-card rh-panel rh-panel-elevated" data-apartment-section="images">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Apartment images"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Keep the gallery close at hand and manage the image currently in view."]</p>
                    </div>

                    @if (Model.CanManageDocuments)
                    {
                        <div class="rh-overview-inline-actions">
                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentImagesModal">@T["Add+"]</button>
                            <button type="button" class="rh-icon-btn" data-bs-toggle="modal" data-bs-target="#manageApartmentImageModal" data-apartment-image-manage-open="true" title="Manage current apartment image" aria-label="Manage current apartment image">
                                <span class="rh-icon-pencil"></span>
                            </button>
                        </div>
                    }
                </div>

                @if (!apartmentImages.Any())
                {
                    <div class="rh-property-image-placeholder rh-apartment-image-placeholder">
                        <strong>@T["No apartment images yet"]</strong>
                        <span>@T["Add one or more landscape images so this apartment has a proper visual gallery."]</span>
                        @if (Model.CanManageDocuments)
                        {
                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentImagesModal">@T["Add images"]</button>
                        }
                    </div>
                }
                else
                {
                    <div class="rh-apartment-gallery" data-apartment-gallery="true">
                        <div class="rh-apartment-gallery-stage">
                            @for (var index = 0; index < apartmentImages.Count; index++)
                            {
                                var image = apartmentImages[index];
                                <div class="rh-apartment-gallery-slide @(index == 0 ? "is-active" : string.Empty)"
                                     data-gallery-slide
                                     data-document-id="@image.Id"
                                     data-image-url="@image.BlobUrl"
                                     data-image-name="@image.FileName">
                                    <button type="button" class="rh-property-image-button" data-bs-toggle="modal" data-bs-target="#apartmentImageLightbox" data-image-lightbox-trigger="true" data-image-url="@image.BlobUrl" data-image-name="@image.FileName" aria-label="Open apartment image">
                                        <img src="@image.BlobUrl" alt="@image.FileName" class="rh-property-image" loading="lazy" />
                                    </button>
                                </div>
                            }

                            @if (apartmentImages.Count > 1)
                            {
                                <button type="button" class="rh-gallery-nav prev" data-gallery-nav="prev" aria-label="@T["Previous image"]">&#8592;</button>
                                <button type="button" class="rh-gallery-nav next" data-gallery-nav="next" aria-label="@T["Next image"]">&#8594;</button>
                            }
                        </div>

                        <div class="rh-apartment-gallery-footer">
                            <div>
                                <strong data-gallery-current-name>@currentApartmentImage?.FileName</strong>
                                <small><span data-gallery-current-index>1</span> / @T["{0} image(s)", apartmentImages.Count]</small>
                            </div>
                        </div>
                    </div>
                }
            </article>

            <article class="rh-overview-docs-card rh-panel rh-panel-elevated rh-overview-docs-compact" data-apartment-section="documents">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Apartment documents"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Reference files and operational records for this apartment."]</p>
                    </div>

                    @if (Model.CanManageDocuments)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentDocumentModal">@T["Add+"]</button>
                    }
                </div>

                @if (!apartmentDocuments.Any())
                {
                    <div class="rh-empty">@T["No apartment documents uploaded yet."]</div>
                }
                else
                {
                    <div class="rh-document-list rh-document-list-compact">
                        @foreach (var document in apartmentDocuments)
                        {
                            <article class="rh-document-item rh-document-item-previewable rh-card-spotlight">
                                <div class="rh-document-item-copy">
                                    <a asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@document.Id" class="rh-document-title-link">@document.FileName</a>
                                    <small>@T[document.DocumentType.ToString()] - @document.UploadedAt.LocalDateTime.ToString("d", CultureInfo.CurrentCulture)</small>
                                </div>
                                <div class="rh-document-actions">
                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@document.Id">@T["Preview"]</a>
                                    @if (Model.CanManageDocuments)
                                    {
                                        <form method="post" asp-action="DeleteDocument" data-confirm-modal="true" data-confirm-title="@T["Delete apartment document?"]" data-confirm-message="@T["This document will be removed from the apartment."]" data-confirm-proceed="@T["Delete document"]">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="apartmentId" value="@apartment.Id" />
                                            <input type="hidden" name="documentId" value="@document.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">@T["Delete"]</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>

        </div>

        <div class="rh-overview-sidecolumn rh-overview-sidecolumn-priority">
            <article class="rh-overview-members-card rh-panel rh-panel-elevated" data-apartment-section="members">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Latest tenancy members"]</h2>
                        @if (latestTenancy != null)
                        {
                            <p class="rh-dashboard-panel-copy">@T["All members from the latest tenancy, whether it is active or closed."]</p>
                        }
                        else
                        {
                            <p class="rh-dashboard-panel-copy">@T["Members from the most recent tenancy will appear here."]</p>
                        }
                    </div>

                </div>

                @if (latestTenancy != null && Model.CanViewLatestTenancyMembers)
                {
                    <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="members">
                        <input type="hidden" name="id" value="@apartment.Id" />
                        <input type="hidden" name="tenancySearch" value="@Model.TenancySearch" />
                        <div class="rh-search-input-wrap">
                            <span class="rh-search-icon"></span>
                            <input class="form-control rh-input js-auto-submit" type="text" name="memberSearch" value="@Model.MemberSearch" placeholder="@T["Search latest tenancy members"]" autocomplete="off" />
                        </div>
                    </form>
                }

                @if (latestTenancy == null)
                {
                    <div class="rh-empty">@T["No tenancy records linked to this apartment yet."]</div>
                }
                else if (!Model.CanViewLatestTenancyMembers)
                {
                    <div class="rh-empty">@T["You do not have permission to view the members of this tenancy."]</div>
                }
                else if (!latestTenancyMembers.Any())
                {
                    <div class="rh-empty">@(string.IsNullOrWhiteSpace(Model.MemberSearch) ? T["No tenancy members added yet."] : T["No tenancy members match this search."])</div>
                }
                else
                {
                    <div class="rh-member-stack">
                        @foreach (var member in latestTenancyMembers)
                        {
                            <article class="rh-member-card rh-card-spotlight">
                                <div class="rh-member-card-copy">
                                    <strong>@member.FullName</strong>
                                    <small>@MemberRoleLabel(member.Role) • @(string.IsNullOrWhiteSpace(member.Email) ? T["No email saved"].Value : member.Email)</small>
                                    <small>@(member.EmailConfirmed ? T["Email confirmed"].Value : T["Email activation pending"].Value)</small>
                                </div>

                                <div class="rh-member-card-actions">
                                    <span class="rh-chip @(string.Equals(member.Role, TenancyMemberRoleEnum.MainTenant.ToString(), StringComparison.OrdinalIgnoreCase) ? "rh-chip-primary" : "rh-chip-info")">@MemberRoleLabel(member.Role)</span>
                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="Profile" asp-action="Index" asp-route-userId="@member.MemberId" asp-route-tenancyId="@latestTenancy.Id">@T["View information"]</a>
                                    @if (canOpenUserOverview)
                                    {
                                        <a class="btn btn-sm rh-btn-subtle" asp-controller="AdminUsers" asp-action="Overview" asp-route-userId="@member.MemberId">@T["User overview"]</a>
                                    }
                                    @if (Model.CanEditMemberEmails)
                                    {
                                        <button type="button" class="btn btn-sm rh-btn-subtle" data-bs-toggle="modal" data-bs-target="#editApartmentMemberEmailModal" data-member-id="@member.MemberId" data-member-name="@member.FullName" data-member-email="@member.Email">@T["Edit email"]</button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }

                @if (owners.Any() || Model.CanManageMembers)
                {
                    <details class="rh-apartment-access-disclosure">
                        <summary>@T["Apartment access"] <span class="rh-chip rh-chip-info">@owners.Count</span></summary>
                        <div class="rh-apartment-access-content">
                            <div class="rh-overview-panel-head align-start">
                                <p class="rh-dashboard-panel-copy">@T["Owners and collaborators with apartment-level access."]</p>
                                @if (Model.CanManageMembers)
                                {
                                    <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentMemberModal">@T["Add+"]</button>
                                }
                            </div>
                            @if (!owners.Any())
                            {
                                <div class="rh-empty">@T["No apartment members assigned yet."]</div>
                            }
                            else
                            {
                                <div class="rh-member-stack">
                                    @foreach (var owner in owners.OrderBy(item => item.Role == ApartmentMemberRoleEnum.Owner ? 0 : 1).ThenByDescending(item => item.AssignedAt))
                                    {
                                        <article class="rh-member-card rh-card-spotlight">
                                            <div class="rh-member-card-copy">
                                                <strong>@owner.OwnerName</strong>
                                                <small>@T[owner.Role.ToString()] • @T["Assigned {0}", owner.AssignedAt.LocalDateTime.ToString("d", CultureInfo.CurrentCulture)]</small>
                                                <small>@owner.OwnerEmail</small>
                                            </div>
                                            <div class="rh-member-card-actions">
                                                <span class="rh-chip rh-chip-info">@T[owner.Role.ToString()]</span>
                                                <span class="rh-chip @(owner.Permission == PermissionLevelEnum.ReadWrite ? "rh-chip-primary" : "rh-chip-warning")">@T[owner.Permission.ToString()]</span>
                                                @if (canOpenUserOverview)
                                                {
                                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="AdminUsers" asp-action="Overview" asp-route-userId="@owner.OwnerId">@T["User overview"]</a>
                                                }
                                                @if (owner.CanEditEmail)
                                                {
                                                    <button type="button" class="btn btn-sm rh-btn-subtle" data-bs-toggle="modal" data-bs-target="#editApartmentMemberEmailModal" data-member-id="@owner.OwnerId" data-member-name="@owner.OwnerName" data-member-email="@owner.OwnerEmail">@T["Edit email"]</button>
                                                }
                                                @if (Model.CanManageMembers)
                                                {
                                                    <button type="button" class="btn btn-sm rh-btn-subtle" data-bs-toggle="modal" data-bs-target="#editApartmentMemberModal-@owner.Id">@T["Edit"]</button>
                                                    <form method="post" asp-action="RemoveOwner" data-confirm-modal="true" data-confirm-title="@T["Remove apartment member?"]" data-confirm-message="@T["This member will lose apartment access."]" data-confirm-proceed="@T["Remove member"]">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="apartmentId" value="@apartment.Id" />
                                                        <input type="hidden" name="assignmentId" value="@owner.Id" />
                                                        <button class="btn btn-sm rh-btn-outline-danger" type="submit">@T["Remove"]</button>
                                                    </form>
                                                }
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
            </article>

            <article class="rh-overview-units-card rh-panel rh-panel-elevated" data-apartment-section="tenancies">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Tenancies"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Track tenancy records linked to this apartment."]</p>
                    </div>

                    @if (Model.CanAddTenancy)
                    {
                        <a class="btn btn-sm rh-btn-primary" asp-controller="Tenancies" asp-action="Create" asp-route-apartmentId="@apartment.Id">@T["Add+"]</a>
                    }
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="tenancies">
                    <input type="hidden" name="id" value="@apartment.Id" />
                    <input type="hidden" name="memberSearch" value="@Model.MemberSearch" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input js-auto-submit" type="text" name="tenancySearch" value="@Model.TenancySearch" placeholder="@T["Search tenancy records"]" autocomplete="off" />
                    </div>
                </form>

                @if (!sortedTenancies.Any())
                {
                    <div class="rh-empty">@T["No tenancy records linked to this apartment yet."]</div>
                }
                else
                {
                    <div class="rh-unit-card-grid rh-unit-card-grid-compact rh-tenancy-card-grid">
                        @foreach (var tenancy in sortedTenancies)
                        {
                            var tenancyState = GetTenancyState(tenancy);
                            var tenancyStateClass = GetTenancyStateClass(tenancyState);
                            var startDateLabel = tenancy.StartDate.LocalDateTime.ToString("d", CultureInfo.CurrentCulture);
                            var endDateLabel = tenancy.EndDate?.LocalDateTime.ToString("d", CultureInfo.CurrentCulture) ?? T["Open term"].Value;
                            <article class="rh-unit-card rh-card-spotlight rh-tenancy-card-shell">
                                <div class="rh-unit-card-head rh-tenancy-card-head">
                                    <div>
                                        <h3>@T["Tenancy"]</h3>
                                        <small>@tenancy.ApartmentName</small>
                                    </div>
                                    <div class="rh-tenancy-card-head-actions">
                                        <span class="rh-chip @tenancyStateClass">@T[tenancyState]</span>
                                        <a class="btn btn-sm rh-btn-subtle" asp-controller="Tenancies" asp-action="Overview" asp-route-id="@tenancy.Id">@T["Open"]</a>
                                        @if (Model.CanEditTenancy)
                                        {
                                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#editTenancyModal-@tenancy.Id">@T["Edit"]</button>
                                        }
                                    </div>
                                </div>

                                <div class="rh-tenancy-dateband">
                                    <div class="rh-tenancy-datepill start">
                                        <span>@T["Start date"]</span>
                                        <strong>@startDateLabel</strong>
                                        <small class="rh-relative-date">@GetRelativeDateLabel(tenancy.StartDate)</small>
                                    </div>
                                    <div class="rh-tenancy-datepill end">
                                        <span>@T["End date"]</span>
                                        <strong>@endDateLabel</strong>
                                        @if (tenancy.EndDate.HasValue)
                                        {
                                            <small class="rh-relative-date">@GetRelativeDateLabel(tenancy.EndDate.Value)</small>
                                        }
                                    </div>
                                </div>

                                <div class="rh-unit-card-meta rh-tenancy-card-meta">
                                    @if (Model.CanViewFinancialInformation)
                                    {
                                    <span>@T["Monthly rent"] <strong>@tenancy.MonthlyRent.ToString("N0", CultureInfo.CurrentCulture) XAF</strong></span>
                                    }
                                    <span>@T["Apartment"] <strong>@tenancy.ApartmentName</strong></span>
                                    <span>@T["Max members"] <strong>@tenancy.MaxMembers</strong></span>
                                </div>

                            </article>
                        }
                    </div>
                }
            </article>

        </div>
    </section>
</section>

@if (Model.CanWrite || Model.CanEditTenancy || Model.CanManageMembers || Model.CanManageDocuments)
{
    @if (Model.CanWrite)
    {
        <div class="modal fade" id="editApartmentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rh-modal-content">
