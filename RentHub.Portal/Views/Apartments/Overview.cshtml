                            </div>

                            <div class="col-md-6">
                                <label class="form-label">@T["End date"] <span class="text-danger" data-edit-end-date-required hidden aria-hidden="true">*</span></label>
                                <input class="form-control rh-input" type="date" name="EndDate" value="@(tenancy.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty)" data-edit-end-date />
                            </div>

                            @if (Model.CanViewFinancialInformation)
                            {
                                <div class="col-md-6">
                                    <label class="form-label">@T["Monthly rent"] @if (Model.CanEditFinancialInformation) { <span class="text-danger" aria-hidden="true">*</span> }</label>
                                    <input class="form-control rh-input" type="text" inputmode="decimal" name="MonthlyRent" value="@tenancy.MonthlyRent.ToString("0.##", CultureInfo.CurrentCulture)" disabled="@(!Model.CanEditFinancialInformation)" required data-localized-decimal data-edit-monthly-rent />
                                    @if (!Model.CanEditFinancialInformation)
                                    {
                                        <input type="hidden" name="MonthlyRent" value="@tenancy.MonthlyRent.ToString(CultureInfo.InvariantCulture)" />
                                    }
                                </div>
                            }

                            <div class="col-md-6">
                                <label class="form-label">@T["Max members"] <span class="text-danger" aria-hidden="true">*</span></label>
                                <input class="form-control rh-input" type="number" name="MaxMembers" min="1" value="@tenancy.MaxMembers" required data-edit-max-members />
                                <small class="text-muted">@T["The selected dates must not overlap another tenancy for this apartment."]</small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">@T["Rent due day"] <span class="text-danger" aria-hidden="true">*</span></label>
                                <input class="form-control rh-input" type="number" name="RentDueDay" min="1" max="31" value="@tenancy.RentDueDay" required data-edit-rent-due-day />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">@T["Rent payment frequency"] <span class="text-danger" aria-hidden="true">*</span></label>
                                <div class="rh-select-wrap">
                                    <select class="form-select rh-input rh-select" name="PaymentIntervalMonths" required data-edit-payment-interval>
                                        @for (var monthCount = 1; monthCount <= 12; monthCount++)
                                        {
                                            var frequencyLabel = monthCount switch
                                            {
                                                1 => T["Monthly"].Value,
                                                3 => T["Quarterly"].Value,
                                                6 => T["Semiannual"].Value,
                                                12 => T["Annual"].Value,
                                                _ => T["Every {0} months", monthCount].Value
                                            };
                                            <option value="@monthCount" selected="@(tenancy.PaymentIntervalMonths == monthCount ? "selected" : null)">@frequencyLabel</option>
                                        }
                                    </select>
                                </div>
                                <small class="text-muted">@T["The payment frequency automatically determines and provisions each complete payment group."]</small>
                            </div>

                            <div class="col-md-6">
