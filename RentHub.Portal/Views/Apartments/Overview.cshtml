@model RentHub.Portal.ViewModels.Apartments.ApartmentOverviewVm
@using Common.Enums
@using System
@using System.Linq
@{
    ViewData["Title"] = "Apartment Overview";

    var apartment = Model.Apartment;
    var documents = Model.Documents?.OrderByDescending(doc => doc.UploadedAt).ToList() ?? new List<Common.CommunicationModels.DocumentDto>();
    var apartmentImages = documents.Where(doc => doc.DocumentType == DocumentTypeEnum.ApartmentImage).ToList();
    var apartmentDocuments = documents.Where(doc => doc.DocumentType != DocumentTypeEnum.ApartmentImage).ToList();
    var owners = Model.Owners ?? new List<Common.CommunicationModels.ApartmentOwnerDto>();
    var tenancies = Model.Tenancies ?? new List<Common.CommunicationModels.TenancyDto>();
    var today = DateTimeOffset.UtcNow.Date;

    string GetTenancyState(Common.CommunicationModels.TenancyDto tenancy)
    {
        if (tenancy.StartDate.Date > today)
        {
            return "Upcoming";
        }

        if (tenancy.EndDate.HasValue && tenancy.EndDate.Value.Date < today)
        {
            return "Closed";
        }

        return "Active";
    }

    string GetTenancyStateClass(string state) => state switch
    {
        "Active" => "rh-chip-primary",
        "Upcoming" => "rh-chip-info",
        _ => "rh-chip-warning"
    };

    int GetTenancySortRank(Common.CommunicationModels.TenancyDto tenancy) => GetTenancyState(tenancy) switch
    {
        "Active" => 0,
        "Upcoming" => 1,
        _ => 2
    };

    var sortedTenancies = tenancies
        .OrderBy(GetTenancySortRank)
        .ThenBy(tenancy => GetTenancyState(tenancy) == "Upcoming" ? tenancy.StartDate : DateTimeOffset.MaxValue)
        .ThenByDescending(tenancy => tenancy.StartDate)
        .ToList();

    var activeTenancies = tenancies.Count(tenancy => GetTenancyState(tenancy) == "Active");
    var memberCount = owners.Count;
    var currentApartmentImage = apartmentImages.FirstOrDefault();
    var averageRent = tenancies.Any() ? tenancies.Average(tenancy => tenancy.MonthlyRent) : apartment.Price;
}

<section class="rh-overview-shell rh-apartment-shell"
         data-apartment-overview-root="true"
         data-overview-content-url="@Url.Action("OverviewContent", "Apartments", new { id = apartment.Id })">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-controller="Properties" asp-action="Overview" asp-route-id="@apartment.PropertyId">&#8592; Back to property overview</a>
            <p class="rh-kicker">Apartment Workspace</p>
            <h1 class="rh-heading-title">@apartment.Name</h1>
            <p class="rh-heading-subtitle">@apartment.PropertyName - @apartment.Type - @apartment.Status</p>

            <div class="rh-overview-badges">
                <span class="rh-chip rh-chip-primary">@apartment.Price.ToString("N0") rent</span>
                <span class="rh-chip rh-chip-info">@(apartment.Area?.ToString("N0") ?? "0") sqm</span>
                <span class="rh-chip @(Model.CanWrite ? "rh-chip-primary" : "rh-chip-warning")">@(Model.CanWrite ? "Write access" : "Read access")</span>
            </div>
        </div>

        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-subtle" asp-controller="Properties" asp-action="Map" asp-route-id="@apartment.PropertyId">Property Map</a>
            <a class="btn rh-btn-primary" asp-controller="Properties" asp-action="Overview" asp-route-id="@apartment.PropertyId">Property Workspace</a>
        </div>
    </section>

    <section class="rh-apartment-commanddeck rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head">
            <div>
                <h2 class="rh-dashboard-panel-title">Apartment overview</h2>
                <p class="rh-dashboard-panel-copy">Live tenancy, member, reminder, and occupancy signals in one apartment board.</p>
            </div>
            <div class="rh-dashboard-range-chip">Live apartment view</div>
        </div>

        <div class="rh-apartment-commanddeck-grid">
            <div class="rh-overview-bigstat">
                <span>Active tenancies</span>
                <strong>@activeTenancies</strong>
                <small>Current apartment occupancy records</small>
            </div>
            <div class="rh-overview-bigstat alt">
                <span>Average tenancy rent</span>
                <strong>@averageRent.ToString("N0")</strong>
                <small>Latest tenancy billing snapshot</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>Members</span>
                <strong>@memberCount</strong>
                <small>Owners and apartment collaborators</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>Status</span>
                <strong>@apartment.Status</strong>
                <small>Operational apartment state</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>Rent reminder</span>
                <strong>@apartment.RentReminderDaysBeforeDue day(s)</strong>
                <small>Lead time before the next due date</small>
            </div>
        </div>
    </section>

    <section class="rh-overview-workgrid rh-apartment-workgrid">
        <div class="rh-overview-maincolumn">
            <article class="rh-overview-image-card rh-panel rh-panel-elevated" data-apartment-section="images">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Apartment images</h2>
                        <p class="rh-dashboard-panel-copy">Keep the gallery close at hand and manage the image currently in view.</p>
                    </div>

                    @if (Model.CanWrite)
                    {
                        <div class="rh-overview-inline-actions">
                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentImagesModal">Add+</button>
                            <button type="button" class="rh-icon-btn" data-bs-toggle="modal" data-bs-target="#manageApartmentImageModal" data-apartment-image-manage-open="true" title="Manage current apartment image" aria-label="Manage current apartment image">
                                <span class="rh-icon-pencil"></span>
                            </button>
                        </div>
                    }
                </div>

                @if (!apartmentImages.Any())
                {
                    <div class="rh-property-image-placeholder rh-apartment-image-placeholder">
                        <strong>No apartment images yet</strong>
                        <span>Add one or more landscape images so this apartment has a proper visual gallery.</span>
                        @if (Model.CanWrite)
                        {
                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentImagesModal">Add images</button>
                        }
                    </div>
                }
                else
                {
                    <div class="rh-apartment-gallery" data-apartment-gallery="true">
                        <div class="rh-apartment-gallery-stage">
                            @for (var index = 0; index < apartmentImages.Count; index++)
                            {
                                var image = apartmentImages[index];
                                <div class="rh-apartment-gallery-slide @(index == 0 ? "is-active" : string.Empty)"
                                     data-gallery-slide
                                     data-document-id="@image.Id"
                                     data-image-url="@image.BlobUrl"
                                     data-image-name="@image.FileName">
                                    <button type="button" class="rh-property-image-button" data-bs-toggle="modal" data-bs-target="#apartmentImageLightbox" data-image-lightbox-trigger="true" data-image-url="@image.BlobUrl" data-image-name="@image.FileName" aria-label="Open apartment image">
                                        <img src="@image.BlobUrl" alt="@image.FileName" class="rh-property-image" loading="lazy" />
                                    </button>
                                </div>
                            }

                            @if (apartmentImages.Count > 1)
                            {
                                <button type="button" class="rh-gallery-nav prev" data-gallery-nav="prev" aria-label="Previous image">&#8592;</button>
                                <button type="button" class="rh-gallery-nav next" data-gallery-nav="next" aria-label="Next image">&#8594;</button>
                            }
                        </div>

                        <div class="rh-apartment-gallery-footer">
                            <div>
                                <strong data-gallery-current-name>@currentApartmentImage?.FileName</strong>
                                <small><span data-gallery-current-index>1</span> / @apartmentImages.Count image(s)</small>
                            </div>
                        </div>
                    </div>
                }
            </article>

            <article class="rh-overview-members-card rh-panel rh-panel-elevated" data-apartment-section="reminders">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Apartment reminder settings</h2>
                        <p class="rh-dashboard-panel-copy">Control how early tenants are reminded about rent due dates and lease termination.</p>
                    </div>
                    @if (Model.CanWrite)
                    {
                        <button type="button" class="rh-icon-btn" id="apartmentReminderEditToggle" title="Edit apartment reminder settings" aria-label="Edit apartment reminder settings">
                            <span class="rh-icon-pencil"></span>
                        </button>
                    }
                </div>

                <form method="post" asp-action="UpdateReminderSettings" class="rh-inline-settings-grid rh-inline-editor-form" id="apartmentReminderForm" data-inline-editor="locked">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="apartmentId" value="@apartment.Id" />

                    <div>
                        <label class="form-label">Rent reminder lead days</label>
                        <input class="form-control rh-input" type="number" min="0" max="365" name="RentReminderDaysBeforeDue" value="@apartment.RentReminderDaysBeforeDue" @(Model.CanWrite ? "readonly" : "disabled") required />
                        <small class="text-muted">Example: 10 means the main tenant is reminded 10 days before the next unpaid due date.</small>
                    </div>

                    <div>
                        <label class="form-label">Lease termination lead days</label>
                        <input class="form-control rh-input" type="number" min="0" max="365" name="LeaseTerminationReminderDaysBeforeEnd" value="@apartment.LeaseTerminationReminderDaysBeforeEnd" @(Model.CanWrite ? "readonly" : "disabled") required />
                        <small class="text-muted">If the tenancy has an end date, the tenant will be notified this many days before the lease ends.</small>
                    </div>

                    <div class="rh-inline-settings-note">
                        Payment reminders use each tenancy rent amount, not the apartment reference price. If a tenant pays several periods ahead, the reminder schedule waits until that advance coverage is nearly exhausted.
                    </div>

                    @if (Model.CanWrite)
                    {
                        <div class="col-12 rh-inline-editor-actions" hidden>
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button class="btn rh-btn-subtle" type="button" id="apartmentReminderCancel">Cancel</button>
                                <button class="btn rh-btn-primary" type="submit">Save reminder settings</button>
                            </div>
                        </div>
                    }
                </form>
            </article>
        </div>

        <div class="rh-overview-sidecolumn rh-overview-sidecolumn-priority">
            <article class="rh-overview-members-card rh-panel rh-panel-elevated" data-apartment-section="members">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Apartment members</h2>
                        <p class="rh-dashboard-panel-copy">Owners and collaborators with apartment-level access.</p>
                    </div>

                    @if (Model.CanWrite)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentMemberModal">Add+</button>
                    }
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="members">
                    <input type="hidden" name="id" value="@apartment.Id" />
                    <input type="hidden" name="tenancySearch" value="@Model.TenancySearch" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input js-auto-submit" type="text" name="memberSearch" value="@Model.MemberSearch" placeholder="Search apartment members" autocomplete="off" />
                    </div>
                </form>
                @if (!owners.Any())
                {
                    <div class="rh-empty">No apartment members assigned yet.</div>
                }
                else
                {
                    <div class="rh-member-stack">
                        @foreach (var owner in owners.OrderBy(item => item.Role == ApartmentMemberRoleEnum.Owner ? 0 : 1).ThenByDescending(item => item.AssignedAt))
                        {
                            <article class="rh-member-card rh-card-spotlight">
                                <div class="rh-member-card-copy">
                                    <strong>@owner.OwnerName</strong>
                                    <small>@owner.Role • Assigned @owner.AssignedAt.LocalDateTime.ToString("dd MMM yyyy")</small>
                                </div>

                                <div class="rh-member-card-actions">
                                    <span class="rh-chip rh-chip-info">@owner.Role</span>
                                    <span class="rh-chip @(owner.Permission == PermissionLevelEnum.ReadWrite ? "rh-chip-primary" : "rh-chip-warning")">@owner.Permission</span>
                                    @if (Model.CanWrite)
                                    {
                                        <button type="button" class="btn btn-sm rh-btn-subtle" data-bs-toggle="modal" data-bs-target="#editApartmentMemberModal-@owner.Id">Edit</button>
                                        <form method="post" asp-action="RemoveOwner" data-confirm-modal="true" data-confirm-title="Remove apartment member?" data-confirm-message="This member will lose apartment access." data-confirm-proceed="Remove member">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="apartmentId" value="@apartment.Id" />
                                            <input type="hidden" name="assignmentId" value="@owner.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">Remove</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>

            <article class="rh-overview-units-card rh-panel rh-panel-elevated" data-apartment-section="tenancies">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Tenancies</h2>
                        <p class="rh-dashboard-panel-copy">Track tenancy records linked to this apartment.</p>
                    </div>

                    @if (Model.CanWrite)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addTenancyModal">Add+</button>
                    }
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="tenancies">
                    <input type="hidden" name="id" value="@apartment.Id" />
                    <input type="hidden" name="memberSearch" value="@Model.MemberSearch" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input js-auto-submit" type="text" name="tenancySearch" value="@Model.TenancySearch" placeholder="Search tenancy records" autocomplete="off" />
                    </div>
                </form>

                @if (!sortedTenancies.Any())
                {
                    <div class="rh-empty">No tenancy records linked to this apartment yet.</div>
                }
                else
                {
                    <div class="rh-unit-card-grid rh-unit-card-grid-compact rh-tenancy-card-grid">
                        @foreach (var tenancy in sortedTenancies)
                        {
                            var tenancyState = GetTenancyState(tenancy);
                            var tenancyStateClass = GetTenancyStateClass(tenancyState);
                            var startDateLabel = tenancy.StartDate.LocalDateTime.ToString("dd MMM yyyy");
                            var endDateLabel = tenancy.EndDate?.LocalDateTime.ToString("dd MMM yyyy") ?? "Open term";
                            <article class="rh-unit-card rh-card-spotlight rh-tenancy-card-shell">
                                <div class="rh-unit-card-head rh-tenancy-card-head">
                                    <div>
                                        <h3>Tenancy #@tenancy.Id</h3>
                                        <small>@tenancy.ApartmentName</small>
                                    </div>
                                    <div class="rh-tenancy-card-head-actions">
                                        <span class="rh-chip @tenancyStateClass">@tenancyState</span>
                                        <a class="btn btn-sm rh-btn-subtle" asp-controller="Tenancies" asp-action="Overview" asp-route-id="@tenancy.Id">Open</a>
                                        @if (Model.CanWrite)
                                        {
                                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#editTenancyModal-@tenancy.Id">Edit</button>
                                        }
                                    </div>
                                </div>

                                <div class="rh-tenancy-dateband">
                                    <div class="rh-tenancy-datepill start">
                                        <span>Start date</span>
                                        <strong>@startDateLabel</strong>
                                    </div>
                                    <div class="rh-tenancy-datepill end">
                                        <span>End date</span>
                                        <strong>@endDateLabel</strong>
                                    </div>
                                </div>

                                <div class="rh-unit-card-meta rh-tenancy-card-meta">
                                    <span>Monthly rent <strong>@tenancy.MonthlyRent.ToString("N0")</strong></span>
                                    <span>Apartment <strong>@tenancy.ApartmentName</strong></span>
                                    <span>Max members <strong>@tenancy.MaxMembers</strong></span>
                                </div>

                                <div class="rh-unit-card-schedule">
                                    <span>Paid through <strong>@(tenancy.PaidThroughDate?.LocalDateTime.ToString("dd MMM yyyy") ?? "Not yet covered")</strong></span>
                                    <span>Next due <strong>@(tenancy.NextRentDueDate?.LocalDateTime.ToString("dd MMM yyyy") ?? "Not scheduled")</strong></span>
                                    <span>Reminder <strong>@(tenancy.NextRentReminderDate?.LocalDateTime.ToString("dd MMM yyyy") ?? "Not scheduled")</strong></span>
                                    <span>Lease alert <strong>@(tenancy.LeaseTerminationReminderDate?.LocalDateTime.ToString("dd MMM yyyy") ?? "No lease end")</strong></span>
                                </div>

                                @if (tenancy.IsPaidInAdvance)
                                {
                                    <div class="rh-inline-hint">Tenant is currently covered in advance. Upcoming rent reminders will wait until the paid coverage window is almost finished.</div>
                                }
                            </article>
                        }
                    </div>
                }
            </article>

            <article class="rh-overview-docs-card rh-panel rh-panel-elevated rh-overview-docs-compact" data-apartment-section="documents">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Apartment documents</h2>
                        <p class="rh-dashboard-panel-copy">Reference files and operational records for this apartment.</p>
                    </div>

                    @if (Model.CanWrite)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentDocumentModal">Add+</button>
                    }
                </div>

                @if (!apartmentDocuments.Any())
                {
                    <div class="rh-empty">No apartment documents uploaded yet.</div>
                }
                else
                {
                    <div class="rh-document-list rh-document-list-compact">
                        @foreach (var document in apartmentDocuments)
                        {
                            <article class="rh-document-item rh-document-item-previewable rh-card-spotlight">
                                <div class="rh-document-item-copy">
                                    <a asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@document.Id" class="rh-document-title-link">@document.FileName</a>
                                    <small>@document.DocumentType - @document.UploadedAt.LocalDateTime.ToString("dd MMM yyyy")</small>
                                </div>
                                <div class="rh-document-actions">
                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@document.Id">Preview</a>
                                    @if (Model.CanWrite)
                                    {
                                        <form method="post" asp-action="DeleteDocument" data-confirm-modal="true" data-confirm-title="Delete apartment document?" data-confirm-message="This document will be removed from the apartment." data-confirm-proceed="Delete document">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="apartmentId" value="@apartment.Id" />
                                            <input type="hidden" name="documentId" value="@document.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">Delete</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </div>
    </section>
</section>

@if (Model.CanWrite)
{
    <div class="modal fade" id="addTenancyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="CreateTenancy" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ApartmentId" value="@apartment.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Add Tenancy</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Start date</label>
                            <input class="form-control rh-input" type="date" name="StartDate" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">End date</label>
                            <input class="form-control rh-input" type="date" name="EndDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Monthly rent</label>
                            <input class="form-control rh-input" type="number" name="MonthlyRent" min="0" step="0.01" value="@apartment.Price" required />
                            <small class="text-muted">You can set a tenancy-specific amount if the tenant negotiated a different arrangement.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Max members</label>
                            <input class="form-control rh-input" type="number" name="MaxMembers" min="1" value="1" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Contract document (optional)</label>
                            <input class="form-control rh-input" type="file" name="ContractDocument" accept=".pdf,application/pdf" />
                            <small class="text-muted">If provided, the tenancy contract is uploaded as a PDF right after the tenancy record is created.</small>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Create tenancy</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @foreach (var tenancy in sortedTenancies)
    {
        <div class="modal fade" id="editTenancyModal-@tenancy.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rh-modal-content">
                    <form method="post" asp-action="UpdateTenancy">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ApartmentId" value="@apartment.Id" />
                        <input type="hidden" name="TenancyId" value="@tenancy.Id" />

                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title">Edit Tenancy #@tenancy.Id</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Start date</label>
                                <input class="form-control rh-input" type="date" name="StartDate" value="@tenancy.StartDate.ToString("yyyy-MM-dd")" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">End date</label>
                                <input class="form-control rh-input" type="date" name="EndDate" value="@(tenancy.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Monthly rent</label>
                                <input class="form-control rh-input" type="number" name="MonthlyRent" min="0" step="0.01" value="@tenancy.MonthlyRent" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Max members</label>
                                <input class="form-control rh-input" type="number" name="MaxMembers" min="1" value="@tenancy.MaxMembers" required />
                                <small class="text-muted">The selected dates must not overlap another tenancy for this apartment.</small>
                            </div>
                        </div>

                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn rh-btn-primary">Save tenancy</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @foreach (var owner in owners)
    {
        <div class="modal fade" id="editApartmentMemberModal-@owner.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rh-modal-content">
                    <form method="post" asp-action="UpdateOwnerPermission">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="apartmentId" value="@apartment.Id" />
                        <input type="hidden" name="assignmentId" value="@owner.Id" />

                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title">Edit Apartment Member</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body row g-3">
                            <div class="col-12">
                                <div class="rh-inline-settings-note">
                                    <strong>@owner.OwnerName</strong>
                                    <div class="mt-2">Adjust the apartment role and permission for this member.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Role</label>
                                <div class="rh-select-wrap">
                                    <select class="form-select rh-input rh-select" name="Role">
                                        <option value="Owner" selected="@(owner.Role == ApartmentMemberRoleEnum.Owner ? "selected" : null)">Owner</option>
                                        <option value="Manager" selected="@(owner.Role == ApartmentMemberRoleEnum.Manager ? "selected" : null)">Manager</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Permission</label>
                                <div class="rh-select-wrap">
                                    <select class="form-select rh-input rh-select" name="Permission">
                                        <option value="ReadOnly" selected="@(owner.Permission == PermissionLevelEnum.ReadOnly ? "selected" : null)">ReadOnly</option>
                                        <option value="ReadWrite" selected="@(owner.Permission == PermissionLevelEnum.ReadWrite ? "selected" : null)">ReadWrite</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn rh-btn-primary">Save member</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="addApartmentMemberModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="AssignOwner">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="apartmentId" value="@apartment.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Add Apartment Member</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">Email</label>
                            <input class="form-control rh-input" name="Email" type="email" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Full name</label>
                            <input class="form-control rh-input" name="FullName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Country code</label>
                            <input class="form-control rh-input" name="CountryCode" inputmode="numeric" placeholder="e.g. +237" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone number</label>
                            <input class="form-control rh-input" name="PhoneNumber" inputmode="numeric" placeholder="e.g. 658772239" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Role</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="Role">
                                    <option value="Owner">Owner</option>
                                    <option value="Manager">Manager</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Permission</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="Permission">
                                    <option value="ReadOnly">ReadOnly</option>
                                    <option value="ReadWrite">ReadWrite</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Add member</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addApartmentDocumentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="UploadApartmentDocument" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="apartmentId" value="@apartment.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Add Apartment Document</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">Document file</label>
                            <input class="form-control rh-input" type="file" name="file" accept=".pdf,application/pdf" required />
                            <small class="text-muted">Only PDF files are allowed in this section.</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Document type</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="documentType">
                                    @foreach (var type in Enum.GetValues<DocumentTypeEnum>().Where(type => type != DocumentTypeEnum.PropertyImage && type != DocumentTypeEnum.ApartmentImage))
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Upload document</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addApartmentImagesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="UploadApartmentImages" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="apartmentId" value="@apartment.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Add Apartment Images</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">Select image files</label>
                            <input class="form-control rh-input" type="file" name="files" accept="image/*" multiple required />
                            <small class="text-muted">You can choose multiple images at once. Landscape images work best for the apartment gallery.</small>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Upload images</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="manageApartmentImageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title">Manage Apartment Image</h5>
                        <p class="text-muted mb-0">Replace or remove the image currently shown in the gallery.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body row g-3">
                    <div class="col-12">
                        <div class="rh-inline-settings-note">
                            <strong data-current-image-name>@(currentApartmentImage?.FileName ?? "No image selected yet")</strong>
                            <div class="mt-2">Use a landscape image under 2 MB for the best result.</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <form method="post" asp-action="UploadApartmentImage" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="apartmentId" value="@apartment.Id" />
                            <input type="hidden" name="currentDocumentId" value="@(currentApartmentImage?.Id)" />

                            <label class="form-label">Replace current image</label>
                            <input class="form-control rh-input" type="file" name="file" accept="image/*" required />
                            <small class="text-muted d-block mt-2">Uploading here replaces only the image currently displayed in the gallery.</small>

                            <div class="modal-footer border-0 px-0 pt-3 pb-0">
                                <button type="submit" class="btn rh-btn-primary">Save current image</button>
                            </div>
                        </form>
                    </div>

                    @if (currentApartmentImage != null)
                    {
                        <div class="col-12">
                            <form method="post" asp-action="DeleteApartmentImage" data-confirm-modal="true" data-confirm-title="Delete apartment image?" data-confirm-message="This will remove the image currently shown in the gallery." data-confirm-proceed="Delete image">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="apartmentId" value="@apartment.Id" />
                                <input type="hidden" name="documentId" value="@currentApartmentImage.Id" />

                                <div class="modal-footer border-0 px-0 pt-0 pb-0 justify-content-start">
                                    <button type="submit" class="btn rh-btn-outline-danger">Delete current image</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="apartmentImageLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rh-image-lightbox-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title">Apartment image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0">
                <img src="@(currentApartmentImage?.BlobUrl ?? string.Empty)"
                     alt="Apartment image preview"
                     class="rh-image-lightbox-preview"
                     id="apartmentImageLightboxPreview" />
            </div>
        </div>
    </div>
</div>


