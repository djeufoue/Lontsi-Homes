                                <div class="rh-select-wrap">
                                    <select class="form-select rh-input rh-select" name="EndBehavior" required data-edit-end-behavior>
                                        <option value="NoEndDate" selected="@(tenancy.EndBehavior is TenancyEndBehaviorEnum.NoEndDate or TenancyEndBehaviorEnum.ContinueMonthToMonth ? "selected" : null)">@T["No end date"]</option>
                                        <option value="ExpireAutomatically" selected="@(tenancy.EndBehavior == TenancyEndBehaviorEnum.ExpireAutomatically ? "selected" : null)">@T["Expire automatically"]</option>
                                    </select>
                                </div>
                                <small class="text-muted" data-edit-no-end-copy>@T["The tenancy stays active until it is terminated. The rent schedule automatically maintains the next complete payment group."]</small>
                                <small class="text-muted" data-edit-expiry-copy hidden>@T["No new rent is generated automatically after the end date."]</small>
                            </div>
                        </div>

                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                            <button type="submit" class="btn rh-btn-primary" data-edit-tenancy-submit disabled>@T["Save tenancy"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

