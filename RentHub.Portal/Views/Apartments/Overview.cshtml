@section Scripts {
    <script>
        (() => {
            const noEndDateValue = "NoEndDate";

            const emailModal = document.getElementById("editApartmentMemberEmailModal");
            if (emailModal && emailModal.dataset.bound !== "true") {
                emailModal.dataset.bound = "true";
                emailModal.addEventListener("show.bs.modal", event => {
                    const button = event.relatedTarget;
                    document.getElementById("editApartmentMemberEmailUserId").value = button?.dataset.memberId ?? "";
                    document.getElementById("editApartmentMemberEmailValue").value = button?.dataset.memberEmail ?? "";
                    document.getElementById("editApartmentMemberEmailName").textContent = button?.dataset.memberName ?? "";
                });
            }

            document.querySelectorAll("[data-edit-tenancy-form]").forEach(form => {
                const startInput = form.querySelector("[data-edit-start-date]");
                const endInput = form.querySelector("[data-edit-end-date]");
                const endRequiredMarker = form.querySelector("[data-edit-end-date-required]");
                const behaviorInput = form.querySelector("[data-edit-end-behavior]");
                const rentInput = form.querySelector("[data-edit-monthly-rent]");
                const membersInput = form.querySelector("[data-edit-max-members]");
                const dueDayInput = form.querySelector("[data-edit-rent-due-day]");
                const paymentIntervalInput = form.querySelector("[data-edit-payment-interval]");
                const noEndCopy = form.querySelector("[data-edit-no-end-copy]");
                const expiryCopy = form.querySelector("[data-edit-expiry-copy]");
                const submitButton = form.querySelector("[data-edit-tenancy-submit]");

                const sync = () => {
                    const noEndDate = behaviorInput?.value === noEndDateValue;
                    const start = startInput?.value ?? "";
                    const end = endInput?.value ?? "";

                    if (endInput) {
                        endInput.min = start;
                        endInput.disabled = noEndDate;
                        endInput.required = !noEndDate;
                        if (noEndDate) endInput.value = "";
                    }
                    if (endRequiredMarker) endRequiredMarker.hidden = noEndDate;
                    if (noEndCopy) noEndCopy.hidden = !noEndDate;
                    if (expiryCopy) expiryCopy.hidden = noEndDate;

                    const rent = window.rhDecimals?.parse(rentInput?.value ?? "") ?? Number.NaN;
                    const members = Number.parseInt(membersInput?.value ?? "", 10);
                    const dueDay = Number.parseInt(dueDayInput?.value ?? "", 10);
                    const paymentInterval = Number.parseInt(paymentIntervalInput?.value ?? "", 10);
                    const rentIsValid = !rentInput || rentInput.disabled || (Number.isFinite(rent) && rent > 0);
                    const dateRangeIsValid = noEndDate || (!!endInput?.value && (!start || endInput.value >= start));
                    const isValid = !!start
                        && dateRangeIsValid
                        && rentIsValid
                        && Number.isInteger(members) && members >= 1
                        && Number.isInteger(dueDay) && dueDay >= 1 && dueDay <= 31
                        && Number.isInteger(paymentInterval) && paymentInterval >= 1 && paymentInterval <= 12
                        && form.checkValidity();

                    if (submitButton) {
                        submitButton.disabled = !isValid;
                        submitButton.setAttribute("aria-disabled", isValid ? "false" : "true");
                    }
                };

                form.addEventListener("input", sync);
                form.addEventListener("change", sync);
                sync();
            });
        })();
    </script>
}


