@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mt-1">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-2">Dashboard</h1>
                <p class="text-muted mb-0">Welcome back, @(User.Identity?.Name ?? "User").</p>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-muted mb-3">Quick Access</h2>

                @if (User.IsInRole("Landlord"))
                {
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" asp-controller="Properties" asp-action="Index">Properties</a>
                        <a class="btn btn-outline-primary" asp-controller="Apartments" asp-action="Index">Units</a>
                        <a class="btn btn-outline-primary" asp-controller="Tenancies" asp-action="Index">Tenancies</a>
                    </div>
                }
                else
                {
                    <a class="btn btn-primary" asp-controller="Tenancies" asp-action="Index">Open Tenancies</a>
                }
            </div>
        </div>
    </div>
</div>
