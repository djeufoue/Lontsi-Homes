@{
    ViewData["Title"] = "Dashboard";
}

<section class="rh-dashboard-hero">
    <div>
        <p class="rh-kicker">Operations Overview</p>
        <h1 class="rh-heading-title">Dashboard</h1>
        <p class="rh-heading-subtitle">Welcome back, @(User.Identity?.Name ?? "User"). Track your portfolio, team access, and latest actions in one workspace.</p>
    </div>
    <div class="rh-toolbar">
        <a class="btn rh-btn-primary" asp-controller="Properties" asp-action="Index">Go to Properties</a>
    </div>
</section>

<section class="rh-dashboard-metrics">
    <article class="rh-metric-card">
        <p class="rh-metric-label">Workspace Status</p>
        <p class="rh-metric-value">Online</p>
        <small>Real-time sync active</small>
    </article>
    <article class="rh-metric-card">
        <p class="rh-metric-label">Core Module</p>
        <p class="rh-metric-value">Properties</p>
        <small>Manage units, members, and documents</small>
    </article>
    <article class="rh-metric-card">
        <p class="rh-metric-label">Access Mode</p>
        <p class="rh-metric-value">Role Aware</p>
        <small>Permissions enforced by backend policy</small>
    </article>
</section>

<section class="rh-dashboard-grid">
    <article class="rh-panel rh-panel-elevated">
        <h2 class="rh-section-title">Property Workspace</h2>
        <p class="mb-3">Open the full property module to create and manage assets, assign property members, upload documents, and control property-level settings.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn rh-btn-primary" asp-controller="Properties" asp-action="Index">Open Properties</a>
            <a class="btn rh-btn-subtle" asp-controller="Properties" asp-action="Index" asp-route-access="owned">View Owned Properties</a>
        </div>
    </article>

    <article class="rh-panel rh-panel-elevated">
        <h2 class="rh-section-title">Quick Guidance</h2>
        <ul class="rh-guidance-list mb-0">
            <li>Create a new property from the Properties page if your role and subscription allow it.</li>
            <li>Use Property Overview to manage units, members, settings, and documents.</li>
            <li>Configure success and error dialog behavior per property for a consistent user experience.</li>
        </ul>
    </article>
</section>
