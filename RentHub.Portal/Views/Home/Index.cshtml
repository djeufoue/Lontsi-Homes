@model RentHub.Portal.ViewModels.Home.PublicHomeIndexVm
@using System.Globalization
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Lontsi Homes";
    var usdToXafRate = Configuration.GetValue<decimal?>("Subscriptions:UsdToXafRate") ?? 565m;
    if (usdToXafRate <= 0)
    {
        usdToXafRate = 565m;
    }
    string FormatUsd(decimal xaf) => (xaf / usdToXafRate).ToString("C", CultureInfo.GetCultureInfo("en-US"));
    string FormatXaf(decimal xaf) => xaf.ToString("N0", CultureInfo.InvariantCulture);
    List<string> PlanFeatures(RentHub.Portal.ViewModels.Auth.SubscriptionPlanOptionVm plan)
    {
        var features = (plan.FeatureHighlights ?? string.Empty)
            .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(feature => !string.IsNullOrWhiteSpace(feature))
            .ToList();

        return features.Count > 0
            ? features
            : new List<string> { "Landlord onboarding and verification", "Property and apartment workspace access", "Reminder and payment follow-up tools" };
    }
}

<section class="rh-landing-home">
    <section class="alert alert-warning rh-test-mode-banner" role="status">
        <strong>Testing mode:</strong> Lontsi Homes is currently open for testing while SMS verification and payment operations are being finalized. Please explore the platform and share feedback; phone-number verification is temporarily skipped while Twilio approval is pending.
    </section>

    <section class="rh-landing-hero-block">
        <div class="rh-landing-hero-surface">
            <div class="rh-landing-hero-topline">
                <span class="rh-landing-brand-mark">Lontsi Homes / Landlord Workspace</span>
                <nav class="rh-landing-anchor-nav" aria-label="Landing sections">
                    <a href="#operations">Operations</a>
                    <a href="#workflow">Workflow</a>
                    <a href="#pricing">Pricing</a>
                </nav>
            </div>

            <div class="rh-landing-hero-grid">
                <div class="rh-landing-hero-copy">
                    <span class="rh-landing-pill">Built for landlords who need control</span>
                    <h1>Manage tenants, rent follow-up, and subscription access from one professional platform.</h1>
                    <p>
                        Lontsi Homes helps landlords structure the work that matters most: tenant visibility, rent collection
                        preparation, reminders, property organization, and operational follow-up without scattered tools.
                    </p>

                    <div class="rh-landing-hero-actions">
                        @if (Model.IsLandlordOperator)
                        {
                            <a class="btn rh-btn-primary" asp-controller="Properties" asp-action="Index">Open My Properties</a>
                        }
                        else
                        {
                            <a class="btn rh-btn-primary" asp-controller="Auth" asp-action="Register">Create Landlord Account</a>
                        }

                        <a class="btn rh-btn-subtle" asp-controller="Auth" asp-action="Login">Log In</a>
                    </div>

                    <ul class="rh-landing-hero-list">
                        <li>Track tenant occupancy by property and apartment.</li>
                        <li>Prepare MTN, Orange, and Visa payment workflows through the platform.</li>
                        <li>Follow upcoming expirations, unpaid rent, and landlord reminders.</li>
                    </ul>
                </div>

                <aside class="rh-landing-hero-aside">
                    <div class="rh-landing-console-card">
                        <div class="rh-landing-console-head">
                            <div>
                                <span>Operations Snapshot</span>
                                <strong>Landlord overview</strong>
                            </div>
                            <span class="rh-landing-live-dot">Live</span>
                        </div>

                        <div class="rh-landing-console-metrics">
                            <article>
                                <strong>Tenants</strong>
                                <span>Keep occupancy and unit status organized.</span>
                            </article>
                            <article>
                                <strong>Payments</strong>
                                <span>Prepare rent collection and payout verification.</span>
                            </article>
                            <article>
                                <strong>Reminders</strong>
                                <span>Stay ahead of late or upcoming rent events.</span>
                            </article>
                        </div>

                        <div class="rh-landing-console-timeline">
                            <div>
                                <span>Account onboarding</span>
                                <strong>Email, payout number, and WhatsApp verification</strong>
                            </div>
                            <div>
                                <span>Subscription activation</span>
                                <strong>Enable property publishing and management limits</strong>
                            </div>
                            <div>
                                <span>Rent follow-up</span>
                                <strong>Monitor due dates, unpaid rent, and expiring occupancies</strong>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>

        <div class="rh-landing-service-rail">
            <article class="rh-landing-service-tile is-accent">
                <span class="rh-landing-service-icon">01</span>
                <h3>Tenant Management</h3>
                <p>Keep tenant occupancy, unit assignment, and apartment status in one workspace.</p>
            </article>

            <article class="rh-landing-service-tile">
                <span class="rh-landing-service-icon">02</span>
                <h3>Payment Operations</h3>
                <p>Prepare subscription and rent payment flows with verified landlord payout setup.</p>
            </article>

            <article class="rh-landing-service-tile">
                <span class="rh-landing-service-icon">03</span>
                <h3>Reminder Coverage</h3>
                <p>Reduce missed follow-up on unpaid rent, due dates, and soon-to-expire occupancy.</p>
            </article>

            <article class="rh-landing-service-tile">
                <span class="rh-landing-service-icon">04</span>
                <h3>Landlord Onboarding</h3>
                <p>Create an account, verify numbers, choose a plan, and start publishing properties.</p>
            </article>
        </div>
    </section>

    <section id="operations" class="rh-landing-story">
        <div class="rh-landing-story-visual">
            <div class="rh-landing-dashboard-shell">
                <div class="rh-landing-dashboard-topbar">
                    <span>Workspace Modules</span>
                    <strong>Focused landlord operations</strong>
                </div>

                <div class="rh-landing-dashboard-grid">
                    <article class="rh-landing-dashboard-widget">
                        <span>Tenant registry</span>
                        <strong>Occupancy and apartment status</strong>
                    </article>
                    <article class="rh-landing-dashboard-widget">
                        <span>Rent reminders</span>
                        <strong>Due, unpaid, and upcoming expiration follow-up</strong>
                    </article>
                    <article class="rh-landing-dashboard-widget">
                        <span>Subscription access</span>
                        <strong>Publishing rights and landlord activation</strong>
                    </article>
                    <article class="rh-landing-dashboard-widget">
                        <span>Payment readiness</span>
                        <strong>MTN, Orange, and Visa preparation</strong>
                    </article>
                </div>

                <div class="rh-landing-dashboard-band">
                    <span>Professional structure</span>
                    <strong>One platform for properties, apartments, tenants, reminders, and landlord actions.</strong>
                </div>
            </div>
        </div>

        <div class="rh-landing-story-copy">
            <span class="rh-landing-section-kicker">Why Lontsi Homes</span>
            <h2>Designed around the real landlord workflow, not around scattered manual follow-up.</h2>
            <p>
                The platform is being shaped around the first release priorities that matter most for daily operations:
                managing tenants cleanly, organizing units, preparing payment flows, and making follow-up easier when rent
                deadlines or occupancy changes need attention.
            </p>

            <div class="rh-landing-benefit-grid">
                <article class="rh-landing-benefit-card">
                    <h3>Clear tenant visibility</h3>
                    <p>Know who is in which apartment, what the unit status is, and what follow-up is needed next.</p>
                </article>
                <article class="rh-landing-benefit-card">
                    <h3>Operational payment view</h3>
                    <p>Keep subscription access, landlord verification, and rent collection preparation connected.</p>
                </article>
                <article class="rh-landing-benefit-card">
                    <h3>Practical reminders</h3>
                    <p>Reduce missed actions when rent is unpaid or when tenancy expiration is approaching.</p>
                </article>
                <article class="rh-landing-benefit-card">
                    <h3>Simple onboarding</h3>
                    <p>Lead new landlords from account creation to workspace activation with fewer moving parts.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="rh-landing-dark-section">
        <div class="rh-landing-dark-copy">
            <span class="rh-landing-section-kicker is-light">Operational Value</span>
            <h2>One platform. Less confusion. Better follow-up.</h2>
            <p>
                Lontsi Homes helps landlords reduce fragmentation by centralizing the parts of rental management that are usually
                spread across messages, spreadsheets, memory, and payment screenshots.
            </p>
        </div>

        <div class="rh-landing-dark-grid">
            <article class="rh-landing-dark-card">
                <h3>Property structure</h3>
                <p>Keep properties and apartments organized with a cleaner operational view.</p>
            </article>
            <article class="rh-landing-dark-card is-featured">
                <h3>Tenant follow-up</h3>
                <p>Track who occupies what, what needs attention, and what rent action is coming next.</p>
            </article>
            <article class="rh-landing-dark-card">
                <h3>Reminder discipline</h3>
                <p>Give upcoming expirations and unpaid rent their own place in the workflow.</p>
            </article>
            <article class="rh-landing-dark-card">
                <h3>Payment readiness</h3>
                <p>Prepare landlord operations for platform-based rent and subscription payment flows.</p>
            </article>
        </div>
    </section>

    <section id="workflow" class="rh-landing-workflow">
        <div class="rh-landing-workflow-head">
            <span class="rh-landing-section-kicker">How It Works</span>
            <h2>A clean onboarding path for landlords</h2>
            <p>
                The experience is built so a landlord can move from account creation to real rental operations
                without unnecessary friction.
            </p>
        </div>

        <div class="rh-landing-workflow-grid">
            <article class="rh-landing-step-card">
                <span>01</span>
                <h3>Create your landlord account</h3>
                <p>Start from the public page and open a dedicated landlord workspace.</p>
            </article>
            <article class="rh-landing-step-card">
                <span>02</span>
                <h3>Verify your key numbers</h3>
                <p>Confirm the payout number and WhatsApp number that support operations.</p>
            </article>
            <article class="rh-landing-step-card">
                <span>03</span>
                <h3>Choose your subscription</h3>
                <p>Activate the plan that unlocks property management and publishing rights.</p>
            </article>
            <article class="rh-landing-step-card">
                <span>04</span>
                <h3>Manage tenants and rent follow-up</h3>
                <p>Use the platform daily to track occupancies, reminders, and payment readiness.</p>
            </article>
        </div>
    </section>

    <section id="pricing" class="rh-landing-pricing">
        <div class="rh-landing-pricing-shell">
            <article class="rh-landing-pricing-intro">
                <span class="rh-landing-section-kicker is-light">Subscription</span>
                <h2>Choose the plan that fits your rental business.</h2>
                <p>
                    Monthly billing for flexibility. Yearly pricing is shown with a two-month saving.
                </p>

                <div class="rh-landing-pricing-toggle">
                    <span class="is-active">Monthly</span>
                    <span>Yearly (Save 2 months)</span>
                </div>
            </article>

            @if (Model.Plans.Count == 0)
            {
                <article class="rh-landing-pricing-card">
                    <h3>Plans loading</h3>
                    <p>Subscription plans will appear here as soon as pricing data is available.</p>
                </article>
            }
            else
            {
                @for (var i = 0; i < Model.Plans.Count; i++)
                {
                    var plan = Model.Plans[i];
                    var isFeatured = plan.IsRecommended;
                    var features = PlanFeatures(plan);

                    <article class="rh-landing-pricing-card @(isFeatured ? "is-featured" : null)">
                        @if (isFeatured)
                        {
                            <span class="rh-landing-pricing-badge">Recommended</span>
                        }

                        <h3>@plan.Name</h3>
                        @if (plan.IsContactSales)
                        {
                            <strong>Custom pricing</strong>
                            <p class="rh-landing-pricing-meta">Unlimited scale</p>
                        }
                        else
                        {
                            <strong>@FormatUsd(plan.Price) <span class="rh-price-period">/ month</span></strong>
                            <p class="rh-landing-pricing-meta">Approx. @FormatXaf(plan.Price) XAF / month</p>
                            @if (plan.AnnualPrice.HasValue)
                            {
                                <p class="rh-landing-pricing-meta">Yearly: @FormatUsd(plan.AnnualPrice.Value) - Approx. @FormatXaf(plan.AnnualPrice.Value) XAF</p>
                            }
                        }
                        <p>@(!string.IsNullOrWhiteSpace(plan.AudienceLabel) ? plan.AudienceLabel : plan.Description ?? "Professional landlord subscription plan")</p>

                        <ul class="rh-landing-pricing-list">
                            @foreach (var feature in features)
                            {
                                <li>@feature</li>
                            }
                        </ul>

                        <a class="btn @(isFeatured ? "rh-btn-primary" : "rh-btn-subtle") w-100" asp-controller="Auth" asp-action="Register">
                            @(plan.IsContactSales ? "Contact Sales" : $"Choose {plan.Name}")
                        </a>
                    </article>
                }
            }
        </div>
    </section>

    <section class="rh-landing-final-cta">
        <div>
            <span class="rh-landing-section-kicker">Start Here</span>
            <h2>Ready to run your landlord workflow from a more organized platform?</h2>
            <p>
                Create your landlord account, verify your details, choose a plan, and start managing tenants,
                properties, reminders, and payment operations with more structure.
            </p>
        </div>

        <div class="rh-landing-final-actions">
            @if (Model.IsLandlordOperator)
            {
                <a class="btn rh-btn-primary" asp-controller="Properties" asp-action="Index">Go to My Properties</a>
            }
            else
            {
                <a class="btn rh-btn-primary" asp-controller="Auth" asp-action="Register">Create Landlord Account</a>
            }

            <a class="btn rh-btn-subtle" asp-controller="Auth" asp-action="Login">Already have an account?</a>
        </div>
    </section>
</section>
