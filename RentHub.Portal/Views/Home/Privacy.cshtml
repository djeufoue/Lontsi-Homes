@model RentHub.Portal.ViewModels.Home.PublicSiteInfoVm
@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="rh-legal-page">
    <div class="rh-legal-shell">
        <div class="rh-legal-hero">
            <span class="rh-landing-section-kicker">Privacy</span>
            <h1>Privacy Policy</h1>
            <p>
                This page explains how @Model.SiteName collects, uses, and protects the information submitted by
                landlords, visitors, and workspace users.
            </p>
        </div>

        <div class="rh-legal-grid">
            <article class="rh-legal-card">
                <h2>Information collected</h2>
                <p>
                    The platform may collect account identity details, contact information, verification data,
                    property data, tenant-related operational records, and payment-related metadata needed to run
                    the service.
                </p>
            </article>

            <article class="rh-legal-card">
                <h2>Why information is used</h2>
                <p>
                    We use the information to manage account access, support verification flows, enable workspace
                    features, improve operational follow-up, and coordinate approved payment-related workflows.
                </p>
            </article>

            <article class="rh-legal-card">
                <h2>Provider involvement</h2>
                <p>
                    Some payment and messaging workflows may rely on third-party providers. Their own policies may
                    also apply when they process information related to transactions or notifications.
                </p>
            </article>

            <article class="rh-legal-card">
                <h2>Access and security</h2>
                <p>
                    Access to workspace areas is controlled by authentication, role-based permissions, and
                    verification steps designed to reduce unauthorized access and misuse.
                </p>
            </article>

            <article class="rh-legal-card">
                <h2>Retention and review</h2>
                <p>
                    Operational records may be retained as needed for service continuity, account review, and
                    compliance needs. Users may contact support for questions related to their data.
                </p>
            </article>

            <article class="rh-legal-card">
                <h2>Contact</h2>
                <p>
                    Privacy questions can be sent to <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a>.
                </p>
            </article>
        </div>
    </div>
</section>
