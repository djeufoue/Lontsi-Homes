@model Common.CommunicationModels.RentReceiptDto
@using Common.Enums
@{
    ViewData["Title"] = "Rent Receipt";

    string DateLabel(DateTimeOffset value) => value.LocalDateTime.ToString("dd MMM yyyy");
    string MethodLabel(PaymentMethodEnum method) => method == PaymentMethodEnum.Cash ? "Cash / off-platform" : method.ToString();
}

<section class="rh-overview-shell">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <p class="rh-kicker">System Receipt</p>
            <h1 class="rh-heading-title">@Model.ReceiptNumber</h1>
            <p class="rh-heading-subtitle">Generated by Lontsi Homes for a rent payment.</p>
        </div>
        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-subtle" asp-action="DownloadPayment" asp-route-paymentId="@Model.PaymentId">Download receipt</a>
            @if (!string.IsNullOrWhiteSpace(Model.ProviderReceiptUrl))
            {
                <a class="btn rh-btn-primary" href="@Model.ProviderReceiptUrl" target="_blank" rel="noopener">Open Stripe receipt</a>
            }
        </div>
    </section>

    <section class="rh-panel rh-panel-elevated rh-receipt-document">
        <div class="rh-receipt-header">
            <div>
                <span class="rh-kicker">Lontsi Homes</span>
                <h2>RECEIPT</h2>
            </div>
            <div class="rh-receipt-stamp">
                <strong>@Model.ReceiptNumber</strong>
                <span>Issued @DateLabel(Model.IssuedAt)</span>
            </div>
        </div>

        <div class="rh-receipt-grid">
            <div>
                <span>Tenant</span>
                <strong>@Model.TenantName</strong>
                <small>@Model.TenantEmail</small>
            </div>
            <div>
                <span>Landlord</span>
                <strong>@Model.LandlordName</strong>
                <small>@Model.LandlordEmail</small>
            </div>
            <div>
                <span>Rental unit</span>
                <strong>@Model.PropertyName</strong>
                <small>@Model.ApartmentName</small>
            </div>
            <div>
                <span>Payment</span>
                <strong>@MethodLabel(Model.Method)</strong>
                <small>@Model.TransactionId</small>
            </div>
        </div>

        <div class="table-responsive mt-4">
            <table class="table align-middle rh-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Period</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Rent payment</td>
                        <td>@Model.PeriodLabel</td>
                        <td class="text-end">@Model.Amount.ToString("N0") @Model.Currency</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="rh-receipt-total">
            <span>Total</span>
            <strong>@Model.Amount.ToString("N0") @Model.Currency</strong>
        </div>

        <div class="rh-receipt-verify">
            <div>
                <span class="rh-kicker">Verification</span>
                <p>Scan the QR code or open the verification link to confirm this receipt was generated by the system.</p>
                <a href="@Model.VerificationUrl" target="_blank" rel="noopener">@Model.VerificationUrl</a>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.QrCodeSvg))
            {
                <div class="rh-receipt-qr">@Html.Raw(Model.QrCodeSvg)</div>
            }
        </div>
    </section>
</section>

<style>
    .rh-receipt-document {
        max-width: 980px;
        margin-inline: auto;
    }

    .rh-receipt-header {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        border-bottom: 4px solid #0f766e;
        padding-bottom: 24px;
    }

    .rh-receipt-header h2 {
        margin: 0;
        font-size: 42px;
        letter-spacing: 4px;
    }

    .rh-receipt-stamp {
        text-align: right;
        display: grid;
        gap: 4px;
    }

    .rh-receipt-stamp strong {
        color: #0f766e;
    }

    .rh-receipt-stamp span,
    .rh-receipt-grid small {
        color: #64748b;
    }

    .rh-receipt-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-top: 24px;
    }

    .rh-receipt-grid > div {
        border: 1px solid #d8e2ee;
        border-radius: 8px;
        padding: 16px;
        display: grid;
        gap: 4px;
    }

    .rh-receipt-grid span {
        color: #64748b;
        font-size: .85rem;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .rh-receipt-total {
        display: flex;
        justify-content: flex-end;
        gap: 18px;
        align-items: baseline;
        font-size: 1.4rem;
        margin-top: 18px;
    }

    .rh-receipt-verify {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        border-top: 1px solid #d8e2ee;
        margin-top: 32px;
        padding-top: 24px;
        align-items: end;
    }

    .rh-receipt-verify p {
        margin: 6px 0;
        color: #64748b;
    }

    .rh-receipt-qr svg {
        width: 148px;
        height: 148px;
        border: 1px solid #d8e2ee;
        border-radius: 8px;
    }

    @@media (max-width: 720px) {
        .rh-receipt-header,
        .rh-receipt-verify {
            flex-direction: column;
            align-items: stretch;
        }

        .rh-receipt-stamp {
            text-align: left;
        }

        .rh-receipt-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
