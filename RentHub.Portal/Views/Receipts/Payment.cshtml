@model Common.CommunicationModels.RentReceiptDto
@using Common.Enums
@using System.Globalization
@{
    ViewData["Title"] = T["Rent invoice"].Value;

    var culture = CultureInfo.CurrentCulture;
    string DateLabel(DateTimeOffset value) => value.LocalDateTime.ToString("dd MMM yyyy", culture);
    string PeriodDateLabel(DateTimeOffset value) => value.ToString("dd MMM yyyy", culture);
    string PeriodLabel() => Model.Lines.Count > 0
        ? $"{PeriodDateLabel(Model.Lines.Min(line => line.PeriodStart))} - {PeriodDateLabel(Model.Lines.Max(line => line.PeriodEnd))}"
        : Model.PeriodStart.HasValue && Model.PeriodEnd.HasValue
        ? $"{Model.PeriodStart.Value.ToString("dd MMM yyyy", culture)} - {Model.PeriodEnd.Value.ToString("dd MMM yyyy", culture)}"
        : Model.PeriodLabel;
    string PeriodUnitName() => string.IsNullOrWhiteSpace(Model.ApartmentName) ? "-" : Model.ApartmentName;
    string MethodLabel(PaymentMethodEnum method) => method switch
    {
        PaymentMethodEnum.Cash => T["Cash / off-platform"].Value,
        PaymentMethodEnum.Momo => "MTN Mobile Money",
        PaymentMethodEnum.OrangeMoney => "Orange Money",
        PaymentMethodEnum.Card => T["Card"].Value,
        _ => method.ToString()
    };
    string PaymentNote() => Model.Method == PaymentMethodEnum.Cash
        ? T["Recorded manually by landlord"].Value
        : string.IsNullOrWhiteSpace(Model.ProviderReceiptUrl)
            ? T["Processed by platform"].Value
            : T["Provider receipt available"].Value;
}

<section class="rh-overview-shell">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <p class="rh-kicker">@T["Rent invoice"]</p>
            <h1 class="rh-heading-title">@Model.ReceiptNumber</h1>
            <p class="rh-heading-subtitle">@T["Official invoice for a completed rent payment."]</p>
        </div>
        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-subtle" asp-action="DownloadPayment" asp-route-paymentId="@Model.PaymentId">@T["Download invoice"]</a>
            @if (!string.IsNullOrWhiteSpace(Model.ProviderReceiptUrl))
            {
                <a class="btn rh-btn-primary" href="@Model.ProviderReceiptUrl" target="_blank" rel="noopener">@T["Open provider receipt"]</a>
            }
        </div>
    </section>

    <article class="rh-rent-invoice" aria-label="@T["Rent invoice"]">
        <header class="rh-rent-invoice__masthead">
            <p class="rh-rent-invoice__title">@T["Rent invoice"].Value.ToUpper(culture)</p>
            <img class="rh-rent-invoice__brand-logo"
                 src="~/assets/branding/logo-light.png"
                 alt="Lontsi Homes"
                 width="1600"
                 height="339" />
            <span>@T["Property management and rent services"]</span>
        </header>

        <div class="rh-rent-invoice__body">
            <table class="rh-rent-invoice__facts rh-rent-invoice__summary">
                <tbody>
                    <tr><th scope="row">@T["Invoice number"]</th><td>@Model.ReceiptNumber</td></tr>
                    <tr><th scope="row">@T["Payment date"]</th><td>@DateLabel(Model.PaymentDate)</td></tr>
                    <tr><th scope="row">@T["Status"]</th><td><strong>@T[Model.Status == PaymentStatusEnum.Success ? "Paid" : Model.Status.ToString()]</strong></td></tr>
                </tbody>
            </table>

            <section class="rh-rent-invoice__section">
                <h2>@T["Rental information"]</h2>
                <table class="rh-rent-invoice__facts">
                    <tbody>
                        <tr><th scope="row">@T["Tenant"]</th><td>@Model.TenantName</td></tr>
                        <tr><th scope="row">@T["Property"]</th><td>@Model.PropertyName</td></tr>
                        <tr><th scope="row">@T["Rental unit"]</th><td>@PeriodUnitName()</td></tr>
                        <tr><th scope="row">@T["Paid period"]</th><td>@PeriodLabel()</td></tr>
                        @if (!string.IsNullOrWhiteSpace(Model.LandlordName))
                        {
                            <tr><th scope="row">@T["Landlord"]</th><td>@Model.LandlordName</td></tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.LandlordEmail))
                        {
                            <tr><th scope="row">@T["Landlord email"]</th><td>@Model.LandlordEmail</td></tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="rh-rent-invoice__section">
                <h2>@T["Payment"]</h2>
                <table class="rh-rent-invoice__facts rh-rent-invoice__payment">
                    <tbody>
                        <tr><th scope="row">@T["Rent"]</th><td>@Model.Amount.ToString("N0", culture) @Model.Currency</td></tr>
                        <tr><th scope="row">@T["Payment method"]</th><td>@MethodLabel(Model.Method)</td></tr>
                        <tr class="rh-rent-invoice__total"><th scope="row">@T["Total paid"]</th><td>@Model.Amount.ToString("N0", culture) @Model.Currency</td></tr>
                    </tbody>
                </table>
                <p class="rh-rent-invoice__note">@PaymentNote()</p>
                <p class="rh-rent-invoice__note">@T["Issue date"]: @DateLabel(Model.IssuedAt)</p>
            </section>

            @if (Model.Lines.Count > 1)
            {
                <section class="rh-rent-invoice__section">
                    <h2>@T["Paid period details"]</h2>
                    <div class="table-responsive">
                        <table class="rh-rent-invoice__details">
                            <thead><tr><th>@T["Period"]</th><th>@T["Period amount"]</th><th>@T["Amount paid"]</th></tr></thead>
                            <tbody>
                                @foreach (var line in Model.Lines.OrderBy(item => item.PeriodStart))
                                {
                                    <tr>
                                        <td>@PeriodDateLabel(line.PeriodStart) - @PeriodDateLabel(line.PeriodEnd)</td>
                                        <td>@line.PeriodAmount.ToString("N0", culture) @Model.Currency</td>
                                        <td>@line.PaidAmount.ToString("N0", culture) @Model.Currency</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>

        <footer class="rh-rent-invoice__footer">
            <div class="rh-rent-invoice__tenant">
                <span>@T["Tenant information"]</span>
                <strong>@Model.TenantName</strong>
                @if (!string.IsNullOrWhiteSpace(Model.TenantPhone))
                {
                    <p>@T["Phone"]: @Model.TenantPhone</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.TenantEmail))
                {
                    <p>@T["Email"]: @Model.TenantEmail</p>
                }
                <small>@T["Scan the QR code to verify this invoice."]</small>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.QrCodeSvg))
            {
                <a class="rh-rent-invoice__qr"
                   href="@Model.VerificationUrl"
                   target="_blank"
                   rel="noopener"
                   aria-label="@T["Verify invoice"]">
                    @Html.Raw(Model.QrCodeSvg)
                </a>
            }
        </footer>
    </article>
</section>

<style>
    .rh-rent-invoice {
        --invoice-paper: #f3eee4;
        --invoice-paper-alt: #fffdf8;
        --invoice-ink: #654948;
        --invoice-muted: #927b75;
        --invoice-accent: #71504f;
        width: min(900px, 100%);
        margin-inline: auto;
        overflow: hidden;
        border-radius: 34px;
        color: var(--invoice-ink);
        background: var(--invoice-paper);
        box-shadow: 0 24px 60px rgba(0, 0, 0, .28);
    }

    .rh-rent-invoice__masthead {
        padding: 52px 64px 34px;
        text-align: center;
        display: grid;
        gap: 7px;
    }

    .rh-rent-invoice__title {
        margin: 0;
        font-size: clamp(2.2rem, 7vw, 4.8rem);
        line-height: 1;
        letter-spacing: .22em;
        font-weight: 500;
    }

    .rh-rent-invoice__brand-logo {
        display: block;
        width: clamp(12rem, 42%, 20rem);
        max-width: 100%;
        height: auto;
        margin: 0 auto;
        object-fit: contain;
    }

    .rh-rent-invoice__masthead span {
        text-transform: uppercase;
        letter-spacing: .12em;
        color: var(--invoice-muted);
    }

    .rh-rent-invoice__tenant > span {
        display: block;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: .11em;
        font-weight: 800;
        font-size: .78rem;
    }
    .rh-rent-invoice__tenant p { margin: 7px 0 0; }

    .rh-rent-invoice__footer {
        min-height: 190px;
        padding: 30px 64px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 28px;
        background: #a88d89;
        color: #fffaf3;
    }

    .rh-rent-invoice__tenant p,
    .rh-rent-invoice__tenant small {
        color: #fffaf3;
    }

    .rh-rent-invoice__tenant strong {
        display: block;
        font-size: 1.3rem;
    }

    .rh-rent-invoice__tenant small {
        display: block;
        margin-top: 16px;
    }

    .rh-rent-invoice__qr {
        flex: 0 0 auto;
        display: block;
        padding: 9px;
        border-radius: 12px;
        background: #fff;
    }

    .rh-rent-invoice__qr svg {
        display: block;
        width: 132px;
        height: 132px;
    }

    @@media (max-width: 720px) {
        .rh-rent-invoice {
            border-radius: 22px;
        }

        .rh-rent-invoice__masthead,
        .rh-rent-invoice__footer {
            padding-left: 24px;
            padding-right: 24px;
        }

        .rh-rent-invoice__footer {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    .rh-rent-invoice__body { padding: 8px 64px 38px; }
    .rh-rent-invoice__section { margin-top: 28px; }
    .rh-rent-invoice__section h2 { margin: 0 0 12px; font-size: 1.1rem; font-weight: 750; color: var(--invoice-accent); }
    .rh-rent-invoice__facts { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .rh-rent-invoice__facts th, .rh-rent-invoice__facts td { padding: 14px 16px; border-bottom: 1px solid #d9ccc2; vertical-align: top; overflow-wrap: anywhere; }
    .rh-rent-invoice__facts th { width: 38%; text-align: left; font-weight: 500; }
    .rh-rent-invoice__facts td { text-align: right; }
    .rh-rent-invoice__summary, .rh-rent-invoice__payment { background: var(--invoice-paper-alt); border: 1px solid #d9ccc2; }
    .rh-rent-invoice__summary th, .rh-rent-invoice__payment th { border-right: 1px solid #d9ccc2; }
    .rh-rent-invoice__total { background: var(--invoice-accent); color: #fffaf3; }
    .rh-rent-invoice__total th, .rh-rent-invoice__total td { font-weight: 800; font-size: 1.1rem; }
    .rh-rent-invoice__note { font-size: .85rem; margin: 10px 0 0; color: var(--invoice-ink); }
    .rh-rent-invoice__details { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .rh-rent-invoice__details th, .rh-rent-invoice__details td { padding: 12px 8px; border-bottom: 1px solid #d9ccc2; text-align: right; }
    .rh-rent-invoice__details th:first-child, .rh-rent-invoice__details td:first-child { text-align: left; }
    .rh-rent-invoice__details th { background: var(--invoice-accent); color: #fffaf3; }
    @@media (max-width: 720px) {
        .rh-rent-invoice__body { padding: 8px 24px 28px; }
        .rh-rent-invoice__facts th, .rh-rent-invoice__facts td { padding: 12px 8px; font-size: .9rem; }
    }
</style>
