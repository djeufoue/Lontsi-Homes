@model Common.CommunicationModels.RentReceiptDto
@using Common.Enums
@using System.Globalization
@{
    ViewData["Title"] = T["Rent invoice"].Value;

    var culture = CultureInfo.CurrentCulture;
    string DateLabel(DateTimeOffset value) => value.LocalDateTime.ToString("dd MMM yyyy", culture);
    string PeriodLabel() => Model.PeriodStart.HasValue && Model.PeriodEnd.HasValue
        ? $"{Model.PeriodStart.Value.ToString("dd MMM yyyy", culture)} - {Model.PeriodEnd.Value.ToString("dd MMM yyyy", culture)}"
        : Model.PeriodLabel;
    string MethodLabel(PaymentMethodEnum method) => method switch
    {
        PaymentMethodEnum.Cash => T["Cash / off-platform"].Value,
        PaymentMethodEnum.Momo => "MTN Mobile Money",
        PaymentMethodEnum.OrangeMoney => "Orange Money",
        PaymentMethodEnum.Card => T["Card"].Value,
        _ => method.ToString()
    };
    string PaymentNote() => Model.Method == PaymentMethodEnum.Cash
        ? T["Recorded manually by landlord"].Value
        : string.IsNullOrWhiteSpace(Model.ProviderReceiptUrl)
            ? T["Processed by platform"].Value
            : T["Provider receipt available"].Value;
}

<section class="rh-overview-shell">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <p class="rh-kicker">@T["Rent invoice"]</p>
            <h1 class="rh-heading-title">@Model.ReceiptNumber</h1>
            <p class="rh-heading-subtitle">@T["Official invoice for a completed rent payment."]</p>
        </div>
        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-subtle" asp-action="DownloadPayment" asp-route-paymentId="@Model.PaymentId">@T["Download invoice"]</a>
            @if (!string.IsNullOrWhiteSpace(Model.ProviderReceiptUrl))
            {
                <a class="btn rh-btn-primary" href="@Model.ProviderReceiptUrl" target="_blank" rel="noopener">@T["Open provider receipt"]</a>
            }
        </div>
    </section>

    <article class="rh-rent-invoice" aria-label="@T["Rent invoice"]">
        <header class="rh-rent-invoice__masthead">
            <p class="rh-rent-invoice__title">@T["Rent invoice"].Value.ToUpper(culture)</p>
            <img class="rh-rent-invoice__brand-logo"
                 src="~/assets/branding/logo-light.png"
                 alt="Lontsi Homes"
                 width="1600"
                 height="339" />
            <span>@T["Property management and rent services"]</span>
        </header>

        <section class="rh-rent-invoice__meta">
            <div>
                <span>@T["Invoice number"]</span>
                <strong>@Model.ReceiptNumber</strong>
                @if (!string.IsNullOrWhiteSpace(Model.LandlordName))
                {
                    <p>@Model.LandlordName</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.LandlordEmail))
                {
                    <p>@Model.LandlordEmail</p>
                }
            </div>
            <div>
                <span>@T["Issue date"]</span>
                <strong>@DateLabel(Model.IssuedAt)</strong>
                @if (!string.IsNullOrWhiteSpace(Model.PropertyName))
                {
                    <p>@Model.PropertyName</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ApartmentName))
                {
                    <p>@Model.ApartmentName</p>
                }
            </div>
        </section>

        <div class="table-responsive rh-responsive-table-wrap rh-rent-invoice__table-wrap">
            <table class="rh-responsive-data-table rh-rent-invoice__table">
                <thead>
                    <tr>
                        <th>@T["Description"]</th>
                        <th>@T["Period"]</th>
                        <th class="text-end">@T["Period amount"]</th>
                        <th class="text-end">@T["Amount paid"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lines.Any())
                    {
                        @foreach (var line in Model.Lines.OrderBy(item => item.PeriodStart))
                        {
                            <tr>
                                <td class="rh-mobile-card-title" data-label="@T["Description"]">@T["Monthly rent"]</td>
                                <td data-label="@T["Period"]">@DateLabel(line.PeriodStart) - @DateLabel(line.PeriodEnd)</td>
                                <td class="text-end" data-label="@T["Period amount"]">@line.PeriodAmount.ToString("N0", culture) @Model.Currency</td>
                                <td class="text-end" data-label="@T["Amount paid"]"><strong>@line.PaidAmount.ToString("N0", culture) @Model.Currency</strong></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="rh-mobile-card-title" data-label="@T["Description"]">@T["Rent for the rental unit"]</td>
                            <td data-label="@T["Period"]">@PeriodLabel()</td>
                            <td class="text-end" data-label="@T["Period amount"]">@Model.Amount.ToString("N0", culture) @Model.Currency</td>
                            <td class="text-end" data-label="@T["Amount paid"]"><strong>@Model.Amount.ToString("N0", culture) @Model.Currency</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <section class="rh-rent-invoice__settlement">
            <div>
                <span>@T["Payment"]</span>
                <strong>@MethodLabel(Model.Method)</strong>
                <p>@PaymentNote()</p>
                <p>@T["Payment date"]: @DateLabel(Model.PaymentDate)</p>
            </div>
            <div class="rh-rent-invoice__amount">
                <span>@T["Amount paid"]</span>
                <strong>@Model.Amount.ToString("N0", culture) @Model.Currency</strong>
                <em>@T["Paid"]</em>
            </div>
        </section>

        <footer class="rh-rent-invoice__footer">
            <div class="rh-rent-invoice__tenant">
                <span>@T["Tenant information"]</span>
                <strong>@Model.TenantName</strong>
                @if (!string.IsNullOrWhiteSpace(Model.TenantPhone))
                {
                    <p>@T["Phone"]: @Model.TenantPhone</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.TenantEmail))
                {
                    <p>@T["Email"]: @Model.TenantEmail</p>
                }
                <small>@T["Scan the QR code to verify this invoice."]</small>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.QrCodeSvg))
            {
                <a class="rh-rent-invoice__qr"
                   href="@Model.VerificationUrl"
                   target="_blank"
                   rel="noopener"
                   aria-label="@T["Verify invoice"]">
                    @Html.Raw(Model.QrCodeSvg)
                </a>
            }
        </footer>
    </article>
</section>

<style>
    .rh-rent-invoice {
        --invoice-paper: #f3eee4;
        --invoice-paper-alt: #fffdf8;
        --invoice-ink: #654948;
        --invoice-muted: #927b75;
        --invoice-accent: #71504f;
        width: min(900px, 100%);
        margin-inline: auto;
        overflow: hidden;
        border-radius: 34px;
        color: var(--invoice-ink);
        background: var(--invoice-paper);
        box-shadow: 0 24px 60px rgba(0, 0, 0, .28);
    }

    .rh-rent-invoice__masthead {
        padding: 52px 64px 34px;
        text-align: center;
        display: grid;
        gap: 7px;
    }

    .rh-rent-invoice__title {
        margin: 0;
        font-size: clamp(2.2rem, 7vw, 4.8rem);
        line-height: 1;
        letter-spacing: .22em;
        font-weight: 500;
    }

    .rh-rent-invoice__brand-logo {
        display: block;
        width: clamp(12rem, 42%, 20rem);
        max-width: 100%;
        height: auto;
        margin: 0 auto;
        object-fit: contain;
    }

    .rh-rent-invoice__masthead span {
        text-transform: uppercase;
        letter-spacing: .12em;
        color: var(--invoice-muted);
    }

    .rh-rent-invoice__meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 40px;
        padding: 22px 64px 34px;
    }

    .rh-rent-invoice__meta > div:last-child {
        text-align: right;
    }

    .rh-rent-invoice__meta span,
    .rh-rent-invoice__settlement span,
    .rh-rent-invoice__tenant > span {
        display: block;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: .11em;
        font-weight: 800;
        font-size: .78rem;
    }

    .rh-rent-invoice__meta strong {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 4px;
        background: var(--invoice-accent);
        color: #fffaf3;
    }

    .rh-rent-invoice__meta p,
    .rh-rent-invoice__settlement p,
    .rh-rent-invoice__tenant p {
        margin: 7px 0 0;
        color: var(--invoice-muted);
    }

    .rh-rent-invoice__table-wrap {
        padding-inline: 64px;
    }

    .rh-rent-invoice__table {
        width: 100%;
        border-collapse: collapse;
        color: var(--invoice-ink);
    }

    .rh-rent-invoice__table th {
        padding: 14px 16px;
        color: #fffaf3;
        background: var(--invoice-accent);
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .rh-rent-invoice__table td {
        padding: 18px 16px;
        background: var(--invoice-paper-alt);
        border-bottom: 8px solid var(--invoice-paper);
        vertical-align: middle;
    }

    .rh-rent-invoice__settlement {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 40px;
        padding: 38px 64px 44px;
    }

    .rh-rent-invoice__settlement strong {
        display: block;
        font-size: 1.05rem;
    }

    .rh-rent-invoice__amount {
        min-width: 260px;
        text-align: right;
    }

    .rh-rent-invoice__amount strong {
        font-size: 2rem;
    }

    .rh-rent-invoice__amount em {
        display: inline-flex;
        margin-top: 10px;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--invoice-accent);
        color: #fffaf3;
        font-style: normal;
        font-weight: 800;
    }

    .rh-rent-invoice__footer {
        min-height: 190px;
        padding: 30px 64px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 28px;
        background: #a88d89;
        color: #fffaf3;
    }

    .rh-rent-invoice__tenant p,
    .rh-rent-invoice__tenant small {
        color: #fffaf3;
    }

    .rh-rent-invoice__tenant strong {
        display: block;
        font-size: 1.3rem;
    }

    .rh-rent-invoice__tenant small {
        display: block;
        margin-top: 16px;
    }

    .rh-rent-invoice__qr {
        flex: 0 0 auto;
        display: block;
        padding: 9px;
        border-radius: 12px;
        background: #fff;
    }

    .rh-rent-invoice__qr svg {
        display: block;
        width: 132px;
        height: 132px;
    }

    @@media (max-width: 720px) {
        .rh-rent-invoice {
            border-radius: 22px;
        }

        .rh-rent-invoice__masthead,
        .rh-rent-invoice__meta,
        .rh-rent-invoice__table-wrap,
        .rh-rent-invoice__settlement,
        .rh-rent-invoice__footer {
            padding-left: 24px;
            padding-right: 24px;
        }

        .rh-rent-invoice__meta,
        .rh-rent-invoice__settlement {
            grid-template-columns: 1fr;
        }

        .rh-rent-invoice__meta > div:last-child,
        .rh-rent-invoice__amount {
            text-align: left;
        }

        .rh-rent-invoice__amount {
            min-width: 0;
        }

        .rh-rent-invoice__footer {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>
