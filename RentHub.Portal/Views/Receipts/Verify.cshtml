@model Common.CommunicationModels.RentReceiptVerificationDto
@{
    Layout = null;

    string DateLabel(DateTimeOffset? value) => value.HasValue ? value.Value.LocalDateTime.ToString("dd MMM yyyy") : "Unavailable";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Receipt Verification</title>
    <style>
        :root {
            color-scheme: light;
            --ink: #122033;
            --muted: #607086;
            --line: #d8e2ee;
            --brand: #0f766e;
            --danger: #b4233a;
            --bg: #eef4f8;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: var(--bg);
            color: var(--ink);
            font-family: Arial, sans-serif;
            padding: 24px;
        }

        main {
            width: min(720px, 100%);
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 10px;
            box-shadow: 0 18px 40px rgba(15, 23, 42, .08);
            padding: 32px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 8px 12px;
            font-weight: 700;
            background: @(Model.IsValid ? "#dcfce7" : "#fee2e2");
            color: @(Model.IsValid ? "#166534" : "#991b1b");
        }

        h1 {
            margin: 18px 0 8px;
            font-size: clamp(2rem, 6vw, 3rem);
            letter-spacing: 0;
        }

        p {
            color: var(--muted);
            margin: 0 0 24px;
        }

        dl {
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: 12px 18px;
            margin: 0;
            border-top: 1px solid var(--line);
            padding-top: 24px;
        }

        dt {
            color: var(--muted);
            font-weight: 700;
        }

        dd {
            margin: 0;
            font-weight: 600;
        }

        @@media (max-width: 560px) {
            dl {
                grid-template-columns: 1fr;
                gap: 6px;
            }
        }
    </style>
</head>
<body>
    <main>
        @if (Model.IsValid)
        {
            <span class="status">Valid system receipt</span>
            <h1>@Model.ReceiptNumber</h1>
            <p>This receipt was generated by Lontsi Homes and matches a successful rent payment.</p>
            <dl>
                <dt>Issued</dt>
                <dd>@DateLabel(Model.IssuedAt)</dd>
                <dt>Payment date</dt>
                <dd>@DateLabel(Model.PaymentDate)</dd>
                <dt>Amount</dt>
                <dd>@Model.Amount.ToString("N0") @Model.Currency</dd>
                <dt>Method</dt>
                <dd>@Model.PaymentMethod</dd>
                <dt>Tenant</dt>
                <dd>@Model.TenantName</dd>
                <dt>Landlord</dt>
                <dd>@Model.LandlordName</dd>
                <dt>Rental unit</dt>
                <dd>@Model.PropertyName - @Model.ApartmentName</dd>
                <dt>Rent period</dt>
                <dd>@Model.PeriodLabel</dd>
            </dl>
        }
        else
        {
            <span class="status">Invalid receipt</span>
            <h1>Receipt not found</h1>
            <p>The scanned code does not match a valid system-generated rent receipt.</p>
        }
    </main>
</body>
</html>
