@model RentHub.Portal.ViewModels.Auth.LandlordMobilePaymentsVm
@using Common.Enums
@{
    ViewData["Title"] = "Mobile Payments";
    Layout = "_AuthLayout";
    var primaryPhone = string.IsNullOrWhiteSpace(Model.PrimaryPhoneNumber) ? "your verified phone" : Model.PrimaryPhoneNumber;
    var isAccountUpdate = User.Identity?.IsAuthenticated == true;
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell rh-auth-shell-register">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">@(isAccountUpdate ? "Payment settings" : "Step 5 of 8")</span>
            <h1>@(isAccountUpdate ? "Update Mobile Money setup." : "Choose Mobile Money numbers.")</h1>
            <p>@(isAccountUpdate ? "Changed numbers must be verified by OTP before they become usable for checkout or future payouts." : "Subscription payments and future tenant rent payouts can use the same verified phone or separate MTN/Orange numbers.")</p>
            <ul class="rh-auth-points">
                <li>Subscription payments are paid by landlords to Lontsi Homes</li>
                <li>Rent payout number is for future tenant rent collection flows</li>
                <li>Different numbers receive their own OTP only once</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            @if (!isAccountUpdate)
            {
                <div class="rh-auth-stepper rh-auth-stepper-wide" aria-label="Registration progress">
                    <span class="done">1</span>
                    <span class="done">2</span>
                    <span class="done">3</span>
                    <span class="done">4</span>
                    <span class="active">5</span>
                    <span>6</span>
                    <span>7</span>
                    <span>8</span>
                </div>
            }

            <div class="rh-auth-card-header">
                <h2>@(isAccountUpdate ? "Edit Mobile Money accounts" : "Mobile payment setup")</h2>
                <p>@(isAccountUpdate ? "Save changes to request OTP verification for any new number." : "Pick the number and operator for each payment use case.")</p>
            </div>

            @if (ViewBag.AuthInfo is string authInfo)
            {
                <div class="alert alert-info py-2">@authInfo</div>
            }

            @if (ViewBag.AuthError is string authError)
            {
                <div class="alert alert-danger py-2">@authError</div>
            }

            <form asp-action="LandlordMobilePayments" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="rh-inline-hint mb-3">
                    Verified main phone: <strong>@primaryPhone</strong>
                </div>

                <div class="rh-auth-choice-block">
                    <div class="form-check form-switch">
                        <input asp-for="UsePrimaryPhoneForSubscriptionPayments" class="form-check-input" data-toggle-target="#subscriptionNumberFields" />
                        <label asp-for="UsePrimaryPhoneForSubscriptionPayments" class="form-check-label"></label>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6 js-conditional" id="subscriptionNumberFields">
                            <label asp-for="SubscriptionPaymentPhoneNumber" class="form-label rh-auth-label"></label>
                            <input asp-for="SubscriptionPaymentPhoneNumber" class="form-control rh-auth-input" inputmode="numeric" placeholder="6XXXXXXXX" required data-required-when-visible="true" />
                            <span asp-validation-for="SubscriptionPaymentPhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SubscriptionPaymentChannel" class="form-label rh-auth-label"></label>
                            <select asp-for="SubscriptionPaymentChannel" class="form-select rh-auth-input rh-auth-select" required data-required-when-visible="true">
                                <option value="">Choose operator</option>
                                <option value="@PayoutChannelEnum.MtnMoney">MTN Money</option>
                                <option value="@PayoutChannelEnum.OrangeMoney">Orange Money</option>
                            </select>
                            <span asp-validation-for="SubscriptionPaymentChannel" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="rh-auth-choice-block">
                    <div class="form-check form-switch">
                        <input asp-for="UsePrimaryPhoneForRentPayouts" class="form-check-input" data-toggle-target="#payoutNumberFields" />
                        <label asp-for="UsePrimaryPhoneForRentPayouts" class="form-check-label"></label>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6 js-conditional" id="payoutNumberFields">
                            <label asp-for="PayoutPhoneNumber" class="form-label rh-auth-label"></label>
                            <input asp-for="PayoutPhoneNumber" class="form-control rh-auth-input" inputmode="numeric" placeholder="6XXXXXXXX" required data-required-when-visible="true" />
                            <span asp-validation-for="PayoutPhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PayoutChannel" class="form-label rh-auth-label"></label>
                            <select asp-for="PayoutChannel" class="form-select rh-auth-input rh-auth-select" required data-required-when-visible="true">
                                <option value="">Choose operator</option>
                                <option value="@PayoutChannelEnum.MtnMoney">MTN Money</option>
                                <option value="@PayoutChannelEnum.OrangeMoney">Orange Money</option>
                            </select>
                            <span asp-validation-for="PayoutChannel" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="WhatsAppPhoneNumber" class="form-label rh-auth-label"></label>
                    <input asp-for="WhatsAppPhoneNumber" class="form-control rh-auth-input" inputmode="numeric" placeholder="Optional WhatsApp number for alerts" />
                    <span asp-validation-for="WhatsAppPhoneNumber" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn rh-btn-primary w-100">@(isAccountUpdate ? "Save changes and send OTPs" : "Save and send required OTPs")</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const sync = (checkbox) => {
                const target = document.querySelector(checkbox.dataset.toggleTarget);
                if (!target) return;
                target.hidden = checkbox.checked;
                target.querySelectorAll("input, select, textarea").forEach(input => {
                    input.disabled = checkbox.checked;
                });
                checkbox.closest("form")?.dispatchEvent(new Event("renthub:external-state-changed", { bubbles: true }));
            };

            document.querySelectorAll("[data-toggle-target]").forEach(checkbox => {
                checkbox.addEventListener("change", () => sync(checkbox));
                sync(checkbox);
            });
        })();
    </script>
}
