@model RentHub.Portal.ViewModels.Auth.VerifyVisitorAccountVm
@{
    ViewData["Title"] = "Verify Visitor Account";
    Layout = "_AuthLayout";
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">Lontsi Homes Public Listings</span>
            <h1>Verify your visitor account.</h1>
            <p>Enter the OTP codes sent to your email, phone number, and WhatsApp before contacting landlords privately.</p>
            <ul class="rh-auth-points">
                <li>Email OTP</li>
                <li>Phone OTP</li>
                <li>WhatsApp OTP</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            <div class="rh-auth-card-header">
                <h2>Verify visitor OTPs</h2>
                <p>All 3 codes are required before you can start a conversation.</p>
            </div>

            @if (ViewBag.AuthInfo is string authInfo)
            {
                <div class="alert alert-info py-2">@authInfo</div>
            }

            @if (ViewBag.AuthError is string authError)
            {
                <div class="alert alert-danger py-2">@authError</div>
            }

            <form asp-action="VerifyVisitorAccount" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label rh-auth-label"></label>
                    <input asp-for="Email" id="verifyVisitorEmailInput" class="form-control rh-auth-input" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EmailOtp" class="form-label rh-auth-label"></label>
                    <input asp-for="EmailOtp" class="form-control rh-auth-input" autocomplete="one-time-code" placeholder="Code from email" />
                    <span asp-validation-for="EmailOtp" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneOtp" class="form-label rh-auth-label"></label>
                    <input asp-for="PhoneOtp" class="form-control rh-auth-input" autocomplete="one-time-code" placeholder="Code sent to your phone" />
                    <span asp-validation-for="PhoneOtp" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="WhatsAppOtp" class="form-label rh-auth-label"></label>
                    <input asp-for="WhatsAppOtp" class="form-control rh-auth-input" autocomplete="one-time-code" placeholder="Code from WhatsApp" />
                    <span asp-validation-for="WhatsAppOtp" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn rh-btn-primary w-100">Activate visitor account</button>
            </form>

            <form asp-action="ResendVisitorOtp" method="post" class="mt-3" id="resendVisitorOtpForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resendVisitorOtpEmail" name="email" value="@Model.Email" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn rh-btn-subtle w-100">Resend visitor OTPs</button>
            </form>

            <p class="rh-auth-footnote mb-0 mt-3">
                Already activated?
                <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Go to Login</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const emailInput = document.getElementById("verifyVisitorEmailInput");
            const resendEmail = document.getElementById("resendVisitorOtpEmail");
            const resendForm = document.getElementById("resendVisitorOtpForm");

            if (!emailInput || !resendEmail || !resendForm) return;

            const sync = () => {
                resendEmail.value = emailInput.value;
            };

            emailInput.addEventListener("input", sync);
            resendForm.addEventListener("submit", sync);
            sync();
        })();
    </script>
}
