@model RentHub.Portal.ViewModels.Auth.SetPasswordVm
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create password";
}

<section class="rh-auth-shell">
    <div class="rh-auth-card">
        <div class="rh-auth-form-panel">
            <span class="rh-auth-kicker">Lontsi Homes Manager</span>
            <h1>Create your password</h1>
            <p>Choose a private password to activate your Manager account.</p>
            <form asp-action="SetPassword" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <div>
                    <label asp-for="NewPassword">Password</label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn rh-btn-primary w-100">Create password</button>
            </form>
        </div>
    </div>
</section>
