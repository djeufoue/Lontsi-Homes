@model RentHub.Portal.ViewModels.Auth.LandlordKycVm
@using Common.Enums
@{
    ViewData["Title"] = "Identity Verification";
    Layout = "_AuthLayout";
    var status = Model.Status;
    var hasSubmittedKyc = status?.IsKycSubmitted == true;
    var isRejected = status?.KycStatus == LandlordKycStatusEnum.Rejected;
    var rejectedFiles = status?.KycRejectedFiles ?? new Common.CommunicationModels.LandlordKycRejectedFilesDto();
    var isPartialResubmission = isRejected && rejectedFiles.Any && status?.KycDocumentType == Model.DocumentType;
    var showFaceFront = !isPartialResubmission || rejectedFiles.FaceFront;
    var showFaceRight = !isPartialResubmission || rejectedFiles.FaceRight;
    var showFaceLeft = !isPartialResubmission || rejectedFiles.FaceLeft;
    var showDocumentFront = !isPartialResubmission || rejectedFiles.DocumentFront;
    var showDocumentBack = !isPartialResubmission || rejectedFiles.DocumentBack;
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell rh-auth-shell-register">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">Step 7 of 8</span>
            <h1>Verify landlord identity.</h1>
            <p>Upload face photos and an identity document so the platform can reduce fraud before property management tools are unlocked.</p>
            <ul class="rh-auth-points">
                <li>Provide front, right, and left face photos</li>
                <li>Upload the front and, when required, back of your ID document</li>
                <li>An admin reviews your submission before payments and property creation unlock</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            <div class="rh-auth-stepper rh-auth-stepper-wide" aria-label="Registration progress">
                <span class="done">1</span>
                <span class="done">2</span>
                <span class="done">3</span>
                <span class="done">4</span>
                <span class="done">5</span>
                <span class="done">6</span>
                <span class="active">7</span>
                <span>8</span>
            </div>

            <div class="rh-auth-card-header">
                <h2>KYC submission</h2>
                <p>Use clear photos. The document image must show the face and document details.</p>
            </div>

            @if (ViewBag.AuthInfo is string authInfo)
            {
                <div class="alert alert-info py-2">@authInfo</div>
            }

            @if (ViewBag.AuthError is string authError)
            {
                <div class="alert alert-danger py-2">@authError</div>
            }

            @if (hasSubmittedKyc && !isRejected)
            {
                <div class="alert alert-info py-2">
                    Your identity files were submitted. You can replace them here if you need to correct something before approval.
                </div>
            }
            else if (isRejected)
            {
                <div class="alert alert-warning py-2">
                    Your previous identity submission was rejected. Upload corrected documents and submit again.
                    @if (isPartialResubmission)
                    {
                        <span class="d-block mt-1">Only the rejected file(s) are requested below. Previously accepted files stay on the submission.</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(status?.KycReviewNote))
                    {
                        <span class="d-block mt-1"><strong>Review note:</strong> @status.KycReviewNote</span>
                    }
                </div>
            }

            <form asp-action="LandlordKyc" method="post" enctype="multipart/form-data" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="DocumentType" class="form-label rh-auth-label"></label>
                    @if (isPartialResubmission)
                    {
                        <input asp-for="DocumentType" type="hidden" />
                    }
                    <select asp-for="DocumentType" class="form-select rh-auth-input rh-auth-select" data-document-type required data-required-when-visible="true" disabled="@isPartialResubmission">
                        <option value="">Choose document type</option>
                        <option value="@KycDocumentTypeEnum.NationalId">National ID</option>
                        <option value="@KycDocumentTypeEnum.Passport">Passport</option>
                        <option value="@KycDocumentTypeEnum.DriverLicense">Driver license</option>
                        <option value="@KycDocumentTypeEnum.ResidencePermit">Residence permit</option>
                        <option value="@KycDocumentTypeEnum.Other">Other government ID</option>
                    </select>
                    @if (isPartialResubmission)
                    {
                        <div class="form-text">Document type is locked while correcting rejected files.</div>
                    }
                    <span asp-validation-for="DocumentType" class="text-danger small"></span>
                </div>

                <div class="rh-kyc-upload-grid">
                    @if (showFaceFront)
                    {
                        <div class="rh-kyc-upload">
                            <label asp-for="FaceFront" class="form-label rh-auth-label"></label>
                            <input asp-for="FaceFront" class="form-control rh-auth-input" type="file" accept="image/*" required data-required-when-visible="true" />
                            <span asp-validation-for="FaceFront" class="text-danger small"></span>
                        </div>
                    }
                    @if (showFaceRight)
                    {
                        <div class="rh-kyc-upload">
                            <label asp-for="FaceRight" class="form-label rh-auth-label"></label>
                            <input asp-for="FaceRight" class="form-control rh-auth-input" type="file" accept="image/*" required data-required-when-visible="true" />
                            <span asp-validation-for="FaceRight" class="text-danger small"></span>
                        </div>
                    }
                    @if (showFaceLeft)
                    {
                        <div class="rh-kyc-upload">
                            <label asp-for="FaceLeft" class="form-label rh-auth-label"></label>
                            <input asp-for="FaceLeft" class="form-control rh-auth-input" type="file" accept="image/*" required data-required-when-visible="true" />
                            <span asp-validation-for="FaceLeft" class="text-danger small"></span>
                        </div>
                    }
                    @if (showDocumentFront)
                    {
                        <div class="rh-kyc-upload">
                            <label asp-for="DocumentFront" class="form-label rh-auth-label"></label>
                            <input asp-for="DocumentFront" class="form-control rh-auth-input" type="file" accept="image/*,.pdf" required data-required-when-visible="true" />
                            <span asp-validation-for="DocumentFront" class="text-danger small"></span>
                        </div>
                    }
                    @if (showDocumentBack)
                    {
                        <div class="rh-kyc-upload" data-document-back-block>
                            <label asp-for="DocumentBack" class="form-label rh-auth-label"></label>
                            <input asp-for="DocumentBack" class="form-control rh-auth-input" type="file" accept="image/*,.pdf" required data-required-when-visible="true" />
                            <div class="form-text">Not required for passports.</div>
                            <span asp-validation-for="DocumentBack" class="text-danger small"></span>
                        </div>
                    }
                </div>

                <button type="submit" class="btn rh-btn-primary w-100 mt-3" data-pending-text="Submitting identity verification">
                    Submit identity verification
                </button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const documentType = document.querySelector("[data-document-type]");
            const backBlock = document.querySelector("[data-document-back-block]");
            const backInput = backBlock?.querySelector("input[type='file']");
            if (!documentType || !backBlock || !backInput) return;

            const passportValue = "@KycDocumentTypeEnum.Passport";
            const sync = () => {
                const hidden = documentType.value === passportValue;
                backBlock.hidden = hidden;
                backInput.disabled = hidden;
                if (hidden) {
                    backInput.value = "";
                }
                backBlock.closest("form")?.dispatchEvent(new Event("renthub:external-state-changed", { bubbles: true }));
            };

            documentType.addEventListener("change", sync);
            sync();
        })();
    </script>
}
