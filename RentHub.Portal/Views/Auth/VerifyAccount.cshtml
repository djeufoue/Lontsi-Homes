@model RentHub.Portal.ViewModels.Auth.VerifyAccountVm
@{
    ViewData["Title"] = "Verify Account";
    Layout = "_AuthLayout";
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">Lontsi Homes Platform</span>
            <h1>Activate your landlord account.</h1>
            <p>Enter the 3 OTP codes sent to your email, payout number, and WhatsApp to complete account activation and access your workspace.</p>
            <ul class="rh-auth-points">
                <li>OTP expires after 10 minutes</li>
                <li>You can request a new code anytime</li>
                <li>Login stays blocked until all 3 verifications complete</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            <div class="rh-auth-card-header">
                <h2>Verify OTPs</h2>
                <p>Complete account creation with the codes sent by email, SMS, and WhatsApp.</p>
            </div>

            @if (ViewBag.AuthInfo is string authInfo)
            {
                <div class="alert alert-info py-2">@authInfo</div>
            }

            @if (ViewBag.AuthError is string authError)
            {
                <div class="alert alert-danger py-2">@authError</div>
            }

            <form asp-action="VerifyAccount" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label rh-auth-label"></label>
                    <input asp-for="Email" id="verifyEmailInput" class="form-control rh-auth-input" autocomplete="email" placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EmailOtp" class="form-label rh-auth-label"></label>
                    <input asp-for="EmailOtp" class="form-control rh-auth-input" autocomplete="one-time-code" placeholder="Code from email" />
                    <span asp-validation-for="EmailOtp" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PayoutOtp" class="form-label rh-auth-label"></label>
                    <input asp-for="PayoutOtp" class="form-control rh-auth-input" autocomplete="one-time-code" placeholder="Code sent to payout number" />
                    <span asp-validation-for="PayoutOtp" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="WhatsAppOtp" class="form-label rh-auth-label"></label>
                    <input asp-for="WhatsAppOtp" class="form-control rh-auth-input" autocomplete="one-time-code" placeholder="Code from WhatsApp" />
                    <span asp-validation-for="WhatsAppOtp" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn rh-btn-primary w-100">Activate Account</button>
            </form>

            <form asp-action="ResendActivationOtp" method="post" class="mt-3" id="resendOtpForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resendOtpEmail" name="email" value="@Model.Email" />
                <button type="submit" class="btn rh-btn-subtle w-100">Resend all OTPs</button>
            </form>

            <p class="rh-auth-footnote mb-0 mt-3">
                Already activated?
                <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Go to Login</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const emailInput = document.getElementById("verifyEmailInput");
            const resendEmail = document.getElementById("resendOtpEmail");
            const resendForm = document.getElementById("resendOtpForm");

            if (!emailInput || !resendEmail || !resendForm) return;

            const sync = () => {
                resendEmail.value = emailInput.value;
            };

            emailInput.addEventListener("input", sync);
            resendForm.addEventListener("submit", sync);
            sync();
        })();
    </script>
}
