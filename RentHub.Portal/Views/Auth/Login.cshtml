@model RentHub.Portal.ViewModels.Auth.LoginVm
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">Lontsi Homes Platform</span>
            <h1>Manage properties with precision and speed.</h1>
            <p>Landlords manage units, subscriptions, rent reminders, and core rental workflows from one place.</p>
            <ul class="rh-auth-points">
                <li>Subscription-based landlord workspace</li>
                <li>Verified landlord onboarding and payout setup</li>
                <li>Professional property workflows end-to-end</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            <div class="rh-auth-card-header">
                <h2>Welcome back</h2>
                <p>Sign in to continue.</p>
            </div>

            @if (ViewBag.AuthInfo is string authInfo)
            {
                <div class="alert alert-info py-2">@authInfo</div>
            }

            @if (ViewBag.AuthError is string authError)
            {
                <div class="alert alert-danger py-2">@authError</div>
            }

            <form asp-action="Login" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label rh-auth-label"></label>
                    <input asp-for="Email" class="form-control rh-auth-input" autocomplete="email" placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <label asp-for="Password" class="form-label rh-auth-label"></label>
                        <a asp-action="ForgotPassword" asp-route-email="@Model.Email" class="rh-auth-secondary-link">Forgot password?</a>
                    </div>
                    <input asp-for="Password" type="password" class="form-control rh-auth-input" autocomplete="current-password" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn rh-btn-primary w-100">Log In</button>
            </form>

            <p class="rh-auth-footnote mb-0">
                Want to list apartments?
                <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create a landlord account</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
