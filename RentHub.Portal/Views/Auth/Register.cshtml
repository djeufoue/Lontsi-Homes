@model RentHub.Portal.ViewModels.Auth.RegisterVm
@using RentHub.Portal.ViewModels.Auth
@{
    ViewData["Title"] = "Register";
    var plans = ViewBag.Plans as IEnumerable<SubscriptionPlanOptionVm> ?? Enumerable.Empty<SubscriptionPlanOptionVm>();
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Create landlord account</h1>
                <p class="text-muted small mb-4">Registration requires selecting a subscription plan.</p>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CountryCode" class="form-label">Country code</label>
                            <input asp-for="CountryCode" class="form-control" placeholder="e.g. +237" />
                            <span asp-validation-for="CountryCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="PlanId" class="form-label">Subscription plan</label>
                            <select asp-for="PlanId" class="form-select">
                                <option value="">Select a plan</option>
                                @foreach (var plan in plans)
                                {
                                    <option value="@plan.Id">@plan.Name - @plan.Price XAF (@plan.DurationInDays days)</option>
                                }
                            </select>
                            <span asp-validation-for="PlanId" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-4">Create account</button>
                </form>
            </div>
            <div class="card-footer bg-white text-center">
                <span class="text-muted small">Already have an account?</span>
                <a asp-action="Login">Sign in</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
