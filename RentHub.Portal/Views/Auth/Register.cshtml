@model RentHub.Portal.ViewModels.Auth.RegisterVm
@using System.Linq
@using RentHub.Portal.ViewModels.Auth
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
    var plans = ViewBag.Plans as IEnumerable<SubscriptionPlanOptionVm> ?? Enumerable.Empty<SubscriptionPlanOptionVm>();
    var selectedPlan = plans.FirstOrDefault(p => p.Id == Model.PlanId);
    var selectedPlanLabel = selectedPlan == null
        ? "Choose later"
        : $"{selectedPlan.Name} - {selectedPlan.Price:0.00} XAF ({selectedPlan.DurationInDays} days)";
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell rh-auth-shell-register">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">Step 1 of 5</span>
            <h1>Create your landlord workspace.</h1>
            <p>Start with your identity and password. Your progress is saved after this step, so you can return later and continue from the right screen.</p>
            <ul class="rh-auth-points">
                <li>Email OTP confirmation</li>
                <li>Phone OTP confirmation</li>
                <li>Separate Mobile Money numbers for subscriptions and rent payouts</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            <div class="rh-auth-stepper" aria-label="Registration progress">
                <span class="active">1</span>
                <span>2</span>
                <span>3</span>
                <span>4</span>
                <span>5</span>
            </div>

            <div class="rh-auth-card-header">
                <h2>Account details</h2>
                <p>Create the login account first. Payment and phone verification come next.</p>
            </div>

            <form asp-action="Register" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label rh-auth-label"></label>
                        <input asp-for="FirstName" class="form-control rh-auth-input" autocomplete="given-name" placeholder="First name" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label rh-auth-label"></label>
                        <input asp-for="LastName" class="form-control rh-auth-input" autocomplete="family-name" placeholder="Last name" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label rh-auth-label"></label>
                        <input asp-for="Email" class="form-control rh-auth-input" autocomplete="email" placeholder="name@company.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CountryCode" class="form-label rh-auth-label"></label>
                        <input asp-for="CountryCode" class="form-control rh-auth-input" inputmode="numeric" placeholder="e.g. +237" />
                        <span asp-validation-for="CountryCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label rh-auth-label"></label>
                        <input asp-for="Password" type="password" class="form-control rh-auth-input" autocomplete="new-password" placeholder="Create a strong password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label rh-auth-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control rh-auth-input" autocomplete="new-password" placeholder="Repeat your password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="PlanId" class="form-label rh-auth-label">Subscription plan (optional)</label>

                        <div class="rh-plan-picker" data-plan-picker>
                            <button type="button" class="rh-plan-toggle" data-plan-toggle aria-expanded="false">
                                <span data-plan-current>@selectedPlanLabel</span>
                                <span class="rh-plan-chevron" aria-hidden="true"></span>
                            </button>

                            <div class="rh-plan-menu" data-plan-menu>
                                <button type="button" class="rh-plan-option @(selectedPlan == null ? "is-active" : null)" data-value="" data-label="Choose later">
                                    <strong>Choose later</strong>
                                    <small>Complete registration now and subscribe when you are ready.</small>
                                </button>

                                @foreach (var plan in plans)
                                {
                                    var planLabel = $"{plan.Name} - {plan.Price:0.00} XAF ({plan.DurationInDays} days)";
                                    <button type="button" class="rh-plan-option @(Model.PlanId == plan.Id ? "is-active" : null)" data-value="@plan.Id" data-label="@planLabel">
                                        <strong>@plan.Name</strong>
                                        <small>@plan.Price.ToString("0.00") XAF for @plan.DurationInDays days</small>
                                    </button>
                                }
                            </div>

                            <div class="rh-native-plan-wrap" aria-hidden="true">
                                <select asp-for="PlanId" class="rh-native-plan-select" tabindex="-1">
                                    <option value="">Choose later</option>
                                    @foreach (var plan in plans)
                                    {
                                        <option value="@plan.Id">@plan.Name - @plan.Price.ToString("0.00") XAF (@plan.DurationInDays days)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <span asp-validation-for="PlanId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="rh-inline-hint mt-3">
                    After this step, you will confirm your email, main phone, and Mobile Money numbers.
                </div>

                <button type="submit" class="btn rh-btn-primary w-100 mt-4">Continue to email OTP</button>
            </form>

            <p class="rh-auth-footnote mb-0">
                Already started?
                <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in to continue</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const picker = document.querySelector("[data-plan-picker]");
            if (!picker) return;

            const toggle = picker.querySelector("[data-plan-toggle]");
            const current = picker.querySelector("[data-plan-current]");
            const select = picker.querySelector(".rh-native-plan-select");
            const options = Array.from(picker.querySelectorAll(".rh-plan-option"));

            const close = () => {
                picker.classList.remove("is-open");
                toggle.setAttribute("aria-expanded", "false");
            };

            const setActive = (value) => {
                const selected = options.find(o => o.dataset.value === value) || options[0];
                options.forEach(o => o.classList.remove("is-active"));
                selected.classList.add("is-active");
                current.textContent = selected.dataset.label || "Choose later";
                select.value = value;
            };

            toggle.addEventListener("click", () => {
                picker.classList.toggle("is-open");
                toggle.setAttribute("aria-expanded", picker.classList.contains("is-open") ? "true" : "false");
            });

            options.forEach(option => {
                option.addEventListener("click", () => {
                    setActive(option.dataset.value || "");
                    close();
                });
            });

            document.addEventListener("click", event => {
                if (!picker.contains(event.target)) close();
            });

            setActive(select.value || "");
        })();
    </script>
}
