@model RentHub.Portal.ViewModels.Auth.RegisterVisitorVm
@{
    ViewData["Title"] = "Register Visitor";
    Layout = "_AuthLayout";
}

<div class="rh-auth-wrap">
    <div class="rh-auth-shell">
        <aside class="rh-auth-hero">
            <span class="rh-auth-kicker">Lontsi Homes Public Listings</span>
            <h1>Create your visitor account.</h1>
            <p>Verify your email to start private conversations with landlords. Phone and WhatsApp details are optional.</p>
            <ul class="rh-auth-points">
                <li>Private messaging per apartment</li>
                <li>Optional phone and WhatsApp verification</li>
                <li>No landlord contact details exposed publicly</li>
            </ul>
        </aside>

        <section class="rh-auth-card">
            <div class="rh-auth-card-header">
                <h2>Create visitor account</h2>
                <p>Use a simple verified account to contact landlords privately.</p>
            </div>

            <form asp-action="RegisterVisitor" method="post" class="rh-auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label rh-auth-label"></label>
                    <input asp-for="Email" class="form-control rh-auth-input" autocomplete="email" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label rh-auth-label"></label>
                    <input asp-for="FullName" class="form-control rh-auth-input" autocomplete="name" placeholder="Optional display name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label rh-auth-label"></label>
                    <input asp-for="PhoneNumber" class="form-control rh-auth-input" autocomplete="tel" inputmode="numeric" placeholder="+237..." />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="WhatsAppPhoneNumber" class="form-label rh-auth-label"></label>
                    <input asp-for="WhatsAppPhoneNumber" class="form-control rh-auth-input" autocomplete="tel" inputmode="numeric" placeholder="+237..." />
                    <span asp-validation-for="WhatsAppPhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label rh-auth-label"></label>
                    <input asp-for="Password" type="password" class="form-control rh-auth-input" autocomplete="new-password" placeholder="Create a password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label rh-auth-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control rh-auth-input" autocomplete="new-password" placeholder="Repeat your password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn rh-btn-primary w-100">Create visitor account</button>
            </form>

            <p class="rh-auth-footnote mb-0">
                Already have a verified account?
                <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
