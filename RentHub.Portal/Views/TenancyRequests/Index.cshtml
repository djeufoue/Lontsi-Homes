@model RentHub.Portal.ViewModels.Tenancies.TenancyRequestsVm
@using Common.Enums
@{
    ViewData["Title"] = T["Tenancy requests"].Value;
    var selected = Model.SelectedTenancy;
    var requests = Model.Requests.Items;
    var propertyOptions = Model.Requests.Properties;
    var effectivePropertyId = Model.PropertyId ?? (propertyOptions.Count == 1 ? propertyOptions[0].Id : null);
    var apartmentOptions = effectivePropertyId.HasValue
        ? Model.Requests.Apartments.Where(option => option.PropertyId == effectivePropertyId.Value).ToList()
        : new List<TenancyRequestApartmentOptionDto>();
    var showPropertyFilter = propertyOptions.Count > 1;
    var showApartmentFilter = effectivePropertyId.HasValue && apartmentOptions.Count > 1;
    var requestActionLabel = selected?.EndDate.HasValue == true
        ? T["Make a renewal request"].Value
        : T["Make an end-of-tenancy request"].Value;
    var canOpenUserOverview = User.IsInRole("Admin") || User.IsInRole("Landlord") || User.IsInRole("Manager");
    string CalendarDateLabel(DateTimeOffset value) => value.Date.ToString("d");
    string ActivityDateLabel(DateTimeOffset value) => value.LocalDateTime.ToString("g");
    string TypeLabel(TenancyRequestTypeEnum type) => type == TenancyRequestTypeEnum.Renewal
        ? T["Renewal"].Value
        : T["End of tenancy"].Value;
}

<section class="rh-overview-shell rh-tenancy-shell" data-tenancy-requests-page="true">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            @if (selected != null)
            {
                <a class="rh-overview-backlink" asp-controller="Tenancies" asp-action="Overview" asp-route-id="@selected.Id">← @T["Back to tenancy overview"]</a>
            }
            <p class="rh-kicker">@T["Tenancy workflow"]</p>
            <h1 class="rh-heading-title">@T["Tenancy requests"]</h1>
            <p class="rh-heading-subtitle">@T["Track renewal and end-of-tenancy requests for every apartment available to you."]</p>
            <div class="rh-overview-badges">
                <span class="rh-chip rh-chip-info">@T["{0} request(s)", Model.Requests.TotalItems]</span>
            </div>
        </div>
    </section>

    @if (selected != null && (selected.CanRequestTermination || selected.CanRequestRenewal))
    {
        <section class="rh-panel rh-panel-elevated mb-3">
            <button class="rh-request-collapse-trigger" type="button" data-bs-toggle="collapse" data-bs-target="#tenancyRequestForm" aria-expanded="@(Model.OpenRequestForm ? "true" : "false")" aria-controls="tenancyRequestForm">
                <span class="rh-request-collapse-copy">
                    <h2 class="rh-dashboard-panel-title">@selected.PropertyName - @selected.ApartmentName</h2>
                    <p class="rh-dashboard-panel-copy">@T["Submit a request. The tenancy changes only after an authorized person approves it."]</p>
                </span>
                <span class="rh-request-collapse-control">
                    <span class="rh-request-collapse-label">@requestActionLabel</span>
                    <span class="rh-request-collapse-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                            <path d="m6 9 6 6 6-6" />
                        </svg>
                    </span>
                </span>
            </button>

            <div class="collapse @(Model.OpenRequestForm ? "show" : null)" id="tenancyRequestForm">
                @if (Model.Requests.RequestableTenancies.Count > 1)
                {
                    <form method="get" asp-action="Index" class="mb-3">
                        <input type="hidden" name="openForm" value="true" />
                        <label class="form-label" for="requestTenancyId">@T["Choose the tenancy concerned"]</label>
                        <div class="rh-select-wrap">
                            <select class="form-select rh-input rh-select" id="requestTenancyId" name="tenancyId" data-auto-submit>
                                @foreach (var option in Model.Requests.RequestableTenancies)
                                {
                                    <option value="@option.TenancyId" selected="@(option.TenancyId == selected.Id ? "selected" : null)">@option.PropertyName - @option.ApartmentName</option>
                                }
                            </select>
                        </div>
                    </form>
                }

                <div class="row g-3">
                    @if (selected.CanRequestTermination)
                    {
                        <div class="col-lg-6 @(selected.EndDate.HasValue ? "order-lg-2" : "order-lg-1")">
                            <article class="rh-card-spotlight p-3 h-100">
                                <h3 class="rh-dashboard-panel-title">@T["Request the end of this tenancy"]</h3>
                                <p class="text-muted">@T["Choose your preferred end date. Your landlord or an authorized manager must approve it."]</p>
                                <form asp-action="SubmitTermination" method="post" class="row g-3" data-tenancy-request-mutation="true">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tenancyId" value="@selected.Id" />
                                    <div class="col-12">
                                        <label class="form-label" for="requestedEndDate">@T["Requested end date"]</label>
                                        <input class="form-control rh-input" id="requestedEndDate" name="requestedEndDate" type="date" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" value="@Model.RequestedEndDate?.ToString("yyyy-MM-dd")" required />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="terminationReason">@T["Reason optional"]</label>
                                        <textarea class="form-control rh-input" id="terminationReason" name="terminationReason" rows="3" maxlength="1000" placeholder="@T["Add any useful context for the landlord"]"></textarea>
                                    </div>
                                    <div class="col-12">
                                        <button class="btn rh-btn-outline-danger" type="submit">@T["Submit end-of-tenancy request"]</button>
                                    </div>
                                </form>
                            </article>
                        </div>
                    }

                    @if (selected.CanRequestRenewal && Model.RenewalWorkspace?.CanRequest == true)
                    {
                        <div class="col-lg-6 order-lg-1">
                            <article class="rh-card-spotlight p-3 h-100">
                                <h3 class="rh-dashboard-panel-title">@T["Request a renewal"]</h3>
                                <p class="text-muted">@T["This option is available because the tenancy has a fixed end date."]</p>
                                <form asp-action="SubmitRenewal" method="post" class="row g-3" data-tenancy-request-mutation="true">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tenancyId" value="@selected.Id" />
                                    <div class="col-12">
                                        <label class="form-label" for="proposedEndDate">@T["Proposed new end date"]</label>
                                        <input class="form-control rh-input" id="proposedEndDate" name="proposedEndDate" type="date" min="@Model.RenewalWorkspace.MinimumProposedEndDate?.ToString("yyyy-MM-dd")" value="@Model.ProposedEndDate?.ToString("yyyy-MM-dd")" required />
                                    </div>
                                    <div class="col-12">
                                        <button class="btn rh-btn-primary" type="submit">@T["Submit renewal request"]</button>
                                    </div>
                                </form>
                            </article>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head align-start">
            <div>
                <h2 class="rh-dashboard-panel-title">@T["Request register"]</h2>
                <p class="rh-dashboard-panel-copy">@T["Managers with view access can read requests. Decision buttons appear only when they have the required permission."]</p>
            </div>
        </div>

        <form method="get" asp-action="Index" class="row g-3 align-items-end mb-3">
            @if (selected != null)
            {
                <input type="hidden" name="tenancyId" value="@selected.Id" />
                <input type="hidden" name="openForm" value="@Model.OpenRequestForm.ToString().ToLowerInvariant()" />
            }
            @if (showPropertyFilter)
            {
                <div class="col-md-3">
                    <label class="form-label" for="propertyId">@T["Property"]</label>
                    <div class="rh-select-wrap">
                        <select class="form-select rh-input rh-select" id="propertyId" name="propertyId" data-property-request-filter>
                            <option value="">@T["All properties"]</option>
                            @foreach (var property in propertyOptions)
                            {
                                <option value="@property.Id" selected="@(effectivePropertyId == property.Id ? "selected" : null)">@property.Label</option>
                            }
                        </select>
                    </div>
                </div>
            }
            else if (effectivePropertyId.HasValue)
            {
                <input type="hidden" name="propertyId" value="@effectivePropertyId.Value" />
            }

            @if (showApartmentFilter)
            {
                <div class="col-md-3">
                    <label class="form-label" for="apartmentId">@T["Apartment"]</label>
                    <div class="rh-select-wrap">
                        <select class="form-select rh-input rh-select" id="apartmentId" name="apartmentId">
                            <option value="">@T["All apartments"]</option>
                            @foreach (var apartment in apartmentOptions)
                            {
                                <option value="@apartment.Id" selected="@(Model.ApartmentId == apartment.Id ? "selected" : null)">@apartment.Label</option>
                            }
                        </select>
                    </div>
                </div>
            }

            <div class="col-md-3">
                <label class="form-label" for="requestType">@T["Request type"]</label>
                <div class="rh-select-wrap">
                    <select class="form-select rh-input rh-select" id="requestType" name="requestType">
                        <option value="">@T["All request types"]</option>
                        <option value="Renewal" selected="@(string.Equals(Model.RequestType, "Renewal", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["Renewal"]</option>
                        <option value="Termination" selected="@(string.Equals(Model.RequestType, "Termination", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["End of tenancy"]</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="status">@T["Status"]</label>
                <div class="rh-select-wrap">
                    <select class="form-select rh-input rh-select" id="status" name="status">
                        <option value="">@T["All statuses"]</option>
                        <option value="Pending" selected="@(string.Equals(Model.Status, "Pending", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["Pending"]</option>
                        <option value="Approved" selected="@(string.Equals(Model.Status, "Approved", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["Approved"]</option>
                        <option value="Rejected" selected="@(string.Equals(Model.Status, "Rejected", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["Rejected"]</option>
                        <option value="Cancelled" selected="@(string.Equals(Model.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["Cancelled"]</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3 col-lg-2">
                <button class="btn rh-btn-primary w-100" type="submit">@T["Filter"]</button>
            </div>
            <div class="col-md-3 col-lg-2">
                <a class="btn rh-btn-subtle w-100" asp-action="Index" asp-route-tenancyId="@selected?.Id" asp-route-openForm="@Model.OpenRequestForm">@T["Clear"]</a>
            </div>
        </form>

        @if (!requests.Any())
        {
            <div class="rh-empty">@T["No tenancy request matches these filters."]</div>
        }
        else
        {
            <div class="table-responsive rh-responsive-table-wrap">
                <table class="table align-middle rh-table rh-responsive-data-table mb-0">
                    <thead>
                    <tr>
                        <th>@T["Property / apartment"]</th>
                        <th>@T["Request"]</th>
                        <th>@T["Requested date"]</th>
                        <th>@T["Requested by"]</th>
                        <th>@T["Status"]</th>
                        <th>@T["Details"]</th>
                        <th>@T["Decision"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var request in requests)
                    {
                        var statusClass = request.Status == "Pending"
                            ? "rh-chip-warning"
                            : request.Status == "Approved"
                                ? "rh-chip-primary"
                                : request.Status == "Cancelled"
                                    ? "rh-chip-info"
                                    : "rh-chip-danger";
                        <tr>
                            <td class="rh-mobile-card-title" data-label="@T["Property / apartment"]">
                                <a class="fw-semibold rh-table-property-link" asp-controller="Properties" asp-action="Overview" asp-route-id="@request.PropertyId">@request.PropertyName</a>
                                <small class="d-block"><a class="rh-table-property-link" asp-controller="Apartments" asp-action="Overview" asp-route-id="@request.ApartmentId">@request.ApartmentName</a></small>
                            </td>
                            <td data-label="@T["Request"]">
                                <strong>@TypeLabel(request.Type)</strong>
                                @if (request.IsDirectDecision)
                                {
                                    <span class="rh-chip rh-chip-info ms-1">@T["Direct landlord decision"]</span>
                                }
                                <small class="d-block text-muted">@T["Submitted {0}", ActivityDateLabel(request.RequestedAt)]</small>
                                @if (!string.IsNullOrWhiteSpace(request.RequestReason))
                                {
                                    <small class="d-block text-muted">@T["Reason:"] @request.RequestReason</small>
                                }
                            </td>
                            <td data-label="@T["Requested date"]">@CalendarDateLabel(request.RequestedDate)</td>
                            <td data-label="@T["Requested by"]">
                                @if (canOpenUserOverview && !string.IsNullOrWhiteSpace(request.RequestedById))
                                {
                                    <a class="rh-table-property-link" asp-controller="AdminUsers" asp-action="Overview" asp-route-userId="@request.RequestedById">@request.RequestedByName</a>
                                }
                                else
                                {
                                    @request.RequestedByName
                                }
                            </td>
                            <td data-label="@T["Status"]"><span class="rh-chip @statusClass">@T[request.Status]</span></td>
                            <td data-label="@T["Details"]">
                                <a class="btn btn-sm rh-btn-subtle" asp-controller="Tenancies" asp-action="Overview" asp-route-id="@request.TenancyId">@T["View tenancy"]</a>
                            </td>
                            <td data-label="@T["Decision"]">
                                @if (request.CanWithdraw)
                                {
                                    <form asp-action="Withdraw" method="post"
                                          data-tenancy-request-mutation="true"
                                          data-confirm-modal="true"
                                          data-confirm-title="@T["Cancel this request?"]"
                                          data-confirm-message="@T["This request is still awaiting a decision. Cancelling it will leave the tenancy unchanged."]"
                                          data-confirm-proceed="@T["Cancel request"]"
                                          data-confirm-style="danger">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tenancyId" value="@request.TenancyId" />
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <input type="hidden" name="requestType" value="@request.Type" />
                                        <button class="btn btn-sm rh-btn-outline-danger" type="submit">@T["Cancel request"]</button>
                                    </form>
                                }
                                else if (request.CanReview)
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        <form asp-action="Approve" method="post"
                                              data-tenancy-request-mutation="true"
                                              data-confirm-modal="true"
                                              data-confirm-title="@T["Approve this request?"]"
                                              data-confirm-message="@(request.Type == TenancyRequestTypeEnum.Renewal ? T["The tenancy end date and rent schedule will be extended immediately."].Value : T["The requested end date will be applied to the tenancy immediately."].Value)"
                                              data-confirm-proceed="@T["Approve"]">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tenancyId" value="@request.TenancyId" />
                                            <input type="hidden" name="requestId" value="@request.Id" />
                                            <input type="hidden" name="requestType" value="@request.Type" />
                                            <button class="btn btn-sm rh-btn-primary" type="submit">@T["Approve"]</button>
                                        </form>
                                        <button class="btn btn-sm rh-btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#rejectRequestModal-@request.Type-@request.Id">@T["Reject"]</button>
                                    </div>
                                }
                                else if (request.CanCancel)
                                {
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        @if (request.ReviewedAt.HasValue)
                                        {
                                            <span>@ActivityDateLabel(request.ReviewedAt.Value)</span>
                                        }
                                        <button class="btn btn-sm rh-btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#cancelTerminationModal-@request.Id">@T["Cancel termination decision"]</button>
                                    </div>
                                }
                                else if (request.ReviewedAt.HasValue || string.Equals(request.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                                {
                                    @if (request.ReviewedAt.HasValue)
                                    {
                                        <span>@ActivityDateLabel(request.ReviewedAt.Value)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.ReviewedByName))
                                    {
                                        <small class="d-block text-muted">@request.ReviewedByName</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.RejectionReason))
                                    {
                                        <small class="d-block text-muted">@T["Reason:"] @request.RejectionReason</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">@T["View only"]</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

        }

        <div class="rh-table-footer">
            <a class="btn btn-sm rh-btn-subtle @(Model.Requests.Page <= 1 ? "disabled" : null)"
               asp-action="Index"
               asp-route-tenancyId="@selected?.Id"
               asp-route-openForm="@Model.OpenRequestForm"
               asp-route-propertyId="@effectivePropertyId"
               asp-route-apartmentId="@Model.ApartmentId"
               asp-route-requestType="@Model.RequestType"
               asp-route-status="@Model.Status"
               asp-route-page="@(Model.Requests.Page - 1)"
               asp-route-pageSize="@Model.Requests.PageSize">@T["Previous"]</a>
            <div class="rh-table-page-size">
                <label class="form-label mb-0" for="requestPageSize">@T["Rows"]</label>
                <select id="requestPageSize" class="form-select rh-input rh-select" data-auto-page-size data-page-size-parameter="pageSize" data-page-parameter="page">
                    @foreach (var size in new[] { 6, 12, 24, 50 })
                    {
                        <option value="@size" selected="@(Model.Requests.PageSize == size ? "selected" : null)">@size</option>
                    }
                </select>
                <small class="text-muted">@T["{0} result(s) · Page {1} of {2}", Model.Requests.TotalItems, Model.Requests.Page, Model.Requests.TotalPages]</small>
            </div>
            <a class="btn btn-sm rh-btn-subtle rh-table-footer-next @(Model.Requests.Page >= Model.Requests.TotalPages ? "disabled" : null)"
               asp-action="Index"
               asp-route-tenancyId="@selected?.Id"
               asp-route-openForm="@Model.OpenRequestForm"
               asp-route-propertyId="@effectivePropertyId"
               asp-route-apartmentId="@Model.ApartmentId"
               asp-route-requestType="@Model.RequestType"
               asp-route-status="@Model.Status"
               asp-route-page="@(Model.Requests.Page + 1)"
               asp-route-pageSize="@Model.Requests.PageSize">@T["Next"]</a>
        </div>
    </section>
</section>

@foreach (var request in requests.Where(request => request.CanReview))
{
    <div class="modal fade" id="rejectRequestModal-@request.Type-@request.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered rh-action-modal-dialog">
            <div class="modal-content rh-modal-content">
                <form asp-action="Reject" method="post" data-tenancy-request-mutation="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenancyId" value="@request.TenancyId" />
                    <input type="hidden" name="requestId" value="@request.Id" />
                    <input type="hidden" name="requestType" value="@request.Type" />
                    <div class="modal-header border-0 pb-0">
                        <div>
                            <h5 class="modal-title">@T["Reject this request?"]</h5>
                            <p class="text-muted mb-0">@T["The tenancy will remain unchanged. The reason will be sent to the tenant."]</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="rejectionReason-@request.Type-@request.Id">@T["Rejection reason"]</label>
                        <textarea class="form-control rh-input" id="rejectionReason-@request.Type-@request.Id" name="rejectionReason" rows="4" maxlength="@(request.Type == TenancyRequestTypeEnum.Renewal ? 512 : 1000)" required></textarea>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button class="btn rh-btn-subtle" type="button" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button class="btn rh-btn-outline-danger" type="submit">@T["Confirm rejection"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@foreach (var request in requests.Where(request => request.CanCancel))
{
    var firstReplacementDate = request.RequestedDate.Date.AddDays(1);
    <div class="modal fade" id="cancelTerminationModal-@request.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered rh-action-modal-dialog">
            <div class="modal-content rh-modal-content">
                <form asp-action="CancelTermination" method="post" data-termination-cancellation-form data-tenancy-request-mutation="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenancyId" value="@request.TenancyId" />
                    <input type="hidden" name="requestId" value="@request.Id" />
                    <div class="modal-header border-0 pb-0">
                        <div>
                            <h5 class="modal-title">@T["Cancel the termination decision?"]</h5>
                            <p class="text-muted mb-0">@T["Choose whether to restore the current tenancy or create its replacement."]</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label" for="continuationMode-@request.Id">@T["How should the tenancy continue?"]</label>
                            <select class="form-select rh-input rh-select" id="continuationMode-@request.Id" name="continuationMode" data-continuation-mode>
                                <option value="ContinueCurrentTenancy">@T["Restore and extend the current tenancy"]</option>
                                <option value="StartReplacementTenancy">@T["Create a replacement tenancy"]</option>
                            </select>
                        </div>
                        <div class="col-12" data-replacement-start hidden>
                            <label class="form-label" for="replacementStartDate-@request.Id">@T["Replacement start date"]</label>
                            <input class="form-control rh-input" id="replacementStartDate-@request.Id" name="replacementStartDate" type="date" min="@firstReplacementDate.ToString("yyyy-MM-dd")" value="@firstReplacementDate.ToString("yyyy-MM-dd")" />
                            <small class="text-muted">@T["The replacement must begin after the recorded termination date."]</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="endMode-@request.Id">@T["New duration"]</label>
                            <select class="form-select rh-input rh-select" id="endMode-@request.Id" name="endMode" data-end-mode>
                                <option value="Open">@T["No fixed end date"]</option>
                                <option value="Fixed">@T["Fixed end date"]</option>
                            </select>
                        </div>
                        <div class="col-md-6" data-new-end hidden>
                            <label class="form-label" for="newEndDate-@request.Id">@T["New end date"]</label>
                            <input class="form-control rh-input" id="newEndDate-@request.Id" name="newEndDate" type="date" min="@firstReplacementDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="cancellationNote-@request.Id">@T["Note optional"]</label>
                            <textarea class="form-control rh-input" id="cancellationNote-@request.Id" name="cancellationNote" rows="3" maxlength="1000"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-warning mb-0">@T["This action immediately updates tenancy dates and the rent schedule. It cannot overlap another tenancy for the apartment."]</div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button class="btn rh-btn-subtle" type="button" data-bs-dismiss="modal">@T["Keep termination"]</button>
                        <button class="btn rh-btn-outline-danger" type="submit">@T["Confirm cancellation"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll("[data-auto-submit]").forEach(select => {
            select.addEventListener("change", () => select.form?.requestSubmit());
        });

        const propertyRequestFilter = document.querySelector("[data-property-request-filter]");
        propertyRequestFilter?.addEventListener("change", () => {
            const apartmentFilter = propertyRequestFilter.form?.querySelector("[name='apartmentId']");
            if (apartmentFilter) apartmentFilter.value = "";
            propertyRequestFilter.form?.requestSubmit();
        });

        document.querySelectorAll("[data-termination-cancellation-form]").forEach(form => {
            const continuation = form.querySelector("[data-continuation-mode]");
            const replacement = form.querySelector("[data-replacement-start]");
            const replacementInput = replacement?.querySelector("input");
            const endMode = form.querySelector("[data-end-mode]");
            const endContainer = form.querySelector("[data-new-end]");
            const endInput = endContainer?.querySelector("input");

            const sync = () => {
                const createsReplacement = continuation?.value === "StartReplacementTenancy";
                if (replacement) replacement.hidden = !createsReplacement;
                if (replacementInput) replacementInput.required = createsReplacement;
                const fixedEnd = endMode?.value === "Fixed";
                if (endContainer) endContainer.hidden = !fixedEnd;
                if (endInput) endInput.required = fixedEnd;
                if (endInput && replacementInput) {
                    const minimumEnd = createsReplacement && replacementInput.value
                        ? replacementInput.value
                        : replacementInput.min;
                    endInput.min = minimumEnd;
                    if (endInput.value && minimumEnd && endInput.value < minimumEnd) {
                        endInput.value = minimumEnd;
                    }
                }
            };

            continuation?.addEventListener("change", sync);
            replacementInput?.addEventListener("change", sync);
            endMode?.addEventListener("change", sync);
            sync();
        });
    </script>
}
