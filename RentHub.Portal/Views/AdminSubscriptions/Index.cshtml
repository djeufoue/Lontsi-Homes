@model RentHub.Portal.ViewModels.AdminSubscriptions.AdminSubscriptionsIndexVm
@{
    ViewData["Title"] = "Subscription Control";
    var pendingCount = Model.PendingSubscriptions.Count;
}

<section class="rh-page-header rh-page-header-elevated">
    <div>
        <p class="rh-kicker">Admin Workspace</p>
        <h1 class="rh-heading-title">Subscription Control Center</h1>
        <p class="rh-heading-subtitle">Approve landlord subscriptions and keep account access aligned with active plan availability.</p>
    </div>
</section>

<section class="rh-property-summary mb-3">
    <article class="rh-summary-card">
        <p>Pending Approval</p>
        <h3>@pendingCount</h3>
        <small>Subscriptions waiting for admin action</small>
    </article>
    <article class="rh-summary-card">
        <p>Active Plans</p>
        <h3>@Model.Plans.Count</h3>
        <small>Plans currently available for registration</small>
    </article>
    <article class="rh-summary-card">
        <p>Approval Rule</p>
        <h3>Required</h3>
        <small>Landlords cannot create properties before approval</small>
    </article>
</section>

<section class="rh-panel rh-panel-elevated mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="rh-section-title mb-0">Pending Subscription Approvals</h2>
        <small class="text-muted">Approve subscriptions to unlock landlord operations.</small>
    </div>

    @if (!Model.PendingSubscriptions.Any())
    {
        <div class="rh-empty">No pending subscriptions right now.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle rh-table mb-0">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Plan</th>
                        <th class="text-end">Price</th>
                        <th>Start</th>
                        <th>End</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PendingSubscriptions)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.UserFullName) ? "N/A" : item.UserFullName)</div>
                                <small class="text-muted">@item.UserEmail</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.PlanName</div>
                                <small class="text-muted">@item.PlanDurationInDays days</small>
                            </td>
                            <td class="text-end">@item.PlanPrice.ToString("N0") XAF</td>
                            <td>@item.StartDate.LocalDateTime.ToString("yyyy-MM-dd")</td>
                            <td>@item.EndDate.LocalDateTime.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <form asp-action="Approve" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="subscriptionId" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm rh-btn-primary">Approve</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
