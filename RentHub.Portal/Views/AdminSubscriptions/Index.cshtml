@model RentHub.Portal.ViewModels.AdminSubscriptions.AdminSubscriptionsIndexVm
@{
    ViewData["Title"] = "Subscription Control";
    var pendingCount = Model.Subscriptions.Count(item => item.Status == "Pending approval");
    string ChipClass(string status) => status switch
    {
        "Active" => "rh-chip-success",
        "Pending approval" => "rh-chip-warning",
        "Rejected" or "Failed" => "rh-chip-danger",
        _ => "rh-chip-info"
    };
}

<section class="rh-page-header rh-page-header-elevated">
    <div>
        <p class="rh-kicker">Admin Workspace</p>
        <h1 class="rh-heading-title">Subscription Control Center</h1>
        <p class="rh-heading-subtitle">Review every landlord subscription and keep a complete decision history.</p>
    </div>
</section>

<section class="rh-property-summary mb-3">
    <article class="rh-summary-card">
        <p>Pending Approval</p>
        <h3>@pendingCount</h3>
        <small>Subscriptions waiting for admin action</small>
    </article>
    <article class="rh-summary-card">
        <p>Subscription Records</p>
        <h3>@Model.Subscriptions.Count</h3>
        <small>Pending, active, expired, and rejected</small>
    </article>
    <article class="rh-summary-card">
        <p>Active Plans</p>
        <h3>@Model.Plans.Count</h3>
        <small>Plans currently available for registration</small>
    </article>
</section>

<section class="rh-panel rh-panel-elevated mb-3">
    <form method="get" asp-action="Index" class="rh-table-filter-grid rh-auto-search-form">
        <div class="flex-grow-1">
            <label class="form-label" for="subscriptionSearch">Search subscriptions</label>
            <input class="form-control js-auto-submit" id="subscriptionSearch" name="search" value="@Model.Search"
                   placeholder="Landlord name, email, plan, or payment reference" />
        </div>
        <div class="d-flex gap-3 align-self-end">
            <button class="btn rh-btn-primary" type="submit">Search</button>
        </div>
    </form>
</section>

<section class="rh-panel rh-panel-elevated mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="rh-section-title mb-0">Landlord Subscription Register</h2>
        <small class="text-muted">Pending requests appear first; all decisions remain visible.</small>
    </div>

    @if (!Model.Subscriptions.Any())
    {
        <div class="rh-empty">No subscriptions match this search.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle rh-table mb-0">
                <thead>
                    <tr>
                        <th>Landlord</th>
                        <th>Plan</th>
                        <th>Status</th>
                        <th>Request</th>
                        <th class="text-end">Price</th>
                        <th>Requested</th>
                        <th>Coverage</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Subscriptions)
                    {
                        var displayName = string.IsNullOrWhiteSpace(item.UserFullName) ? item.UserEmail : item.UserFullName;
                        var canDecide = item.Status == "Pending approval";
                        <tr>
                            <td>
                                <a class="rh-table-property-link fw-semibold" asp-action="History" asp-route-subscriptionId="@item.Id">@displayName</a>
                                <small class="text-muted d-block">@item.UserEmail</small>
                            </td>
                            <td>
                                <a class="rh-table-property-link fw-semibold" asp-action="History" asp-route-subscriptionId="@item.Id">@item.PlanName</a>
                                <small class="text-muted d-block">@item.DurationMonths month(s)</small>
                            </td>
                            <td><span class="rh-chip @ChipClass(item.Status)">@item.Status</span></td>
                            <td>
                                <div class="fw-semibold">@item.PaymentMethod</div>
                                <a class="text-muted small" asp-action="History" asp-route-subscriptionId="@item.Id">@item.PaymentReference</a>
                            </td>
                            <td class="text-end">@item.PlanPrice.ToString("N0") XAF</td>
                            <td>@item.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @item.StartDate.LocalDateTime.ToString("dd MMM yyyy")
                                <small class="text-muted d-block">to @item.EndDate.LocalDateTime.ToString("dd MMM yyyy")</small>
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm rh-btn-subtle" asp-action="History" asp-route-subscriptionId="@item.Id">History</a>
                                @if (canDecide)
                                {
                                    <form asp-action="Approve" method="post" class="d-inline ms-1"
                                          data-confirm-modal="true"
                                          data-confirm-title="Approve subscription?"
                                          data-confirm-message="Approve @item.PlanName for @displayName after confirming the @item.PaymentMethod payment of @item.PlanPrice.ToString("N0") XAF?"
                                          data-confirm-proceed="Approve subscription"
                                          data-confirm-style="primary">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="subscriptionId" value="@item.Id" />
                                        <input type="hidden" name="search" value="@Model.Search" />
                                        <button type="submit" class="btn btn-sm rh-btn-primary">Approve</button>
                                    </form>
                                    <form asp-action="Reject" method="post" class="d-inline ms-1"
                                          data-confirm-modal="true"
                                          data-confirm-title="Reject subscription?"
                                          data-confirm-message="Reject the @item.PlanName request from @displayName? The decision will stay in the subscription history."
                                          data-confirm-proceed="Reject request"
                                          data-confirm-style="danger">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="subscriptionId" value="@item.Id" />
                                        <input type="hidden" name="search" value="@Model.Search" />
                                        <button type="submit" class="btn btn-sm rh-btn-danger">Reject</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
