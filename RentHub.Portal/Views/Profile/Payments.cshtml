@model RentHub.Portal.ViewModels.Profile.ProfileIndexVm
@using Common.Enums
@using Common.CommunicationModels
@using System.Globalization
@using System.Text.Json
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = T["Payment Center"].Value;

    var overview = Model.Overview;
    var now = Model.NowUtc;
    var usdToXafRate = Configuration.GetValue<decimal?>("Subscriptions:UsdToXafRate") ?? 565m;
    if (usdToXafRate <= 0)
    {
        usdToXafRate = 565m;
    }
    string NormalizeCountryCode(string? countryCode)
    {
        var digits = new string((countryCode ?? string.Empty).Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(digits) ? string.Empty : $"+{digits}";
    }
    string FormatUsd(decimal xaf) => (xaf / usdToXafRate).ToString("C", CultureInfo.CurrentCulture);
    string FormatXaf(decimal xaf) => xaf.ToString("N0", CultureInfo.CurrentCulture);
    List<string> PlanFeatures(SubscriptionPlanDto plan)
    {
        var features = (plan.FeatureHighlights ?? string.Empty)
            .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(feature => !string.IsNullOrWhiteSpace(feature))
            .ToList();

        if (features.Count > 0)
        {
            return features.Select(feature => T[feature].Value).ToList();
        }

        return new List<string>
        {
            T["Up to {0} properties", plan.MaxProperties.HasValue ? plan.MaxProperties.Value : T["unlimited"].Value].Value,
            T["Up to {0} apartments / property", plan.MaxApartmentsPerProperty.HasValue ? plan.MaxApartmentsPerProperty.Value : T["unlimited"].Value].Value,
            T["Up to {0} apartments total", plan.MaxTotalApartments.HasValue ? plan.MaxTotalApartments.Value.ToString("N0") : T["unlimited"].Value].Value
        };
    }
    var hasCurrentPlan = overview.HasActiveSubscription && overview.SubscriptionEndDate.HasValue && overview.SubscriptionEndDate.Value > now;
    var smsVerificationUnavailable = !overview.SmsVerificationEnabled;
    var hasPendingSubscriptionPayment = overview.PendingSubscriptionId.HasValue &&
        overview.PendingPaymentStatus == PaymentStatusEnum.Pending &&
        overview.PendingPaymentMethod != PaymentMethodEnum.Card;
    var registeredMobileMoneyNumber = !string.IsNullOrWhiteSpace(overview.SubscriptionPaymentPhoneNumber)
        ? overview.SubscriptionPaymentPhoneNumber
        : !string.IsNullOrWhiteSpace(overview.PayoutPhoneNumber)
            ? overview.PayoutPhoneNumber
            : overview.PhoneNumber ?? string.Empty;
    var registeredPaymentChannel = overview.SubscriptionPaymentChannel ?? overview.PayoutChannel;
    var registeredPaymentMethodLabel = registeredPaymentChannel switch
    {
        PayoutChannelEnum.MtnMoney => "MTN Mobile Money",
        PayoutChannelEnum.OrangeMoney => "Orange Money",
        _ => T["Not configured"].Value
    };
    var hasRegisteredMobileMoneyPayment = !smsVerificationUnavailable &&
        !string.IsNullOrWhiteSpace(registeredMobileMoneyNumber) &&
        registeredPaymentChannel is PayoutChannelEnum.MtnMoney or PayoutChannelEnum.OrangeMoney &&
        overview.IsSubscriptionPaymentPhoneVerified;
    var isLandlord = overview.Roles.Any(role => string.Equals(role, "Landlord", StringComparison.OrdinalIgnoreCase));
    var isCameroonLandlord = string.Equals(NormalizeCountryCode(overview.CountryCode), "+237", StringComparison.Ordinal);
    var canPaySubscription = overview.CanStartSubscriptionCheckout;
    var payoutSetupInProgress = overview.StripePayoutSetupStarted || overview.HasStripePayoutAccount;
    var payoutSetupButtonText = payoutSetupInProgress ? T["Continue Stripe setup"].Value : T["Set up payout account"].Value;
    var payoutSetupHeading = payoutSetupInProgress ? T["Continue your Stripe payout setup"].Value : T["Set up your Stripe payout account"].Value;
    var payoutSetupHint = payoutSetupInProgress
        ? T["Stripe saved your payout account, but still needs a few details before tenant rent payments can be routed to you."].Value
        : T["Required before subscription so tenant rent payments can be routed to you later."].Value;
    var stripePayoutStatusLabel = overview.StripePayoutSetupComplete
        ? T["Ready"].Value
        : !overview.StripeConnectPlatformEnabled
            ? T["Testing bypass"].Value
        : payoutSetupInProgress
            ? T["Incomplete"].Value
            : T["Not set up"].Value;
    var stripePayoutStatusHint = overview.StripePayoutSetupComplete
        ? T["Tenant rent payouts enabled"].Value
        : !overview.StripeConnectPlatformEnabled
            ? T["Stripe Connect activation pending"].Value
        : payoutSetupInProgress
            ? T["Continue Stripe onboarding"].Value
            : T["Required before subscription"].Value;
    var mobileMoneyUnavailableMessage = T["MTN Mobile Money and Orange Money payments are not available yet. Please use card payment for this release."].Value;
    var mobileMoneySetupUrl = Url.Action("MobileMoneySetup", "Profile");
    var startMobileMoneyUpdateUrl = Url.Action("StartMobileMoneyUpdate", "Profile");
    var cancelMobileMoneyUpdateUrl = Url.Action("CancelMobileMoneyUpdate", "Profile");
    var verifyMobileMoneyOtpUrl = Url.Action("VerifyMobileMoneyOtp", "Profile");
    var resendMobileMoneyOtpUrl = Url.Action("ResendMobileMoneyOtp", "Profile");
    var subscriptionPending = !smsVerificationUnavailable &&
        !string.IsNullOrWhiteSpace(overview.SubscriptionPaymentPhoneNumber) &&
        !overview.IsSubscriptionPaymentPhoneVerified;
    var payoutPending = !smsVerificationUnavailable &&
        !string.IsNullOrWhiteSpace(overview.PayoutPhoneNumber) &&
        !overview.IsPayoutPhoneVerified;
    var whatsAppPending = !smsVerificationUnavailable &&
        !string.IsNullOrWhiteSpace(overview.WhatsAppPhoneNumber) &&
        !overview.IsWhatsAppPhoneVerified;
    var hasPendingMobilePaymentVerification = subscriptionPending || payoutPending || whatsAppPending;
    var mobileMoneyActionDisabled = smsVerificationUnavailable || hasPendingMobilePaymentVerification;
    var payoutSharesSubscriptionPendingNumber = payoutPending &&
        subscriptionPending &&
        string.Equals(
            (overview.PayoutPhoneNumber ?? string.Empty).Trim(),
            (overview.SubscriptionPaymentPhoneNumber ?? string.Empty).Trim(),
            StringComparison.OrdinalIgnoreCase);
    var subscriptionRetryAfter = Math.Max(0, overview.SubscriptionPaymentOtpRequestLimit?.RetryAfterSeconds ?? 0);
    var payoutRetryAfter = Math.Max(0, overview.PayoutOtpRequestLimit?.RetryAfterSeconds ?? 0);
    var whatsAppRetryAfter = Math.Max(0, overview.WhatsAppOtpRequestLimit?.RetryAfterSeconds ?? 0);
    var subscriptionDailyLimitReached = overview.SubscriptionPaymentOtpRequestLimit?.DailyLimitReached ?? false;
    var payoutDailyLimitReached = overview.PayoutOtpRequestLimit?.DailyLimitReached ?? false;
    var whatsAppDailyLimitReached = overview.WhatsAppOtpRequestLimit?.DailyLimitReached ?? false;
    var boolText = (Func<bool, string>)(value => value.ToString().ToLowerInvariant());
    var primaryPhone = smsVerificationUnavailable
        ? T["not required for this account"].Value
        : string.IsNullOrWhiteSpace(overview.PhoneNumber) ? T["your verified phone"].Value : overview.PhoneNumber;
    var subscriptionChannel = overview.SubscriptionPaymentChannel ?? PayoutChannelEnum.MtnMoney;
    var payoutChannel = overview.PayoutChannel ?? PayoutChannelEnum.MtnMoney;
    var paymentClientTranslations = new Dictionary<string, string>
    {
        ["Unable to refresh subscription details."] = T["Unable to refresh subscription details."].Value,
        ["Working..."] = T["Working..."].Value,
        ["Confirming..."] = T["Confirming..."].Value,
        ["Rent payout number"] = T["Rent payout number"].Value,
        ["WhatsApp alerts number"] = T["WhatsApp alerts number"].Value,
        ["Subscription payment number"] = T["Subscription payment number"].Value,
        ["Not provided"] = T["Not provided"].Value,
        ["Verified"] = T["Verified"].Value,
        ["Pending verification"] = T["Pending verification"].Value,
        ["Enter the OTP sent to the new number to finish the update."] = T["Enter the OTP sent to the new number to finish the update."].Value,
        ["Send OTP first, then enter the code here."] = T["Send OTP first, then enter the code here."].Value,
        ["Resend available in {0}."] = T["Resend available in {0}."].Value,
        ["Loading..."] = T["Loading..."].Value,
        ["Unable to reload the latest Mobile Money setup. Showing the last loaded values."] = T["Unable to reload the latest Mobile Money setup. Showing the last loaded values."].Value,
        ["Sending..."] = T["Sending..."].Value,
        ["OTP sent to the new number. Enter it below to confirm the update."] = T["OTP sent to the new number. Enter it below to confirm the update."].Value,
        ["Unable to send the OTP right now. Please try again."] = T["Unable to send the OTP right now. Please try again."].Value,
        ["You have reached today's OTP request limit. Please try again later."] = T["You have reached today's OTP request limit. Please try again later."].Value,
        ["Discarding..."] = T["Discarding..."].Value,
        ["Unable to discard this update right now. Please try again."] = T["Unable to discard this update right now. Please try again."].Value,
        ["Unable to verify this OTP. Please try again."] = T["Unable to verify this OTP. Please try again."].Value,
        ["Verifying..."] = T["Verifying..."].Value,
        ["Number verified successfully."] = T["Number verified successfully."].Value,
        ["Verify"] = T["Verify"].Value,
        ["OTP sent. You can request another code after the cooldown."] = T["OTP sent. You can request another code after the cooldown."].Value,
        ["Unable to resend the OTP right now. Please try again."] = T["Unable to resend the OTP right now. Please try again."].Value
    };
}

<section class="rh-page-header rh-page-header-elevated">
    <div>
        <p class="rh-kicker">@T["Payment Center"]</p>
        <h1 class="rh-heading-title">@T["Payments and Subscriptions"]</h1>
        <p class="rh-heading-subtitle">@T["Review your subscription status, payment options, and available landlord plans."]</p>
    </div>
    <div class="rh-toolbar">
        <a class="btn rh-btn-subtle" asp-controller="Profile" asp-action="Index">@T["Back to Profile"]</a>
        @if (overview.AutomaticPaymentsEnabled && isLandlord && isCameroonLandlord)
        {
            <button type="button" class="btn rh-btn-primary" data-mobile-money-open @(mobileMoneyActionDisabled ? "disabled" : null)>@T["Update Mobile Money"]</button>
        }
    </div>
</section>

<div class="alert d-none" data-payment-feedback></div>

@if (!isLandlord)
{
    <section class="rh-panel rh-panel-elevated">
        <h2 class="rh-section-title mb-2">@T["Landlord payment workspace"]</h2>
        <p class="text-muted mb-0">@T["This page is used for landlord subscription payment setup. Admin payment settings are managed in Subscription Control."]</p>
    </section>
}
else
{
    <section class="rh-profile-metrics mb-3">
        <article class="rh-summary-card">
            <p>@T["Subscription Status"]</p>
            <h3>@(hasCurrentPlan ? T["Active"].Value : hasPendingSubscriptionPayment ? T["Pending"].Value : T["Inactive"].Value)</h3>
            <small>@(hasCurrentPlan ? T["Current plan: {0}", overview.CurrentPlanName].Value : T["Choose a plan when your account is ready"].Value)</small>
        </article>
        @if (overview.AutomaticPaymentsEnabled && isCameroonLandlord)
        {
            <article class="rh-summary-card">
                <p>@T["Payment Method"]</p>
                <h3>@(smsVerificationUnavailable ? T["Card testing"].Value : registeredPaymentMethodLabel)</h3>
                <small>@(smsVerificationUnavailable ? T["Phone verification is not required"].Value : hasRegisteredMobileMoneyPayment ? registeredMobileMoneyNumber : T["Card payment available"].Value)</small>
            </article>
            <article class="rh-summary-card">
                <p>@T["Mobile Money Payout"]</p>
                <h3>@(smsVerificationUnavailable ? T["Temporarily skipped"].Value : overview.IsPayoutPhoneVerified ? T["Verified"].Value : T["Pending"].Value)</h3>
                <small>@(!string.IsNullOrWhiteSpace(overview.PayoutPhoneNumber) ? overview.PayoutPhoneNumber : T["Not configured"].Value)</small>
            </article>
        }
        else
        {
            <article class="rh-summary-card">
                <p>@T["Payment Method"]</p>
                <h3>@(overview.AutomaticPaymentsEnabled ? T["Card"].Value : T["Manual"].Value)</h3>
                <small>@(overview.AutomaticPaymentsEnabled ? T["Stripe checkout"].Value : T["Cash activation after admin review"].Value)</small>
            </article>
        }
        @if (overview.AutomaticPaymentsEnabled)
        {
            <article class="rh-summary-card">
                <p>@T["Stripe Payout Account"]</p>
                <h3>@stripePayoutStatusLabel</h3>
                <small>@stripePayoutStatusHint</small>
            </article>
        }
        <article class="rh-summary-card">
            <p>@T["Subscription Access"]</p>
            <h3>@(overview.CanStartSubscriptionCheckout ? T["Unlocked"].Value : T["Blocked"].Value)</h3>
            <small>@T[string.IsNullOrWhiteSpace(overview.SubscriptionBlockedReason) ? (overview.AutomaticPaymentsEnabled ? "Ready for checkout" : "Ready to request manual activation") : overview.SubscriptionBlockedReason]</small>
        </article>
    </section>

    @if (!overview.AutomaticPaymentsEnabled)
    {
        <section class="rh-panel rh-panel-elevated rh-payout-setup-panel mb-3">
            <div>
                <p class="rh-kicker mb-1">@T["Manual subscription mode"]</p>
                <h2 class="rh-section-title mb-1">@T["Automatic payments are temporarily unavailable"]</h2>
                <p class="rh-card-meta mb-0">@T["Choose a plan below and send an activation request. An administrator will approve it after confirming that the cash payment was received."]</p>
            </div>
            <a class="btn rh-btn-primary" href="#subscriptionPlans">@T["Choose a plan"]</a>
        </section>
    }
    else if (!overview.StripePayoutSetupComplete && overview.StripePayoutSetupRequired)
    {
        <section class="rh-panel rh-panel-elevated rh-payout-setup-panel mb-3">
            <div>
                <p class="rh-kicker mb-1">@T["Payout setup"]</p>
                <h2 class="rh-section-title mb-1">@(overview.IsKycApproved ? payoutSetupHeading : T["KYC approval required before Stripe setup"].Value)</h2>
                <p class="rh-card-meta mb-0">@(overview.IsKycApproved ? payoutSetupHint : T["An administrator must approve your KYC before you can connect a Stripe payout account."].Value)</p>
            </div>
            @if (overview.IsKycApproved)
            {
                <a class="btn rh-btn-primary" asp-controller="Profile" asp-action="PayoutSetup">@payoutSetupButtonText</a>
            }
            else
            {
                <a class="btn rh-btn-subtle" asp-controller="Profile" asp-action="Index">@T["Check KYC status"]</a>
            }
        </section>
    }
    else if (!overview.StripeConnectPlatformEnabled)
    {
        <section class="rh-panel rh-panel-elevated rh-payout-setup-panel mb-3">
            <div>
                <p class="rh-kicker mb-1">@T["Payout setup"]</p>
                <h2 class="rh-section-title mb-1">@T["Stripe Connect activation pending"]</h2>
                <p class="rh-card-meta mb-0">@T["Payout account setup is temporarily skipped. Continue testing checkout with fake card information only."]</p>
            </div>
            <a class="btn rh-btn-primary" href="#subscriptionPlans">@T["Test subscription checkout"]</a>
        </section>
    }
    else if (!hasCurrentPlan)
    {
        <section class="rh-panel rh-panel-elevated rh-payout-setup-panel is-complete mb-3">
            <div>
                <p class="rh-kicker mb-1">@T["Payout setup"]</p>
                <h2 class="rh-section-title mb-1">@T["Payout account ready"]</h2>
                <p class="rh-card-meta mb-0">@T["Choose a subscription plan when your KYC approval is complete."]</p>
            </div>
            <a class="btn rh-btn-primary" href="#subscriptionPlans">@T["Choose subscription"]</a>
        </section>
    }

    <section class="rh-profile-grid mb-3">
        @if (overview.AutomaticPaymentsEnabled && isCameroonLandlord)
        {
            <article class="rh-panel rh-panel-elevated">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h2 class="rh-section-title mb-0">@T["Mobile Money Accounts"]</h2>
                    <button type="button" class="btn btn-sm rh-btn-subtle" data-mobile-money-open @(mobileMoneyActionDisabled ? "disabled" : null)>@T["Edit setup"]</button>
                </div>

                @if (!smsVerificationUnavailable && hasPendingMobilePaymentVerification)
                {
                    <div class="alert alert-warning py-2 rh-mobile-pending-banner">
                        @T["Finish OTP validation for the pending number before changing Mobile Money setup again."]
                    </div>
                }

                <div class="rh-profile-info-grid">
                    <div class="rh-profile-info-item rh-payment-phone-section @(subscriptionPending ? "is-pending" : string.Empty)" data-otp-section="subscription">
                        <p>@T["Subscription Payment Number"]</p>
                        <h3>@(!string.IsNullOrWhiteSpace(overview.SubscriptionPaymentPhoneNumber) ? overview.SubscriptionPaymentPhoneNumber : T["Not provided"].Value)</h3>
                        @if (subscriptionPending)
                        {
                            <div class="rh-payment-pending-note">
                                @T["Pending OTP verification. This number is not usable for subscription checkout yet."]
                            </div>
                            <form action="@verifyMobileMoneyOtpUrl" method="post" class="rh-otp-form" data-mobile-otp-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="target" value="subscription" />
                                <label class="form-label rh-mini-label" for="subscriptionPaymentOtp">@T["OTP code"]</label>
                                <div class="rh-otp-input-row">
                                    <input id="subscriptionPaymentOtp" name="otp" class="form-control form-control-sm" autocomplete="one-time-code" inputmode="numeric" maxlength="6" placeholder="@T["Enter OTP"]" required />
                                    <button type="submit" class="btn btn-sm rh-btn-primary" data-otp-verify>@T["Verify"]</button>
                                </div>
                            </form>
                            <form action="@resendMobileMoneyOtpUrl" method="post" class="rh-otp-resend-form" data-mobile-resend-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="target" value="subscription" />
                                <button type="submit"
                                        class="btn btn-sm rh-btn-subtle"
                                        data-otp-resend
                                        data-target="subscription"
                                        data-retry-after="@subscriptionRetryAfter"
                                        data-daily-limit-reached="@boolText(subscriptionDailyLimitReached)"
                                        @(subscriptionDailyLimitReached || subscriptionRetryAfter > 0 ? "disabled" : null)>
                                    @T["Resend OTP"]
                                </button>
                            </form>
                            <small class="text-muted d-block mt-2 @(subscriptionRetryAfter > 0 && !subscriptionDailyLimitReached ? string.Empty : "d-none")" data-otp-countdown></small>
                            <small class="text-danger d-block mt-2 @(subscriptionDailyLimitReached ? string.Empty : "d-none")" data-otp-daily-limit>@T["You have reached today's OTP request limit. Please try again after the daily reset."]</small>
                            <small class="d-block mt-2 d-none" data-otp-message></small>
                        }
                    </div>
                    <div class="rh-profile-info-item">
                        <p>@T["Subscription Payment Network"]</p>
                        <h3>@(overview.SubscriptionPaymentChannel.HasValue ? T[overview.SubscriptionPaymentChannel.Value.ToString()].Value : T["Not provided"].Value)</h3>
                    </div>
                    <div class="rh-profile-info-item">
                        <p>@T["Subscription Payment Verification"]</p>
                        <h3>@(smsVerificationUnavailable ? T["Temporarily skipped"].Value : overview.IsSubscriptionPaymentPhoneVerified ? T["Verified"].Value : T["Pending"].Value)</h3>
                    </div>
                    <div class="rh-profile-info-item rh-payment-phone-section @(payoutPending ? "is-pending" : string.Empty)" data-otp-section="payout">
                        <p>@T["Rent Payout Number"]</p>
                        <h3>@(!string.IsNullOrWhiteSpace(overview.PayoutPhoneNumber) ? overview.PayoutPhoneNumber : T["Not provided"].Value)</h3>
                        @if (payoutPending)
                        {
                            <div class="rh-payment-pending-note">
                                @T["Pending OTP verification. This number cannot be used for rent payouts yet."]
                            </div>
                            @if (payoutSharesSubscriptionPendingNumber)
                            {
                                <small class="text-muted d-block mt-2">@T["This payout uses the same pending number as subscription payments. Verify the subscription payment number first."]</small>
                            }
                            else
                            {
                                <form action="@verifyMobileMoneyOtpUrl" method="post" class="rh-otp-form" data-mobile-otp-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="target" value="payout" />
                                    <label class="form-label rh-mini-label" for="payoutOtp">@T["OTP code"]</label>
                                    <div class="rh-otp-input-row">
                                        <input id="payoutOtp" name="otp" class="form-control form-control-sm" autocomplete="one-time-code" inputmode="numeric" maxlength="6" placeholder="@T["Enter OTP"]" required />
                                        <button type="submit" class="btn btn-sm rh-btn-primary" data-otp-verify>@T["Verify"]</button>
                                    </div>
                                </form>
                                <form action="@resendMobileMoneyOtpUrl" method="post" class="rh-otp-resend-form" data-mobile-resend-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="target" value="payout" />
                                    <button type="submit"
                                            class="btn btn-sm rh-btn-subtle"
                                            data-otp-resend
                                            data-target="payout"
                                            data-retry-after="@payoutRetryAfter"
                                            data-daily-limit-reached="@boolText(payoutDailyLimitReached)"
                                            @(payoutDailyLimitReached || payoutRetryAfter > 0 ? "disabled" : null)>
                                        @T["Resend OTP"]
                                    </button>
                                </form>
                                <small class="text-muted d-block mt-2 @(payoutRetryAfter > 0 && !payoutDailyLimitReached ? string.Empty : "d-none")" data-otp-countdown></small>
                                <small class="text-danger d-block mt-2 @(payoutDailyLimitReached ? string.Empty : "d-none")" data-otp-daily-limit>@T["You have reached today's OTP request limit. Please try again after the daily reset."]</small>
                                <small class="d-block mt-2 d-none" data-otp-message></small>
                            }
                        }
                    </div>
                    <div class="rh-profile-info-item">
                        <p>@T["Rent Payout Network"]</p>
                        <h3>@(overview.PayoutChannel.HasValue ? T[overview.PayoutChannel.Value.ToString()].Value : T["Not provided"].Value)</h3>
                    </div>
                    <div class="rh-profile-info-item">
                        <p>@T["Rent Payout Verification"]</p>
                        <h3>@(smsVerificationUnavailable ? T["Temporarily skipped"].Value : overview.IsPayoutPhoneVerified ? T["Verified"].Value : T["Pending"].Value)</h3>
                    </div>
                    <div class="rh-profile-info-item rh-payment-phone-section @(whatsAppPending ? "is-pending" : string.Empty)" data-otp-section="whatsapp">
                        <p>@T["WhatsApp Alerts Number"]</p>
                        <h3>@(!string.IsNullOrWhiteSpace(overview.WhatsAppPhoneNumber) ? overview.WhatsAppPhoneNumber : T["Not provided"].Value)</h3>
                        @if (whatsAppPending)
                        {
                            <div class="rh-payment-pending-note">
                                @T["Pending OTP verification. WhatsApp alerts will use this number after confirmation."]
                            </div>
                            <form action="@verifyMobileMoneyOtpUrl" method="post" class="rh-otp-form" data-mobile-otp-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="target" value="whatsapp" />
                                <label class="form-label rh-mini-label" for="whatsAppOtp">@T["OTP code"]</label>
                                <div class="rh-otp-input-row">
                                    <input id="whatsAppOtp" name="otp" class="form-control form-control-sm" autocomplete="one-time-code" inputmode="numeric" maxlength="6" placeholder="@T["Enter OTP"]" required />
                                    <button type="submit" class="btn btn-sm rh-btn-primary" data-otp-verify>@T["Verify"]</button>
                                </div>
                            </form>
                            <form action="@resendMobileMoneyOtpUrl" method="post" class="rh-otp-resend-form" data-mobile-resend-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="target" value="whatsapp" />
                                <button type="submit"
                                        class="btn btn-sm rh-btn-subtle"
                                        data-otp-resend
                                        data-target="whatsapp"
                                        data-retry-after="@whatsAppRetryAfter"
                                        data-daily-limit-reached="@boolText(whatsAppDailyLimitReached)"
                                        @(whatsAppDailyLimitReached || whatsAppRetryAfter > 0 ? "disabled" : null)>
                                    @T["Resend OTP"]
                                </button>
                            </form>
                            <small class="text-muted d-block mt-2 @(whatsAppRetryAfter > 0 && !whatsAppDailyLimitReached ? string.Empty : "d-none")" data-otp-countdown></small>
                            <small class="text-danger d-block mt-2 @(whatsAppDailyLimitReached ? string.Empty : "d-none")" data-otp-daily-limit>@T["You have reached today's OTP request limit. Please try again after the daily reset."]</small>
                            <small class="d-block mt-2 d-none" data-otp-message></small>
                        }
                    </div>
                    <div class="rh-profile-info-item">
                        <p>@T["WhatsApp Alerts Verification"]</p>
                        <h3>@(smsVerificationUnavailable ? T["Temporarily skipped"].Value : string.IsNullOrWhiteSpace(overview.WhatsAppPhoneNumber) ? T["Not required"].Value : overview.IsWhatsAppPhoneVerified ? T["Verified"].Value : T["Pending"].Value)</h3>
                    </div>
                </div>
            </article>
        }

        <article class="rh-panel rh-panel-elevated">
            @await Html.PartialAsync("_SubscriptionDetails", Model)
        </article>
    </section>

    <section class="rh-panel rh-panel-elevated" id="subscriptionPlans">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 class="rh-section-title mb-0">@T["Choose Subscription"]</h2>
            <small class="text-muted">@(overview.AutomaticPaymentsEnabled ? T["Use card checkout to pay your landlord subscription."].Value : T["Request activation after arranging the cash payment with the platform administrator."].Value)</small>
        </div>
        @if (overview.AutomaticPaymentsEnabled && isCameroonLandlord)
        {
            <div class="alert alert-danger py-2">
                @mobileMoneyUnavailableMessage
            </div>
        }

        @if (!overview.AvailablePlans.Any())
        {
            <div class="rh-empty">@T["No plans available right now."]</div>
        }
        else
        {
            <div class="rh-profile-plan-grid">
                @foreach (var plan in overview.AvailablePlans)
                {
                    var isCurrent = overview.CurrentPlanId.HasValue && overview.CurrentPlanId.Value == plan.Id && hasCurrentPlan;
                    var isPendingPlan = hasPendingSubscriptionPayment && overview.PendingPlanId == plan.Id;
                    var isChangingPendingPlan = !overview.AutomaticPaymentsEnabled && hasPendingSubscriptionPayment && !isPendingPlan;
                    var features = PlanFeatures(plan);
                    var requestConfirmTitle = isChangingPendingPlan ? T["Change pending subscription?"].Value : T["Request this subscription?"].Value;
                    var requestConfirmMessage = isChangingPendingPlan
                        ? T["Replace the pending {0} request with {1}? The administrator will review only the new choice.", overview.PendingPlanName, plan.Name].Value
                        : T["Request {0} for manual activation after your cash payment is verified?", plan.Name].Value;
                    var requestConfirmProceed = isChangingPendingPlan ? T["Change plan"].Value : T["Send request"].Value;
                    <article class="rh-profile-plan-card @(isCurrent ? "is-current" : string.Empty) @(plan.IsRecommended ? "is-recommended" : string.Empty)">
                        <div class="rh-admin-plan-head">
                            <div>
                                @if (plan.IsRecommended)
                                {
                                    <span class="rh-landing-pricing-badge">@T["Recommended"]</span>
                                }
                                <h3>@plan.Name</h3>
                            </div>
                            <span class="rh-chip @(isCurrent ? "rh-chip-primary" : "rh-chip-info")">@(plan.IsContactSales ? T["Custom"].Value : T["Monthly"].Value)</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(plan.Description))
                        {
                            <p class="text-muted mb-2">@T[plan.Description]</p>
                        }

                        @if (plan.IsContactSales)
                        {
                            <p class="rh-profile-plan-price">
                                @T["Custom pricing"]
                                <span class="d-block text-muted small">@T["Contact sales"]</span>
                            </p>
                        }
                        else
                        {
                            <p class="rh-profile-plan-price">
                                @FormatUsd(plan.Price)
                                <span class="d-block text-muted small">@T["per month"]</span>
                                @if (plan.AnnualPrice.HasValue)
                                {
                                    <span class="d-block text-muted small">@T["Yearly: {0}", FormatUsd(plan.AnnualPrice.Value)]</span>
                                }
                            </p>
                            <button type="button" class="btn btn-sm rh-btn-subtle rh-plan-fx-button" data-bs-toggle="modal" data-bs-target="#planFxModal_@plan.Id">
                                @T["View FCFA estimate"]
                            </button>
                        }

                        <ul class="rh-profile-plan-meta">
                            @foreach (var feature in features)
                            {
                                <li>@feature</li>
                            }
                        </ul>

                        @if (plan.IsContactSales)
                        {
                            <div class="mt-3">
                                <a class="btn rh-btn-primary w-100"
                                   asp-controller="PlanInquiries"
                                   asp-action="Index"
                                   asp-route-plan="@plan.Name">@T["Describe your needs"]</a>
                            </div>
                        }
                        else
                        {
                            <form asp-action="@(overview.AutomaticPaymentsEnabled ? "StartCheckout" : "RequestManualSubscription")"
                                  method="post"
                                  class="mt-3 rh-subscription-form"
                                  data-subscription-form
                                  data-confirm-modal="@(!overview.AutomaticPaymentsEnabled ? "true" : null)"
                                  data-confirm-title="@requestConfirmTitle"
                                  data-confirm-message="@requestConfirmMessage"
                                  data-confirm-proceed="@requestConfirmProceed"
                                  data-confirm-style="primary"
                                  data-confirm-duration="@(!overview.AutomaticPaymentsEnabled ? "true" : null)">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="planId" value="@plan.Id" />
                                @if (!overview.AutomaticPaymentsEnabled)
                                {
                                    <input type="hidden" name="durationMonths" value="12" data-subscription-duration-input />
                                }

                                <ul class="rh-profile-plan-meta mb-3">
                                    <li>@T["Amount:"] <strong>@FormatUsd(plan.Price)</strong></li>
                                    @if (plan.AnnualPrice.HasValue)
                                    {
                                        <li>@T["Yearly value:"] <strong>@FormatUsd(plan.AnnualPrice.Value)</strong></li>
                                    }
                                    <li>@T["Activation:"] <strong>@(overview.AutomaticPaymentsEnabled ? T["Card via Stripe"].Value : T["Manual approval after cash payment"].Value)</strong></li>
                                </ul>

                                @if (isCurrent)
                                {
                                    <button type="button" class="btn rh-btn-subtle w-100" disabled>@T["Current Plan"]</button>
                                }
                                else if (isPendingPlan)
                                {
                                    <button type="button" class="btn rh-btn-subtle w-100" disabled>@T["Approval Pending"]</button>
                                }
                                else if (!overview.AutomaticPaymentsEnabled)
                                {
                                    <button type="submit" class="btn rh-btn-primary w-100" disabled="@(!canPaySubscription ? "disabled" : null)">
                                        @(canPaySubscription ? (isChangingPendingPlan ? T["Change to this plan"].Value : T["Request manual activation"].Value) : T["Verification required"].Value)
                                    </button>
                                    <div class="text-muted small mt-2">@T["The administrator will be notified and will approve or reject the request after verifying the cash payment."]</div>
                                }
                                else
                                {
                                    <input type="hidden" name="paymentMethod" value="@PaymentMethodEnum.Card" />
                                    <input type="hidden" name="allowAutomaticCardPayments" value="false" />
                                    <div class="form-check rh-auto-renew-check">
                                        <input class="form-check-input" type="checkbox" name="allowAutomaticCardPayments" value="true" id="autoRenew_@plan.Id" checked />
                                        <label class="form-check-label" for="autoRenew_@plan.Id">@T["Renew this plan automatically by card"]</label>
                                    </div>
                                    <button type="submit" class="btn rh-btn-primary w-100" disabled="@(!canPaySubscription ? "disabled" : null)">
                                        @(canPaySubscription ? (hasCurrentPlan ? T["Switch with card"].Value : T["Pay with card"].Value) : T["Verification required"].Value)
                                    </button>
                                    @if (!overview.CanStartSubscriptionCheckout && !string.IsNullOrWhiteSpace(overview.SubscriptionBlockedReason))
                                    {
                                        <div class="text-muted small mt-2">@T[overview.SubscriptionBlockedReason]</div>
                                    }
                                    @if (isCameroonLandlord)
                                    {
                                        <button type="button" class="btn rh-btn-subtle w-100 mt-2" disabled>@T["Orange / MTN unavailable"]</button>
                                        <div class="text-danger small mt-2">@mobileMoneyUnavailableMessage</div>
                                    }
                                }
                            </form>
                        }
                    </article>

                    @if (!plan.IsContactSales)
                    {
                        <div class="modal fade rh-plan-fx-modal" id="planFxModal_@plan.Id" tabindex="-1" aria-labelledby="planFxModalLabel_@plan.Id" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <div>
                                            <p class="rh-kicker mb-1">@T["Currency estimate"]</p>
                                            <h2 class="modal-title" id="planFxModalLabel_@plan.Id">@T["{0} plan", plan.Name]</h2>
                                        </div>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="rh-plan-fx-grid">
                                            <div>
                                                <span>@T["Monthly amount"]</span>
                                                <strong>@FormatUsd(plan.Price)</strong>
                                            </div>
                                            <div>
                                                <span>@T["Estimated FCFA value"]</span>
                                                <strong>@FormatXaf(plan.Price) XAF</strong>
                                            </div>
                                            @if (plan.AnnualPrice.HasValue)
                                            {
                                                <div>
                                                    <span>@T["Yearly card value"]</span>
                                                    <strong>@FormatUsd(plan.AnnualPrice.Value)</strong>
                                                </div>
                                                <div>
                                                    <span>@T["Estimated yearly FCFA value"]</span>
                                                    <strong>@FormatXaf(plan.AnnualPrice.Value) XAF</strong>
                                                </div>
                                            }
                                        </div>
                                        <p class="text-muted small mb-0 mt-3">
                                            @T["Estimate uses {0:N0} XAF per USD. Stripe charges the USD amount shown on the plan.", usdToXafRate]
                                        </p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Close"]</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </section>

    @if (isCameroonLandlord && !smsVerificationUnavailable)
    {
        <div class="modal fade rh-mobile-money-modal" id="mobileMoneyModal" tabindex="-1" aria-labelledby="mobileMoneyModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <p class="rh-kicker mb-1">@T["Payment settings"]</p>
                        <h2 class="modal-title" id="mobileMoneyModalLabel">@T["Update Mobile Money setup"]</h2>
                    </div>
                </div>
                <form action="@startMobileMoneyUpdateUrl" method="post" class="rh-mobile-money-form" data-mobile-money-form data-setup-url="@mobileMoneySetupUrl" data-cancel-url="@cancelMobileMoneyUpdateUrl" data-verify-url="@verifyMobileMoneyOtpUrl">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="target" value="subscription" data-mobile-target-field />
                    <div class="modal-body">
                        <div class="rh-inline-hint mb-3">
                            @T["Verified main phone:"] <strong data-mobile-primary-phone>@primaryPhone</strong>
                        </div>

                        <p class="rh-modal-warning">
                            @T["Change one number at a time. A changed number must be confirmed by OTP before it becomes usable."]
                        </p>

                        <div class="alert d-none py-2" data-mobile-money-message></div>

                        <div class="rh-mobile-money-single">
                            <div>
                                <label class="form-label rh-mini-label" for="MobileMoneyTarget">@T["Number to update"]</label>
                                <select class="form-select" id="MobileMoneyTarget" data-mobile-target>
                                    <option value="subscription">@T["Subscription payment number"]</option>
                                    <option value="payout">@T["Rent payout number"]</option>
                                    <option value="whatsapp">@T["WhatsApp alerts number"]</option>
                                </select>
                            </div>

                            <div class="rh-current-phone-card">
                                <span>@T["Current number"]</span>
                                <strong data-current-phone>@T["Not provided"]</strong>
                                <small data-current-phone-meta></small>
                            </div>

                            <div data-operator-group>
                                <label class="form-label rh-mini-label" for="MobileMoneyChannel">@T["Mobile Money operator"]</label>
                                <select class="form-select" id="MobileMoneyChannel" name="channel" data-mobile-channel>
                                    <option value="">@T["Choose operator"]</option>
                                    <option value="@PayoutChannelEnum.MtnMoney">MTN Money</option>
                                    <option value="@PayoutChannelEnum.OrangeMoney">Orange Money</option>
                                </select>
                            </div>

                            <div>
                                <label class="form-label rh-mini-label" for="MobileMoneyPhoneNumber">@T["New number"]</label>
                                <div class="rh-phone-input-group">
                                    <span class="rh-country-code-block">+237</span>
                                    <input class="form-control" id="MobileMoneyPhoneNumber" name="phoneNumber" inputmode="numeric" placeholder="6XXXXXXXX" data-mobile-phone />
                                </div>
                                <small class="text-danger d-none mt-2" data-phone-format-message>@T["Enter the 9-digit Cameroon number after +237, for example 696389202."]</small>
                            </div>

                            <div class="rh-otp-panel d-none" data-modal-otp-panel>
                                <label class="form-label rh-mini-label" for="MobileMoneyOtp">@T["OTP code"]</label>
                                <input class="form-control" id="MobileMoneyOtp" name="otp" autocomplete="one-time-code" inputmode="numeric" maxlength="6" placeholder="@T["Enter the 6-digit OTP"]" data-mobile-otp />
                                <small class="text-muted d-block mt-2" data-mobile-otp-hint>@T["Send OTP first, then enter the code here."]</small>
                                <button type="submit" class="btn rh-btn-primary mt-3 d-none" data-mobile-money-submit>@T["Send OTP"]</button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn rh-btn-subtle" data-mobile-money-discard>@T["Discard"]</button>
                        <button type="button" class="btn rh-btn-primary d-none" disabled data-mobile-money-confirm>@T["Confirm OTP"]</button>
                    </div>
                </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        window.rhPaymentI18n = @Html.Raw(JsonSerializer.Serialize(paymentClientTranslations));
    </script>
    <script>
        (() => {
            const pt = (key, ...args) => {
                let value = window.rhPaymentI18n?.[key] || key;
                args.forEach((argument, index) => value = value.replaceAll(`{${index}}`, String(argument)));
                return value;
            };
            const pollIntervalMs = 5000;
            const maxAttempts = 36;
            let attempts = 0;
            let timerId = null;

            const getPanel = () => document.querySelector("[data-subscription-details]");

            const shouldPoll = (panel) =>
                panel?.dataset.pendingPayment === "true" &&
                Boolean(panel.dataset.refreshUrl) &&
                attempts < maxAttempts;

            const schedule = () => {
                window.clearTimeout(timerId);
                timerId = window.setTimeout(refreshSubscriptionDetails, pollIntervalMs);
            };

            const refreshSubscriptionDetails = async () => {
                const panel = getPanel();
                if (!shouldPoll(panel)) {
                    return;
                }

                attempts += 1;
                panel.setAttribute("aria-busy", "true");

                try {
                    const response = await fetch(panel.dataset.refreshUrl, {
                        credentials: "same-origin",
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });

                    if (!response.ok) {
                        throw new Error(pt("Unable to refresh subscription details."));
                    }

                    const template = document.createElement("template");
                    template.innerHTML = (await response.text()).trim();
                    const updatedPanel = template.content.firstElementChild;

                    if (!updatedPanel) {
                        schedule();
                        return;
                    }

                    panel.replaceWith(updatedPanel);

                    if (shouldPoll(updatedPanel)) {
                        schedule();
                    }
                } catch {
                    schedule();
                } finally {
                    getPanel()?.removeAttribute("aria-busy");
                }
            };

            const startPolling = () => {
                if (shouldPoll(getPanel())) {
                    schedule();
                }
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", startPolling, { once: true });
            } else {
                startPolling();
            }
        })();
    </script>
    <script>
        (() => {
            const pt = (key, ...args) => {
                let value = window.rhPaymentI18n?.[key] || key;
                args.forEach((argument, index) => value = value.replaceAll(`{${index}}`, String(argument)));
                return value;
            };
            const modalElement = document.getElementById("mobileMoneyModal");
            let mobileMoneyModal = null;
            let setup = null;
            let otpSentSignature = null;

            const getModal = () => {
                if (!modalElement || !window.bootstrap?.Modal) {
                    return null;
                }

                mobileMoneyModal ??= new window.bootstrap.Modal(modalElement, {
                    backdrop: "static",
                    keyboard: false
                });
                return mobileMoneyModal;
            };

            const pick = (source, ...names) => {
                if (!source || typeof source !== "object") {
                    return undefined;
                }

                for (const name of names) {
                    if (Object.prototype.hasOwnProperty.call(source, name)) {
                        return source[name];
                    }
                }

                return undefined;
            };

            const readJson = async (response) => {
                const text = await response.text();
                if (!text) {
                    return {};
                }

                try {
                    return JSON.parse(text);
                } catch {
                    return { message: text };
                }
            };

            const readMessage = (data, fallback) =>
                pt(pick(data, "message", "Message") || fallback);

            const postForm = async (form, url = form.action, body = new FormData(form)) => {
                const response = await fetch(url, {
                    method: "POST",
                    body,
                    credentials: "same-origin",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                const data = await readJson(response);

                if (!response.ok) {
                    throw data;
                }

                return data;
            };

            const showPageFeedback = (message, kind = "success") => {
                const feedback = document.querySelector("[data-payment-feedback]");
                if (!feedback || !message) {
                    return;
                }

                feedback.textContent = message;
                feedback.className = `alert alert-${kind}`;
            };

            const restorePageFeedback = () => {
                const message = window.sessionStorage.getItem("renthub:payment-center-message");
                if (!message) {
                    return;
                }

                window.sessionStorage.removeItem("renthub:payment-center-message");
                showPageFeedback(message, "success");
            };

            const setButtonBusy = (button, busy, busyText) => {
                if (!button) {
                    return;
                }

                if (!button.dataset.defaultText) {
                    button.dataset.defaultText = button.textContent.trim();
                }

                button.disabled = busy;
                button.textContent = busy ? busyText : button.dataset.defaultText;
            };

            const setModalBusy = (form, busy, busyText = pt("Working...")) => {
                const submit = form.querySelector("[data-mobile-money-submit]");
                const confirm = form.querySelector("[data-mobile-money-confirm]");
                setButtonBusy(submit, busy, busyText);
                setButtonBusy(confirm, busy, pt("Confirming..."));
                form.querySelectorAll("input, select, button").forEach(input => {
                    input.disabled = busy;
                });
            };

            const showModalMessage = (form, message, kind) => {
                const messageBox = form.querySelector("[data-mobile-money-message]");
                if (!messageBox) {
                    return;
                }

                messageBox.textContent = message;
                messageBox.className = `alert py-2 alert-${kind}`;
            };

            const showOtpMessage = (section, message, kind) => {
                const messageBox = section?.querySelector("[data-otp-message]");
                if (!messageBox) {
                    return;
                }

                messageBox.textContent = message;
                messageBox.className = `d-block mt-2 text-${kind}`;
            };

            const asBool = (value) =>
                value === true || value === "true" || value === "True";

            const normalizePhone = (value) => {
                let digits = String(value || "").replace(/\D/g, "");
                if (digits.startsWith("00")) {
                    digits = digits.slice(2);
                }

                if (digits.startsWith("237") && digits.length === 12) {
                    digits = digits.slice(3);
                }

                return digits;
            };

            const cleanLocalCameroonPhone = (value) =>
                normalizePhone(value).slice(0, 9);

            const isValidLocalCameroonPhone = (value) =>
                /^6\d{8}$/.test(cleanLocalCameroonPhone(value));

            const targetLabel = (target) => {
                if (target === "payout") return pt("Rent payout number");
                if (target === "whatsapp") return pt("WhatsApp alerts number");
                return pt("Subscription payment number");
            };

            const getTargetSetup = (target) => {
                if (!setup) {
                    return {
                        number: "",
                        channel: "MtnMoney",
                        verified: false
                    };
                }

                if (target === "payout") {
                    return setup.payout;
                }

                if (target === "whatsapp") {
                    return setup.whatsapp;
                }

                return setup.subscription;
            };

            const getSelectedTarget = (form) =>
                form.querySelector("[data-mobile-target]")?.value || "subscription";

            const modalSignature = (form) => {
                const target = getSelectedTarget(form);
                const phone = cleanLocalCameroonPhone(form.querySelector("[data-mobile-phone]")?.value);
                const channel = target === "whatsapp"
                    ? ""
                    : form.querySelector("[data-mobile-channel]")?.value || "";

                return `${target}|${phone}|${channel}`;
            };

            const hasChangedPhone = (form) => {
                const current = getTargetSetup(getSelectedTarget(form)).number;
                const next = form.querySelector("[data-mobile-phone]")?.value;
                return isValidLocalCameroonPhone(next) &&
                    cleanLocalCameroonPhone(next) !== cleanLocalCameroonPhone(current);
            };

            const targetVerifiedFromResponse = (data, target) => {
                const status = pick(data, "status", "Status");
                if (!status) {
                    return false;
                }

                if (target === "payout") {
                    return asBool(pick(status, "isPayoutPhoneVerified", "IsPayoutPhoneVerified"));
                }

                if (target === "whatsapp") {
                    return asBool(pick(status, "isWhatsAppPhoneVerified", "IsWhatsAppPhoneVerified"));
                }

                return asBool(pick(status, "isSubscriptionPaymentPhoneVerified", "IsSubscriptionPaymentPhoneVerified"));
            };

            const updateConfirmButton = (form) => {
                const confirm = form.querySelector("[data-mobile-money-confirm]");
                const otp = form.querySelector("[data-mobile-otp]");
                if (!confirm || !otp) {
                    return;
                }

                const complete = otpSentSignature === modalSignature(form) &&
                    /^\d{6}$/.test(otp.value.trim());
                confirm.disabled = !complete;
            };

            const updateModalState = (form) => {
                const target = getSelectedTarget(form);
                const targetState = getTargetSetup(target);
                const operatorGroup = form.querySelector("[data-operator-group]");
                const channel = form.querySelector("[data-mobile-channel]");
                const sendButton = form.querySelector("[data-mobile-money-submit]");
                const confirmButton = form.querySelector("[data-mobile-money-confirm]");
                const otpPanel = form.querySelector("[data-modal-otp-panel]");
                const otpInput = form.querySelector("[data-mobile-otp]");
                const otpHint = form.querySelector("[data-mobile-otp-hint]");
                const phone = form.querySelector("[data-mobile-phone]");
                const phoneFormatMessage = form.querySelector("[data-phone-format-message]");
                const hiddenTarget = form.querySelector("[data-mobile-target-field]");
                const currentPhone = form.querySelector("[data-current-phone]");
                const currentMeta = form.querySelector("[data-current-phone-meta]");

                if (hiddenTarget) {
                    hiddenTarget.value = target;
                }

                if (currentPhone) {
                    currentPhone.textContent = targetState.number || pt("Not provided");
                }

                if (currentMeta) {
                    const meta = [];
                    if (target !== "whatsapp" && targetState.channel) {
                        meta.push(targetState.channel === "OrangeMoney" ? "Orange Money" : "MTN Money");
                    }
                    meta.push(targetState.verified ? pt("Verified") : pt("Pending verification"));
                    currentMeta.textContent = meta.join(" - ");
                }

                const usesOperator = target !== "whatsapp";
                operatorGroup?.classList.toggle("d-none", !usesOperator);
                if (channel) {
                    channel.required = usesOperator;
                    channel.disabled = !usesOperator;
                }

                const changed = hasChangedPhone(form);
                const hasPhoneValue = cleanLocalCameroonPhone(phone?.value).length > 0;
                const phoneIsValid = isValidLocalCameroonPhone(phone?.value);
                phoneFormatMessage?.classList.toggle("d-none", !hasPhoneValue || phoneIsValid);
                const currentSignature = modalSignature(form);
                if (otpSentSignature && otpSentSignature !== currentSignature) {
                    otpSentSignature = null;
                    const otp = form.querySelector("[data-mobile-otp]");
                    if (otp) {
                        otp.value = "";
                    }
                }

                const otpSent = otpSentSignature === currentSignature;
                sendButton?.classList.toggle("d-none", !changed || otpSent);
                confirmButton?.classList.toggle("d-none", !changed);
                otpPanel?.classList.toggle("d-none", !changed);

                if (otpInput) {
                    otpInput.disabled = !otpSent;
                }

                if (otpHint) {
                    otpHint.textContent = otpSent
                        ? pt("Enter the OTP sent to the new number to finish the update.")
                        : pt("Send OTP first, then enter the code here.");
                }

                if (sendButton) {
                    sendButton.disabled = !changed || !phoneIsValid || (usesOperator && !channel?.value);
                }

                updateConfirmButton(form);
            };

            const applyTargetToForm = (form) => {
                const target = getSelectedTarget(form);
                const targetState = getTargetSetup(target);
                const phone = form.querySelector("[data-mobile-phone]");
                const channel = form.querySelector("[data-mobile-channel]");
                const otp = form.querySelector("[data-mobile-otp]");

                if (phone) {
                    phone.value = cleanLocalCameroonPhone(targetState.number);
                    phone.defaultValue = phone.value;
                }

                if (channel) {
                    channel.value = target === "whatsapp" ? "" : targetState.channel || "MtnMoney";
                }

                if (otp) {
                    otp.value = "";
                }

                otpSentSignature = null;
                clearModalMessage(form);
                updateModalState(form);
            };

            const formatDuration = (seconds) => {
                const minutes = Math.floor(seconds / 60);
                const remainingSeconds = seconds % 60;
                return `${minutes}m ${remainingSeconds.toString().padStart(2, "0")}s`;
            };

            const applyCountdown = (button) => {
                window.clearTimeout(button._otpTimer);

                const section = button.closest("[data-otp-section]");
                const countdown = section?.querySelector("[data-otp-countdown]");
                const dailyLimit = section?.querySelector("[data-otp-daily-limit]");
                const dailyLimitReached = button.dataset.dailyLimitReached === "true";
                let retryAfter = Number.parseInt(button.dataset.retryAfter || "0", 10);

                if (!Number.isFinite(retryAfter) || retryAfter < 0) {
                    retryAfter = 0;
                }

                if (dailyLimitReached) {
                    button.disabled = true;
                    countdown?.classList.add("d-none");
                    dailyLimit?.classList.remove("d-none");
                    return;
                }

                dailyLimit?.classList.add("d-none");

                if (retryAfter <= 0) {
                    button.disabled = false;
                    countdown?.classList.add("d-none");
                    return;
                }

                button.disabled = true;
                if (countdown) {
                    countdown.textContent = pt("Resend available in {0}.", formatDuration(retryAfter));
                    countdown.classList.remove("d-none");
                }

                button.dataset.retryAfter = String(retryAfter - 1);
                button._otpTimer = window.setTimeout(() => applyCountdown(button), 1000);
            };

            const getLimitForTarget = (data, target) => {
                const status = pick(data, "status", "Status");
                if (!status) {
                    return null;
                }

                if (target === "subscription") {
                    return pick(status, "subscriptionPaymentOtpRequestLimit", "SubscriptionPaymentOtpRequestLimit");
                }

                if (target === "payout") {
                    return pick(status, "payoutOtpRequestLimit", "PayoutOtpRequestLimit");
                }

                if (target === "whatsapp") {
                    return pick(status, "whatsAppOtpRequestLimit", "WhatsAppOtpRequestLimit");
                }

                return null;
            };

            const updateResendButtonState = (button, data, fallbackRetryAfter) => {
                const target = button.dataset.target;
                const limit = getLimitForTarget(data, target);
                const retryAfter = Number(
                    pick(limit, "retryAfterSeconds", "RetryAfterSeconds") ??
                    pick(data, "retryAfterSeconds", "RetryAfterSeconds") ??
                    fallbackRetryAfter
                );
                const dailyLimitReached = Boolean(
                    pick(limit, "dailyLimitReached", "DailyLimitReached") ??
                    pick(data, "dailyLimitReached", "DailyLimitReached") ??
                    false
                );

                button.dataset.retryAfter = String(Number.isFinite(retryAfter) && retryAfter > 0 ? retryAfter : 0);
                button.dataset.dailyLimitReached = dailyLimitReached ? "true" : "false";
                applyCountdown(button);
            };

            const clearModalMessage = (form) => {
                const messageBox = form?.querySelector("[data-mobile-money-message]");
                if (!messageBox) {
                    return;
                }

                messageBox.textContent = "";
                messageBox.className = "alert d-none py-2";
            };

            const reloadMobileMoneyForm = async (form) => {
                if (!form?.dataset.setupUrl) {
                    applyTargetToForm(form);
                    return;
                }

                clearModalMessage(form);
                otpSentSignature = null;

                const separator = form.dataset.setupUrl.includes("?") ? "&" : "?";
                const response = await fetch(`${form.dataset.setupUrl}${separator}_=${Date.now()}`, {
                    credentials: "same-origin",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                const data = await readJson(response);

                if (!response.ok) {
                    form.reset();
                    applyTargetToForm(form);
                    throw data;
                }

                setup = {
                    primaryPhoneNumber: pick(data, "primaryPhoneNumber", "PrimaryPhoneNumber"),
                    subscription: {
                        number: pick(data, "subscriptionPaymentPhoneNumber", "SubscriptionPaymentPhoneNumber") || "",
                        channel: pick(data, "subscriptionPaymentChannel", "SubscriptionPaymentChannel") || "MtnMoney",
                        verified: asBool(pick(data, "isSubscriptionPaymentPhoneVerified", "IsSubscriptionPaymentPhoneVerified"))
                    },
                    payout: {
                        number: pick(data, "payoutPhoneNumber", "PayoutPhoneNumber") || "",
                        channel: pick(data, "payoutChannel", "PayoutChannel") || "MtnMoney",
                        verified: asBool(pick(data, "isPayoutPhoneVerified", "IsPayoutPhoneVerified"))
                    },
                    whatsapp: {
                        number: pick(data, "whatsAppPhoneNumber", "WhatsAppPhoneNumber") || "",
                        channel: "",
                        verified: asBool(pick(data, "isWhatsAppPhoneVerified", "IsWhatsAppPhoneVerified"))
                    }
                };

                const primaryPhone = modalElement.querySelector("[data-mobile-primary-phone]");
                if (primaryPhone) {
                    primaryPhone.textContent = setup.primaryPhoneNumber || "your verified phone";
                }

                applyTargetToForm(form);
            };

            const wireModal = () => {
                const modal = getModal();
                if (!modalElement || !modal) {
                    return;
                }

                document.querySelectorAll("[data-mobile-money-open]").forEach(button => {
                    button.addEventListener("click", async () => {
                        const form = modalElement.querySelector("[data-mobile-money-form]");
                        setButtonBusy(button, true, pt("Loading..."));

                        try {
                            await reloadMobileMoneyForm(form);
                            modal.show();
                        } catch (error) {
                            modal.show();
                            showModalMessage(
                                form,
                                readMessage(error, pt("Unable to reload the latest Mobile Money setup. Showing the last loaded values.")),
                                "danger");
                        } finally {
                            setButtonBusy(button, false);
                        }
                    });
                });

                modalElement.addEventListener("shown.bs.modal", () => {
                    document.querySelectorAll(".modal-backdrop").forEach(backdrop => {
                        backdrop.classList.add("rh-mobile-money-backdrop");
                    });
                });

                const form = modalElement.querySelector("[data-mobile-money-form]");
                const target = form?.querySelector("[data-mobile-target]");
                const phone = form?.querySelector("[data-mobile-phone]");
                const channel = form?.querySelector("[data-mobile-channel]");
                const otp = form?.querySelector("[data-mobile-otp]");

                target?.addEventListener("change", () => applyTargetToForm(form));
                phone?.addEventListener("input", () => {
                    const cleaned = cleanLocalCameroonPhone(phone.value);
                    if (phone.value !== cleaned) {
                        phone.value = cleaned;
                    }
                    clearModalMessage(form);
                    updateModalState(form);
                });
                channel?.addEventListener("change", () => {
                    clearModalMessage(form);
                    updateModalState(form);
                });
                otp?.addEventListener("input", () => {
                    otp.value = otp.value.replace(/\D/g, "").slice(0, 6);
                    updateConfirmButton(form);
                });

                modalElement.querySelector("[data-mobile-money-form]")?.addEventListener("submit", async (event) => {
                    event.preventDefault();
                    const form = event.currentTarget;
                    const target = getSelectedTarget(form);

                    if (!hasChangedPhone(form)) {
                        updateModalState(form);
                        return;
                    }

                    const body = new FormData(form);
                    setModalBusy(form, true, pt("Sending..."));

                    try {
                        const data = await postForm(form, form.action, body);
                        if (targetVerifiedFromResponse(data, target)) {
                            window.sessionStorage.setItem(
                                "renthub:payment-center-message",
                                `${targetLabel(target)} updated successfully.`);
                            modal.hide();
                            window.location.reload();
                            return;
                        }

                        otpSentSignature = modalSignature(form);
                        showModalMessage(
                            form,
                            readMessage(data, pt("OTP sent to the new number. Enter it below to confirm the update.")),
                            "success");
                    } catch (error) {
                        showModalMessage(
                            form,
                            readMessage(error, pt("Unable to send the OTP right now. Please try again.")),
                            "danger");

                        if (pick(error, "code", "Code") === "OTP_REQUEST_LIMITED") {
                            showModalMessage(form, readMessage(error, pt("You have reached today's OTP request limit. Please try again later.")), "danger");
                        }
                    } finally {
                        setModalBusy(form, false);
                        updateModalState(form);
                    }
                });

                modalElement.querySelector("[data-mobile-money-discard]")?.addEventListener("click", async () => {
                    const form = modalElement.querySelector("[data-mobile-money-form]");
                    const modal = getModal();

                    if (!otpSentSignature) {
                        otpSentSignature = null;
                        applyTargetToForm(form);
                        modal?.hide();
                        return;
                    }

                    const body = new FormData();
                    const token = form.querySelector("input[name='__RequestVerificationToken']")?.value;
                    if (token) {
                        body.append("__RequestVerificationToken", token);
                    }
                    body.append("target", getSelectedTarget(form));

                    setModalBusy(form, true, pt("Discarding..."));

                    try {
                        await postForm(form, form.dataset.cancelUrl, body);
                        otpSentSignature = null;
                        modal?.hide();
                        window.location.reload();
                    } catch (error) {
                        showModalMessage(
                            form,
                            readMessage(error, pt("Unable to discard this update right now. Please try again.")),
                            "danger");
                    } finally {
                        setModalBusy(form, false);
                        updateModalState(form);
                    }
                });

                modalElement.querySelector("[data-mobile-money-confirm]")?.addEventListener("click", async () => {
                    const form = modalElement.querySelector("[data-mobile-money-form]");
                    const target = getSelectedTarget(form);
                    const otp = form.querySelector("[data-mobile-otp]")?.value?.trim() || "";

                    if (!/^\d{6}$/.test(otp)) {
                        updateConfirmButton(form);
                        return;
                    }

                    const body = new FormData();
                    const token = form.querySelector("input[name='__RequestVerificationToken']")?.value;
                    if (token) {
                        body.append("__RequestVerificationToken", token);
                    }
                    body.append("target", target);
                    body.append("otp", otp);

                    setModalBusy(form, true, pt("Confirming..."));

                    try {
                        const data = await postForm(form, form.dataset.verifyUrl, body);
                        window.sessionStorage.setItem(
                            "renthub:payment-center-message",
                            readMessage(data, `${targetLabel(target)} verified successfully.`));
                        modal.hide();
                        window.location.reload();
                    } catch (error) {
                        showModalMessage(
                            form,
                            readMessage(error, pt("Unable to verify this OTP. Please try again.")),
                            "danger");
                    } finally {
                        setModalBusy(form, false);
                        updateModalState(form);
                    }
                });
            };

            const wireOtpForms = () => {
                document.querySelectorAll("[data-otp-resend]").forEach(applyCountdown);

                document.querySelectorAll("[data-mobile-otp-form]").forEach(form => {
                    form.addEventListener("submit", async (event) => {
                        event.preventDefault();
                        const section = form.closest("[data-otp-section]");
                        const button = form.querySelector("[data-otp-verify]");

                        setButtonBusy(button, true, pt("Verifying..."));

                        try {
                            const data = await postForm(form);
                            showOtpMessage(section, readMessage(data, pt("Number verified successfully.")), "success");
                            window.setTimeout(() => window.location.reload(), 700);
                        } catch (error) {
                            showOtpMessage(section, readMessage(error, pt("Unable to verify this OTP. Please try again.")), "danger");
                            setButtonBusy(button, false, pt("Verify"));
                        }
                    });
                });

                document.querySelectorAll("[data-mobile-resend-form]").forEach(form => {
                    form.addEventListener("submit", async (event) => {
                        event.preventDefault();
                        const section = form.closest("[data-otp-section]");
                        const button = form.querySelector("[data-otp-resend]");

                        setButtonBusy(button, true, pt("Sending..."));

                        try {
                            const data = await postForm(form);
                            showOtpMessage(section, readMessage(data, pt("OTP sent. You can request another code after the cooldown.")), "info");
                            updateResendButtonState(button, data, 60);
                        } catch (error) {
                            showOtpMessage(section, readMessage(error, pt("Unable to resend the OTP right now. Please try again.")), "danger");
                            updateResendButtonState(button, error, Number(button.dataset.retryAfter || 0));
                        }
                    });
                });
            };

            const start = () => {
                restorePageFeedback();
                wireModal();
                wireOtpForms();
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", start, { once: true });
            } else {
                start();
            }
        })();
    </script>
}
