@model RentHub.Portal.ViewModels.Profile.ProfileIndexVm
@using Common.Enums
@{
    ViewData["Title"] = "Profile";

    var overview = Model.Overview;
    var composedName = $"{overview.FirstName} {overview.LastName}".Trim();
    var displayName = !string.IsNullOrWhiteSpace(overview.FullName)
        ? overview.FullName
        : composedName;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = overview.Email;
    }

    var now = Model.NowUtc;
    var hasCurrentPlan = overview.HasActiveSubscription && overview.SubscriptionEndDate.HasValue && overview.SubscriptionEndDate.Value > now;
    var currentPlanEndsInDays = hasCurrentPlan
        ? Math.Max(0, (int)Math.Ceiling((overview.SubscriptionEndDate!.Value - now).TotalDays))
        : 0;
    var isLandlord = overview.Roles.Any(role => string.Equals(role, "Landlord", StringComparison.OrdinalIgnoreCase));
    var isAdmin = overview.Roles.Any(role => string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase));
    var smsVerificationUnavailable = !overview.SmsVerificationEnabled;
    var kycAction = Url.Action("LandlordKyc", "Auth", new { email = overview.Email });
    var contractAction = Url.Action("LandlordContract", "Auth", new { email = overview.Email });
    var payoutSetupAction = Url.Action("PayoutSetup", "Profile");
    var payoutSetupInProgress = overview.StripePayoutSetupStarted || overview.HasStripePayoutAccount;
    var payoutSetupButtonText = payoutSetupInProgress ? "Continue Stripe setup" : "Set up payout account";
    var payoutSetupStatusText = overview.StripePayoutSetupComplete
        ? "Connected"
        : !overview.StripeConnectPlatformEnabled
            ? "Temporarily skipped"
        : payoutSetupInProgress
            ? "Needs Stripe details"
            : "Not started";
    var contractSignedAtText = overview.PlatformTermsAcceptedAt?.LocalDateTime.ToString("yyyy-MM-dd");
}

<section class="rh-page-header rh-page-header-elevated">
    <div>
        <p class="rh-kicker">Profile Center</p>
        <h1 class="rh-heading-title">@displayName</h1>
        <p class="rh-heading-subtitle">Review your account identity, verified contact channels, accessible properties, and subscription lifecycle in one place.</p>
        <div class="rh-badge-row mt-2">
            @if (overview.Roles.Any())
            {
                @foreach (var role in overview.Roles)
                {
                    <span class="rh-chip rh-chip-info">@role</span>
                }
            }
            else
            {
                <span class="rh-chip rh-chip-warning">No role assigned</span>
            }
        </div>
    </div>
    <div class="rh-toolbar">
        @if (isLandlord)
        {
            <a class="btn rh-btn-primary" asp-controller="Profile" asp-action="Payments">Payment Center</a>
        }
        @if (isAdmin)
        {
            <a class="btn rh-btn-subtle" asp-controller="AdminSubscriptions" asp-action="PaymentAccounts">Payment Accounts</a>
        }
    </div>
</section>

<section class="alert alert-info rh-test-mode-banner" role="status">
    <strong>Testing mode:</strong> Phone-number and WhatsApp SMS verification are temporarily skipped while Twilio approval is pending. You can continue testing the profile, payments, and property workflows without completing phone verification.
</section>

<section class="rh-profile-metrics mb-3">
    <article class="rh-summary-card">
        <p>Accessible Properties</p>
        <h3>@overview.PropertyCount</h3>
        <small>Total properties you can access</small>
    </article>
    <article class="rh-summary-card">
        <p>Visible Units</p>
        <h3>@overview.ApartmentCount</h3>
        <small>Total apartments across your properties</small>
    </article>
    <article class="rh-summary-card">
        <p>Current Subscription</p>
        <h3>@(hasCurrentPlan ? overview.CurrentPlanName : "None")</h3>
        @if (hasCurrentPlan)
        {
            <small>Ends on @overview.SubscriptionEndDate!.Value.LocalDateTime.ToString("yyyy-MM-dd")</small>
        }
        else
        {
            <small>No active subscription detected</small>
        }
    </article>
    <article class="rh-summary-card">
        <p>Approval Status</p>
        <h3>@(overview.SubscriptionApproved ? "Approved" : "Pending")</h3>
        @if (hasCurrentPlan)
        {
            <small>@currentPlanEndsInDays day(s) remaining</small>
        }
        else
        {
            <small>Activate a plan to unlock property limits</small>
        }
    </article>
</section>

@if (isLandlord)
{
    <section class="rh-panel rh-panel-elevated mb-3">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <p class="rh-kicker mb-1">Landlord readiness</p>
                <h2 class="rh-section-title mb-1">Verification checklist</h2>
                <p class="rh-card-meta mb-0">Complete these items before subscription payments and property creation are unlocked.</p>
            </div>
            @if (!overview.CanStartSubscriptionCheckout && !string.IsNullOrWhiteSpace(overview.SubscriptionBlockedReason))
            {
                <span class="rh-chip rh-chip-warning">@overview.SubscriptionBlockedReason</span>
            }
            else
            {
                <span class="rh-chip rh-chip-success">Ready for subscription</span>
            }
        </div>

        <div class="rh-readiness-grid mt-3">
            <article class="rh-readiness-item @(overview.IsKycSubmitted ? "is-complete" : "is-current")">
                <div class="rh-readiness-marker"></div>
                <div>
                    <h3>Identity files submitted</h3>
                    <p>Three face photos and government ID document files.</p>
                    <small>Status: @overview.KycStatus</small>
                    @if (!overview.IsKycSubmitted || overview.KycStatus == LandlordKycStatusEnum.Rejected)
                    {
                        <a class="btn btn-sm rh-btn-primary mt-2" href="@kycAction">Submit KYC</a>
                    }
                </div>
            </article>

            <article class="rh-readiness-item @(overview.IsKycApproved ? "is-complete" : (overview.IsKycSubmitted ? "is-current" : string.Empty))">
                <div class="rh-readiness-marker"></div>
                <div>
                    <h3>Admin identity approval</h3>
                    <p>Only the system admin can approve submitted KYC files.</p>
                    <small>Manual review status: @overview.KycStatus</small>
                    @if (!string.IsNullOrWhiteSpace(overview.KycReviewNote))
                    {
                        <small class="d-block">Review note: @overview.KycReviewNote</small>
                    }
                </div>
            </article>

            <article class="rh-readiness-item @(overview.PlatformTermsAccepted ? "is-complete" : (overview.IsKycSubmitted ? "is-current" : string.Empty))">
                <div class="rh-readiness-marker"></div>
                <div>
                    <h3>Platform contract signed</h3>
                    <p>Accept the landlord terms with your full legal name.</p>
                    @if (overview.PlatformTermsAccepted)
                    {
                        <small>Signed by @overview.PlatformTermsSignatureName on @contractSignedAtText</small>
                    }
                    else if (overview.IsKycSubmitted)
                    {
                        <a class="btn btn-sm rh-btn-primary mt-2" href="@contractAction">Sign contract</a>
                    }
                </div>
            </article>

            <article class="rh-readiness-item @(overview.StripePayoutSetupComplete ? "is-complete" : (overview.PlatformTermsAccepted ? "is-current" : string.Empty))">
                <div class="rh-readiness-marker"></div>
                <div>
                    <h3>Payout account setup</h3>
                    <p>@(overview.StripeConnectPlatformEnabled ? "Connect Stripe after KYC approval so tenant card rent payments can be routed to you." : "Stripe Connect setup is paused while platform activation is pending. Continue testing the other workflows.")</p>
                    <small>Status: @payoutSetupStatusText</small>
                    @if (!overview.StripePayoutSetupComplete && overview.StripeConnectPlatformEnabled)
                    {
                        @if (overview.IsKycApproved)
                        {
                            <a class="btn btn-sm rh-btn-primary mt-2" href="@payoutSetupAction">@payoutSetupButtonText</a>
                        }
                        else
                        {
                            <small class="d-block mt-2">Available after admin KYC approval.</small>
                        }
                    }
                </div>
            </article>
        </div>
    </section>
}

<section class="rh-profile-grid">
    <article class="rh-panel rh-panel-elevated">
        <h2 class="rh-section-title mb-3">Account Information</h2>

        <div class="rh-profile-info-grid">
            <div class="rh-profile-info-item">
                <p>Email</p>
                <h3>@overview.Email</h3>
            </div>
            <div class="rh-profile-info-item">
                <p>Phone</p>
                <h3>@(!string.IsNullOrWhiteSpace(overview.PhoneNumber) ? overview.PhoneNumber : "Not provided")</h3>
            </div>
            <div class="rh-profile-info-item">
                <p>WhatsApp Number</p>
                <h3>@(!string.IsNullOrWhiteSpace(overview.WhatsAppPhoneNumber) ? overview.WhatsAppPhoneNumber : "Not provided")</h3>
            </div>
            <div class="rh-profile-info-item">
                <p>WhatsApp Verification</p>
                <h3>@(smsVerificationUnavailable ? "Temporarily skipped" : overview.IsWhatsAppPhoneVerified ? "Verified" : "Pending")</h3>
            </div>
        </div>
    </article>

    @if (isLandlord || isAdmin)
    {
        <article class="rh-panel rh-panel-elevated">
            <h2 class="rh-section-title mb-3">Payments and Subscriptions</h2>
            <p class="text-muted">Payment numbers, payout routing, subscription status, and plan actions now live in their own workspace.</p>
            <div class="d-flex flex-wrap gap-2">
                @if (isLandlord)
                {
                    <a class="btn rh-btn-primary" asp-controller="Profile" asp-action="Payments">Open Payment Center</a>
                    @if (!overview.StripePayoutSetupComplete && overview.IsKycApproved && overview.StripeConnectPlatformEnabled)
                    {
                        <a class="btn rh-btn-subtle" asp-controller="Profile" asp-action="PayoutSetup">@payoutSetupButtonText</a>
                    }
                }
                @if (isAdmin)
                {
                    <a class="btn rh-btn-subtle" asp-controller="AdminSubscriptions" asp-action="PaymentAccounts">Manage Payment Accounts</a>
                }
            </div>
        </article>
    }

    <article class="rh-panel rh-panel-elevated">
        <h2 class="rh-section-title mb-3">Properties You Can Access</h2>

        @if (!overview.Properties.Any())
        {
            <div class="rh-empty">No properties available yet.</div>
        }
        else
        {
            <div class="rh-profile-property-list">
                @foreach (var property in overview.Properties)
                {
                    <a class="rh-profile-property-item" asp-controller="Properties" asp-action="Overview" asp-route-id="@property.Id">
                        <div>
                            <h3>@property.Name</h3>
                            <p>@property.City - @property.Address</p>
                        </div>
                        <div class="text-end">
                            <span class="rh-chip rh-chip-primary">@property.AccessSource</span>
                            <small>@property.ApartmentCount apartments</small>
                        </div>
                    </a>
                }
            </div>
        }
    </article>
</section>
