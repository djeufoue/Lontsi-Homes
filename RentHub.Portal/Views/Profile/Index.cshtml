@model RentHub.Portal.ViewModels.Profile.ProfileIndexVm
@using Common.Enums
@{
    ViewData["Title"] = T["Profile"].Value;

    var overview = Model.Overview;
    var composedName = $"{overview.FirstName} {overview.LastName}".Trim();
    var displayName = !string.IsNullOrWhiteSpace(overview.FullName)
        ? overview.FullName
        : composedName;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = overview.Email;
    }

    var now = Model.NowUtc;
    var hasCurrentPlan = overview.HasActiveSubscription && overview.SubscriptionEndDate.HasValue && overview.SubscriptionEndDate.Value > now;
    var currentPlanEndsInDays = hasCurrentPlan
        ? Math.Max(0, (int)Math.Ceiling((overview.SubscriptionEndDate!.Value - now).TotalDays))
        : 0;
    var isLandlord = overview.Roles.Any(role => string.Equals(role, "Landlord", StringComparison.OrdinalIgnoreCase));
    var isAdmin = overview.Roles.Any(role => string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase));
    var isOwnProfile = Model.IsOwnProfile;
    var smsVerificationUnavailable = !overview.SmsVerificationEnabled;
    var kycAction = Url.Action("LandlordKyc", "Auth", new { email = overview.Email });
    var contractAction = Url.Action("LandlordContract", "Auth", new { email = overview.Email });
    var payoutSetupAction = Url.Action("PayoutSetup", "Profile");
    var payoutSetupInProgress = overview.StripePayoutSetupStarted || overview.HasStripePayoutAccount;
    var payoutSetupButtonText = payoutSetupInProgress ? T["Continue Stripe setup"].Value : T["Set up payout account"].Value;
    var payoutSetupStatusText = overview.StripePayoutSetupComplete
        ? T["Connected"].Value
        : !overview.StripeConnectPlatformEnabled
            ? T["Temporarily skipped"].Value
        : payoutSetupInProgress
            ? T["Needs Stripe details"].Value
            : T["Not started"].Value;
}

<section class="rh-page-header rh-page-header-elevated">
    <div>
        <p class="rh-kicker">@T["Profile Center"]</p>
        <h1 class="rh-heading-title">@displayName</h1>
        <p class="rh-heading-subtitle">@T["Review your account identity, verified contact channels, accessible properties, and subscription lifecycle in one place."]</p>
        <div class="rh-badge-row mt-2">
            @if (overview.Roles.Any())
            {
                @foreach (var role in overview.Roles)
                {
                    <span class="rh-chip rh-chip-info">@T[role]</span>
                }
            }
            else
            {
                <span class="rh-chip rh-chip-warning">@T["No role assigned"]</span>
            }
        </div>
    </div>
    <div class="rh-toolbar">
        @if (isOwnProfile && isLandlord && !overview.IsSubscriptionExempt)
        {
            <a class="btn rh-btn-primary" asp-controller="Profile" asp-action="Payments">@T["Payment Center"]</a>
        }
        @if (isOwnProfile && isAdmin)
        {
            <a class="btn rh-btn-subtle" asp-controller="AdminSubscriptions" asp-action="PaymentAccounts">@T["Payment Accounts"]</a>
        }
    </div>
</section>

<section class="rh-profile-metrics mb-3">
    <article class="rh-summary-card">
        <p>@T["Accessible Properties"]</p>
        <h3>@overview.PropertyCount</h3>
        <small>@T["Total properties you can access"]</small>
    </article>
    <article class="rh-summary-card">
        <p>@T["Visible Units"]</p>
        <h3>@overview.ApartmentCount</h3>
        <small>@T["Total apartments across your properties"]</small>
    </article>
    <article class="rh-summary-card">
        <p>@T["Current Subscription"]</p>
        <h3>@(hasCurrentPlan ? overview.CurrentPlanName : T["None"].Value)</h3>
        @if (hasCurrentPlan)
        {
            <small>@T["Ends on {0:D}", overview.SubscriptionEndDate!.Value.LocalDateTime]</small>
        }
        else
        {
            <small>@T["No active subscription detected"]</small>
        }
    </article>
    <article class="rh-summary-card">
        <p>@T["Approval Status"]</p>
        <h3>@(overview.SubscriptionApproved ? T["Approved"].Value : T["Pending"].Value)</h3>
        @if (hasCurrentPlan)
        {
            <small>@(currentPlanEndsInDays == 1 ? T["1 day remaining"].Value : T["{0} days remaining", currentPlanEndsInDays].Value)</small>
        }
        else
        {
            <small>@T["Activate a plan to unlock property limits"]</small>
        }
    </article>
</section>

@if (isLandlord)
{
    <section class="rh-panel rh-panel-elevated mb-3">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <p class="rh-kicker mb-1">@T["Landlord readiness"]</p>
                <h2 class="rh-section-title mb-1">@T["Verification checklist"]</h2>
                <p class="rh-card-meta mb-0">@T["Complete these items before subscription payments and property creation are unlocked."]</p>
            </div>
            @if (!overview.CanStartSubscriptionCheckout && !string.IsNullOrWhiteSpace(overview.SubscriptionBlockedReason))
            {
                <span class="rh-chip rh-chip-warning">@overview.SubscriptionBlockedReason</span>
            }
            else
            {
                <span class="rh-chip rh-chip-success">@T["Ready for subscription"]</span>
            }
        </div>

        <div class="rh-readiness-grid mt-3">
            <article class="rh-readiness-item @(overview.IsKycSubmitted ? "is-complete" : "is-current")">
                <div class="rh-readiness-marker"></div>
                <div>
                    <h3>@T["Identity files submitted"]</h3>
                    <p>@T["Three face photos and government ID document files."]</p>
                    <small>@T["Status: {0}", T[overview.KycStatus.ToString()]]</small>
                    @if (isOwnProfile && (!overview.IsKycSubmitted || overview.KycStatus == LandlordKycStatusEnum.Rejected))
                    {
                        <a class="btn btn-sm rh-btn-primary mt-2" href="@kycAction">@T["Submit KYC"]</a>
                    }
                </div>
            </article>

            <article class="rh-readiness-item @(overview.IsKycApproved ? "is-complete" : (overview.IsKycSubmitted ? "is-current" : string.Empty))">
                <div class="rh-readiness-marker"></div>
                <div>
                    <h3>@T["Admin identity approval"]</h3>
                    <p>@T["Only the system admin can approve submitted KYC files."]</p>
                    <small>@T["Manual review status: {0}", T[overview.KycStatus.ToString()]]</small>
                    @if (!string.IsNullOrWhiteSpace(overview.KycReviewNote))
                    {
                        <small class="d-block">@T["Review note: {0}", overview.KycReviewNote]</small>
                    }
                </div>
            </article>

            <article class="rh-readiness-item @(overview.PlatformTermsAccepted ? "is-complete" : (overview.IsKycSubmitted ? "is-current" : string.Empty))">
                <div class="rh-readiness-marker"></div>
                <div>
                    <h3>@T["Platform contract signed"]</h3>
                    <p>@T["Accept the landlord terms with your full legal name."]</p>
                    @if (overview.PlatformTermsAccepted)
                    {
                        <small>@T["Signed by {0} on {1:D}", overview.PlatformTermsSignatureName ?? T["Not available"].Value, overview.PlatformTermsAcceptedAt!.Value.LocalDateTime]</small>
                    }
                    else if (isOwnProfile && overview.IsKycSubmitted)
                    {
                        <a class="btn btn-sm rh-btn-primary mt-2" href="@contractAction">@T["Sign contract"]</a>
                    }
                </div>
            </article>

            <article class="rh-readiness-item @(overview.StripePayoutSetupComplete ? "is-complete" : (overview.PlatformTermsAccepted ? "is-current" : string.Empty))">
                <div class="rh-readiness-marker"></div>
                <div>
                    <h3>@T["Payout account setup"]</h3>
                    <p>@(overview.StripeConnectPlatformEnabled ? T["Connect Stripe after KYC approval so tenant card rent payments can be routed to you."].Value : T["Stripe Connect setup is paused while platform activation is pending. Continue testing the other workflows."].Value)</p>
                    <small>@T["Status: {0}", payoutSetupStatusText]</small>
                    @if (isOwnProfile && !overview.StripePayoutSetupComplete && overview.StripeConnectPlatformEnabled)
                    {
                        @if (overview.IsKycApproved)
                        {
                            <a class="btn btn-sm rh-btn-primary mt-2" href="@payoutSetupAction">@payoutSetupButtonText</a>
                        }
                        else
                        {
                            <small class="d-block mt-2">@T["Available after admin KYC approval."]</small>
                        }
                    }
                </div>
            </article>
        </div>
    </section>
}

<section class="rh-profile-grid">
    <article class="rh-panel rh-panel-elevated">
        <h2 class="rh-section-title mb-3">@T["Account Information"]</h2>

        <div class="rh-profile-info-grid">
            <div class="rh-profile-info-item">
                <p>@T["Email"]</p>
                <h3>@overview.Email</h3>
            </div>
            <div class="rh-profile-info-item">
                <p>@T["Phone"]</p>
                <h3>@(!string.IsNullOrWhiteSpace(overview.PhoneNumber) ? overview.PhoneNumber : T["Not provided"].Value)</h3>
            </div>
            <div class="rh-profile-info-item">
                <p>@T["WhatsApp Number"]</p>
                <h3>@(!string.IsNullOrWhiteSpace(overview.WhatsAppPhoneNumber) ? overview.WhatsAppPhoneNumber : T["Not provided"].Value)</h3>
            </div>
            <div class="rh-profile-info-item">
                <p>@T["WhatsApp Verification"]</p>
                <h3>@(smsVerificationUnavailable ? T["Temporarily skipped"].Value : overview.IsWhatsAppPhoneVerified ? T["Verified"].Value : T["Pending"].Value)</h3>
            </div>
        </div>
    </article>

    <article class="rh-panel rh-panel-elevated">
        @if (isOwnProfile)
        {
            <h2 class="rh-section-title mb-2">@T["Language"]</h2>
            <p class="text-muted">@T["Choose the language used throughout Lontsi Homes."]</p>
            <form asp-controller="Profile" asp-action="UpdateLanguage" method="post" class="rh-profile-language-form">
                @Html.AntiForgeryToken()
                <label class="form-label" for="profileLanguage">@T["Language"]</label>
                <div class="rh-profile-language-controls">
                    <select class="form-select" id="profileLanguage" name="Language" aria-describedby="profileLanguageHelp">
                        <option value="@((int)PlatformLanguage.English)" selected="@(overview.Language == PlatformLanguage.English ? "selected" : null)">English</option>
                        <option value="@((int)PlatformLanguage.French)" selected="@(overview.Language == PlatformLanguage.French ? "selected" : null)">Français</option>
                    </select>
                    <button class="btn rh-btn-primary" type="submit">@T["Save language"]</button>
                </div>
                <small class="text-muted" id="profileLanguageHelp">@T["Your selection is saved to your account and restored whenever you sign in."]</small>
            </form>

            <hr class="my-4" />
            <h3 class="rh-section-title mb-2">@T["Email language"]</h3>
        }
        else
        {
            <h2 class="rh-section-title mb-2">@T["Email language"]</h2>
        }
        <p class="text-muted">@T["Choose the language used for every email sent to you, including reminders, receipts, invitations, renewals, and account notifications."]</p>
        <form asp-controller="Profile" asp-action="UpdateEmailLanguage" method="post" class="rh-profile-language-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" value="@(!isOwnProfile ? overview.UserId : null)" />
            <input type="hidden" name="TenancyId" value="@Model.AccessTenancyId" />
            <label class="form-label" for="profileEmailLanguage">@T["Email language"]</label>
            <div class="rh-profile-language-controls">
                <select class="form-select" id="profileEmailLanguage" name="EmailLanguage" aria-describedby="profileEmailLanguageHelp">
                    <option value="@((int)PlatformLanguage.English)" selected="@(overview.EmailLanguage == PlatformLanguage.English ? "selected" : null)">English</option>
                    <option value="@((int)PlatformLanguage.French)" selected="@(overview.EmailLanguage == PlatformLanguage.French ? "selected" : null)">Français</option>
                </select>
                <button class="btn rh-btn-primary" type="submit">@T["Save email language"]</button>
            </div>
            <small class="text-muted" id="profileEmailLanguageHelp">@T["This preference is independent from the language of the application interface."]</small>
        </form>

        @if (isOwnProfile)
        {
            <hr class="my-4" />
            <h3 class="rh-section-title mb-2">@T["Message email notifications"]</h3>
            <p class="text-muted">@T["Choose whether a follow-up email is sent when a new message is waiting for you in Lontsi Homes."]</p>
            <form asp-controller="Profile" asp-action="UpdateConversationEmailNotifications" method="post" class="rh-profile-language-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Enabled" value="false" />
                <div class="form-check form-switch">
                    <input class="form-check-input"
                           type="checkbox"
                           role="switch"
                           id="conversationEmailNotificationsEnabled"
                           name="Enabled"
                           value="true"
                           checked="@(overview.ConversationEmailNotificationsEnabled ? "checked" : null)" />
                    <label class="form-check-label" for="conversationEmailNotificationsEnabled">@T["Receive an email for new messages"]</label>
                </div>
                <small class="text-muted d-block mt-2 mb-3">@T["Disabling this option does not block messages in the platform. It only stops the additional email notification."]</small>
                <button class="btn rh-btn-primary" type="submit">@T["Save notification preference"]</button>
            </form>
        }
    </article>

    @if (isOwnProfile && ((isLandlord && !overview.IsSubscriptionExempt) || isAdmin))
    {
        <article class="rh-panel rh-panel-elevated">
            <h2 class="rh-section-title mb-3">@T["Payments and Subscriptions"]</h2>
            <p class="text-muted">@T["Payment numbers, payout routing, subscription status, and plan actions now live in their own workspace."]</p>
            <div class="d-flex flex-wrap gap-2">
                @if (isLandlord && !overview.IsSubscriptionExempt)
                {
                    <a class="btn rh-btn-primary" asp-controller="Profile" asp-action="Payments">@T["Open Payment Center"]</a>
                    @if (!overview.StripePayoutSetupComplete && overview.IsKycApproved && overview.StripeConnectPlatformEnabled)
                    {
                        <a class="btn rh-btn-subtle" asp-controller="Profile" asp-action="PayoutSetup">@payoutSetupButtonText</a>
                    }
                }
                @if (isAdmin)
                {
                    <a class="btn rh-btn-subtle" asp-controller="AdminSubscriptions" asp-action="PaymentAccounts">@T["Manage Payment Accounts"]</a>
                }
            </div>
        </article>
    }

    <article class="rh-panel rh-panel-elevated">
        <h2 class="rh-section-title mb-3">@T["Properties You Can Access"]</h2>

        @if (!overview.Properties.Any())
        {
            <div class="rh-empty">@T["No properties available yet."]</div>
        }
        else
        {
            <div class="rh-profile-property-list">
                @foreach (var property in overview.Properties)
                {
                    <a class="rh-profile-property-item" asp-controller="Properties" asp-action="Overview" asp-route-id="@property.Id">
                        <div>
                            <h3>@property.Name</h3>
                            <p>@property.City - @property.Address</p>
                        </div>
                        <div class="text-end">
                            <span class="rh-chip rh-chip-primary">@T[property.AccessSource]</span>
                            <small>@T["{0} apartments", property.ApartmentCount]</small>
                        </div>
                    </a>
                }
            </div>
        }
    </article>
</section>
