@model RentHub.Portal.ViewModels.Tenant.TenantTenancyVm
@using Common.Enums
@using Common.Helpers
@{
    ViewData["Title"] = T["My tenancy"].Value;
    var item = Model.Item;
    var tenancy = item.Tenancy;
    var allPeriods = item.RentPeriods.OrderBy(period => period.PeriodStart).ToList();
    var pendingPaymentPeriod = allPeriods
        .Where(period => period.Status == RentPeriodStatusEnum.PendingPayment && !string.IsNullOrWhiteSpace(period.PaymentReference))
        .OrderBy(period => period.PeriodStart)
        .FirstOrDefault();
    var openPayablePeriods = pendingPaymentPeriod == null
        ? allPeriods
            .Where(period => !RentPeriodScheduleHelper.IsPaidStatus(period.Status) && period.Status != RentPeriodStatusEnum.PendingPayment)
            .OrderBy(period => period.PeriodStart)
            .ToList()
        : new List<Common.CommunicationModels.RentPeriodDto>();
    var firstPayableGroupSequence = openPayablePeriods.FirstOrDefault()?.BillingGroupSequence;
    var payablePeriods = firstPayableGroupSequence.HasValue
        ? openPayablePeriods
            .Where(period => period.BillingGroupSequence == firstPayableGroupSequence.Value)
            .ToList()
        : new List<Common.CommunicationModels.RentPeriodDto>();
    var payableGroupTotal = payablePeriods.Sum(period => Math.Max(0, period.Amount - period.PaidAmount));
    var contract = item.Documents
        .Where(document => document.DocumentType == DocumentTypeEnum.TenancyContract)
        .OrderByDescending(document => document.UploadedAt)
        .FirstOrDefault();
    var paidPeriods = allPeriods.Count(period => RentPeriodScheduleHelper.IsPaidStatus(period.Status));

    string DateLabel(DateTimeOffset value) => value.LocalDateTime.ToString("d");
    string OptionalDateLabel(DateTimeOffset? value) => value.HasValue ? DateLabel(value.Value) : T["Not scheduled"].Value;
    string StatusClass(RentPeriodStatusEnum status) => status switch
    {
        RentPeriodStatusEnum.Paid or RentPeriodStatusEnum.PaidInAdvance => "rh-chip-primary",
        RentPeriodStatusEnum.PaidBeforeRentHub => "rh-chip-info",
        RentPeriodStatusEnum.Due or RentPeriodStatusEnum.Overdue => "rh-chip-warning",
        RentPeriodStatusEnum.PendingPayment => "rh-chip-info",
        RentPeriodStatusEnum.Waived or RentPeriodStatusEnum.Cancelled => "rh-chip-info",
        _ => "rh-chip-info"
    };
    string PaymentMethodLabel(PaymentMethodEnum method) => method switch
    {
        PaymentMethodEnum.Momo => "MTN Mobile Money",
        PaymentMethodEnum.OrangeMoney => "Orange Money",
        PaymentMethodEnum.Card => T["card"].Value,
        _ => T[method.ToString()].Value
    };
}

<section class="rh-overview-shell rh-tenancy-shell">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-action="Index">&#8592; @T["Back to rent dashboard"]</a>
            <p class="rh-kicker">@T["Tenant tenancy workspace"]</p>
            <h1 class="rh-heading-title">@tenancy.PropertyName - @tenancy.ApartmentName</h1>
            <p class="rh-heading-subtitle">
                @T["Start date"]: @DateLabel(tenancy.StartDate)
                <span aria-hidden="true"> · </span>
                @T["End date"]: @(tenancy.EndDate.HasValue ? DateLabel(tenancy.EndDate.Value) : T["Open term"].Value)
            </p>
            <div class="rh-overview-badges">
                <span class="rh-chip rh-chip-info">@T[tenancy.Status]</span>
                <span class="rh-chip rh-chip-primary">@T["{0:N0} XAF rent", tenancy.MonthlyRent]</span>
                <span class="rh-chip @(item.OutstandingBalance > 0 ? "rh-chip-warning" : "rh-chip-primary")">@T["Outstanding"]: @item.OutstandingBalance.ToString("N0") XAF</span>
            </div>
        </div>
        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-primary" asp-controller="Tenancies" asp-action="Overview" asp-route-id="@tenancy.Id">@T["Full tenancy workspace"]</a>
            @if (tenancy.EndDate.HasValue && !tenancy.TerminatedAt.HasValue)
            {
                <a class="btn rh-btn-subtle" asp-controller="Tenancies" asp-action="Renewal" asp-route-tenancyId="@tenancy.Id">@T["Renewal"]</a>
            }
        </div>
    </section>

    <section class="rh-apartment-commanddeck rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head">
            <div>
                <h2 class="rh-dashboard-panel-title">@T["Tenancy at a glance"]</h2>
                <p class="rh-dashboard-panel-copy">@T["The key rent and contact information for this apartment."]</p>
            </div>
            <div class="rh-dashboard-range-chip">@T["Tenancy"]</div>
        </div>
        <div class="rh-apartment-commanddeck-grid rh-rent-summary-grid">
            <div class="rh-overview-bigstat alt">
                <span>@T["Outstanding balance"]</span>
                <strong>@item.OutstandingBalance.ToString("N0") XAF</strong>
                <small>@T["Across unpaid rent periods"]</small>
            </div>
            <div class="rh-overview-bigstat">
                <span>@T["Next due date"]</span>
                <strong>@OptionalDateLabel(item.NextDueDate)</strong>
                <small>@T["Oldest unpaid period"]</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Rent progress"]</span>
                <strong>@paidPeriods / @allPeriods.Count</strong>
                <small>@T["Paid rent periods"]</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Landlord"]</span>
                <strong>@item.LandlordName</strong>
                @if (!string.IsNullOrWhiteSpace(item.LandlordEmail))
                {
                    <small><a class="rh-payment-contact-link" href="mailto:@item.LandlordEmail">@item.LandlordEmail</a></small>
                }
            </div>
        </div>
    </section>

    <section class="rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head align-start">
            <div>
                <h2 class="rh-dashboard-panel-title">@T["Rent payment"]</h2>
                <p class="rh-dashboard-panel-copy">@T["Pay the oldest outstanding period first or contact your landlord when online payment is unavailable."]</p>
            </div>
        </div>

        @if (payablePeriods.Count > 0 && item.CanPayRent)
        {
            <form asp-action="PayRent" method="post" class="rh-inline-settings-note rh-rent-payment-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                <input type="hidden" name="paymentMethod" value="@item.PaymentMethod" />
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label">@T["Oldest outstanding payment group"]</label>
                        <div class="rh-inline-settings-note">
                            <strong>@DateLabel(payablePeriods.First().PeriodStart) - @DateLabel(payablePeriods.Last().PeriodEnd)</strong>
                            <small class="d-block text-muted">@T["{0} monthly period(s) · {1:N0} XAF due", payablePeriods.Count, payableGroupTotal]</small>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var period in payablePeriods)
                                {
                                    <span class="rh-chip rh-chip-info">@DateLabel(period.PeriodStart) - @DateLabel(period.PeriodEnd) · @Math.Max(0, period.Amount - period.PaidAmount).ToString("N0") XAF</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn rh-btn-primary w-100">@T["Pay {0:N0} XAF", payableGroupTotal]</button>
                        <small class="text-muted d-block mt-2">@T["Payment method: {0}", PaymentMethodLabel(item.PaymentMethod)]</small>
                    </div>
                </div>
            </form>
        }
        else if (pendingPaymentPeriod != null && item.AutomaticPaymentsEnabled)
        {
            <div class="rh-inline-settings-note d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <span>@T["A card payment is already pending for {0} - {1}. Complete that payment before selecting another period.", DateLabel(pendingPaymentPeriod.PeriodStart), DateLabel(pendingPaymentPeriod.PeriodEnd)]</span>
                <a class="btn rh-btn-primary" asp-action="RentCardCheckout" asp-route-reference="@pendingPaymentPeriod.PaymentReference">@T["Continue card payment"]</a>
            </div>
        }
        else if (payablePeriods.Count > 0 || pendingPaymentPeriod != null)
        {
            <div class="rh-tenant-manual-payment">
                <ol class="rh-payment-step-list">
                    <li>@T["Contact the landlord using the email shown above."]</li>
                    <li>@T["Agree on the accepted offline payment method."]</li>
                    <li>@T["Ask the landlord to record the cash payment in Lontsi Homes and provide your receipt."]</li>
                </ol>
                @if (!string.IsNullOrWhiteSpace(item.LandlordEmail))
                {
                    <a class="btn rh-btn-primary" href="mailto:@item.LandlordEmail">@T["Contact the landlord"]</a>
                }
            </div>
        }
        else
        {
            <div class="rh-empty">@T["No unpaid rent period is currently available for payment."]</div>
        }
    </section>

    <section class="rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head align-start">
            <div>
                <h2 class="rh-dashboard-panel-title">@T["Rent periods"]</h2>
                <p class="rh-dashboard-panel-copy">@T["Month-by-month rent state for this tenancy."]</p>
            </div>
            <a class="btn btn-sm rh-btn-subtle" asp-controller="Tenancies" asp-action="RentPeriods" asp-route-tenancyId="@tenancy.Id">@T["Open rent ledger"]</a>
        </div>

        @if (Model.RentPeriods.Count == 0)
        {
            <div class="rh-empty">@T["No rent period is currently recorded."]</div>
        }
        else
        {
            <div class="table-responsive rh-responsive-table-wrap">
                <table class="table align-middle rh-table rh-responsive-data-table mb-0">
                    <thead><tr><th>@T["Period"]</th><th>@T["Due date"]</th><th class="text-end">@T["Amount"]</th><th class="text-end">@T["Paid"]</th><th class="text-end">@T["Balance"]</th><th>@T["Status"]</th><th>@T["Receipt"]</th></tr></thead>
                    <tbody>
                    @foreach (var period in Model.RentPeriods)
                    {
                        var balance = Math.Max(0, period.Amount - period.PaidAmount);
                        <tr>
                            <td class="rh-mobile-card-title" data-label="@T["Period"]">@DateLabel(period.PeriodStart) - @DateLabel(period.PeriodEnd)</td>
                            <td data-label="@T["Due date"]">@DateLabel(period.DueDate)</td>
                            <td class="text-end" data-label="@T["Amount"]">@period.Amount.ToString("N0") XAF</td>
                            <td class="text-end" data-label="@T["Paid"]">@period.PaidAmount.ToString("N0") XAF</td>
                            <td class="text-end" data-label="@T["Balance"]">@balance.ToString("N0") XAF</td>
                            <td data-label="@T["Status"]"><span class="rh-chip @StatusClass(period.Status)" title="@(period.Status == RentPeriodStatusEnum.PaidBeforeRentHub ? T["Paid before this tenancy was recorded in Lontsi Homes."].Value : null)">@T[period.StatusLabel]</span></td>
                            <td data-label="@T["Receipt"]">
                                @if (period.PaymentId.HasValue && RentPeriodScheduleHelper.IsPaidStatus(period.Status))
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        <a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="Payment" asp-route-paymentId="@period.PaymentId.Value">@T["Receipt"]</a>
                                        <a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="DownloadPayment" asp-route-paymentId="@period.PaymentId.Value">@T["Download"]</a>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">@T["Not available"]</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <div class="rh-table-footer">
            <a class="btn btn-sm rh-btn-subtle @(Model.PeriodPage <= 1 ? "disabled" : null)" asp-action="Tenancy" asp-route-tenancyId="@tenancy.Id" asp-route-periodPage="@(Model.PeriodPage - 1)" asp-route-periodPageSize="@Model.PeriodPageSize" asp-route-historyPage="@Model.HistoryPage" asp-route-historyPageSize="@Model.HistoryPageSize">@T["Previous"]</a>
            <div class="rh-table-page-size">
                <label class="form-label mb-0" for="tenantPeriodPageSize">@T["Rows"]</label>
                <select id="tenantPeriodPageSize" class="form-select rh-input rh-select" data-auto-page-size data-page-size-parameter="periodPageSize" data-page-parameter="periodPage">
                    @foreach (var size in new[] { 5, 10, 20, 50 }) { <option value="@size" selected="@(Model.PeriodPageSize == size ? "selected" : null)">@size</option> }
                </select>
                <small class="text-muted">@T["{0} result(s) · Page {1} of {2}", Model.TotalRentPeriods, Model.PeriodPage, Model.TotalPeriodPages]</small>
            </div>
            <a class="btn btn-sm rh-btn-subtle rh-table-footer-next @(Model.PeriodPage >= Model.TotalPeriodPages ? "disabled" : null)" asp-action="Tenancy" asp-route-tenancyId="@tenancy.Id" asp-route-periodPage="@(Model.PeriodPage + 1)" asp-route-periodPageSize="@Model.PeriodPageSize" asp-route-historyPage="@Model.HistoryPage" asp-route-historyPageSize="@Model.HistoryPageSize">@T["Next"]</a>
        </div>
    </section>

    <section class="rh-overview-workgrid rh-apartment-workgrid">
        <div class="rh-overview-maincolumn">
            <article class="rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head align-start">
                    <div><h2 class="rh-dashboard-panel-title">@T["Payment history"]</h2><p class="rh-dashboard-panel-copy">@T["Recorded payments for this tenancy and their receipts."]</p></div>
                </div>

                @if (Model.PaymentHistory.Count == 0)
                {
                    <div class="rh-empty">@T["No payment has been recorded for this tenancy yet."]</div>
                }
                else
                {
                    <div class="table-responsive rh-responsive-table-wrap">
                        <table class="table align-middle rh-table rh-responsive-data-table mb-0">
                            <thead><tr><th>@T["Date"]</th><th>@T["Period"]</th><th class="text-end">@T["Amount"]</th><th>@T["Status"]</th><th>@T["Receipt"]</th></tr></thead>
                            <tbody>
                            @foreach (var payment in Model.PaymentHistory)
                            {
                                <tr>
                                    <td class="rh-mobile-card-title" data-label="@T["Date"]">@DateLabel(payment.PaymentDate)</td>
                                    <td data-label="@T["Period"]">@payment.PeriodLabel</td>
                                    <td class="text-end" data-label="@T["Amount"]">@payment.Amount.ToString("N0") @payment.Currency</td>
                                    <td data-label="@T["Status"]"><span class="rh-chip @(payment.Status == PaymentStatusEnum.Success ? "rh-chip-primary" : "rh-chip-info")">@T[payment.Status.ToString()]</span></td>
                                    <td data-label="@T["Receipt"]">
                                        @if (payment.Status == PaymentStatusEnum.Success)
                                        {
                                            <div class="d-flex flex-wrap gap-2"><a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="Payment" asp-route-paymentId="@payment.PaymentId">@T["Receipt"]</a><a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="DownloadPayment" asp-route-paymentId="@payment.PaymentId">@T["Download"]</a></div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@T["Not available"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="rh-table-footer">
                    <a class="btn btn-sm rh-btn-subtle @(Model.HistoryPage <= 1 ? "disabled" : null)" asp-action="Tenancy" asp-route-tenancyId="@tenancy.Id" asp-route-periodPage="@Model.PeriodPage" asp-route-periodPageSize="@Model.PeriodPageSize" asp-route-historyPage="@(Model.HistoryPage - 1)" asp-route-historyPageSize="@Model.HistoryPageSize">@T["Previous"]</a>
                    <div class="rh-table-page-size">
                        <label class="form-label mb-0" for="tenantHistoryPageSize">@T["Rows"]</label>
                        <select id="tenantHistoryPageSize" class="form-select rh-input rh-select" data-auto-page-size data-page-size-parameter="historyPageSize" data-page-parameter="historyPage">
                            @foreach (var size in new[] { 5, 10, 20, 50 }) { <option value="@size" selected="@(Model.HistoryPageSize == size ? "selected" : null)">@size</option> }
                        </select>
                        <small class="text-muted">@T["{0} result(s) · Page {1} of {2}", Model.TotalPayments, Model.HistoryPage, Model.TotalHistoryPages]</small>
                    </div>
                    <a class="btn btn-sm rh-btn-subtle rh-table-footer-next @(Model.HistoryPage >= Model.TotalHistoryPages ? "disabled" : null)" asp-action="Tenancy" asp-route-tenancyId="@tenancy.Id" asp-route-periodPage="@Model.PeriodPage" asp-route-periodPageSize="@Model.PeriodPageSize" asp-route-historyPage="@(Model.HistoryPage + 1)" asp-route-historyPageSize="@Model.HistoryPageSize">@T["Next"]</a>
                </div>
            </article>
        </div>

        <div class="rh-overview-sidecolumn rh-overview-sidecolumn-priority">
            <article class="rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head align-start"><div><h2 class="rh-dashboard-panel-title">@T["Tenancy contract"]</h2><p class="rh-dashboard-panel-copy">@T["The current contract registered for this tenancy."]</p></div></div>
                @if (contract == null)
                {
                    <div class="rh-empty">@T["No tenancy contract uploaded yet."]</div>
                }
                else
                {
                    <div class="rh-member-profile-list">
                        <div><span>@T["Document"]</span><strong>@contract.FileName</strong><small>@T["Uploaded"] @DateLabel(contract.UploadedAt)</small></div>
                    </div>
                    <a class="btn rh-btn-subtle w-100 mt-3" asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@contract.Id">@T["Preview"]</a>
                }
            </article>
        </div>
    </section>
</section>
