@model Common.CommunicationModels.TenantDashboardTenancyDto
@using Common.Helpers
@{
    ViewData["Title"] = T["Payment Details"].Value;
    var unpaidPeriods = Model.RentPeriods
        .Where(period => !RentPeriodScheduleHelper.IsPaidStatus(period.Status))
        .OrderBy(period => period.PeriodStart)
        .ToList();
}

<section class="rh-overview-shell">
    <section class="rh-page-header rh-page-header-elevated">
        <div>
            <p class="rh-kicker">@T["Rent payment information"]</p>
            <h1 class="rh-heading-title">@Model.Tenancy.PropertyName · @Model.Tenancy.ApartmentName</h1>
            <p class="rh-heading-subtitle">@T["Review what is due and contact your landlord to arrange an offline payment."]</p>
        </div>
        <a class="btn rh-btn-subtle" asp-action="Index">@T["Back to rent dashboard"]</a>
    </section>

    <section class="rh-panel rh-panel-elevated mb-3">
        <div class="rh-inline-settings-note rh-warning-note mb-3">
            @T["Automatic card, Orange Money and MTN payments are temporarily unavailable for this property. Do not enter payment credentials on another page."]
        </div>
        <div class="rh-property-summary">
            <article class="rh-summary-card">
                <p>@T["Outstanding balance"]</p>
                <h3>@Model.OutstandingBalance.ToString("N0")</h3>
                <small>@T["Across unpaid rent periods"]</small>
            </article>
            <article class="rh-summary-card">
                <p>@T["Next due date"]</p>
                <h3>@(Model.NextDueDate?.LocalDateTime.ToString("d") ?? T["Not scheduled"].Value)</h3>
                <small>@T["Oldest unpaid period"]</small>
            </article>
            <article class="rh-summary-card">
                <p>@T["Landlord"]</p>
                <h3>@Model.LandlordName</h3>
                <small>@Model.LandlordEmail</small>
            </article>
        </div>
    </section>

    <section class="rh-panel rh-panel-elevated">
        <h2 class="rh-section-title mb-2">@T["How to continue"]</h2>
        <ol class="mb-4">
            <li>@T["Contact the landlord using the email shown above."]</li>
            <li>@T["Agree on the accepted offline payment method."]</li>
            <li>@T["Ask the landlord to record the cash payment in Lontsi Homes and provide your receipt."]</li>
        </ol>

        <h2 class="rh-section-title mb-2">@T["Unpaid periods"]</h2>
        @if (unpaidPeriods.Count == 0)
        {
            <div class="rh-empty">@T["No unpaid rent period is currently recorded."]</div>
        }
        else
        {
            <div class="table-responsive rh-responsive-table-wrap">
                <table class="table align-middle rh-table rh-responsive-data-table mb-0">
                    <thead><tr><th>@T["Period"]</th><th>@T["Due date"]</th><th class="text-end">@T["Balance"]</th><th>@T["Status"]</th></tr></thead>
                    <tbody>
                    @foreach (var period in unpaidPeriods)
                    {
                        <tr>
                            <td class="rh-mobile-card-title" data-label="@T["Period"]">@period.PeriodStart.LocalDateTime.ToString("d") - @period.PeriodEnd.LocalDateTime.ToString("d")</td>
                            <td data-label="@T["Due date"]">@period.DueDate.LocalDateTime.ToString("d")</td>
                            <td class="text-end" data-label="@T["Balance"]">@(period.Amount - period.PaidAmount).ToString("N0")</td>
                            <td data-label="@T["Status"]">@T[period.StatusLabel]</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
