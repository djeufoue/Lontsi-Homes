@model Common.CommunicationModels.TenantDashboardDto
@using Common.Enums
@using Common.Helpers
@{
    ViewData["Title"] = "Tenant Dashboard";

    string DateLabel(DateTimeOffset value) => value.LocalDateTime.ToString("dd MMM yyyy");
    string OptionalDateLabel(DateTimeOffset? value) => value.HasValue ? DateLabel(value.Value) : "Not scheduled";
    string StatusClass(RentPeriodStatusEnum status) => status switch
    {
        RentPeriodStatusEnum.Paid or RentPeriodStatusEnum.PaidBeforeRentHub or RentPeriodStatusEnum.PaidInAdvance => "rh-chip-primary",
        RentPeriodStatusEnum.Due or RentPeriodStatusEnum.Overdue => "rh-chip-warning",
        RentPeriodStatusEnum.PendingPayment => "rh-chip-info",
        RentPeriodStatusEnum.Waived or RentPeriodStatusEnum.Cancelled => "rh-chip-info",
        _ => "rh-chip-info"
    };

    string PaymentMethodLabel(PaymentMethodEnum method) => method switch
    {
        PaymentMethodEnum.Momo => "MTN Mobile Money",
        PaymentMethodEnum.OrangeMoney => "Orange Money",
        PaymentMethodEnum.Card => "card",
        _ => method.ToString()
    };
}

<section class="rh-overview-shell">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <p class="rh-kicker">Tenant workspace</p>
            <h1 class="rh-heading-title">My rent dashboard</h1>
            <p class="rh-heading-subtitle">Review your tenancy, payment history, and rent periods from one place.</p>
        </div>
    </section>

    @if (Model.Tenancies.Count == 0)
    {
        <section class="rh-panel rh-panel-elevated">
            <div class="rh-empty">No active tenancy is linked to your account yet.</div>
        </section>
    }
    else
    {
        foreach (var item in Model.Tenancies)
        {
            var tenancy = item.Tenancy;
            var periods = item.RentPeriods.OrderBy(period => period.PeriodStart).ToList();
            var pendingPaymentPeriod = periods
                .Where(period => period.Status == RentPeriodStatusEnum.PendingPayment && !string.IsNullOrWhiteSpace(period.PaymentReference))
                .OrderBy(period => period.PeriodStart)
                .FirstOrDefault();
            var payablePeriods = pendingPaymentPeriod == null
                ? periods
                    .Where(period => !RentPeriodScheduleHelper.IsPaidStatus(period.Status) && period.Status != RentPeriodStatusEnum.PendingPayment)
                    .OrderBy(period => period.PeriodStart)
                    .ToList()
                : new List<Common.CommunicationModels.RentPeriodDto>();
            var maxPayable = payablePeriods.Count;

            <section class="rh-panel rh-panel-elevated mb-3">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <p class="rh-kicker">@tenancy.PropertyName</p>
                        <h2 class="rh-dashboard-panel-title">@tenancy.ApartmentName</h2>
                        <p class="rh-dashboard-panel-copy">
                            @DateLabel(tenancy.StartDate) - @(tenancy.EndDate.HasValue ? DateLabel(tenancy.EndDate.Value) : "Open term")
                        </p>
                    </div>
                    <span class="rh-chip rh-chip-info">@tenancy.Status</span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <div class="rh-stat-box">
                            <span class="rh-stat-label">Monthly rent</span>
                            <strong class="rh-stat-value">@tenancy.MonthlyRent.ToString("N0")</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="rh-stat-box">
                            <span class="rh-stat-label">Outstanding</span>
                            <strong class="rh-stat-value">@item.OutstandingBalance.ToString("N0")</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="rh-stat-box">
                            <span class="rh-stat-label">Next due</span>
                            <strong class="rh-stat-value">@OptionalDateLabel(item.NextDueDate)</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="rh-stat-box">
                            <span class="rh-stat-label">Landlord</span>
                            <strong class="rh-stat-value">@item.LandlordName</strong>
                        </div>
                    </div>
                </div>

                @if (maxPayable > 0)
                {
                    if (!item.CanPayRent)
                    {
                        <div class="rh-inline-settings-note rh-warning-note mb-3">
                            @(string.IsNullOrWhiteSpace(item.PaymentUnavailableReason)
                                ? "Card payment mode is not available right now."
                                : item.PaymentUnavailableReason)
                        </div>
                    }
                    else
                    {
                        <form asp-action="PayRent" method="post" class="rh-inline-settings-note rh-rent-payment-form mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                            <input type="hidden" name="paymentMethod" value="@item.PaymentMethod" />
                            <input type="hidden" name="numberOfPeriods" value="0" data-rent-period-count />
                            <div class="row g-3 align-items-end">
                                <div class="col-md-8">
                                    <label class="form-label">Pay rent periods in order</label>
                                    <div class="rh-rent-period-picker" data-rent-period-picker>
                                        <button class="btn rh-btn-subtle rh-rent-period-picker-toggle" type="button" data-rent-picker-toggle>
                                            Choose rent periods
                                        </button>
                                        <div class="rh-rent-period-picker-menu" data-rent-picker-menu>
                                            @for (var optionIndex = 0; optionIndex < maxPayable; optionIndex++)
                                            {
                                                var period = payablePeriods[optionIndex];
                                                var selectedPeriods = payablePeriods.Take(optionIndex + 1).ToList();
                                                var total = selectedPeriods.Sum(selectedPeriod => selectedPeriod.Amount - selectedPeriod.PaidAmount);
                                                var optionLabel = $"{DateLabel(period.PeriodStart)} - {DateLabel(period.PeriodEnd)}";
                                                <label class="rh-rent-period-option">
                                                    <input type="checkbox"
                                                           data-rent-period-option
                                                           data-index="@optionIndex"
                                                           data-total="@total.ToString("N0")"
                                                           data-label="@optionLabel"
                                                           disabled="@(optionIndex > 0)" />
                                                    <span>
                                                        <strong>@optionLabel</strong>
                                                        <small>@(period.Amount - period.PaidAmount).ToString("N0") due</small>
                                                    </span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                    <small class="text-muted" data-rent-picker-help>
                                        Select the oldest period first. Each selected period unlocks the next one.
                                    </small>
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn rh-btn-primary w-100" data-rent-submit disabled>
                                        Pay selected rent
                                    </button>
                                    <small class="text-muted d-block mt-2">Payment method: @PaymentMethodLabel(item.PaymentMethod)</small>
                                </div>
                            </div>
                        </form>
                    }
                }
                else if (pendingPaymentPeriod != null)
                {
                    <div class="rh-inline-settings-note mb-3 d-flex flex-wrap gap-2 align-items-center justify-content-between">
                        <span>A card payment is already pending for @DateLabel(pendingPaymentPeriod.PeriodStart) - @DateLabel(pendingPaymentPeriod.PeriodEnd). Complete that payment before selecting another period.</span>
                        <a class="btn rh-btn-primary" asp-action="RentCardCheckout" asp-route-reference="@pendingPaymentPeriod.PaymentReference">Continue card payment</a>
                    </div>
                }
                else
                {
                    <div class="rh-inline-settings-note mb-3">No unpaid rent period is currently available for payment.</div>
                }

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th class="text-end">Amount</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var period in periods)
                            {
                                <tr>
                                    <td>@DateLabel(period.PeriodStart) - @DateLabel(period.PeriodEnd)</td>
                                    <td class="text-end">@period.Amount.ToString("N0")</td>
                                    <td><span class="rh-chip @StatusClass(period.Status)">@period.StatusLabel</span></td>
                                    <td>
                                        @if (period.IsPayable)
                                        {
                                            <span>Available in payment selector</span>
                                        }
                                        else if (period.Status == RentPeriodStatusEnum.PendingPayment && !string.IsNullOrWhiteSpace(period.PaymentReference))
                                        {
                                            <a class="btn btn-sm rh-btn-subtle" asp-action="RentCardCheckout" asp-route-reference="@period.PaymentReference">Continue payment</a>
                                        }
                                        else if (period.PaymentId.HasValue && RentPeriodScheduleHelper.IsPaidStatus(period.Status))
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                <a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="Payment" asp-route-paymentId="@period.PaymentId.Value">Receipt</a>
                                                <a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="DownloadPayment" asp-route-paymentId="@period.PaymentId.Value">Download</a>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(period.LockedReason))
                                        {
                                            <span class="text-muted">@period.LockedReason</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">View</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (item.PaymentHistory.Any())
                {
                    <h3 class="rh-section-title mt-4 mb-2">Payment history</h3>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Period</th>
                                    <th class="text-end">Amount</th>
                                    <th>Status</th>
                                    <th>Receipt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in item.PaymentHistory.OrderByDescending(payment => payment.PaymentDate))
                                {
                                    <tr>
                                        <td>@DateLabel(payment.PaymentDate)</td>
                                        <td>@payment.PeriodLabel</td>
                                        <td class="text-end">@payment.Amount.ToString("N0") @payment.Currency</td>
                                        <td>@payment.Status</td>
                                        <td>
                                            @if (payment.Status == PaymentStatusEnum.Success)
                                            {
                                                <div class="d-flex flex-wrap gap-2">
                                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="Payment" asp-route-paymentId="@payment.PaymentId">Receipt</a>
                                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="DownloadPayment" asp-route-paymentId="@payment.PaymentId">Download</a>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">After payment</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }
</section>
