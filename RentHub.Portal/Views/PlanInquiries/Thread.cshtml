@model RentHub.Portal.ViewModels.PlanInquiries.PublicPlanInquiryThreadVm
@{ ViewData["Title"] = "Plan conversation"; }
<section class="rh-page-header rh-page-header-elevated"><div><p class="rh-kicker">Plan conversation</p><h1 class="rh-heading-title">@Model.Thread.PlanName</h1><p class="rh-heading-subtitle">Keep this private link to continue your conversation with Lontsi Homes.</p></div></section>
<section class="rh-panel rh-panel-elevated mx-auto" style="max-width:960px">
    <div class="rh-properties-overview-grid mb-3"><article class="rh-properties-stat-card"><span>Properties</span><strong>@Model.Thread.PropertyCount</strong></article><article class="rh-properties-stat-card"><span>Apartments</span><strong>@Model.Thread.ApartmentCount</strong></article><article class="rh-properties-stat-card"><span>Tenants</span><strong>@Model.Thread.TenantCount</strong></article><article class="rh-properties-stat-card"><span>Months</span><strong>@Model.Thread.CommitmentMonths</strong></article><article class="rh-properties-stat-card"><span>Monthly price</span><strong>@Model.Thread.ProposedMonthlyPrice.ToString("N2")</strong></article><article class="rh-properties-stat-card"><span>Proposed total</span><strong>@((Model.Thread.ProposedMonthlyPrice * Model.Thread.CommitmentMonths).ToString("N2"))</strong></article></div>
    <div class="rh-public-chat-thread rh-public-chat-thread-inbox">@foreach (var message in Model.Thread.Messages) { <div class="rh-chat-bubble @(message.SentByCurrentUser ? "is-self" : "is-other")"><strong>@message.SenderName</strong><p>@message.Body</p><small>@message.SentAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small></div> }</div>
    <form asp-action="Reply" method="post" class="mt-3">@Html.AntiForgeryToken()<input type="hidden" name="token" value="@Model.Token" /><label class="form-label">Reply</label><textarea name="message" class="form-control rh-input" rows="4" required></textarea><button class="btn rh-btn-primary mt-3" type="submit">Send reply</button></form>
</section>
