           asp-route-tenancyId="@tenancy.Id"
           asp-route-memberSearch="@Model.MemberSearch"
           asp-route-rentStatus="@Model.RentStatus"
           asp-route-rentFrom="@Model.RentFrom?.ToString("yyyy-MM-dd")"
           asp-route-rentTo="@Model.RentTo?.ToString("yyyy-MM-dd")"
           asp-route-rentSortDirection="@Model.RentSortDirection"
           asp-route-rentGroupPage="@Model.RentGroupPage"
           asp-route-rentPage="@(Model.RentPage + 1)"
           asp-route-rentPageSize="@Model.RentPageSize">@T["Next"]</a>
</div>

@if (Model.IsRentPeriodsPage && manualCashCandidates.Any())
{
    <script>
        document.querySelectorAll('[data-rent-batch-form]').forEach(function (form) {
            const checkboxes = Array.from(form.querySelectorAll('[data-rent-batch-checkbox]'));
            const ids = form.querySelector('[data-rent-batch-ids]');
            const submit = form.querySelector('[data-rent-batch-submit]');
            const refresh = function () {
                let prefixComplete = true;
                checkboxes.forEach(function (checkbox, index) {
                    if (index === 0) {
                        checkbox.disabled = false;
                    } else {
                        checkbox.disabled = !prefixComplete;
                        if (checkbox.disabled) checkbox.checked = false;
                    }
                    prefixComplete = prefixComplete && checkbox.checked;
                });
                const selected = checkboxes.filter(function (checkbox) {
                    return checkbox.checked && !checkbox.disabled;
                });
                ids.value = selected.map(function (checkbox) { return checkbox.value; }).join(',');
                submit.disabled = selected.length === 0;
                submit.setAttribute('aria-disabled', submit.disabled ? 'true' : 'false');
            };
            checkboxes.forEach(function (checkbox) { checkbox.addEventListener('change', refresh); });
            form.addEventListener('rent-batch:refresh', refresh);
            form.addEventListener('submit', function (event) {
                refresh();
                if (submit.disabled || !ids.value) {
                    event.preventDefault();
                    event.stopPropagation();
                }
            });
            refresh();
        });
    </script>
}

@functions {
    private static string DateLabel(DateTimeOffset value) => value.ToLocalTime().ToString("dd MMM yyyy", CultureInfo.CurrentCulture);

    private static string DateTimeLabel(DateTimeOffset value) => value.ToLocalTime().ToString("dd MMM yyyy · HH:mm", CultureInfo.CurrentCulture);

    private static bool IsSettled(RentPeriodStatusEnum status) => status is
        RentPeriodStatusEnum.Paid or
        RentPeriodStatusEnum.PaidBeforeRentHub or
        RentPeriodStatusEnum.PaidInAdvance or
        RentPeriodStatusEnum.Waived or
        RentPeriodStatusEnum.Cancelled;

    private static string StatusClass(RentPeriodStatusEnum status)
    {
        return status switch
        {
            RentPeriodStatusEnum.Paid => "rh-chip-success",
            RentPeriodStatusEnum.PaidBeforeRentHub => "rh-chip-info",
            RentPeriodStatusEnum.PaidInAdvance => "rh-chip-success",
            RentPeriodStatusEnum.Overdue => "rh-chip-warning",
            RentPeriodStatusEnum.Waived => "rh-chip-info",
            RentPeriodStatusEnum.Cancelled => "rh-chip-info",
            _ => "rh-chip-info"
        };
    }
}
