@model RentHub.Portal.ViewModels.Tenancies.TenancyOverviewVm
@using Common.Enums
@using Common.Helpers
@using System
@{
    ViewData["Title"] = "Tenancy Overview";

    var tenancy = Model.Tenancy;
    var today = DateTimeOffset.UtcNow.Date;
    var contract = Model.Documents.OrderByDescending(document => document.UploadedAt).FirstOrDefault();
    var rentPeriods = Model.RentPeriods.OrderBy(period => period.PeriodStart).ToList();
    var waiveCandidates = rentPeriods
        .Where(period => !RentPeriodScheduleHelper.IsPaidStatus(period.Status) && period.PeriodEnd.Date >= today)
        .ToList();
    var members = Model.Members.OrderBy(member => string.Equals(member.Role, TenancyMemberRoleEnum.MainTenant.ToString(), StringComparison.OrdinalIgnoreCase) ? 0 : 1)
        .ThenBy(member => member.FullName)
        .ToList();
    var tenancyState = !string.IsNullOrWhiteSpace(tenancy.Status)
        ? tenancy.Status
        : tenancy.StartDate.Date > today
            ? "Upcoming"
            : tenancy.EndDate.HasValue && tenancy.EndDate.Value.Date < today
                ? "Closed"
                : "Active";
    var stateClass = tenancyState switch
    {
        "Active" => "rh-chip-primary",
        "Terminated" => "rh-chip-warning",
        "Upcoming" => "rh-chip-info",
        _ => "rh-chip-warning"
    };

    string DateLabel(DateTimeOffset value) => value.LocalDateTime.ToString("dd MMM yyyy");
    string StatusClass(RentPeriodStatusEnum status) => status switch
    {
        RentPeriodStatusEnum.Paid or RentPeriodStatusEnum.PaidBeforeRentHub or RentPeriodStatusEnum.PaidInAdvance => "rh-chip-primary",
        RentPeriodStatusEnum.Due or RentPeriodStatusEnum.Overdue => "rh-chip-warning",
        RentPeriodStatusEnum.PendingPayment => "rh-chip-info",
        RentPeriodStatusEnum.Waived or RentPeriodStatusEnum.Cancelled => "rh-chip-info",
        _ => "rh-chip-info"
    };
}

<section class="rh-overview-shell rh-tenancy-shell">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-controller="Apartments" asp-action="Overview" asp-route-id="@tenancy.ApartmentId">&#8592; Back to apartment overview</a>
            <p class="rh-kicker">Tenancy Workspace</p>
            <h1 class="rh-heading-title">Tenancy #@tenancy.Id</h1>
            <p class="rh-heading-subtitle">@tenancy.PropertyName - @tenancy.ApartmentName</p>

            <div class="rh-overview-badges">
                <span class="rh-chip @stateClass">@tenancyState</span>
                <span class="rh-chip rh-chip-primary">@tenancy.MonthlyRent.ToString("N0") rent</span>
                <span class="rh-chip rh-chip-info">@members.Count / @tenancy.MaxMembers member(s)</span>
                <span class="rh-chip @(tenancy.CanWrite ? "rh-chip-primary" : "rh-chip-warning")">@(tenancy.CanWrite ? "Write access" : "Read access")</span>
            </div>
        </div>

        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-subtle" asp-controller="Apartments" asp-action="Overview" asp-route-id="@tenancy.ApartmentId">Apartment Workspace</a>
            <a class="btn rh-btn-primary" asp-controller="Properties" asp-action="Overview" asp-route-id="@tenancy.PropertyId">Property Workspace</a>
            @if (tenancy.CanWrite && tenancy.TerminatedAt == null)
            {
                <button type="button" class="btn rh-btn-outline-danger" data-bs-toggle="modal" data-bs-target="#terminateTenancyModal">Terminate tenancy</button>
            }
        </div>
    </section>

    <section class="rh-apartment-commanddeck rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head">
            <div>
                <h2 class="rh-dashboard-panel-title">Tenancy overview</h2>
                <p class="rh-dashboard-panel-copy">Keep the tenancy contract and member structure clear in one focused workspace.</p>
            </div>
            <div class="rh-dashboard-range-chip">Live tenancy view</div>
        </div>

        <div class="rh-apartment-commanddeck-grid">
            <div class="rh-overview-bigstat">
                <span>Start date</span>
                <strong>@tenancy.StartDate.LocalDateTime.ToString("dd MMM yyyy")</strong>
                <small>Lease commencement</small>
            </div>
            <div class="rh-overview-bigstat alt">
                <span>End date</span>
                <strong>@(tenancy.EndDate?.LocalDateTime.ToString("dd MMM yyyy") ?? "Open term")</strong>
                <small>Lease completion window</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>Main rent</span>
                <strong>@tenancy.MonthlyRent.ToString("N0")</strong>
                <small>Monthly tenancy arrangement</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>Members</span>
                <strong>@members.Count</strong>
                <small>Tenancy occupants and guests</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>Status</span>
                <strong>@tenancyState</strong>
                <small>Tenancy lifecycle state</small>
            </div>
        </div>
    </section>

    <section class="rh-overview-workgrid rh-apartment-workgrid">
        <div class="rh-overview-maincolumn">
            <article class="rh-overview-docs-card rh-panel rh-panel-elevated rh-overview-docs-compact">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Tenancy contract</h2>
                        <p class="rh-dashboard-panel-copy">Maintain a single contract document for this tenancy.</p>
                    </div>

                    @if (tenancy.CanWrite)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#uploadTenancyContractModal">@(contract == null ? "Add+" : "Replace")</button>
                    }
                </div>

                @if (contract == null)
                {
                    <div class="rh-empty">No tenancy contract uploaded yet.</div>
                }
                else
                {
                    <article class="rh-document-item rh-document-item-previewable rh-card-spotlight">
                        <div class="rh-document-item-copy">
                            <a asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@contract.Id" class="rh-document-title-link">@contract.FileName</a>
                            <small>@contract.DocumentType - @contract.UploadedAt.LocalDateTime.ToString("dd MMM yyyy")</small>
                        </div>
                        <div class="rh-document-actions">
                            <a class="btn btn-sm rh-btn-subtle" asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@contract.Id">Preview</a>
                            @if (tenancy.CanWrite)
                            {
                                <form method="post" asp-action="DeleteDocument" data-confirm-modal="true" data-confirm-title="Delete tenancy contract?" data-confirm-message="This will remove the current tenancy contract." data-confirm-proceed="Delete contract">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                                    <input type="hidden" name="documentId" value="@contract.Id" />
                                    <button class="btn btn-sm rh-btn-outline-danger" type="submit">Delete</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </article>

            <article class="rh-overview-docs-card rh-panel rh-panel-elevated rh-overview-docs-compact mt-3">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Rent periods</h2>
                        <p class="rh-dashboard-panel-copy">Month-by-month rent state for this tenancy.</p>
                    </div>
                </div>

                @if (!rentPeriods.Any())
                {
                    <div class="rh-empty">No rent periods generated yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th>Due date</th>
                                    <th class="text-end">Amount</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var period in rentPeriods)
                                {
                                    <tr>
                                        <td>@DateLabel(period.PeriodStart) - @DateLabel(period.PeriodEnd)</td>
                                        <td>@DateLabel(period.DueDate)</td>
                                        <td class="text-end">@period.Amount.ToString("N0")</td>
                                        <td><span class="rh-chip @StatusClass(period.Status)">@period.StatusLabel</span></td>
                                        <td>
                                            @if (period.PaymentId.HasValue)
                                            {
                                                <div class="d-flex flex-wrap gap-2">
                                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="Payment" asp-route-paymentId="@period.PaymentId.Value">Receipt</a>
                                                    <a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="DownloadPayment" asp-route-paymentId="@period.PaymentId.Value">Download</a>
                                                </div>
                                            }
                                            else if (tenancy.CanWrite && period.IsPayable)
                                            {
                                                <form method="post" asp-action="MarkRentPeriodPaid" data-confirm-modal="true" data-confirm-title="Mark this rent period as paid by cash?" data-confirm-message="This will mark the oldest unlocked rent period as paid outside Stripe, create a system payment record, generate a RentHub receipt, and unlock the next rent period. Use it only if the tenant already paid you by cash or another off-platform method." data-confirm-proceed="Mark paid cash" data-confirm-style="primary">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                                                    <input type="hidden" name="rentPeriodId" value="@period.Id" />
                                                    <button type="submit" class="btn btn-sm rh-btn-primary">Mark paid cash</button>
                                                </form>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(period.LockedReason))
                                            {
                                                <span class="text-muted">@period.LockedReason</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No receipt</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>
        </div>

        <div class="rh-overview-sidecolumn rh-overview-sidecolumn-priority">
            <article class="rh-overview-members-card rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Tenancy members</h2>
                        <p class="rh-dashboard-panel-copy">Manage the main tenant, co-tenants, children, and visitors.</p>
                    </div>
                    @if (tenancy.CanWrite)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addTenancyMemberModal">Add+</button>
                    }
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar">
                    <input type="hidden" name="id" value="@tenancy.Id" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input" type="text" name="memberSearch" value="@Model.MemberSearch" placeholder="Search tenancy members" autocomplete="off" />
                    </div>
                </form>

                @if (!members.Any())
                {
                    <div class="rh-empty">No tenancy members added yet.</div>
                }
                else
                {
                    <div class="rh-member-stack">
                        @foreach (var member in members)
                        {
                            <article class="rh-member-card rh-card-spotlight rh-member-card-clickable">
                                <a class="rh-member-card-link"
                                   asp-action="MemberProfile"
                                   asp-route-tenancyId="@tenancy.Id"
                                   asp-route-memberId="@member.Id"
                                   aria-label="Open profile for @member.FullName"></a>
                                <div class="rh-member-card-copy">
                                    <strong>@member.FullName</strong>
                                    <small>@member.Role • @(string.IsNullOrWhiteSpace(member.Email) ? "No email saved" : member.Email)</small>
                                    <small>@(member.EmailConfirmed ? "Email confirmed" : "Email activation pending")</small>
                                </div>
                                <div class="rh-member-card-actions">
                                    <span class="rh-chip @(string.Equals(member.Role, TenancyMemberRoleEnum.MainTenant.ToString(), StringComparison.OrdinalIgnoreCase) ? "rh-chip-primary" : "rh-chip-info")">@member.Role</span>
                                    <span class="rh-chip @(member.EmailConfirmed ? "rh-chip-primary" : "rh-chip-warning")">@(member.EmailConfirmed ? "Active" : "Pending")</span>
                                    @if (!string.IsNullOrWhiteSpace(member.CountryCode))
                                    {
                                        <span class="rh-chip rh-chip-info">@member.CountryCode</span>
                                    }
                                    @if (tenancy.CanWrite)
                                    {
                                        <button type="button" class="btn btn-sm rh-btn-subtle" data-bs-toggle="modal" data-bs-target="#editTenancyMemberModal-@member.Id">Edit</button>
                                        <form method="post" asp-action="RemoveMember" data-confirm-modal="true" data-confirm-title="Remove this tenancy member?" data-confirm-message="This will remove the member from this tenancy and revoke their access to this tenancy workspace. Existing rent periods, payments, and generated receipts will stay in the system." data-confirm-proceed="Remove member" data-confirm-style="danger">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                                            <input type="hidden" name="memberId" value="@member.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">Remove</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </div>
    </section>
</section>

@if (tenancy.CanWrite)
{
    <div class="modal fade" id="terminateTenancyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered rh-action-modal-dialog">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="Terminate">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenancyId" value="@tenancy.Id" />

                    <div class="modal-header border-0 pb-0">
                        <div>
                            <h5 class="modal-title">Terminate tenancy</h5>
                            <p class="text-muted mb-0">Future rent generation stops after the termination date.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Termination date</label>
                            <input class="form-control rh-input" type="date" name="terminationDate" value="@today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Reason</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="reason">
                                    <option value="TenantMovedOut">Tenant moved out</option>
                                    <option value="Eviction">Eviction</option>
                                    <option value="AgreementEnded">Agreement ended</option>
                                    <option value="LandlordDecision">Landlord decision</option>
                                    <option value="TenantRequest">Tenant request</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Future rent handling</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="futureRentHandling" data-future-rent-handling>
                                    <option value="CancelFutureUnpaidPeriods">Cancel future unpaid periods</option>
                                    <option value="KeepUnpaidBalance">Keep unpaid balance</option>
                                    <option value="WaiveSelectedPeriods">Waive selected periods</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12" data-waive-periods hidden>
                            <div class="rh-inline-settings-note">
                                <strong>Waive selected future/unpaid periods</strong>
                                @if (!waiveCandidates.Any())
                                {
                                    <div class="mt-2">No unpaid future period is available for waiver.</div>
                                }
                                else
                                {
                                    <div class="mt-2 d-grid gap-2">
                                        @foreach (var period in waiveCandidates)
                                        {
                                            <label>
                                                <input type="checkbox" name="waivedRentPeriodIds" value="@period.Id" />
                                                @DateLabel(period.PeriodStart) - @DateLabel(period.PeriodEnd) (@period.Amount.ToString("N0"))
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes optional</label>
                            <textarea class="form-control rh-input" name="notes" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-outline-danger">Terminate tenancy</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="uploadTenancyContractModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="UploadContract" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                    <input type="hidden" name="currentDocumentId" value="@contract?.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@(contract == null ? "Upload Tenancy Contract" : "Replace Tenancy Contract")</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">Contract PDF</label>
                            <input class="form-control rh-input" type="file" name="file" accept=".pdf,application/pdf" required />
                            <small class="text-muted">Only PDF files are allowed. Uploading a new file replaces the current contract.</small>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Save contract</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addTenancyMemberModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="AddMember">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenancyId" value="@tenancy.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Add Tenancy Member</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">Email</label>
                            <input class="form-control rh-input" name="Email" type="email" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Full name</label>
                            <input class="form-control rh-input" name="FullName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Country code</label>
                            <input class="form-control rh-input" name="CountryCode" inputmode="numeric" placeholder="e.g. +237" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone number</label>
                            <input class="form-control rh-input" name="PhoneNumber" inputmode="numeric" placeholder="e.g. REMOVED_PRIVATE_VALUE" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">WhatsApp number</label>
                            <input class="form-control rh-input" name="WhatsAppPhoneNumber" inputmode="numeric" placeholder="Optional" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Role</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="Role">
                                    <option value="MainTenant">MainTenant</option>
                                    <option value="CoTenant">CoTenant</option>
                                    <option value="Children">Children</option>
                                    <option value="Visitor">Visitor</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Add member</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @foreach (var member in members)
    {
        <div class="modal fade" id="editTenancyMemberModal-@member.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rh-modal-content">
                    <form method="post" asp-action="UpdateMemberRole">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                        <input type="hidden" name="memberId" value="@member.Id" />

                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title">Edit Tenancy Member</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body row g-3">
                            <div class="col-12">
                                <div class="rh-inline-settings-note">
                                    <strong>@member.FullName</strong>
                                    <div class="mt-2">Set the tenancy role for this member.</div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Role</label>
                                <div class="rh-select-wrap">
                                    <select class="form-select rh-input rh-select" name="Role">
                                        <option value="MainTenant" selected="@(string.Equals(member.Role, TenancyMemberRoleEnum.MainTenant.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">MainTenant</option>
                                        <option value="CoTenant" selected="@(string.Equals(member.Role, TenancyMemberRoleEnum.CoTenant.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">CoTenant</option>
                                        <option value="Children" selected="@(string.Equals(member.Role, TenancyMemberRoleEnum.Children.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Children</option>
                                        <option value="Visitor" selected="@(string.Equals(member.Role, TenancyMemberRoleEnum.Visitor.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Visitor</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn rh-btn-primary">Save member</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        (() => {
            const select = document.querySelector("[data-future-rent-handling]");
            const waive = document.querySelector("[data-waive-periods]");
            if (!select || !waive) return;

            const sync = () => {
                waive.hidden = select.value !== "WaiveSelectedPeriods";
            };

            select.addEventListener("change", sync);
            sync();
        })();
    </script>
}
