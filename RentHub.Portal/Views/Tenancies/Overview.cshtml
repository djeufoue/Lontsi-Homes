@model RentHub.Portal.ViewModels.Tenancies.TenancyOverviewVm
@using Common.Enums
@using Common.Helpers
@using System
@{
    ViewData["Title"] = T["Tenancy Overview"].Value;
    var canOpenUserOverview = User.IsInRole("Admin") || User.IsInRole("Landlord") || User.IsInRole("Manager");

    var tenancy = Model.Tenancy;
    var today = DateTimeOffset.UtcNow.Date;
    var contract = Model.Documents.OrderByDescending(document => document.UploadedAt).FirstOrDefault();
    var rentPeriods = Model.AllRentPeriods.OrderBy(period => period.PeriodStart).ToList();
    var waiveCandidates = rentPeriods
        .Where(period => !RentPeriodScheduleHelper.IsPaidStatus(period.Status) && period.PeriodEnd.Date >= today)
        .ToList();
    var members = Model.Members.OrderBy(member => string.Equals(member.Role, TenancyMemberRoleEnum.MainTenant.ToString(), StringComparison.OrdinalIgnoreCase) ? 0 : 1)
        .ThenBy(member => member.FullName)
        .ToList();
    var tenancyState = !string.IsNullOrWhiteSpace(tenancy.Status)
        ? tenancy.Status
        : tenancy.StartDate.Date > today
            ? "Upcoming"
            : tenancy.EndDate.HasValue && tenancy.EndDate.Value.Date < today
                ? "Closed"
                : "Active";
    var stateClass = tenancyState switch
    {
        "Active" => "rh-chip-primary",
        "Terminated" => "rh-chip-warning",
        "Upcoming" => "rh-chip-info",
        _ => "rh-chip-warning"
    };

    string DateLabel(DateTimeOffset value) => value.LocalDateTime.ToString("d");
}

<section class="rh-overview-shell rh-tenancy-shell">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-controller="Apartments" asp-action="Overview" asp-route-id="@tenancy.ApartmentId">&#8592; @T["Back to apartment overview"]</a>
            <p class="rh-kicker">@T["Tenancy Workspace"]</p>
            <h1 class="rh-heading-title">@T["Tenancy #{0}", tenancy.Id]</h1>
            <p class="rh-heading-subtitle">@tenancy.PropertyName - @tenancy.ApartmentName</p>

            <div class="rh-overview-badges">
                <span class="rh-chip @stateClass">@T[tenancyState]</span>
                <span class="rh-chip rh-chip-primary">@T["{0:N0} rent", tenancy.MonthlyRent]</span>
                <span class="rh-chip rh-chip-info">@T["{0} / {1} members", members.Count, tenancy.MaxMembers]</span>
                <span class="rh-chip @(tenancy.CanWrite ? "rh-chip-primary" : "rh-chip-warning")">@(tenancy.CanWrite ? T["Write access"].Value : T["Read access"].Value)</span>
            </div>
        </div>

        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-subtle" asp-controller="Apartments" asp-action="Overview" asp-route-id="@tenancy.ApartmentId">@T["Apartment Workspace"]</a>
            <a class="btn rh-btn-primary" asp-controller="Properties" asp-action="Overview" asp-route-id="@tenancy.PropertyId">@T["Property Workspace"]</a>
            <a class="btn rh-btn-subtle" asp-action="Renewal" asp-route-tenancyId="@tenancy.Id">@T["Renewal requests"]</a>
            @if (tenancy.CanWrite && tenancy.TerminatedAt == null)
            {
                <button type="button" class="btn rh-btn-outline-danger" data-bs-toggle="modal" data-bs-target="#terminateTenancyModal">@T["Terminate tenancy"]</button>
            }
        </div>
    </section>

    <section class="rh-apartment-commanddeck rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head">
            <div>
                <h2 class="rh-dashboard-panel-title">@T["Tenancy overview"]</h2>
                <p class="rh-dashboard-panel-copy">@T["Keep the tenancy contract and member structure clear in one focused workspace."]</p>
            </div>
            <div class="rh-dashboard-range-chip">@T["Live tenancy view"]</div>
        </div>

        <div class="rh-apartment-commanddeck-grid">
            <div class="rh-overview-bigstat">
                <span>@T["Start date"]</span>
                <strong>@tenancy.StartDate.LocalDateTime.ToString("d")</strong>
                <small>@T["Lease commencement"]</small>
            </div>
            <div class="rh-overview-bigstat alt">
                <span>@T["End date"]</span>
                <strong>@(tenancy.EndDate?.LocalDateTime.ToString("d") ?? T["Open term"].Value)</strong>
                <small>@T["Lease completion window"]</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Main rent"]</span>
                <strong>@tenancy.MonthlyRent.ToString("N0")</strong>
                <small>@T["Monthly tenancy arrangement"]</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Members"]</span>
                <strong>@members.Count</strong>
                <small>@T["Tenancy occupants and guests"]</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>@T["Status"]</span>
                <strong>@T[tenancyState]</strong>
                <small>@T["Tenancy lifecycle state"]</small>
            </div>
        </div>
    </section>

    <section class="rh-overview-workgrid rh-apartment-workgrid">
        <div class="rh-overview-maincolumn">
            <article class="rh-overview-docs-card rh-panel rh-panel-elevated rh-overview-docs-compact">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Tenancy contract"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Maintain a single contract document for this tenancy."]</p>
                    </div>

                    @if (tenancy.CanWrite)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#uploadTenancyContractModal">@(contract == null ? T["Add+"].Value : T["Replace"].Value)</button>
                    }
                </div>

                @if (contract == null)
                {
                    <div class="rh-empty">@T["No tenancy contract uploaded yet."]</div>
                }
                else
                {
                    <article class="rh-document-item rh-document-item-previewable rh-card-spotlight">
                        <div class="rh-document-item-copy">
                            <a asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@contract.Id" class="rh-document-title-link">@contract.FileName</a>
                            <small>@T[contract.DocumentType.ToString()] - @contract.UploadedAt.LocalDateTime.ToString("d")</small>
                        </div>
                        <div class="rh-document-actions">
                            <a class="btn btn-sm rh-btn-subtle" asp-controller="Properties" asp-action="DocumentPreview" asp-route-id="@contract.Id">@T["Preview"]</a>
                            @if (tenancy.CanWrite)
                            {
                                <form method="post" asp-action="DeleteDocument" data-confirm-modal="true" data-confirm-title="@T["Delete tenancy contract?"]" data-confirm-message="@T["This will remove the current tenancy contract."]" data-confirm-proceed="@T["Delete contract"]">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                                    <input type="hidden" name="documentId" value="@contract.Id" />
                                    <button class="btn btn-sm rh-btn-outline-danger" type="submit">@T["Delete"]</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </article>

            @if (!User.IsInRole("Admin"))
            {
                <article class="rh-overview-docs-card rh-panel rh-panel-elevated rh-overview-docs-compact mt-3">
                    <div class="rh-overview-panel-head align-start">
                        <div>
                            <h2 class="rh-dashboard-panel-title">@T["Rent periods"]</h2>
                            <p class="rh-dashboard-panel-copy">@T["Open the complete rent ledger to filter periods, change the page size, sort by date, and manage payments."]</p>
                        </div>
                        <a class="btn rh-btn-primary" asp-action="RentPeriods" asp-route-tenancyId="@tenancy.Id">@T["Open rent ledger"]</a>
                    </div>
                </article>
            }
        </div>

        <div class="rh-overview-sidecolumn rh-overview-sidecolumn-priority">
            <article class="rh-overview-members-card rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">@T["Tenancy members"]</h2>
                        <p class="rh-dashboard-panel-copy">@T["Manage the main tenant, co-tenants, children, and visitors."]</p>
                    </div>
                    @if (tenancy.CanWrite)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addTenancyMemberModal">@T["Add+"]</button>
                    }
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar d-flex gap-2">
                    <input type="hidden" name="id" value="@tenancy.Id" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input" type="text" name="memberSearch" value="@Model.MemberSearch" placeholder="@T["Search tenancy members"]" autocomplete="off" />
                    </div>
                    <button class="btn rh-btn-subtle" type="submit">@T["Search"]</button>
                </form>

                @if (!members.Any())
                {
                    <div class="rh-empty">@T["No tenancy members added yet."]</div>
                }
                else
                {
                    <div class="rh-member-stack">
                        @foreach (var member in members)
                        {
                            <article class="rh-member-card rh-card-spotlight rh-member-card-clickable">
                                <a class="rh-member-card-link"
                                   asp-action="MemberProfile"
                                   asp-route-tenancyId="@tenancy.Id"
                                   asp-route-memberId="@member.Id"
                                   aria-label="@T["Open profile for {0}", member.FullName]"></a>
                                <div class="rh-member-card-copy">
                                    <strong>@member.FullName</strong>
                                    <small>@T[member.Role] • @(string.IsNullOrWhiteSpace(member.Email) ? T["No email saved"].Value : member.Email)</small>
                                    <small>@(member.EmailConfirmed ? T["Email confirmed"].Value : T["Email activation pending"].Value)</small>
                                </div>
                                <div class="rh-member-card-actions">
                                    <span class="rh-chip @(string.Equals(member.Role, TenancyMemberRoleEnum.MainTenant.ToString(), StringComparison.OrdinalIgnoreCase) ? "rh-chip-primary" : "rh-chip-info")">@T[member.Role]</span>
                                    <span class="rh-chip @(member.EmailConfirmed ? "rh-chip-primary" : "rh-chip-warning")">@(member.EmailConfirmed ? T["Active"].Value : T["Pending"].Value)</span>
                                    @if (!string.IsNullOrWhiteSpace(member.CountryCode))
                                    {
                                        <span class="rh-chip rh-chip-info">@member.CountryCode</span>
                                    }
                                    @if (canOpenUserOverview)
                                    {
                                        <a class="btn btn-sm rh-btn-subtle" asp-controller="AdminUsers" asp-action="Overview" asp-route-userId="@member.MemberId">@T["User overview"]</a>
                                    }
                                    @if (tenancy.CanWrite)
                                    {
                                        <button type="button" class="btn btn-sm rh-btn-subtle" data-bs-toggle="modal" data-bs-target="#editTenancyMemberModal-@member.Id">@T["Edit"]</button>
                                        <form method="post" asp-action="RemoveMember" data-confirm-modal="true" data-confirm-title="@T["Remove this tenancy member?"]" data-confirm-message="@T["This will remove the member from this tenancy and revoke their access to this tenancy workspace. Existing rent periods, payments, and generated receipts will stay in the system."]" data-confirm-proceed="@T["Remove member"]" data-confirm-style="danger">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                                            <input type="hidden" name="memberId" value="@member.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">@T["Remove"]</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </div>
    </section>
</section>

@if (tenancy.CanWrite)
{
    <div class="modal fade" id="terminateTenancyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered rh-action-modal-dialog">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="Terminate">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenancyId" value="@tenancy.Id" />

                    <div class="modal-header border-0 pb-0">
                        <div>
                            <h5 class="modal-title">@T["Terminate tenancy"]</h5>
                            <p class="text-muted mb-0">@T["Confirm the date and future rent handling before ending this tenancy."]</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@T["Termination date"]</label>
                            <input class="form-control rh-input" type="date" name="terminationDate" value="@today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T["Reason"]</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="reason">
                                    <option value="TenantMovedOut">@T["Tenant moved out"]</option>
                                    <option value="Eviction">@T["Eviction"]</option>
                                    <option value="AgreementEnded">@T["Agreement ended"]</option>
                                    <option value="LandlordDecision">@T["Landlord decision"]</option>
                                    <option value="TenantRequest">@T["Tenant request"]</option>
                                    <option value="Other">@T["Other"]</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@T["Future rent handling"]</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="futureRentHandling" data-future-rent-handling>
                                    <option value="CancelFutureUnpaidPeriods">@T["Cancel future unpaid periods"]</option>
                                    <option value="KeepUnpaidBalance">@T["Keep unpaid balance"]</option>
                                    <option value="WaiveSelectedPeriods">@T["Waive selected periods"]</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12" data-waive-periods hidden>
                            <div class="rh-inline-settings-note">
                                <strong>@T["Waive selected future/unpaid periods"]</strong>
                                @if (!waiveCandidates.Any())
                                {
                                    <div class="mt-2">@T["No unpaid future period is available for waiver."]</div>
                                }
                                else
                                {
                                    <div class="mt-2 d-grid gap-2">
                                        @foreach (var period in waiveCandidates)
                                        {
                                            <label>
                                                <input type="checkbox" name="waivedRentPeriodIds" value="@period.Id" />
                                                @DateLabel(period.PeriodStart) - @DateLabel(period.PeriodEnd) (@period.Amount.ToString("N0"))
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@T["Notes optional"]</label>
                            <textarea class="form-control rh-input" name="notes" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-outline-danger">@T["Terminate tenancy"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="uploadTenancyContractModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="UploadContract" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                    <input type="hidden" name="currentDocumentId" value="@contract?.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@(contract == null ? T["Upload Tenancy Contract"].Value : T["Replace Tenancy Contract"].Value)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">@T["Contract PDF"]</label>
                            <input class="form-control rh-input" type="file" name="file" accept=".pdf,application/pdf" required />
                            <small class="text-muted">@T["Only PDF files are allowed. Uploading a new file replaces the current contract."]</small>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-primary">@T["Save contract"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addTenancyMemberModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="AddMember">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenancyId" value="@tenancy.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">@T["Add Tenancy Member"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">@T["Email"]</label>
                            <input class="form-control rh-input" name="Email" type="email" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@T["Full name"]</label>
                            <input class="form-control rh-input" name="FullName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T["Country code"]</label>
                            <input class="form-control rh-input" name="CountryCode" inputmode="numeric" placeholder="e.g. +237" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T["Phone number"]</label>
                            <input class="form-control rh-input" name="PhoneNumber" inputmode="numeric" placeholder="e.g. REMOVED_PRIVATE_VALUE" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T["WhatsApp number"]</label>
                            <input class="form-control rh-input" name="WhatsAppPhoneNumber" inputmode="numeric" placeholder="@T["Optional"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T["Role"]</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="Role">
                                    <option value="MainTenant">@T["MainTenant"]</option>
                                    <option value="CoTenant">@T["CoTenant"]</option>
                                    <option value="Children">@T["Children"]</option>
                                    <option value="Visitor">@T["Visitor"]</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn rh-btn-primary">@T["Add member"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @foreach (var member in members)
    {
        <div class="modal fade" id="editTenancyMemberModal-@member.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rh-modal-content">
                    <form method="post" asp-action="UpdateMemberRole">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tenancyId" value="@tenancy.Id" />
                        <input type="hidden" name="memberId" value="@member.Id" />

                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title">@T["Edit Tenancy Member"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                        </div>

                        <div class="modal-body row g-3">
                            <div class="col-12">
                                <div class="rh-inline-settings-note">
                                    <strong>@member.FullName</strong>
                                    <div class="mt-2">@T["Set the tenancy role for this member."]</div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">@T["Role"]</label>
                                <div class="rh-select-wrap">
                                    <select class="form-select rh-input rh-select" name="Role">
                                        <option value="MainTenant" selected="@(string.Equals(member.Role, TenancyMemberRoleEnum.MainTenant.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["MainTenant"]</option>
                                        <option value="CoTenant" selected="@(string.Equals(member.Role, TenancyMemberRoleEnum.CoTenant.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["CoTenant"]</option>
                                        <option value="Children" selected="@(string.Equals(member.Role, TenancyMemberRoleEnum.Children.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["Children"]</option>
                                        <option value="Visitor" selected="@(string.Equals(member.Role, TenancyMemberRoleEnum.Visitor.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T["Visitor"]</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">@T["Cancel"]</button>
                            <button type="submit" class="btn rh-btn-primary">@T["Save member"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        (() => {
            const select = document.querySelector("[data-future-rent-handling]");
            const waive = document.querySelector("[data-waive-periods]");
            if (!select || !waive) return;

            const sync = () => {
                waive.hidden = select.value !== "WaiveSelectedPeriods";
            };

            select.addEventListener("change", sync);
            sync();
        })();
    </script>
}
