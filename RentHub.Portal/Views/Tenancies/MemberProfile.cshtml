@model RentHub.Portal.ViewModels.Tenancies.TenancyMemberProfileVm
@using Common.Enums
@using Common.Helpers
@{
    ViewData["Title"] = "Tenant Profile";

    var tenancy = Model.Tenancy;
    var member = Model.Member;
    var nextPayable = Model.NextPayablePeriod;

    string DateLabel(DateTimeOffset value) => value.LocalDateTime.ToString("dd MMM yyyy");
    string TextOrFallback(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    string StatusClass(RentPeriodStatusEnum status) => status switch
    {
        RentPeriodStatusEnum.Paid or RentPeriodStatusEnum.PaidBeforeRentHub or RentPeriodStatusEnum.PaidInAdvance => "rh-chip-primary",
        RentPeriodStatusEnum.Due or RentPeriodStatusEnum.Overdue => "rh-chip-warning",
        RentPeriodStatusEnum.PendingPayment => "rh-chip-info",
        RentPeriodStatusEnum.Waived or RentPeriodStatusEnum.Cancelled => "rh-chip-info",
        _ => "rh-chip-info"
    };
}

<section class="rh-overview-shell rh-tenancy-shell">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-action="Overview" asp-route-id="@tenancy.Id">&#8592; Back to tenancy overview</a>
            <p class="rh-kicker">Tenant Profile</p>
            <h1 class="rh-heading-title">@TextOrFallback(member.FullName, "Unnamed tenant")</h1>
            <p class="rh-heading-subtitle">@tenancy.PropertyName - @tenancy.ApartmentName</p>
            <div class="rh-overview-badges">
                <span class="rh-chip rh-chip-info">@member.Role</span>
                <span class="rh-chip @(member.EmailConfirmed ? "rh-chip-primary" : "rh-chip-warning")">
                    @(member.EmailConfirmed ? "Email confirmed" : "Email activation pending")
                </span>
                <span class="rh-chip rh-chip-info">@Model.PaidPeriods / @Model.TotalPeriods rent period(s) complete</span>
            </div>
        </div>
        <div class="rh-overview-hero-actions">
            @if (User.IsInRole("Admin") || User.IsInRole("Landlord") || User.IsInRole("Manager"))
            {
                <a class="btn rh-btn-primary" asp-controller="AdminUsers" asp-action="Overview" asp-route-userId="@member.MemberId">User overview</a>
            }
            <a class="btn rh-btn-subtle" asp-action="Overview" asp-route-id="@tenancy.Id">Tenancy Workspace</a>
        </div>
    </section>

    <section class="rh-apartment-commanddeck rh-panel rh-panel-elevated">
        <div class="rh-overview-panel-head">
            <div>
                <h2 class="rh-dashboard-panel-title">Tenant overview</h2>
                <p class="rh-dashboard-panel-copy">Contact, activation, and rent progress for this tenancy member.</p>
            </div>
            <div class="rh-dashboard-range-chip">Live member view</div>
        </div>

        <div class="rh-apartment-commanddeck-grid">
            <div class="rh-overview-bigstat">
                <span>Email</span>
                <strong>@TextOrFallback(member.Email, "No email")</strong>
                <small>@(member.EmailConfirmed ? "Activated account" : "Waiting for activation")</small>
            </div>
            <div class="rh-overview-bigstat alt">
                <span>Outstanding</span>
                <strong>@Model.OutstandingBalance.ToString("N0")</strong>
                <small>Open rent balance</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>Progress</span>
                <strong>@Model.ProgressPercent%</strong>
                <small>@Model.PaidPeriods of @Model.TotalPeriods periods complete</small>
            </div>
            <div class="rh-apartment-stat-card rh-card-spotlight">
                <span>Next payable</span>
                <strong>@(nextPayable == null ? "None" : DateLabel(nextPayable.PeriodStart))</strong>
                <small>@(nextPayable == null ? "No unlocked rent period" : $"{DateLabel(nextPayable.PeriodStart)} - {DateLabel(nextPayable.PeriodEnd)}")</small>
            </div>
        </div>

        <div class="rh-admin-progress-bar mt-3" aria-label="Rent payment progress">
            <span style="width: @Model.ProgressPercent%"></span>
        </div>
    </section>

    <section class="rh-overview-workgrid rh-apartment-workgrid">
        <div class="rh-overview-maincolumn">
            <article class="rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Rent periods</h2>
                        <p class="rh-dashboard-panel-copy">Payment status for every generated period in this tenancy.</p>
                    </div>
                </div>

                <div class="table-responsive rh-responsive-table-wrap">
                    <table class="table align-middle rh-responsive-data-table">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>Due date</th>
                                <th class="text-end">Amount</th>
                                <th>Status</th>
                                <th>Receipt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var period in Model.RentPeriods)
                            {
                                <tr>
                                    <td class="rh-mobile-card-title" data-label="Period">@DateLabel(period.PeriodStart) - @DateLabel(period.PeriodEnd)</td>
                                    <td data-label="Due date">@DateLabel(period.DueDate)</td>
                                    <td class="text-end" data-label="Amount">@period.Amount.ToString("N0")</td>
                                    <td data-label="Status"><span class="rh-chip @StatusClass(period.Status)">@period.StatusLabel</span></td>
                                    <td data-label="Receipt">
                                        @if (period.PaymentId.HasValue && !User.IsInRole("Admin"))
                                        {
                                            <a class="btn btn-sm rh-btn-subtle" asp-controller="Receipts" asp-action="Payment" asp-route-paymentId="@period.PaymentId.Value">View</a>
                                        }
                                        else if (period.PaymentId.HasValue)
                                        {
                                            <span class="text-muted">Restricted</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No receipt</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

        <div class="rh-overview-sidecolumn rh-overview-sidecolumn-priority">
            <article class="rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Contact</h2>
                        <p class="rh-dashboard-panel-copy">Stored contact details for reminders and tenancy communication.</p>
                    </div>
                </div>

                <div class="rh-member-profile-list">
                    <div>
                        <span>Country code</span>
                        <strong>@TextOrFallback(member.CountryCode, "Not provided")</strong>
                    </div>
                    <div>
                        <span>Phone</span>
                        <strong>@TextOrFallback(member.PhoneNumber, "Not provided")</strong>
                    </div>
                    <div>
                        <span>WhatsApp</span>
                        <strong>@TextOrFallback(member.WhatsAppPhoneNumber, "Not provided")</strong>
                        <small>@(member.WhatsAppPhoneVerified ? "Verified" : "Not verified yet")</small>
                    </div>
                    <div>
                        <span>Added to tenancy</span>
                        <strong>@DateLabel(member.CreatedAt)</strong>
                    </div>
                </div>
            </article>
        </div>
    </section>
</section>
