@model RentHub.Portal.ViewModels.AdminUsers.AdminLandlordsIndexVm
@using Common.CommunicationModels
@using Common.Enums
@{
    ViewData["Title"] = "Landlord Validation";
}

<section class="rh-page-header rh-page-header-elevated">
    <div>
        <p class="rh-kicker">Admin Workspace</p>
        <h1 class="rh-heading-title">Landlord Validation Monitor</h1>
        <p class="rh-heading-subtitle">Review landlord onboarding, KYC, payout setup, and Stripe Connect readiness from one place.</p>
    </div>
    <div class="rh-toolbar">
        <a asp-action="LandlordApprovals" class="btn rh-btn-primary">KYC Approval Queue</a>
    </div>
</section>

<section class="rh-panel rh-panel-elevated mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-9">
            <label class="form-label rh-auth-label" for="search">Search</label>
            <input id="search" name="search" class="form-control rh-input" value="@Model.Search" placeholder="Email, name, or phone number" />
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn rh-btn-primary">Apply Filter</button>
        </div>
    </form>
</section>

<section class="rh-panel rh-panel-elevated">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="rh-section-title mb-0">Landlords</h2>
        <small class="text-muted">Showing up to 100 records</small>
    </div>

    @if (!Model.Landlords.Any())
    {
        <div class="rh-empty">No landlords match this filter.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle rh-table mb-0">
                <thead>
                    <tr>
                        <th>Landlord</th>
                        <th>Country</th>
                        <th>Status</th>
                        <th>KYC</th>
                        <th>Contract</th>
                        <th>Phone</th>
                        <th>Stripe payout</th>
                        <th>Stripe concluded</th>
                        <th>Mobile money</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var landlord in Model.Landlords)
                    {
                        var stripeDisabledReason = FriendlyStripeMessage(landlord.StripePayoutDisabledReason);
                        var stripeRequirementsSummary = FriendlyStripeMessage(landlord.StripePayoutRequirementsSummary);
                        <tr>
                            <td>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(landlord.FullName) ? "N/A" : landlord.FullName)</div>
                                <small class="text-muted">@landlord.Email</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@CountryLabel(landlord)</div>
                                <small class="text-muted">@(!string.IsNullOrWhiteSpace(landlord.CountryCode) ? landlord.CountryCode : "No dialing code")</small>
                            </td>
                            <td>
                                <span class="rh-chip @(landlord.IsOnboardingComplete ? "rh-chip-success" : "rh-chip-warning")">
                                    @(landlord.IsOnboardingComplete ? "Complete" : landlord.NextOnboardingStep)
                                </span>
                            </td>
                            <td>
                                <span class="rh-chip @KycChipClass(landlord.KycStatus)">@landlord.KycStatus</span>
                                @if (landlord.KycReviewedAt.HasValue)
                                {
                                    <small class="d-block text-muted">@FormatDate(landlord.KycReviewedAt)</small>
                                }
                            </td>
                            <td>
                                <span class="rh-chip @(landlord.PlatformTermsAccepted ? "rh-chip-success" : "rh-chip-warning")">
                                    @(landlord.PlatformTermsAccepted ? "Signed" : "Pending")
                                </span>
                            </td>
                            <td>
                                <div>@(string.IsNullOrWhiteSpace(landlord.PhoneNumber) ? "Not provided" : landlord.PhoneNumber)</div>
                                @StatusChip(landlord.PhoneNumberConfirmed)
                            </td>
                            <td>
                                <span class="rh-chip @StripeChipClass(landlord)">
                                    @StripeStatusLabel(landlord)
                                </span>
                                @if (!string.IsNullOrWhiteSpace(stripeDisabledReason))
                                {
                                    <small class="d-block text-danger">Payouts waiting: @stripeDisabledReason</small>
                                }
                                else if (!string.IsNullOrWhiteSpace(stripeRequirementsSummary))
                                {
                                    <small class="d-block text-muted">@stripeRequirementsSummary</small>
                                }
                            </td>
                            <td>
                                <div>@(landlord.StripePayoutSetupComplete ? "Completed" : "Not completed")</div>
                                <small class="text-muted">@FormatDate(landlord.StripePayoutSetupCompletedAt ?? landlord.StripePayoutStatusUpdatedAt)</small>
                            </td>
                            <td>
                                <div>@MobileMoneySummary(landlord)</div>
                                <small class="text-muted">@WhatsAppSummary(landlord)</small>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Overview" asp-route-userId="@landlord.UserId" class="btn btn-sm rh-btn-subtle">Overview</a>
                                    <form asp-action="RestartValidation" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@landlord.UserId" />
                                        <input type="hidden" name="search" value="@Model.Search" />
                                        <input type="hidden" name="returnTo" value="landlords" />
                                        <button type="submit" class="btn btn-sm rh-btn-outline-danger" data-confirm="Restart validation for @landlord.Email? This keeps only email and name.">
                                            Restart
                                        </button>
                                    </form>
                                    @if (Model.CanDeleteUsers)
                                    {
                                        <form asp-action="DeleteUser"
                                              method="post"
                                              class="d-inline"
                                              data-delete-user-form="true"
                                              data-confirm-modal="true"
                                              data-confirm-title="Delete landlord"
                                              data-confirm-message="Delete @landlord.Email and all records related to this landlord? This cannot be undone."
                                              data-confirm-proceed="Delete"
                                              data-confirm-style="danger">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@landlord.UserId" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="returnTo" value="landlords" />
                                            <button type="submit" class="btn btn-sm rh-btn-outline-danger" data-delete-submit="true">
                                                <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true" data-delete-spinner="true"></span>
                                                <span data-delete-label="true">Delete</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@functions {
    private static string CountryLabel(AdminUserVerificationStatusDto landlord)
    {
        return string.IsNullOrWhiteSpace(landlord.CountryIsoCode)
            ? "Not selected"
            : landlord.CountryIsoCode;
    }

    private static string FormatDate(DateTimeOffset? value)
    {
        return value.HasValue ? value.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt") : "No date";
    }

    private static string MobileMoneySummary(AdminUserVerificationStatusDto landlord)
    {
        if (!string.Equals(landlord.CountryIsoCode, "CM", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(landlord.CountryCode, "+237", StringComparison.Ordinal))
        {
            return "Not required";
        }

        var subscription = string.IsNullOrWhiteSpace(landlord.SubscriptionPaymentPhoneNumber)
            ? "Subscription not configured"
            : $"Subscription {landlord.SubscriptionPaymentPhoneNumber}";

        var payout = string.IsNullOrWhiteSpace(landlord.PayoutPhoneNumber)
            ? "Payout not configured"
            : $"Payout {landlord.PayoutPhoneNumber}";

        return $"{subscription}; {payout}";
    }

    private static string WhatsAppSummary(AdminUserVerificationStatusDto landlord)
    {
        return string.IsNullOrWhiteSpace(landlord.WhatsAppPhoneNumber)
            ? "WhatsApp not configured"
            : $"WhatsApp {landlord.WhatsAppPhoneNumber}";
    }

    private static string StripeStatusLabel(AdminUserVerificationStatusDto landlord)
    {
        if (landlord.StripePayoutSetupComplete)
        {
            return "Ready";
        }

        if (!string.IsNullOrWhiteSpace(landlord.StripePayoutDisabledReason) ||
            !string.IsNullOrWhiteSpace(landlord.StripePayoutRequirementsSummary))
        {
            return "Action needed";
        }

        if (landlord.HasStripePayoutAccount)
        {
            return landlord.StripePayoutDetailsSubmitted ? "Waiting" : "Needs details";
        }

        return "Not started";
    }

    private static string StripeChipClass(AdminUserVerificationStatusDto landlord)
    {
        if (landlord.StripePayoutSetupComplete)
        {
            return "rh-chip-success";
        }

        return landlord.HasStripePayoutAccount ? "rh-chip-warning" : "rh-chip-info";
    }

    private static Microsoft.AspNetCore.Html.IHtmlContent StatusChip(bool ok)
    {
        var label = ok ? "Verified" : "Pending";
        var css = ok ? "rh-chip-success" : "rh-chip-warning";
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"rh-chip {css}\">{label}</span>");
    }

    private static string KycChipClass(LandlordKycStatusEnum status)
    {
        return status switch
        {
            LandlordKycStatusEnum.Approved => "rh-chip-success",
            LandlordKycStatusEnum.Rejected => "rh-chip-danger",
            LandlordKycStatusEnum.Submitted => "rh-chip-warning",
            _ => "rh-chip-info"
        };
    }

    private static string FriendlyStripeMessage(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value
            .Replace("requirements.past_due", "Stripe needs overdue verification details before payouts can be enabled", StringComparison.OrdinalIgnoreCase)
            .Replace("requirements.pending_verification", "Stripe is reviewing the submitted payout account details", StringComparison.OrdinalIgnoreCase)
            .Replace("individual.verification.proof_of_liveness", "complete the Stripe identity/liveness check", StringComparison.OrdinalIgnoreCase)
            .Replace("individual.verification.document", "upload an identity document", StringComparison.OrdinalIgnoreCase)
            .Replace("individual.verification.additional_document", "upload an additional identity document", StringComparison.OrdinalIgnoreCase)
            .Replace("Missing now:", "Action needed now:", StringComparison.OrdinalIgnoreCase)
            .Replace("Past due:", "Overdue:", StringComparison.OrdinalIgnoreCase)
            .Replace("Pending verification:", "Pending review:", StringComparison.OrdinalIgnoreCase);
    }
}

@section Scripts {
    <script>
        (() => {
            document.querySelectorAll("[data-confirm]").forEach(button => {
                button.addEventListener("click", event => {
                    if (!window.confirm(button.dataset.confirm)) {
                        event.preventDefault();
                    }
                });
            });

            document.addEventListener("submit", event => {
                const form = event.target.closest("form[data-delete-user-form='true']");
                if (!form || event.defaultPrevented) {
                    return;
                }

                const button = form.querySelector("[data-delete-submit='true']");
                if (!button) {
                    return;
                }

                button.disabled = true;
                button.querySelector("[data-delete-spinner='true']")?.classList.remove("d-none");
                const label = button.querySelector("[data-delete-label='true']");
                if (label) {
                    label.textContent = "Deleting";
                }
            });
        })();
    </script>
}
