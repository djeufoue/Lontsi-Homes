@using System
@using System.Linq
@using Common.Enums
@model RentHub.Portal.ViewModels.Properties.PropertyIndexVm
@{
    ViewData["Title"] = "Properties";
    var allowScopeSelection = string.Equals(Model.UserRole, "Manager", StringComparison.OrdinalIgnoreCase) || Model.CreationScopes.Count > 1;
    var firstScope = Model.CreationScopes.FirstOrDefault(s => s.CanCreate);
}

<div class="rh-properties-page">
    <section class="rh-properties-hero">
        <div class="rh-properties-overview-head">
            <div>
                <p class="rh-kicker rh-kicker-ghost">Portfolio operations</p>
                <h1 class="rh-heading-title rh-properties-overview-title">Properties overview</h1>
            </div>
        </div>

        <div class="rh-properties-overview-grid">
            <article class="rh-properties-stat-card">
                <span>Total Properties</span>
                <strong>@Model.TotalCount</strong>
                <small>Across your accessible scope</small>
            </article>

            <article class="rh-properties-stat-card">
                <span>Current Role</span>
                <strong>@Model.UserRole</strong>
                <small>Role-based visibility enabled</small>
            </article>

            <article class="rh-properties-stat-card">
                <span>Create Access</span>
                <strong>@(Model.CanCreateProperty ? "Enabled" : "Restricted")</strong>
                <small>Subscription and rights controlled</small>
            </article>
        </div>
    </section>

    <section class="rh-properties-filter-shell">
        <div class="rh-properties-filter-head">
            <div>
                <p class="rh-kicker rh-kicker-ghost mb-1">Smart filters</p>
                <h2 class="rh-section-title mb-0">Refine your portfolio table</h2>
            </div>
            <small>Filter by search, city, access scope, and page size.</small>
        </div>

        <form method="get" asp-action="Index" class="rh-properties-filter-grid">
            <div class="rh-properties-filter-field rh-properties-filter-field-wide">
                <label class="form-label mb-1">Search</label>
                <input class="form-control rh-input" type="text" name="search" value="@Model.Search" placeholder="Name, address, landlord, or city" />
            </div>

            <div class="rh-properties-filter-field">
                <label class="form-label mb-1">City</label>
                <input class="form-control rh-input" type="text" name="city" value="@Model.City" placeholder="Filter by city" />
            </div>

            <div class="rh-properties-filter-field">
                <label class="form-label mb-1">Access Scope</label>
                <div class="rh-select-wrap">
                    <select class="form-select rh-input rh-select" name="access">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Access) ? "selected" : null)">All access</option>
                        <option value="owned" selected="@(Model.Access == "owned" ? "selected" : null)">Owned</option>
                        <option value="managed" selected="@(Model.Access == "managed" ? "selected" : null)">Managed</option>
                        <option value="owner" selected="@(Model.Access == "owner" ? "selected" : null)">Owner</option>
                        <option value="tenant" selected="@(Model.Access == "tenant" ? "selected" : null)">Tenant</option>
                    </select>
                </div>
            </div>

            <div class="rh-properties-filter-field">
                <label class="form-label mb-1">Page Size</label>
                <div class="rh-select-wrap">
                    <select class="form-select rh-input rh-select" name="pageSize">
                        <option value="6" selected="@(Model.PageSize == 6 ? "selected" : null)">6 rows</option>
                        <option value="12" selected="@(Model.PageSize == 12 ? "selected" : null)">12 rows</option>
                        <option value="24" selected="@(Model.PageSize == 24 ? "selected" : null)">24 rows</option>
                    </select>
                </div>
            </div>

            <input type="hidden" name="page" value="1" />

            <div class="rh-properties-filter-actions">
                <button type="submit" class="btn rh-btn-primary">Apply Filters</button>
            </div>
        </form>
    </section>

    <section id="propertyGridHost" class="rh-results-host rh-properties-results-host">
        @await Html.PartialAsync("_PropertyGrid", Model)
    </section>

    @if (Model.CreationScopes.Any())
    {
        <section class="rh-properties-scope-shell">
            <div class="rh-properties-filter-head">
                <div>
                    <p class="rh-kicker rh-kicker-ghost mb-1">Scope controls</p>
                    <h2 class="rh-section-title mb-0">Creation scope and limits</h2>
                </div>
                <small>Plan limits and approval state for each landlord scope.</small>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 rh-table rh-smart-meta-table">
                    <thead>
                        <tr>
                            <th>Landlord</th>
                            <th>Current</th>
                            <th>Limit</th>
                            <th>Subscription</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var scope in Model.CreationScopes)
                        {
                            <tr>
                                <td>@scope.LandlordName</td>
                                <td>@scope.CurrentProperties</td>
                                <td>@(scope.MaxProperties.HasValue ? scope.MaxProperties.Value : "Unlimited")</td>
                                <td>@(scope.SubscriptionApproved ? "Approved" : "Pending/Inactive")</td>
                                <td>@scope.StatusMessage</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@if (Model.CanCreateProperty)
{
    <div class="modal fade" id="createPropertyModal" tabindex="-1" aria-labelledby="createPropertyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="Create">
                    @Html.AntiForgeryToken()

                    <div class="modal-header border-0 pb-0">
                        <div>
                            <h5 class="modal-title" id="createPropertyModalLabel">Add New Property</h5>
                            <small class="text-muted">Create a property within an allowed scope.</small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" name="returnSearch" value="@Model.Search" />
                        <input type="hidden" name="returnCity" value="@Model.City" />
                        <input type="hidden" name="returnAccess" value="@Model.Access" />
                        <input type="hidden" name="returnPage" value="@Model.Page" />
                        <input type="hidden" name="returnPageSize" value="@Model.PageSize" />

                        <div class="row g-3">
                            @if (allowScopeSelection)
                            {
                                <div class="col-12">
                                    <label class="form-label">Create For Landlord</label>
                                    <div class="rh-select-wrap">
                                        <select class="form-select rh-input rh-select" name="LandlordId" required>
                                            @foreach (var scope in Model.CreationScopes)
                                            {
                                                <option value="@scope.LandlordId" disabled="@(scope.CanCreate ? null : "disabled")">
                                                    @scope.LandlordName (@scope.StatusMessage)
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }
                            else if (firstScope != null)
                            {
                                <input type="hidden" name="LandlordId" value="@firstScope.LandlordId" />
                            }

                            <div class="col-md-6">
                                <label class="form-label">Property Name</label>
                                <input class="form-control rh-input" name="Name" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <input class="form-control rh-input" name="City" required />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Address</label>
                                <input class="form-control rh-input" name="Address" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Latitude (Optional)</label>
                                <input class="form-control rh-input" name="Latitude" type="number" step="0.000001" min="-90" max="90" placeholder="e.g. 4.051056" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Longitude (Optional)</label>
                                <input class="form-control rh-input" name="Longitude" type="number" step="0.000001" min="-180" max="180" placeholder="e.g. 9.767868" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Description (Optional)</label>
                                <textarea class="form-control rh-input" name="Description" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Create Property</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
else if (Model.RequiresSubscriptionCheckout)
{
    <div class="modal fade" id="subscriptionRequiredModal" tabindex="-1" aria-labelledby="subscriptionRequiredModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title" id="subscriptionRequiredModalLabel">Choose a subscription before adding properties</h5>
                        <small class="text-muted">Pay with MTN Money, Orange Money Cameroon, or Visa through Notch Pay.</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="rh-profile-plan-grid">
                        @foreach (var plan in Model.AvailablePlans)
                        {
                            <article class="rh-profile-plan-card">
                                <div class="rh-admin-plan-head">
                                    <h3>@plan.Name</h3>
                                    <span class="rh-chip rh-chip-info">@plan.DurationInDays days</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(plan.Description))
                                {
                                    <p class="text-muted mb-2">@plan.Description</p>
                                }

                                <p class="rh-profile-plan-price">@plan.Price.ToString("N0") XAF</p>

                                <ul class="rh-profile-plan-meta">
                                    <li>Max properties: @(plan.MaxProperties.HasValue ? plan.MaxProperties.Value.ToString() : "Unlimited")</li>
                                    <li>Max apartments/property: @(plan.MaxApartmentsPerProperty.HasValue ? plan.MaxApartmentsPerProperty.Value.ToString() : "Unlimited")</li>
                                </ul>

                                <form asp-controller="Profile" asp-action="StartCheckout" method="post" class="mt-3 rh-subscription-form" data-subscription-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="planId" value="@plan.Id" />

                                    <label class="form-label mb-1">Payment method</label>
                                    <div class="rh-select-wrap mb-2">
                                        <select class="form-select rh-input rh-select" name="paymentMethod" data-payment-method>
                                            <option value="@PaymentMethodEnum.Momo">MTN Money</option>
                                            <option value="@PaymentMethodEnum.OrangeMoney">Orange Money</option>
                                            <option value="@PaymentMethodEnum.Card">Visa</option>
                                        </select>
                                    </div>

                                    <div class="rh-form-switch-row mb-3" data-card-consent hidden>
                                        <div class="form-check rh-form-switch">
                                            <input class="form-check-input" type="checkbox" name="allowAutomaticCardPayments" value="true" id="propertyCardConsent_@plan.Id" />
                                            <label class="form-check-label" for="propertyCardConsent_@plan.Id">
                                                Allow automatic Visa renewal for this subscription. Leave unchecked if you prefer to renew manually.
                                            </label>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn rh-btn-primary w-100">Continue to payment</button>
                                </form>
                            </article>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const host = document.getElementById("propertyGridHost");
            if (!host) return;

            const endpoint = '@Url.Action("ListPartial", "Properties")';
            const refreshMs = 20000;

            const loadPartial = async () => {
                const activeModal = document.querySelector(".modal.show");
                if (activeModal) {
                    return;
                }

                const params = new URLSearchParams(window.location.search);
                if (!params.has("page")) params.set("page", "@Model.Page");
                if (!params.has("pageSize")) params.set("pageSize", "@Model.PageSize");

                const url = `${endpoint}?${params.toString()}`;
                const response = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                if (!response.ok) return;

                host.innerHTML = await response.text();
            };

            const timer = window.setInterval(loadPartial, refreshMs);
            window.addEventListener("beforeunload", () => window.clearInterval(timer), { once: true });
        })();

        (() => {
            const forms = document.querySelectorAll("[data-subscription-form]");
            forms.forEach(form => {
                const methodSelect = form.querySelector("[data-payment-method]");
                const cardConsent = form.querySelector("[data-card-consent]");
                if (!methodSelect || !cardConsent) return;

                const sync = () => {
                    cardConsent.hidden = methodSelect.value !== "Card";
                };

                methodSelect.addEventListener("change", sync);
                sync();
            });
        })();
    </script>
}
