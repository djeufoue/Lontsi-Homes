@model RentHub.Portal.ViewModels.Documents.DocumentPreviewVm
@{
    ViewData["Title"] = "Document Preview";
    var previewUrl = Url.Action("DocumentContent", "Properties", new { id = Model.Document.Id, download = false }) ?? string.Empty;
    var downloadUrl = Url.Action("DocumentContent", "Properties", new { id = Model.Document.Id, download = true }) ?? string.Empty;
    var fallbackShareUrl = !string.IsNullOrWhiteSpace(downloadUrl) ? downloadUrl : previewUrl;
}

<section class="rh-document-preview-shell">
    <section class="rh-document-preview-hero rh-panel rh-panel-elevated">
        <div>
            @if (Model.TenancyId.HasValue)
            {
                <a class="rh-overview-backlink" asp-controller="Tenancies" asp-action="Overview" asp-route-id="@Model.TenancyId.Value">&#8592; Back to tenancy overview</a>
            }
            else if (Model.ApartmentId.HasValue)
            {
                <a class="rh-overview-backlink" asp-controller="Apartments" asp-action="Overview" asp-route-id="@Model.ApartmentId.Value">&#8592; Back to apartment overview</a>
            }
            else if (Model.PropertyId.HasValue)
            {
                <a class="rh-overview-backlink" asp-controller="Properties" asp-action="Overview" asp-route-id="@Model.PropertyId.Value">&#8592; Back to property overview</a>
            }
            else
            {
                <a class="rh-overview-backlink" asp-controller="Properties" asp-action="Index">&#8592; Back to properties</a>
            }
            <p class="rh-kicker">@Model.SectionLabel</p>
            <h1 class="rh-heading-title">@Model.Document.FileName</h1>
            <p class="rh-heading-subtitle">Preview, download, and share this file from one place.</p>
        </div>

        <div class="rh-document-preview-actions">
            <a class="btn rh-btn-subtle" href="@downloadUrl">Download</a>
            <button type="button" class="btn rh-btn-primary" data-share-source="@previewUrl" data-share-fallback="@fallbackShareUrl" data-share-name="@Model.Document.FileName">Share</button>
        </div>
    </section>

    <section class="rh-document-preview-grid">
        <article class="rh-document-preview-stage-card rh-panel rh-panel-elevated">
            <div class="rh-overview-panel-head align-start">
                <div>
                    <h2 class="rh-dashboard-panel-title">Preview</h2>
                    <p class="rh-dashboard-panel-copy">Open the content directly when the browser supports it.</p>
                </div>
            </div>

            <div class="rh-document-preview-stage">
                @if (Model.IsImage)
                {
                    <img src="@previewUrl" alt="@Model.Document.FileName" class="rh-document-preview-image" />
                }
                else if (Model.IsPdf)
                {
                    <object data="@previewUrl" type="application/pdf" class="rh-document-preview-frame">
                        <div class="rh-document-preview-placeholder">
                            <strong>PDF preview could not open in this browser</strong>
                            <span>Use the download button to open the file locally.</span>
                            <a class="btn rh-btn-primary" href="@downloadUrl">Download PDF</a>
                        </div>
                    </object>
                }
                else
                {
                    <div class="rh-document-preview-placeholder">
                        <strong>Preview not available in browser</strong>
                        <span>Use the download button to open this file in its native application.</span>
                        <a class="btn rh-btn-primary" href="@downloadUrl">Download file</a>
                    </div>
                }
            </div>
        </article>

        <aside class="rh-document-preview-meta rh-panel rh-panel-elevated">
            <div class="rh-overview-panel-head compact">
                <div>
                    <h2 class="rh-dashboard-panel-title">Document information</h2>
                    <p class="rh-dashboard-panel-copy">Original file details and linked workspace.</p>
                </div>
            </div>

            <div class="rh-document-meta-list">
                <div class="rh-document-meta-item">
                    <span>Original name</span>
                    <strong>@Model.Document.FileName</strong>
                </div>
                <div class="rh-document-meta-item">
                    <span>Type</span>
                    <strong>@Model.Document.DocumentType</strong>
                </div>
                <div class="rh-document-meta-item">
                    <span>Uploaded</span>
                    <strong>@Model.Document.UploadedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</strong>
                </div>
                <div class="rh-document-meta-item">
                    <span>Property</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.PropertyName) ? "Not linked" : Model.PropertyName)</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ApartmentName))
                {
                    <div class="rh-document-meta-item">
                        <span>Apartment</span>
                        <strong>@Model.ApartmentName</strong>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.TenancyName))
                {
                    <div class="rh-document-meta-item">
                        <span>Tenancy</span>
                        <strong>@Model.TenancyName</strong>
                    </div>
                }
            </div>
        </aside>
    </section>
</section>

@section Scripts {
    <script>
        (() => {
            const shareButton = document.querySelector('[data-share-source]');
            if (!shareButton) return;

            const originalLabel = shareButton.textContent;
            const sourceUrl = shareButton.getAttribute('data-share-source');
            const fallbackUrl = shareButton.getAttribute('data-share-fallback');
            const fileName = shareButton.getAttribute('data-share-name') || 'document';

            const setLabel = (label, timeout = 1600) => {
                shareButton.textContent = label;
                window.setTimeout(() => shareButton.textContent = originalLabel, timeout);
            };

            shareButton.addEventListener('click', async () => {
                if (!sourceUrl) return;

                try {
                    const response = await fetch(sourceUrl, { credentials: 'same-origin' });
                    if (!response.ok) {
                        throw new Error('preview-fetch-failed');
                    }

                    const blob = await response.blob();
                    const file = new File([blob], fileName, { type: blob.type || 'application/octet-stream' });

                    if (navigator.canShare && navigator.canShare({ files: [file] })) {
                        await navigator.share({ files: [file], title: fileName });
                        setLabel('Shared');
                        return;
                    }

                    if (navigator.share && fallbackUrl) {
                        await navigator.share({ title: fileName, url: fallbackUrl });
                        setLabel('Link shared');
                        return;
                    }

                    if (navigator.clipboard && fallbackUrl) {
                        await navigator.clipboard.writeText(fallbackUrl);
                        setLabel('Link copied');
                        return;
                    }

                    throw new Error('share-not-supported');
                } catch {
                    setLabel('Share unavailable');
                }
            });
        })();
    </script>
}
