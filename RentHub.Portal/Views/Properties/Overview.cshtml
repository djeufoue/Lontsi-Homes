@model RentHub.Portal.ViewModels.Properties.PropertyOverviewVm
@using Common.Enums
@using System
@using System.Linq
@{
    ViewData["Title"] = "Property Overview";

    var property = Model.Property;
    var totalPages = Model.UnitsPageSize <= 0 ? 1 : (int)Math.Ceiling((double)Model.TotalUnits / Model.UnitsPageSize);
    var nextUnitsPage = Model.UnitsPage + 1;
    var allUnits = property.Apartments?.ToList() ?? new List<Common.CommunicationModels.ApartmentDto>();
    var activeStatuses = new[] { "occupied", "rented", "active" };
    var occupiedUnits = allUnits.Count(unit => activeStatuses.Contains((unit.Status ?? string.Empty).Trim().ToLowerInvariant()));
    var availableUnits = Math.Max(0, Model.TotalUnits - occupiedUnits);
    var averageRent = allUnits.Any() ? allUnits.Average(unit => unit.Price) : 0m;
    var propertyImage = Model.Documents
        .Where(doc => doc.DocumentType == DocumentTypeEnum.PropertyImage)
        .OrderByDescending(doc => doc.UploadedAt)
        .FirstOrDefault();
    var propertyImageUrl = propertyImage != null ? Url.Action("DocumentContent", "Properties", new { id = propertyImage.Id }) : null;
    var propertyDocuments = Model.Documents
        .Where(doc => doc.DocumentType != DocumentTypeEnum.PropertyImage)
        .OrderByDescending(doc => doc.UploadedAt)
        .ToList();
    var landlordName = string.IsNullOrWhiteSpace(property.LandlordName) ? "Landlord" : property.LandlordName;
    var landlordInitial = landlordName.Trim()[0].ToString().ToUpperInvariant();
    var members = Model.FilteredManagers ?? new List<Common.CommunicationModels.PropertyManagerDto>();
}

<section class="rh-overview-shell"
         data-property-overview-root="true"
         data-property-id="@property.Id"
         data-overview-content-url="@Url.Action("OverviewContent", "Properties", new { id = property.Id })"
         data-show-close-button="true"
         data-auto-close-enabled="@(Model.SuccessDialogAutoCloseEnabled.ToString().ToLowerInvariant())"
         data-auto-close-seconds="@Model.SuccessDialogAutoCloseSeconds">
    <section class="rh-overview-hero rh-panel rh-panel-elevated">
        <div class="rh-overview-hero-copy">
            <a class="rh-overview-backlink" asp-action="Index">&#8592; Back to properties</a>
            <p class="rh-kicker">Property Command Center</p>
            <h1 class="rh-heading-title">@property.Name</h1>
            <p class="rh-heading-subtitle">@property.Address, @property.City</p>

            <div class="rh-overview-badges">
                <span class="rh-chip rh-chip-primary">@Model.TotalUnits apartments</span>
                <span class="rh-chip rh-chip-info">@(propertyDocuments.Count) documents</span>
                <span class="rh-chip @(Model.CanWrite ? "rh-chip-primary" : "rh-chip-warning")">@(Model.CanWrite ? "Write access" : "Read access")</span>
            </div>
        </div>

        <div class="rh-overview-hero-actions">
            <a class="btn rh-btn-subtle" asp-action="Map" asp-route-id="@property.Id">Open Map</a>
            <a class="btn rh-btn-primary" asp-action="Index">Property Portfolio</a>
        </div>
    </section>

    <section class="rh-overview-mastgrid">
        <article class="rh-overview-spotlight rh-panel rh-panel-elevated">
            <div class="rh-overview-panel-head">
                <div>
                    <h2 class="rh-dashboard-panel-title">Operations overview</h2>
                    <p class="rh-dashboard-panel-copy">A refined workspace for apartments, members, location, and documents.</p>
                </div>

                <div class="rh-dashboard-range-chip">Updated today</div>
            </div>

            <div class="rh-overview-spotlight-grid">
                <div class="rh-overview-bigstat">
                    <span>Occupied</span>
                    <strong>@occupiedUnits</strong>
                    <small>Actively assigned apartments</small>
                </div>
                <div class="rh-overview-bigstat alt">
                    <span>Average rent</span>
                    <strong>@averageRent.ToString("N0")</strong>
                    <small>Snapshot across apartments</small>
                </div>
            </div>

            <div class="rh-overview-profile-strip">
                <div class="rh-overview-profile-pill">
                    <span class="rh-avatar">@landlordInitial</span>
                    <div>
                        <strong>@landlordName</strong>
                        <small>Landlord</small>
                    </div>
                </div>
            </div>
        </article>

        <article class="rh-overview-sidebarcard rh-panel rh-panel-elevated">
            <div class="rh-overview-sidebarstat">
                <span>Total apartments</span>
                <strong>@Model.TotalUnits</strong>
                <small>Inventory inside this property</small>
            </div>
            <div class="rh-overview-sidebarstat">
                <span>Available now</span>
                <strong>@availableUnits</strong>
                <small>Ready for the next tenant</small>
            </div>
            <div class="rh-overview-sidebarstat">
                <span>Members</span>
                <strong>@(Model.Managers.Count + 1)</strong>
                <small>Landlord plus property team</small>
            </div>
        </article>
    </section>

    <section class="rh-overview-workgrid rh-overview-workgrid-rebalanced">
        <div class="rh-overview-maincolumn">
            <article class="rh-overview-image-card rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Property image</h2>
                        <p class="rh-dashboard-panel-copy">Landscape cover for this property. Max 2 MB.</p>
                    </div>

                    @if (Model.CanWrite)
                    {
                        <form id="propertyImageForm" method="post" asp-action="UploadPropertyDocument" enctype="multipart/form-data" class="rh-property-image-form" data-live-submit="property-overview">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="propertyId" value="@property.Id" />
                            <input type="hidden" name="type" value="@DocumentTypeEnum.PropertyImage" />
                            <input class="rh-hidden-input" id="propertyImageFile" type="file" name="file" accept="image/*" />
                            <button type="button" class="rh-icon-btn rh-image-edit-trigger" data-image-trigger="propertyImageFile" title="Replace property image" aria-label="Replace property image">
                                <span class="rh-icon-pencil"></span>
                            </button>
                            <p class="rh-inline-validation" id="propertyImageValidation" aria-live="polite"></p>
                        </form>
                    }
                </div>

                <div class="rh-property-image-frame">
                    @if (propertyImage != null && !string.IsNullOrWhiteSpace(propertyImageUrl))
                    {
                        <button type="button" class="rh-property-image-button" data-bs-toggle="modal" data-bs-target="#propertyImageLightbox" aria-label="Open property image">
                            <img src="@propertyImageUrl" alt="@property.Name property image" class="rh-property-image" />
                        </button>
                    }
                    else
                    {
                        <div class="rh-property-image-placeholder">
                            <strong>No property image yet</strong>
                            <span>Upload a landscape image so this overview feels complete.</span>
                        </div>
                    }
                </div>
            </article>

            <article class="rh-overview-map-preview rh-panel rh-panel-elevated">
                <div class="rh-overview-panel-head">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Property map</h2>
                        <p class="rh-dashboard-panel-copy">Your saved latitude and longitude now pin the property on the map.</p>
                    </div>

                    <a class="btn rh-btn-subtle btn-sm" asp-action="Map" asp-route-id="@property.Id">Open full map</a>
                </div>

                @{
                    var previewLatitude = property.Latitude ?? 4.048300;
                    var previewLongitude = property.Longitude ?? 9.704400;
                    var previewLatText = previewLatitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);
                    var previewLonText = previewLongitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);
                    var previewBbox = string.Format(
                        System.Globalization.CultureInfo.InvariantCulture,
                        "{0},{1},{2},{3}",
                        previewLongitude - 0.006,
                        previewLatitude - 0.006,
                        previewLongitude + 0.006,
                        previewLatitude + 0.006);
                    var previewMarker = string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0},{1}", previewLatitude, previewLongitude);
                    var previewEmbedUrl = $"https://www.openstreetmap.org/export/embed.html?bbox={Uri.EscapeDataString(previewBbox)}&layer=mapnik&marker={Uri.EscapeDataString(previewMarker)}";
                }

                <div class="rh-map-preview-stage rh-map-preview-stage-real">
                    <iframe
                        class="rh-map-iframe"
                        src="@previewEmbedUrl"
                        title="@property.Name location preview"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                    <div class="rh-map-preview-card">
                        <small>@property.City</small>
                        <strong>@property.Name</strong>
                        <span>@property.Address</span>
                        <em class="rh-map-preview-coordinates">@previewLatText, @previewLonText</em>
                    </div>
                </div>
            </article>

            <article class="rh-overview-docs-card rh-panel rh-panel-elevated rh-overview-docs-compact">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Property documents</h2>
                        <p class="rh-dashboard-panel-copy">Rules, guides, and reference files linked to this property.</p>
                    </div>

                    @if (Model.CanWrite)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addPropertyDocumentModal">Add+</button>
                    }
                </div>
                @if (!propertyDocuments.Any())
                {
                    <div class="rh-empty">No property documents uploaded yet.</div>
                }
                else
                {
                    <div class="rh-document-list rh-document-list-compact">
                        @foreach (var doc in propertyDocuments.Take(5))
                        {
                            <article class="rh-document-item rh-document-item-previewable rh-card-spotlight">
                                <div class="rh-document-item-copy">
                                    <a asp-action="DocumentPreview" asp-route-id="@doc.Id" class="rh-document-title-link">@doc.FileName</a>
                                    <small>@doc.DocumentType • @doc.UploadedAt.LocalDateTime.ToString("dd MMM yyyy")</small>
                                </div>

                                <div class="rh-document-actions">
                                    <a class="btn btn-sm rh-btn-subtle" asp-action="DocumentPreview" asp-route-id="@doc.Id">Preview</a>
                                    @if (Model.CanWrite)
                                    {
                                        <form method="post" asp-action="DeleteDocument" class="d-inline" data-live-submit="property-overview" data-confirm-modal="true" data-confirm-title="Delete document?" data-confirm-message="This document will be removed from this property." data-confirm-proceed="Delete document">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="propertyId" value="@property.Id" />
                                            <input type="hidden" name="documentId" value="@doc.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">Delete</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </div>

        <div class="rh-overview-sidecolumn rh-overview-sidecolumn-priority">
            <article class="rh-overview-units-card rh-panel rh-panel-elevated" data-property-section="apartments">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Apartments</h2>
                        <p class="rh-dashboard-panel-copy">Manage the apartments in this property.</p>
                    </div>

                    <div class="rh-overview-inline-actions">
                        <div class="rh-overview-inline-stats">
                            <span>@Model.TotalUnits total</span>
                            <span>@availableUnits available</span>
                        </div>
                        @if (Model.CanWrite)
                        {
                            <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addApartmentModal">Add+</button>
                        }
                    </div>
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="apartments">
                    <input type="hidden" name="id" value="@property.Id" />
                    <input type="hidden" name="memberSearch" value="@Model.MemberSearch" />
                    <input type="hidden" name="unitsPage" value="1" />
                    <input type="hidden" name="unitsPageSize" value="@Model.UnitsPageSize" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input js-auto-submit" type="text" name="apartmentSearch" value="@Model.ApartmentSearch" placeholder="Search apartments by name, type, or status" autocomplete="off" />
                    </div>
                </form>

                @if (!Model.Units.Any())
                {
                    <div class="rh-empty">No apartments found for this property.</div>
                }
                else
                {
                    <div class="rh-unit-card-grid rh-unit-card-grid-compact">
                        @foreach (var unit in Model.Units)
                        {
                            <a class="rh-unit-card rh-unit-card-link rh-card-spotlight" asp-controller="Apartments" asp-action="Overview" asp-route-id="@unit.Id">
                                <div class="rh-unit-card-head">
                                    <div>
                                        <h3>@unit.Name</h3>
                                        <small>@unit.Type</small>
                                    </div>
                                    <span class="rh-chip @(((unit.Status ?? string.Empty).Contains("available", StringComparison.OrdinalIgnoreCase)) ? "rh-chip-primary" : "rh-chip-info")">@unit.Status</span>
                                </div>

                                <div class="rh-unit-card-meta">
                                    <span>Area <strong>@unit.Area.ToString("N0") sqm</strong></span>
                                    <span>Rent <strong>@unit.Price.ToString("N0")</strong></span>
                                </div>
                            </a>
                        }
                    </div>
                }

                <div class="rh-overview-footerline">
                    <small class="text-muted">Page @Model.UnitsPage / @totalPages</small>
                    @if (nextUnitsPage <= totalPages)
                    {
                        <a class="btn btn-sm rh-btn-subtle" asp-action="Overview" asp-route-id="@property.Id" asp-route-apartmentSearch="@Model.ApartmentSearch" asp-route-memberSearch="@Model.MemberSearch" asp-route-unitsPage="@nextUnitsPage" asp-route-unitsPageSize="@Model.UnitsPageSize">See More</a>
                    }
                </div>
            </article>

            <article class="rh-overview-members-card rh-panel rh-panel-elevated" data-property-section="members">
                <div class="rh-overview-panel-head align-start">
                    <div>
                        <h2 class="rh-dashboard-panel-title">Property members</h2>
                        <p class="rh-dashboard-panel-copy">Landlord and managers assigned to this property.</p>
                    </div>

                    @if (Model.CanWrite)
                    {
                        <button type="button" class="btn btn-sm rh-btn-primary" data-bs-toggle="modal" data-bs-target="#addMemberModal">Add+</button>
                    }
                </div>

                <form method="get" asp-action="Overview" class="rh-overview-searchbar rh-auto-search-form" data-section-search="members">
                    <input type="hidden" name="id" value="@property.Id" />
                    <input type="hidden" name="apartmentSearch" value="@Model.ApartmentSearch" />
                    <input type="hidden" name="unitsPage" value="@Model.UnitsPage" />
                    <input type="hidden" name="unitsPageSize" value="@Model.UnitsPageSize" />
                    <div class="rh-search-input-wrap">
                        <span class="rh-search-icon"></span>
                        <input class="form-control rh-input js-auto-submit" type="text" name="memberSearch" value="@Model.MemberSearch" placeholder="Search members by name or access" autocomplete="off" />
                    </div>
                </form>

                <div class="rh-member-stack">
                    <article class="rh-member-card rh-card-spotlight is-landlord">
                        <div class="rh-member-card-copy">
                            <strong>@landlordName</strong>
                            <small>Landlord</small>
                        </div>
                        <span class="rh-chip rh-chip-primary">ReadWrite</span>
                    </article>
                    @if (!members.Any())
                    {
                        <div class="rh-empty">No additional members assigned yet.</div>
                    }
                    else
                    {
                        @foreach (var manager in members.OrderByDescending(manager => manager.AssignedAt))
                        {
                            <article class="rh-member-card rh-card-spotlight">
                                <div class="rh-member-card-copy">
                                    <strong>@manager.ManagerName</strong>
                                    <small>Manager • @manager.AssignedAt.LocalDateTime.ToString("yyyy-MM-dd")</small>
                                </div>

                                @if (Model.CanWrite)
                                {
                                    <div class="rh-member-card-actions">
                                        <form method="post" asp-action="UpdateManagerPermission" class="rh-member-permission-form" data-live-submit="property-overview">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="propertyId" value="@property.Id" />
                                            <input type="hidden" name="assignmentId" value="@manager.Id" />
                                            <div class="rh-select-wrap">
                                                <select class="form-select form-select-sm rh-input rh-select" name="permission">
                                                    <option value="ReadOnly" selected="@(manager.Permission == PermissionLevelEnum.ReadOnly ? "selected" : null)">ReadOnly</option>
                                                    <option value="ReadWrite" selected="@(manager.Permission == PermissionLevelEnum.ReadWrite ? "selected" : null)">ReadWrite</option>
                                                </select>
                                            </div>
                                            <button class="btn btn-sm rh-btn-subtle" type="submit">Save</button>
                                        </form>

                                        <form method="post" asp-action="RemoveManager" data-live-submit="property-overview" data-confirm-modal="true" data-confirm-title="Remove property member?" data-confirm-message="This member will lose access to this property." data-confirm-proceed="Remove member">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="propertyId" value="@property.Id" />
                                            <input type="hidden" name="assignmentId" value="@manager.Id" />
                                            <button class="btn btn-sm rh-btn-outline-danger" type="submit">Remove</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="rh-chip rh-chip-info">@manager.Permission</span>
                                }
                            </article>
                        }
                    }
                </div>
            </article>
        </div>
    </section>

    <section class="rh-overview-bottomgrid">
        <article class="rh-overview-settings-card rh-panel rh-panel-elevated">
            <div class="rh-overview-panel-head compact">
                <div>
                    <h2 class="rh-dashboard-panel-title">Property settings</h2>
                    <p class="rh-dashboard-panel-copy">Keep the core information current and accurate.</p>
                </div>
                @if (Model.CanWrite)
                {
                    <button type="button" class="rh-icon-btn" id="propertySettingsEditToggle" title="Edit property settings" aria-label="Edit property settings">
                        <span class="rh-icon-pencil"></span>
                    </button>
                }
            </div>

            <form method="post" asp-action="UpdateSettings" class="row g-3 rh-inline-editor-form" id="propertySettingsForm" data-inline-editor="locked" data-live-submit="property-overview">
                @Html.AntiForgeryToken()
                <input type="hidden" name="propertyId" value="@property.Id" />

                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <input class="form-control rh-input" name="Name" value="@property.Name" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-md-6">
                    <label class="form-label">City</label>
                    <input class="form-control rh-input" name="City" value="@property.City" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Latitude</label>
                    <input class="form-control rh-input" name="Latitude" type="number" step="0.000001" min="-90" max="90" value="@(property.Latitude?.ToString("F6") ?? string.Empty)" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Longitude</label>
                    <input class="form-control rh-input" name="Longitude" type="number" step="0.000001" min="-180" max="180" value="@(property.Longitude?.ToString("F6") ?? string.Empty)" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-12">
                    <label class="form-label">Address</label>
                    <input class="form-control rh-input" name="Address" value="@property.Address" @(Model.CanWrite ? "readonly" : "disabled") />
                </div>

                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea class="form-control rh-input" name="Description" rows="4" @(Model.CanWrite ? "readonly" : "disabled")>@property.Description</textarea>
                </div>

                @if (Model.CanWrite)
                {
                    <div class="col-12 rh-inline-editor-actions" hidden>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button class="btn rh-btn-subtle" type="button" id="propertySettingsCancel">Cancel</button>
                            <button class="btn rh-btn-primary" type="submit">Save Settings</button>
                        </div>
                    </div>
                }
            </form>
        </article>

        <article class="rh-overview-settings-card rh-panel rh-panel-elevated">
            <div class="rh-overview-panel-head compact">
                <div>
                    <h2 class="rh-dashboard-panel-title">Dialog settings</h2>
                    <p class="rh-dashboard-panel-copy">Control auto-hide behavior for success and error dialogs only.</p>
                </div>
            </div>

            <form method="post" asp-action="UpdateSuccessDialogSettings" class="row g-3" data-live-submit="property-overview">
                @Html.AntiForgeryToken()
                <input type="hidden" name="propertyId" value="@property.Id" />

                <div class="col-12">
                    <div class="rh-form-switch-row">
                        <div class="form-check form-switch rh-form-switch">
                            <input class="form-check-input" type="checkbox" id="autoCloseEnabled" name="autoCloseEnabled" value="true" @(Model.SuccessDialogAutoCloseEnabled ? "checked" : null) />
                            <label class="form-check-label" for="autoCloseEnabled">Auto-hide success and error dialogs</label>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">Auto close after (seconds)</label>
                    <input class="form-control rh-input" type="number" min="2" max="30" name="autoCloseSeconds" id="autoCloseSeconds" value="@Model.SuccessDialogAutoCloseSeconds" @(Model.SuccessDialogAutoCloseEnabled ? null : "disabled") />
                    <small class="text-muted">Applies only to success and error dialogs, never to add/edit modal forms.</small>
                </div>

                <div class="col-12 d-grid">
                    <button class="btn rh-btn-subtle" type="submit">Save Dialog Preferences</button>
                </div>
            </form>
        </article>
    </section>
</section>
@if (Model.CanWrite)
{
    <div class="modal fade" id="addApartmentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="CreateApartment" data-live-submit="property-overview" data-live-close-modal="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@property.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Add Apartment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">Apartment name</label>
                            <input class="form-control rh-input" name="Name" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Type</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="Type">
                                    @foreach (var type in Enum.GetValues<ApartmentTypeEnum>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Area (sqm)</label>
                            <input class="form-control rh-input" name="Area" type="number" min="0" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Monthly rent</label>
                            <input class="form-control rh-input" name="Price" type="number" min="0" step="0.01" required />
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Add Apartment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addMemberModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="AddMember" data-live-submit="property-overview" data-live-close-modal="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="propertyId" value="@property.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Add Property Member</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-2">
                        <div class="col-12">
                            <label class="form-label">Role</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="role">
                                    <option value="Manager">Manager</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Email</label>
                            <input class="form-control rh-input" name="Email" type="email" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Full Name</label>
                            <input class="form-control rh-input" name="FullName" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Country Code</label>
                            <input class="form-control rh-input" name="CountryCode" placeholder="e.g. +237" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Allowed Access</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="Permission">
                                    <option value="ReadOnly">ReadOnly</option>
                                    <option value="ReadWrite">ReadWrite</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Add+</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addPropertyDocumentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rh-modal-content">
                <form method="post" asp-action="UploadPropertyDocument" enctype="multipart/form-data" data-live-submit="property-overview" data-live-close-modal="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="propertyId" value="@property.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Add Property Document</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">Document file</label>
                            <input class="form-control rh-input" type="file" name="file" accept=".pdf,application/pdf" required />
                            <small class="text-muted">Only PDF files are allowed in this section.</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Document type</label>
                            <div class="rh-select-wrap">
                                <select class="form-select rh-input rh-select" name="type">
                                    @foreach (var type in Enum.GetValues<DocumentTypeEnum>().Where(type => type != DocumentTypeEnum.PropertyImage && type != DocumentTypeEnum.ApartmentImage))
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn rh-btn-subtle" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn rh-btn-primary">Upload document</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (propertyImage != null && !string.IsNullOrWhiteSpace(propertyImageUrl))
{
    <div class="modal fade" id="propertyImageLightbox" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content rh-image-lightbox-modal">
                <div class="modal-header border-0">
                    <h5 class="modal-title">@property.Name image</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0">
                    <img src="@propertyImageUrl" alt="@property.Name property image" class="rh-image-lightbox-preview" />
                </div>
            </div>
        </div>
    </div>
}




