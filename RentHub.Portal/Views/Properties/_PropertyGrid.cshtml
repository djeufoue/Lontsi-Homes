@using System
@using System.Linq
@model RentHub.Portal.ViewModels.Properties.PropertyIndexVm

<div class="rh-smart-table-card">
    <div class="rh-smart-table-header">
        <div class="rh-smart-table-heading">
            <p class="rh-kicker rh-kicker-ghost mb-1">Property register</p>
            <div class="rh-smart-table-heading-row">
                <h2 class="rh-section-title mb-0">Portfolio smart table</h2>
                @if (Model.ShowCreateEntryPoint)
                {
                    <button class="btn rh-btn-primary rh-smart-table-add-btn" type="button" data-bs-toggle="modal" data-bs-target="@(Model.CanCreateProperty ? "#createPropertyModal" : "#subscriptionRequiredModal")">
                        Add+
                    </button>
                }
            </div>
        </div>
        <div class="rh-smart-table-header-right">
            <div class="rh-smart-table-header-meta">
                <div>
                    <strong>@Model.TotalCount</strong>
                    <span>properties in scope</span>
                </div>
                <div>
                    <strong>@Model.Page / @Math.Max(Model.TotalPages, 1)</strong>
                    <span>current page</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="rh-empty rh-empty-dark">
            No properties found with the selected filters.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0 rh-smart-table">
                <thead>
                    <tr>
                        <th class="rh-smart-table-check-col">
                            <input class="form-check-input rh-table-check" type="checkbox" aria-label="Select all visible properties" />
                        </th>
                        <th>Code</th>
                        <th>Property</th>
                        <th>City</th>
                        <th>Units</th>
                        <th>Landlord</th>
                        <th>Access</th>
                        <th>Permission</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var property in Model.Items)
                    {
                        var initials = new string((property.Name ?? string.Empty)
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Where(part => !string.IsNullOrWhiteSpace(part))
                            .Take(2)
                            .Select(part => char.ToUpperInvariant(part[0]))
                            .ToArray());
                        if (string.IsNullOrWhiteSpace(initials))
                        {
                            initials = "PR";
                        }

                        var propertyCode = $"PRP-{property.Id:D4}";
                        var landlordName = string.IsNullOrWhiteSpace(property.LandlordName) ? "Not assigned" : property.LandlordName;
                    <tr>
                        <td class="rh-smart-table-check-col">
                            <input class="form-check-input rh-table-check" type="checkbox" aria-label="Select @property.Name" />
                        </td>
                        <td>
                            <div class="rh-row-code">
                                <strong>@propertyCode</strong>
                                <span>ID @property.Id</span>
                            </div>
                        </td>
                        <td>
                            <div class="rh-table-property">
                                <div class="rh-table-avatar">@initials</div>
                                <div class="rh-table-property-copy">
                                    <a class="rh-table-property-link" asp-controller="Properties" asp-action="Overview" asp-route-id="@property.Id">@property.Name</a>
                                    <span class="rh-table-secondary">@property.Address</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="rh-table-city">@property.City</span>
                        </td>
                        <td>
                            <div class="rh-row-metric">
                                <strong>@property.ApartmentCount</strong>
                                <span>registered units</span>
                            </div>
                        </td>
                        <td>
                            <div class="rh-row-landlord">
                                <strong>@landlordName</strong>
                                <span>portfolio owner</span>
                            </div>
                        </td>
                        <td>
                            <span class="rh-chip @(string.Equals(property.AccessSource, "Owned", StringComparison.OrdinalIgnoreCase) || string.Equals(property.AccessSource, "Owner", StringComparison.OrdinalIgnoreCase) ? "rh-chip-primary" : "rh-chip-info")">@property.AccessSource</span>
                        </td>
                        <td>
                            @if (property.CanWrite)
                            {
                                <span class="rh-chip rh-chip-primary">Write Access</span>
                            }
                            else
                            {
                                <span class="rh-chip rh-chip-warning">Read Access</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm rh-table-action" asp-controller="Properties" asp-action="Overview" asp-route-id="@property.Id">
                                Open
                            </a>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Property pages">
        <ul class="pagination mb-0 rh-pagination rh-pagination-dark">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-city="@Model.City" asp-route-access="@Model.Access" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">Page @Model.Page / @Model.TotalPages</span>
            </li>

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-city="@Model.City" asp-route-access="@Model.Access" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
            </li>
        </ul>
    </nav>
}
