@model RentHub.Portal.ViewModels.Properties.PropertyIndexVm

@if (Model.Items.Count == 0)
{
    <div class="rh-empty">
        No properties found with the selected filters.
    </div>
}
else
{
    <div class="rh-property-grid">
        @foreach (var property in Model.Items)
        {
            <article class="rh-property-card">
                <div class="rh-badge-row">
                    <span class="rh-chip rh-chip-info">@property.AccessSource</span>
                    @if (property.CanWrite)
                    {
                        <span class="rh-chip rh-chip-primary">Write Access</span>
                    }
                    else
                    {
                        <span class="rh-chip rh-chip-warning">Read Access</span>
                    }
                </div>

                <div>
                    <h3 class="rh-card-title">@property.Name</h3>
                    <p class="rh-card-meta">@property.City</p>
                    <p class="rh-card-meta">@property.Address</p>
                </div>

                <div class="rh-stat-row">
                    <div class="rh-stat-box">
                        <p class="rh-stat-label">Units</p>
                        <p class="rh-stat-value">@property.ApartmentCount</p>
                    </div>
                    <div class="rh-stat-box">
                        <p class="rh-stat-label">Landlord</p>
                        <p class="rh-stat-value">@(string.IsNullOrWhiteSpace(property.LandlordName) ? "N/A" : property.LandlordName)</p>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-1">
                    <small class="text-muted">Property ID: @property.Id</small>
                    <a class="btn btn-sm rh-btn-primary" asp-controller="Properties" asp-action="Overview" asp-route-id="@property.Id">
                        Open Property
                    </a>
                </div>
            </article>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Property pages">
        <ul class="pagination mb-0 rh-pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-city="@Model.City" asp-route-access="@Model.Access" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">Page @Model.Page / @Model.TotalPages</span>
            </li>

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-city="@Model.City" asp-route-access="@Model.Access" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
            </li>
        </ul>
    </nav>
}
